{
  "name": "kern-monorepo",
  "version": "4.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "KERN — backend structure and portable route logic for TypeScript/Express and Python/FastAPI parity.",
  "author": "cukas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KERNlang/kern.git"
  },
  "homepage": "https://github.com/KERNlang/kern#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc -b && pnpm --filter @kernlang/playground build",
    "test": "pnpm -r --filter '!kern-monorepo' --filter '!@kernlang/review-python' test && pnpm test:infra && pnpm check:rule-coverage",
    "test:non-semantics": "pnpm -r --filter '!kern-monorepo' --filter '!@kernlang/review-python' test --testPathIgnorePatterns=ir-semantics && pnpm test:infra && pnpm check:rule-coverage",
    "check:rule-coverage": "node ./scripts/check-rule-coverage.mjs",
    "check:python-codegen": "pnpm --filter @kernlang/core --filter @kernlang/python build && node ./scripts/lift-rate-python.mjs --check",
    "check:conformance": "pnpm --filter @kernlang/core --filter @kernlang/python --filter @kernlang/express build && node ./scripts/conformance.mjs && node ./scripts/class-conformance.mjs",
    "docs:contracts": "pnpm --filter @kernlang/core build && node ./scripts/generate-ir-semantics-docs.mjs --format=markdown --out=-",
    "docs:contracts:json": "pnpm --filter @kernlang/core build && node ./scripts/generate-ir-semantics-docs.mjs --format=json --out=generated/contracts/registry.json",
    "docs:contracts:check": "pnpm --filter @kernlang/core build && node ./scripts/check-contract-docs.mjs",
    "test:ir-semantics": "pnpm --filter @kernlang/core test --testPathPatterns=ir-semantics && pnpm --filter @kernlang/python test --testPathPatterns=ir-semantics-python-leg",
    "test:kern": "pnpm --filter @kernlang/test build && node packages/test/dist/cli.js examples/native-test --coverage --min-coverage 100 && node packages/test/dist/cli.js packages/core/native-test --coverage --min-coverage 100",
    "check:runner-browser-budget": "pnpm --filter @kernlang/core build && node ./scripts/check-runner-browser-budget.mjs",
    "check:runner-browser-budget:required": "pnpm --filter @kernlang/core build && node ./scripts/check-runner-browser-budget.mjs --browser-budget=required",
    "demo:kern-5-preview": "pnpm --filter @kernlang/core build && node ./examples/kern-5-preview-app/server.mjs",
    "test:app-demo": "pnpm --filter @kernlang/core build && node ./scripts/check-kern-5-preview-app.mjs",
    "test:runner-smoke": "pnpm --filter @kernlang/core build && pnpm --filter @kernlang/cli build && node ./scripts/check-kern-run-smoke.mjs && node ./scripts/check-kern-5-preview-app.mjs && node ./scripts/check-runner-browser-budget.mjs && pnpm test:capstone-flatten && pnpm test:capstone-assertion-engine && pnpm test:capstone-checker-subset && pnpm test:selfhost-validator",
    "test:capstone-flatten": "node --test scripts/capstone/flatten.test.mjs",
    "test:capstone-assertion-engine": "pnpm --filter @kernlang/core build && pnpm --filter @kernlang/cli build && node ./scripts/check-capstone-assertion-engine.mjs",
    "test:capstone-checker-subset": "pnpm --filter @kernlang/core build && pnpm --filter @kernlang/cli build && node ./scripts/check-capstone-checker-subset.mjs",
    "test:selfhost-validator": "pnpm --filter @kernlang/core build && pnpm --filter @kernlang/cli build && node ./scripts/check-selfhost-validator.mjs",
    "test:app-behavior": "node ./scripts/app-behavior-conformance.mjs",
    "test:drift-showcase": "pnpm --filter @kernlang/core --filter @kernlang/express --filter @kernlang/python build && node ./scripts/check-drift-showcase.mjs",
    "test:root": "pnpm build && node ./scripts/run-node-tests.mjs \"tests/**/*.test.ts\"",
    "test:prepush": "node --test scripts/pre-push.test.mjs",
    "test:kern-5-fitness": "node --test scripts/kern-5-fitness.test.mjs",
    "test:kern-ir-probe": "pnpm --filter @kernlang/core build && node ./scripts/check-kir-seam-probe.mjs",
    "test:kern-ir-reader-candidate": "pnpm --filter @kernlang/core build && node ./scripts/check-kir-reader-candidate.mjs",
    "test:kern-semantic-ownership": "node --test scripts/semantic-ownership/validate.test.mjs && node ./scripts/check-semantic-ownership.mjs",
    "test:kern-ir-eligibility": "pnpm --filter @kernlang/core build && node --test scripts/kir-v1/validate-eligibility.test.mjs && node ./scripts/check-kir-v1-eligibility.mjs",
    "test:kern-canonical-value": "pnpm --filter @kernlang/core test --testPathPatterns=canonical-value && node --test ./scripts/check-canonical-value.test.mjs && node ./scripts/check-canonical-value.mjs",
    "test:kern-kir-structural-constitution": "pnpm --filter @kernlang/core build && node --test ./scripts/kir-structural/constitution.test.mjs && node ./scripts/check-kir-structural-constitution.mjs",
    "test:kern-kir-structural-codec": "pnpm --filter @kernlang/core test --testPathPatterns=kir-structural && node --test ./scripts/check-kir-structural-codec.test.mjs && node ./scripts/check-kir-structural-codec.mjs",
    "test:kern-kir-module-graph": "pnpm --filter @kernlang/core test --testPathPatterns=kir-module-graph && node ./scripts/check-kir-module-graph.mjs",
    "test:kern-kir-coverage-closure": "pnpm --filter @kernlang/core build && node --test scripts/kir-v1/coverage-ledger.test.mjs && node ./scripts/check-kir-coverage-closure.mjs",
    "test:kern-kir-evidence": "pnpm --filter @kernlang/core test --testPathPatterns=kir-evidence && node ./scripts/check-kir-evidence.mjs",
    "test:kern-alpha-receipt": "node --test scripts/kir-v1/alpha-receipt.test.mjs",
    "test:kern-runtime-envelope": "pnpm --filter @kernlang/core test --testPathPatterns='runtime-envelope|portable-machine-evaluator' && node --test ./scripts/runtime-envelope-import-closure.test.mjs ./scripts/runtime-envelope-handler-import-closure.test.mjs && node ./scripts/check-runtime-envelope.mjs",
    "test:runtime-abi": "pnpm --filter @kernlang/core test --testPathPatterns='runtime-handler-public' && node --test ./scripts/runtime-handler-public-import-closure.test.mjs && node ./scripts/check-runtime-envelope.mjs",
    "build:kern-alpha-receipt": "node ./scripts/kir-v1/alpha-receipt.mjs",
    "test:infra": "pnpm test:prepush && pnpm test:release-policy && pnpm test:kern-5-fitness && pnpm test:kern-semantic-ownership && pnpm test:kern-ir-eligibility && pnpm test:kern-canonical-value && pnpm test:kern-kir-structural-constitution && pnpm test:kern-kir-structural-codec && pnpm test:kern-kir-module-graph && pnpm test:kern-kir-coverage-closure && pnpm test:kern-kir-evidence && pnpm test:kern-alpha-receipt && pnpm test:kern-runtime-envelope && pnpm test:runtime-abi",
    "fitness": "pnpm fitness:kern-5",
    "fitness:kern-5": "node ./scripts/kern-5-fitness.mjs",
    "check:kern-5-contract": "node ./scripts/kern-5-fitness.mjs --check",
    "check:repo": "node ./scripts/check-repo-consistency.mjs",
    "test:release-policy": "node --test scripts/release/*.test.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "prepush": "node ./scripts/pre-push.mjs",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "check:class-conformance": "pnpm --filter @kernlang/core --filter @kernlang/python build && node ./scripts/class-conformance.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "tree-sitter",
      "tree-sitter-python",
      "unrs-resolver"
    ],
    "overrides": {
      "typescript": "^6.0.3",
      "dompurify": ">=3.4.0",
      "brace-expansion": ">=5.0.6",
      "picomatch": ">=4.0.4",
      "hono": ">=4.12.19",
      "@hono/node-server": ">=1.19.13",
      "postcss": "8.5.15",
      "ip-address": "10.2.0",
      "qs": ">=6.15.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "express": "^5.2.1",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
