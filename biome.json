{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "!packages/*/src/generated"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "noMisleadingCharacterClass": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      },
      "correctness": {
        "noSwitchDeclarations": "warn",
        "noEmptyCharacterClassInRegex": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/tests/ir-semantics-do.test.ts",
        "packages/core/tests/rag-runtime.test.ts",
        "packages/core/tests/runner-array-index.test.ts",
        "packages/core/tests/runner-dynamic-index.test.ts",
        "packages/core/tests/runner-source-executor.test.ts",
        "packages/core/tests/runner-stdlib-namespace-calls.test.ts",
        "packages/core/tests/runner-string-ops.test.ts"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/review/tests/corpus/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
