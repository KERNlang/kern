{
  "name": "@kernlang/cli",
  "version": "4.6.0",
  "description": "KERN CLI — transpile, compile, minify, and analyze .kern files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kern": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./transpiler-cli": "./dist/transpiler-cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kern",
    "llm",
    "cli",
    "transpiler",
    "compiler",
    "review",
    "ai"
  ],
  "license": "AGPL-3.0",
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-kern-canonicalizer-cli-assets.mjs && node ../../scripts/build-kern-checker-cli-assets.mjs && node ../../scripts/build-kern-formatter-cli-assets.mjs",
    "test": "pnpm run build && node ../../scripts/run-node-tests.mjs \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@kernlang/check": "workspace:*",
    "@kernlang/codemod": "workspace:*",
    "@kernlang/core": "workspace:*",
    "@kernlang/evolve": "workspace:*",
    "@kernlang/express": "workspace:*",
    "@kernlang/go": "workspace:*",
    "@kernlang/python": "workspace:*",
    "@kernlang/mcp": "workspace:*",
    "@kernlang/metrics": "workspace:*",
    "@kernlang/native": "workspace:*",
    "@kernlang/react": "workspace:*",
    "@kernlang/review": "workspace:*",
    "@kernlang/review-mcp": "workspace:*",
    "@kernlang/test": "workspace:*",
    "@kernlang/terminal": "workspace:*",
    "@kernlang/vue": "workspace:*",
    "chokidar": "^5.0.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
