use path="./import-metadata.kern"
  from name=ExternalImportRegistry kind=type
  from name=ExternalImportTarget kind=type
  from name=ExternalImportTargetFamily kind=type
  from name=splitCapabilityList kind=fn

type name=ExternalBoundaryStringKey alias="'runtime' | 'serialization' | 'version' | 'review' | 'reason' | 'protocol' | 'module' | 'session' | 'options' | 'error' | 'timeout'"
type name=ExternalBoundaryInheritance alias="{ runtime?: string; serialization?: string; version?: string; review?: string; reason?: string; protocol?: string; module?: string; session?: string; options?: string; error?: string; timeout?: string; effects?: string[]; args?: string[] }"
type name=ExternalRuntimeImportShape alias="{ names: string[]; default?: string; from?: string; signature?: string; signatures?: Record<string, string>; types: boolean; line?: number; col?: number }"
type name=ExternalBoundaryRuntimeShape alias="{ explicitPackage?: boolean; island?: unknown; imports: ExternalRuntimeImportShape[]; requiresSidecar?: boolean; targetFamily?: string; registry?: string }"
type name=ExternalSidecarBoundaryShape alias="ExternalBoundaryRuntimeShape & { package: string; registry: ExternalImportRegistry; target: ExternalImportTarget; targetFamily: ExternalImportTargetFamily; version?: string; line?: number; col?: number }"
type name=ExternalSidecarPackageShape alias="{ package: string; registry: ExternalImportRegistry; target: ExternalImportTarget; targetFamily: ExternalImportTargetFamily; imports: ExternalRuntimeImportShape[]; version?: string; line?: number; col?: number }"

fn name=splitExternalNames params="value:unknown" returns="string[]" export=true
  handler
    return value="splitCapabilityList(value)"

fn name=externalStringProp returns="string | undefined" export=true
  param name=props type="Record<string, unknown>"
  param name=key type=string
  handler
    let name=value value="props[key]"
    return value="typeof value === 'string' && value.length > 0 ? value : undefined"

fn name=externalBoolProp returns=boolean export=true
  param name=props type="Record<string, unknown>"
  param name=key type=string
  handler
    return value="props[key] === true || props[key] === 'true'"

fn name=mergeExternalEffects returns="string[]" export=true
  param name=props type="Record<string, unknown>"
  param name=island type="ExternalBoundaryInheritance | undefined"
  handler
    let name=islandEffects value="Array.isArray(island?.effects) ? island.effects : []"
    return value="[...new Set([...islandEffects, ...splitExternalNames(props.effects)])]"

fn name=inheritExternalString returns="string | undefined" export=true
  param name=props type="Record<string, unknown>"
  param name=key type=ExternalBoundaryStringKey
  param name=island type="ExternalBoundaryInheritance | undefined"
  handler
    let name=value value="externalStringProp(props, key)"
    if cond="value !== undefined"
      return value="value"
    let name=inherited value="island?.[key]"
    return value="typeof inherited === 'string' ? inherited : undefined"

fn name=inheritExternalArgs returns="string[] | undefined" export=true
  param name=props type="Record<string, unknown>"
  param name=island type="ExternalBoundaryInheritance | undefined"
  handler
    let name=args value="splitExternalNames(props.args)"
    return value="args.length > 0 ? args : island?.args"

fn name=hasExternalRuntimeImports returns=boolean export=true
  param name=boundary type=ExternalBoundaryRuntimeShape
  handler
    return value="boundary.imports.some((binding) => binding.types !== true)"

fn name=externalRuntimeImports returns="ExternalRuntimeImportShape[]" export=true
  param name=imports type="ExternalRuntimeImportShape[]"
  handler
    return value="imports.filter((binding) => binding.types !== true)"

fn name=isPythonSidecarBoundaryShape returns=boolean export=true
  param name=boundary type=ExternalBoundaryRuntimeShape
  handler
    return value="boundary.requiresSidecar === true && hasExternalRuntimeImports(boundary) && (boundary.targetFamily === 'python' || boundary.registry === 'pypi')"

fn name=isLoosePythonBoundaryShape returns=boolean export=true
  param name=boundary type=ExternalBoundaryRuntimeShape
  handler
    return value="boundary.explicitPackage === true && !boundary.island && hasExternalRuntimeImports(boundary) && (boundary.targetFamily === 'python' || boundary.registry === 'pypi')"

fn name=externalSidecarPackageKey returns=string export=true
  param name=sidecarPackage type=ExternalSidecarPackageShape
  handler
    return value="`${sidecarPackage.package}\0${sidecarPackage.registry}\0${sidecarPackage.target}`"

fn name=externalSidecarPackageFromBoundary returns=ExternalSidecarPackageShape export=true
  param name=boundary type=ExternalSidecarBoundaryShape
  handler <<<
    const sidecarPackage: ExternalSidecarPackageShape = {
      package: boundary.package,
      registry: boundary.registry,
      target: boundary.target,
      targetFamily: boundary.targetFamily,
      imports: externalRuntimeImports(boundary.imports),
    };
    if (boundary.version !== undefined) sidecarPackage.version = boundary.version;
    if (boundary.line !== undefined) sidecarPackage.line = boundary.line;
    if (boundary.col !== undefined) sidecarPackage.col = boundary.col;
    return sidecarPackage;
  >>>
