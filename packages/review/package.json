{
  "name": "@kernlang/review",
  "version": "3.6.0",
  "description": "Kern Review — scan TS, infer .kern IR, roundtrip diff, report",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kern",
    "llm",
    "review",
    "static-analysis",
    "typescript",
