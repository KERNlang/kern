    "test": "pnpm run build && node ../../scripts/run-node-tests.mjs \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@kernlang/core": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "^2.0.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
