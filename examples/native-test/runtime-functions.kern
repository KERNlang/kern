const name=base value=10

fn name=add returns=number
  param name=a type=number
  param name=b type=number
  handler
    return value="a + b"

fn name=withBase params="value:number" returns=number
  handler
    return value="add(value, base)"

fn name=discountedTotal returns=number
  param name=order type=object
  handler
    let name=subtotal value="order.items.reduce((sum, item) => sum + item.price * item.qty, 0)"
    if cond="subtotal >= 50"
      return value="subtotal * 0.9"
    return value="subtotal"

fn name=loadTotal async=true returns=number
  param name=amount type=number
  handler
    let name=loaded value="await Promise.resolve(amount)"
    return value="loaded + 5"

derive name=runtimeTotal expr={{discountedTotal(order) + base}}
