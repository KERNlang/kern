fn name=whitespacetrimfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(\"kern.frontend.whitespace-trim-shadow.1\")"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    for name=padding from=0 to=15
      do value="out.push(\"\")"
    return value="out"

fn name=frontendtrimspace returns=boolean export=true
  param name=c type=string
  handler lang="kern"
    if cond="c == \"\\u0009\" || c == \"\\u000a\" || c == \"\\u000b\" || c == \"\\u000c\" || c == \"\\u000d\" || c == \" \""
      return value="true"
    if cond="c == \"\\u00a0\" || c == \"\\u1680\" || (c >= \"\\u2000\" && c <= \"\\u200a\")"
      return value="true"
    return value="c == \"\\u2028\" || c == \"\\u2029\" || c == \"\\u202f\" || c == \"\\u205f\" || c == \"\\u3000\" || c == \"\\ufeff\""

fn name=observewhitespacetrim returns="string[]" export=true
  param name=content type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxRecords type=number
  param name=maxLexicalDepth type=number
  handler lang="kern"
    if cond="maxCodePoints <= 0 || maxTokens <= 0 || maxDiagnostics <= 0 || maxRecords <= 0 || maxLexicalDepth <= 0"
      let name=invalidLimits value="whitespacetrimfailure(\"INVALID_LIMITS\", \"\")"
      return value="invalidLimits"
    let name=n value="Text.length(content)"
    if cond="n > maxCodePoints"
      let name=codePointsFailure value="whitespacetrimfailure(\"CODE_POINTS_LIMIT\", \"\")"
      return value="codePointsFailure"

    let name=scan value="scanlexicalcontent(content, 0, 0, 0, maxLexicalDepth)"
    if cond="scan[0] == 1"
      let name=scanLimitsFailure value="whitespacetrimfailure(\"INVALID_LIMITS\", \"\")"
      return value="scanLimitsFailure"
    if cond="scan[0] == 2"
      let name=scanDepthFailure value="whitespacetrimfailure(\"LEXICAL_DEPTH_LIMIT\", \"\")"
      return value="scanDepthFailure"

    let name=quote value="\"none\""
    if cond="scan[1] == 1"
      assign target=quote value="\"single\""
    if cond="scan[1] == 2"
      assign target=quote value="\"double\""
    let name=stop value="\"record-end\""
    let name=markerOffsetText value="\"none\""
    let name=markerKind value="\"none\""
    let name=markerText value="\"\""
    let name=rawPayload value="\"\""
    let name=codeEnd value="n"
    let name=triviaEnd value="n"

    if cond="scan[5] == 1"
      assign target=stop value="\"eligible-marker\""
      let name=markerOffset value="scan[6]"
      assign target=markerOffsetText value="String(markerOffset)"
      assign target=triviaEnd value="markerOffset"
      assign target=codeEnd value="triviaEnd"
      while cond="codeEnd > 0 && frontendtrimspace(Text.charAt(content, codeEnd - 1))"
        assign target=codeEnd value="codeEnd - 1"
      let name=first value="Text.charAt(content, markerOffset)"
      let name=payloadStart value="markerOffset + 1"
      if cond="first == \"#\""
        assign target=markerKind value="\"hash\""
        assign target=markerText value="\"#\""
      else
        if cond="first != \"/\" || markerOffset + 1 >= n || Text.charAt(content, markerOffset + 1) != \"/\""
          let name=markerFailure value="whitespacetrimfailure(\"TRIM_INVALID\", \"\")"
          return value="markerFailure"
        assign target=markerKind value="\"slash-slash\""
        assign target=markerText value="\"//\""
        assign target=payloadStart value="markerOffset + 2"
      assign target=rawPayload value="Text.slice(content, payloadStart, n)"

    let name=retainedCode value="Text.slice(content, 0, codeEnd)"
    let name=tokenized value="tokenizeline(retainedCode, maxCodePoints, maxTokens, maxDiagnostics, maxRecords)"
    if cond="tokenized.length >= 2 && tokenized[1] == \"failure\""
      let name=tokenFailure value="whitespacetrimfailure(tokenized[2], tokenized[3])"
      return value="tokenFailure"

    let name=out value="[]"
    do value="out.push(\"kern.frontend.whitespace-trim-shadow.1\")"
    do value="out.push(\"trim\")"
    do value="out.push(\"0\")"
    do value="out.push(\"0\")"
    do value="out.push(\"0\")"
    do value="out.push(\"0\")"
    do value="out.push(\"0\")"
    do value="out.push(content)"
    do value="out.push(quote)"
    do value="out.push(String(scan[2]))"
    do value="out.push(String(scan[3]))"
    do value="out.push(String(scan[4]))"
    do value="out.push(stop)"
    do value="out.push(markerOffsetText)"
    do value="out.push(markerKind)"
    do value="out.push(markerText)"
    do value="out.push(rawPayload)"
    do value="out.push(String(codeEnd))"
    do value="out.push(String(triviaEnd))"
    do value="out.push(\"seal\")"
    do value="out.push(content)"
    for name=sealPadding from=0 to=16
      do value="out.push(\"\")"
    return value="out"
