fn name=f5chargedsort returns="string[]"
  param name=entryFrames type="string[]"
  param name=entryWork type=number
  handler lang="kern"
    let name=work value=entryWork
    let name=order value="[]"
    let name=positionToOrdinal value="new Map()"
    let name=previous value="\"\""
    for name=outIndex from=0 to=entryFrames.length
      let name=selectedIndex value="-1"
      for name=candidateIndex from=0 to=entryFrames.length
        assign target=work value="work + 1"
        let name=positionKey value="String(candidateIndex)"
        if cond="Map.has(positionToOrdinal, positionKey)"
          let name=mappedPosition value="Map.get(positionToOrdinal, positionKey)"
          if cond="mappedPosition < 0"
            return value="[\"2\", String(work)]"
        else
          let name=candidateEntry value="f5rowread(List.index(entryFrames, candidateIndex))"
          assign target=work value="work + f5rowcodecwork(List.index(entryFrames, candidateIndex), candidateEntry)"
          if cond="candidateEntry.length != 2"
            return value="[\"2\", String(work)]"
          if cond="selectedIndex < 0"
            assign target=selectedIndex value=candidateIndex
          else
            let name=currentEntry value="f5rowread(List.index(entryFrames, selectedIndex))"
            assign target=work value="work + f5rowcodecwork(List.index(entryFrames, selectedIndex), currentEntry)"
            if cond="currentEntry.length != 2"
              return value="[\"2\", String(work)]"
            let name=candidateKey value="List.index(candidateEntry, 0)"
            let name=currentKey value="List.index(currentEntry, 0)"
            assign target=work value="work + f5scalarcomparework(candidateKey, currentKey)"
            if cond="f5scalartextless(candidateKey, currentKey)"
              assign target=selectedIndex value=candidateIndex
              assign target=work value="work + 1"
      if cond="selectedIndex < 0"
        return value="[\"2\", String(work)]"
      let name=selectedEntry value="f5rowread(List.index(entryFrames, selectedIndex))"
      assign target=work value="work + f5rowcodecwork(List.index(entryFrames, selectedIndex), selectedEntry)"
      if cond="selectedEntry.length != 2"
        return value="[\"2\", String(work)]"
      let name=selectedKey value="List.index(selectedEntry, 0)"
      if cond="outIndex > 0"
        assign target=work value="work + f5scalarcomparework(selectedKey, previous)"
        if cond="selectedKey == previous"
          return value="[\"2\", String(work)]"
      assign target=previous value=selectedKey
      do value="Map.set(positionToOrdinal, String(selectedIndex), outIndex)"
      do value="order.push(String(selectedIndex))"
    let name=result value="[]"
    do value="result.push(\"0\")"
    for name=orderIndex from=0 to=order.length
      do value="result.push(List.index(order, orderIndex))"
    do value="result.push(String(work))"
    return value=result
