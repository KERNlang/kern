fn name=structuredfn returns="string[]"
  param name=raw type=string
  handler lang="kern"
    let name=out value="[]"
    let name=rawRange value="structuredtrimrange(raw, 0, Text.length(raw))"
    let name=trimmedStart value="rawRange[0]"
    let name=trimmedEnd value="rawRange[1]"
    let name=trimmed value="Text.slice(raw, trimmedStart, trimmedEnd)"
    let name=n value="Text.length(trimmed)"
    if cond="n == 0 || !structurednamestart(Text.charAt(trimmed, 0))"
      do value="out.push(\"rewind-initial\")"
      return value=out
    let name=cursor value=1
    while cond="cursor < n && structurednamechar(Text.charAt(trimmed, cursor))"
      assign target=cursor value="cursor + 1"
    let name=name value="Text.slice(trimmed, 0, cursor)"
    while cond="cursor < n && structuredspace(Text.charAt(trimmed, cursor))"
      assign target=cursor value="cursor + 1"
    let name=generics value="\"\""
    let name=genericsStart value=0
    let name=genericsEnd value=0
    if cond="cursor < n && Text.charAt(trimmed, cursor) == \"<\""
      let name=genericClose value="structuredfindmatching(trimmed, cursor, \"<\", \">\")"
      if cond="genericClose < 0"
        do value="out.push(\"rewind-initial\")"
        return value=out
      assign target=genericsStart value=cursor
      assign target=genericsEnd value="genericClose + 1"
      assign target=generics value="Text.slice(trimmed, genericsStart, genericsEnd)"
      assign target=cursor value="genericClose + 1"
      while cond="cursor < n && structuredspace(Text.charAt(trimmed, cursor))"
        assign target=cursor value="cursor + 1"
    if cond="cursor >= n || Text.charAt(trimmed, cursor) != \"(\""
      do value="out.push(\"rewind-initial\")"
      return value=out
    let name=paramsClose value="structuredfindmatching(trimmed, cursor, \"(\", \")\")"
    if cond="paramsClose < 0"
      do value="out.push(\"rewind-initial\")"
      return value=out
    let name=paramsRange value="structuredtrimrange(trimmed, cursor + 1, paramsClose)"
    let name=params value="structuredcompactparams(Text.slice(trimmed, paramsRange[0], paramsRange[1]))"
    assign target=cursor value="paramsClose + 1"
    while cond="cursor < n && structuredspace(Text.charAt(trimmed, cursor))"
      assign target=cursor value="cursor + 1"
    let name=returns value="\"\""
    let name=returnsStart value=cursor
    let name=returnsEnd value=cursor
    let name=trailingRange value="structuredtrimrange(trimmed, cursor, n)"
    let name=trailingStart value="trailingRange[0]"
    let name=trailing value="Text.slice(trimmed, trailingStart, trailingRange[1])"
    if cond="Text.length(trailing) > 0 && Text.charAt(trailing, 0) == \":\""
      assign target=returnsStart value="trailingStart + 1"
      while cond="returnsStart < n && structuredspace(Text.charAt(trimmed, returnsStart))"
        assign target=returnsStart value="returnsStart + 1"
      let name=split value="structuredsplitreturns(Text.slice(trimmed, returnsStart, n))"
      assign target=returns value="split[0]"
      assign target=trailing value="split[1]"
      assign target=returnsEnd value="returnsStart + structureduint(split[2])"
      assign target=trailingStart value="returnsStart + structureduint(split[3])"
    do value="out.push(\"commit\")"
    do value="out.push(\"name\")"
    do value="out.push(\"text\")"
    do value="out.push(name)"
    do value="out.push(String(trimmedStart))"
    do value="out.push(String(trimmedStart + Text.length(name)))"
    if cond="generics != \"\""
      do value="out.push(\"generics\")"
      do value="out.push(\"text\")"
      do value="out.push(generics)"
      do value="out.push(String(trimmedStart + genericsStart))"
      do value="out.push(String(trimmedStart + genericsEnd))"
    if cond="params != \"\""
      do value="out.push(\"params\")"
      do value="out.push(\"text\")"
      do value="out.push(params)"
      do value="out.push(String(trimmedStart + paramsRange[0]))"
      do value="out.push(String(trimmedStart + paramsRange[1]))"
    if cond="returns != \"\""
      do value="out.push(\"returns\")"
      do value="out.push(\"text\")"
      do value="out.push(returns)"
      do value="out.push(String(trimmedStart + returnsStart))"
      do value="out.push(String(trimmedStart + returnsEnd))"
    let name=bare value="structuredbareprops(trailing, trimmedStart + trailingStart)"
    for name=index from=0 to="bare.length"
      do value="out.push(bare[index])"
    do value="out.push(\"__firstClassSyntax\")"
    do value="out.push(\"boolean\")"
    do value="out.push(\"true\")"
    do value="out.push(String(trimmedStart))"
    do value="out.push(String(trimmedEnd))"
    return value=out
fn name=structuredhaslegacytail returns=boolean
  param name=value type=string
  handler lang="kern"
    let name=parts value="structuredsplitwhitespace(value)"
    for name=index from=0 to="parts.length" step=3
      let name=part value="parts[index]"
      let name=equals value="Text.indexOf(part, \"=\")"
      if cond="equals <= 0"
        continue
      let name=key value="Text.slice(part, 0, equals)"
      let name=after value="Text.charAt(part, equals + 1)"
      if cond="(key == \"name\" || key == \"value\" || key == \"expr\" || key == \"type\" || key == \"kind\") && after != \"=\" && after != \">\""
        return value=true
    return value=false

fn name=structuredlet returns="string[]"
  param name=raw type=string
  handler lang="kern"
    let name=out value="[]"
    let name=rawRange value="structuredtrimrange(raw, 0, Text.length(raw))"
    let name=trimmedStart value="rawRange[0]"
    let name=trimmed value="Text.slice(raw, trimmedStart, rawRange[1])"
    let name=equals value="structuredfindassignment(trimmed)"
    if cond="equals < 0"
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=lhsRange value="structuredtrimrange(trimmed, 0, equals)"
    let name=valueRange value="structuredtrimrange(trimmed, equals + 1, Text.length(trimmed))"
    let name=lhs value="Text.slice(trimmed, lhsRange[0], lhsRange[1])"
    let name=value value="Text.slice(trimmed, valueRange[0], valueRange[1])"
    let name=legacyLhs value="lhs == \"name\" || lhs == \"value\" || lhs == \"expr\" || lhs == \"type\" || lhs == \"kind\""
    if cond="legacyLhs && structuredhaslegacytail(value)"
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=colon value="Text.indexOf(lhs, \":\")"
    let name=name value=lhs
    let name=type value="\"\""
    let name=nameRange value="structuredtrimrange(lhs, 0, colon >= 0 ? colon : Text.length(lhs))"
    let name=typeRange value="structuredtrimrange(lhs, colon + 1, Text.length(lhs))"
    if cond="colon >= 0"
      assign target=name value="structuredtrim(Text.slice(lhs, 0, colon))"
      assign target=type value="structuredtrim(Text.slice(lhs, colon + 1, Text.length(lhs)))"
    if cond="!structuredvalidname(name) || (colon >= 0 && type == \"\")"
      do value="out.push(\"rewind-tail\")"
      return value=out
    do value="out.push(\"commit\")"
    do value="out.push(\"name\")"
    do value="out.push(\"text\")"
    do value="out.push(name)"
    do value="out.push(String(trimmedStart + lhsRange[0] + nameRange[0]))"
    do value="out.push(String(trimmedStart + lhsRange[0] + nameRange[1]))"
    if cond="type != \"\""
      do value="out.push(\"type\")"
      do value="out.push(\"text\")"
      do value="out.push(type)"
      do value="out.push(String(trimmedStart + lhsRange[0] + typeRange[0]))"
      do value="out.push(String(trimmedStart + lhsRange[0] + typeRange[1]))"
    do value="out.push(\"value\")"
    do value="out.push(\"text\")"
    do value="out.push(value)"
    do value="out.push(String(trimmedStart + valueRange[0]))"
    do value="out.push(String(trimmedStart + valueRange[1]))"
    return value=out
