fn name=stitchdocument returns="string[]" export=true
  param name=source type=string
  param name=rawProfile type=string
  param name=maxCodePoints type=number
  param name=maxPhysicalRecords type=number
  param name=maxPhysicalRecordCodePoints type=number
  param name=maxGroups type=number
  param name=maxGroupRecords type=number
  param name=maxStitchDepth type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxEnvelopeRecords type=number
  param name=maxRawOpeners type=number
  handler lang="kern"
    let name=format value="\"kern.frontend.stitch-shadow.1\""
    if cond="maxCodePoints <= 0 || maxPhysicalRecords <= 0 || maxPhysicalRecordCodePoints <= 0 || maxGroups <= 0 || maxGroupRecords <= 0 || maxStitchDepth <= 0 || maxTokens <= 0 || maxDiagnostics <= 0 || maxEnvelopeRecords <= 0 || maxRawOpeners <= 0"
      let name=invalidLimitsFailure value="stitchfailure(\"INVALID_LIMITS\", \"\")"
      return value="invalidLimitsFailure"
    let name=n value="Text.length(source)"
    if cond="n > maxCodePoints"
      let name=codePointsFailure value="stitchfailure(\"CODE_POINTS_LIMIT\", \"\")"
      return value="codePointsFailure"
    if cond="Text.indexOf(source, \"\\r\") >= 0"
      let name=lineEndingFailure value="stitchfailure(\"UNSUPPORTED_LINE_ENDING\", \"\")"
      return value="lineEndingFailure"

    let name=contents value="[]"
    let name=hasLfs value="[]"
    let name=classes value="[]"
    let name=out value="[]"
    do value="out.push(format)"
    let name=envelopeRecords value="0"
    let name=rawOpeners value="0"
    let name=cursor value="0"
    let name=physicalIndex value="0"
    if cond="n == 0"
      do value="contents.push(\"\")"
      do value="hasLfs.push(0)"
      do value="classes.push(\"blank\")"
    while cond="cursor < n"
      let name=lineStart value="cursor"
      while cond="cursor < n && Text.charAt(source, cursor) != \"\\n\""
        assign target=cursor value="cursor + 1"
      let name=content value="Text.slice(source, lineStart, cursor)"
      let name=hasLf value="0"
      if cond="cursor < n"
        assign target=hasLf value="1"
      if cond="Text.length(content) > maxPhysicalRecordCodePoints"
        let name=physicalCodePointsFailure value="stitchfailure(\"PHYSICAL_RECORD_CODE_POINTS_LIMIT\", \"\")"
        return value="physicalCodePointsFailure"
      if cond="physicalIndex >= maxPhysicalRecords"
        let name=physicalRecordsFailure value="stitchfailure(\"PHYSICAL_RECORD_LIMIT\", \"\")"
        return value="physicalRecordsFailure"
      let name=recordClass value="stitchclass(content, rawProfile)"
      if cond="recordClass == \"raw-opener-candidate\""
        assign target=rawOpeners value="rawOpeners + 1"
        if cond="rawOpeners > maxRawOpeners"
          let name=rawOpenersFailure value="stitchfailure(\"RAW_OPENER_LIMIT\", \"\")"
          return value="rawOpenersFailure"
      do value="contents.push(content)"
      do value="hasLfs.push(hasLf)"
      do value="classes.push(recordClass)"
      if cond="hasLf == 1"
        assign target=cursor value="cursor + 1"
      assign target=physicalIndex value="physicalIndex + 1"

    for name=p from=0 to="contents.length"
      if cond="envelopeRecords >= maxEnvelopeRecords"
        let name=physicalEnvelopeFailure value="stitchfailure(\"ENVELOPE_RECORD_LIMIT\", \"\")"
        return value="physicalEnvelopeFailure"
      let name=extent value="contents[p]"
      if cond="hasLfs[p] == 1"
        assign target=extent value="extent + \"\\n\""
      do value="out.push(\"physical\")"
      do value="out.push(String(p))"
      do value="out.push(contents[p])"
      do value="out.push(stitchindent(contents[p]))"
      do value="out.push(String(hasLfs[p]))"
      do value="out.push(classes[p])"
      do value="out.push(extent)"
      do value="out.push(\"\")"
      assign target=envelopeRecords value="envelopeRecords + 1"

    let name=groupIndex value="0"
    let name=consumedThrough value="-1"
    let name=totalTokens value="0"
    let name=totalDiagnostics value="0"
    for name=recordIndex from=0 to="contents.length"
      if cond="recordIndex <= consumedThrough"
        continue
      let name=currentClass value="classes[recordIndex]"
      if cond="currentClass == \"file-comment-candidate\" || currentClass == \"raw-opener-candidate\" || currentClass == \"blank\""
        continue
      if cond="groupIndex >= maxGroups"
        let name=groupsFailure value="stitchfailure(\"GROUP_LIMIT\", \"\")"
        return value="groupsFailure"
      let name=groupStart value="recordIndex"
      let name=groupEnd value="recordIndex"
      let name=groupSource value="contents[recordIndex]"
      let name=state value="stitchscan(contents[recordIndex], 0)"
      let name=quoteState value="0"
      let name=exprDepth value="state"
      if cond="state < 0"
        assign target=quoteState value="1"
        assign target=exprDepth value="0"
      if cond="exprDepth > maxStitchDepth"
        let name=initialStitchDepthFailure value="stitchfailure(\"STITCH_DEPTH_LIMIT\", \"\")"
        return value="initialStitchDepthFailure"
      let name=termination value="\"complete\""
      for name=candidate from=0 to="contents.length"
        if cond="candidate <= recordIndex"
          continue
        if cond="quoteState == 0 && exprDepth == 0"
          break
        let name=nextClass value="classes[candidate]"
        if cond="nextClass == \"file-comment-candidate\""
          assign target=termination value="\"comment-boundary\""
          break
        if cond="nextClass == \"raw-opener-candidate\""
          assign target=termination value="\"raw-opener-boundary\""
          break
        if cond="candidate - groupStart >= maxGroupRecords"
          let name=groupRecordsFailure value="stitchfailure(\"GROUP_RECORD_LIMIT\", \"\")"
          return value="groupRecordsFailure"
        assign target=groupEnd value="candidate"
        assign target=groupSource value="groupSource + \"\\n\" + contents[candidate]"
        assign target=state value="stitchscan(contents[candidate], state)"
        assign target=quoteState value="0"
        assign target=exprDepth value="state"
        if cond="state < 0"
          assign target=quoteState value="1"
          assign target=exprDepth value="0"
        if cond="exprDepth > maxStitchDepth"
          let name=stitchDepthFailure value="stitchfailure(\"STITCH_DEPTH_LIMIT\", \"\")"
          return value="stitchDepthFailure"
      if cond="quoteState == 1 || exprDepth > 0"
        if cond="termination == \"complete\""
          assign target=termination value="\"eof-unclosed\""
      if cond="envelopeRecords >= maxEnvelopeRecords"
        let name=groupEnvelopeFailure value="stitchfailure(\"ENVELOPE_RECORD_LIMIT\", \"\")"
        return value="groupEnvelopeFailure"
      do value="out.push(\"group\")"
      do value="out.push(String(groupIndex))"
      do value="out.push(String(groupStart))"
      do value="out.push(String(groupEnd))"
      do value="out.push(termination)"
      do value="out.push(String(quoteState))"
      do value="out.push(String(exprDepth))"
      do value="out.push(\"\")"
      assign target=envelopeRecords value="envelopeRecords + 1"

      if cond="termination == \"complete\""
        let name=tokenResult value="tokenizeline(groupSource, maxCodePoints, maxTokens, maxDiagnostics, maxTokens + maxDiagnostics)"
        if cond="tokenResult.length >= 5 && tokenResult[1] == \"failure\""
          let name=tokenizerFailure value="stitchfailure(tokenResult[2], tokenResult[3])"
          return value="tokenizerFailure"
        for name=tokenCursor from=1 to="tokenResult.length" step=4
          if cond="tokenResult[tokenCursor] == \"token\""
            assign target=totalTokens value="totalTokens + 1"
          if cond="tokenResult[tokenCursor] == \"diagnostic\""
            assign target=totalDiagnostics value="totalDiagnostics + 1"
        if cond="totalTokens > maxTokens"
          let name=tokensFailure value="stitchfailure(\"TOKEN_LIMIT\", \"\")"
          return value="tokensFailure"
        if cond="totalDiagnostics > maxDiagnostics"
          let name=diagnosticsFailure value="stitchfailure(\"DIAGNOSTIC_LIMIT\", \"\")"
          return value="diagnosticsFailure"
        for name=t from=0 to="tokenResult.length"
          if cond="envelopeRecords >= maxEnvelopeRecords"
            let name=tokenEnvelopeFailure value="stitchfailure(\"ENVELOPE_RECORD_LIMIT\", \"\")"
            return value="tokenEnvelopeFailure"
          do value="out.push(\"token-field\")"
          do value="out.push(String(groupIndex))"
          do value="out.push(String(t))"
          do value="out.push(tokenResult[t])"
          do value="out.push(\"\")"
          do value="out.push(\"\")"
          do value="out.push(\"\")"
          do value="out.push(\"\")"
          assign target=envelopeRecords value="envelopeRecords + 1"
      assign target=groupIndex value="groupIndex + 1"
      assign target=consumedThrough value="groupEnd"

    if cond="envelopeRecords >= maxEnvelopeRecords"
      let name=sealEnvelopeFailure value="stitchfailure(\"ENVELOPE_RECORD_LIMIT\", \"\")"
      return value="sealEnvelopeFailure"
    do value="out.push(\"seal\")"
    do value="out.push(source)"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    return value="out"
