fn name=tokenizeline returns="string[]" export=true
  param name=line type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxRecords type=number
  handler lang="kern"
    if cond="maxCodePoints <= 0 || maxTokens <= 0 || maxDiagnostics <= 0 || maxRecords <= 0"
      return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"INVALID_LIMITS\", \"\", \"\"]"
    let name=n value="Text.length(line)"
    if cond="n > maxCodePoints"
      return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"CODE_POINTS_LIMIT\", \"\", \"\"]"
    let name=out value="[]"
    do value="out.push(\"kern.frontend.tokenizer-shadow.2\")"
    let name=i value="0"
    let name=tokens value="0"
    let name=diagnostics value="0"
    let name=records value="0"
    let name=boundaryStart value="0"
    while cond="i < n"
      let name=ch value="Text.charAt(line, i)"

      if cond="ch == \" \" || ch == \"\\t\""
        let name=whitespaceStart value="i"
        while cond="i < n && (Text.charAt(line, i) == \" \" || Text.charAt(line, i) == \"\\t\")"
          assign target=i value="i + 1"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        do value="out.push(\"token\")"
        do value="out.push(\"whitespace\")"
        do value="out.push(Text.slice(line, whitespaceStart, i))"
        do value="out.push(Text.slice(line, boundaryStart, whitespaceStart))"
        assign target=boundaryStart value="whitespaceStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        continue

      if cond="ch == \"{\" && i + 1 < n && Text.charAt(line, i + 1) == \"{\""
        let name=expressionStart value="i"
        assign target=i value="i + 2"
        let name=depth value="1"
        while cond="i < n - 1 && depth > 0"
          if cond="Text.charAt(line, i) == \"{\" && Text.charAt(line, i + 1) == \"{\""
            assign target=depth value="depth + 1"
            assign target=i value="i + 2"
            continue
          if cond="Text.charAt(line, i) == \"}\" && Text.charAt(line, i + 1) == \"}\""
            assign target=depth value="depth - 1"
            if cond="depth == 0"
              break
            assign target=i value="i + 2"
            continue
          assign target=i value="i + 1"
        let name=expressionInner value="trimtoken(Text.slice(line, expressionStart + 2, i))"
        if cond="depth > 0"
          if cond="records >= maxRecords"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
          if cond="diagnostics >= maxDiagnostics"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"DIAGNOSTIC_LIMIT\", \"\", \"\"]"
          do value="out.push(\"diagnostic\")"
          do value="out.push(\"UNCLOSED_EXPR\")"
          do value="out.push(Text.slice(line, boundaryStart, expressionStart))"
          do value="out.push(Text.slice(line, expressionStart, expressionStart + 2))"
          assign target=boundaryStart value="expressionStart"
          assign target=diagnostics value="diagnostics + 1"
          assign target=records value="records + 1"
        if cond="i < n - 1"
          assign target=i value="i + 2"
        else
          assign target=i value="n"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        do value="out.push(\"token\")"
        do value="out.push(\"expr\")"
        do value="out.push(expressionInner)"
        do value="out.push(Text.slice(line, boundaryStart, expressionStart))"
        assign target=boundaryStart value="expressionStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        continue

      if cond="ch == \"{\""
        let name=styleStart value="i"
        let name=styleCursor value="n"
        let name=styleClosed value="false"
        let name=styleInQuote value="false"
        let name=styleSkip value="false"
        let name=styleIndex value="styleStart + 1"
        while cond="styleIndex < n"
          if cond="styleSkip"
            assign target=styleSkip value="false"
          else
            if cond="Text.charAt(line, styleIndex) == \"\\\\\" && styleIndex + 1 < n"
              assign target=styleSkip value="true"
            else
              if cond="Text.charAt(line, styleIndex) == \"\\\"\""
                assign target=styleInQuote value="!styleInQuote"
              else
                if cond="!styleInQuote"
                  if cond="Text.charAt(line, styleIndex) == \"}\""
                    assign target=styleCursor value="styleIndex + 1"
                    assign target=styleClosed value="true"
                    break
          assign target=styleIndex value="styleIndex + 1"
        if cond="!styleClosed"
          if cond="records >= maxRecords"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
          if cond="diagnostics >= maxDiagnostics"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"DIAGNOSTIC_LIMIT\", \"\", \"\"]"
          do value="out.push(\"diagnostic\")"
          do value="out.push(\"UNCLOSED_STYLE\")"
          do value="out.push(Text.slice(line, boundaryStart, styleStart))"
          do value="out.push(Text.slice(line, styleStart, styleStart + 1))"
          assign target=boundaryStart value="styleStart"
          assign target=diagnostics value="diagnostics + 1"
          assign target=records value="records + 1"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        let name=styleEnd value="styleCursor"
        if cond="styleClosed"
          assign target=styleEnd value="styleCursor - 1"
        do value="out.push(\"token\")"
        do value="out.push(\"style\")"
        do value="out.push(Text.slice(line, styleStart + 1, styleEnd))"
        do value="out.push(Text.slice(line, boundaryStart, styleStart))"
        assign target=boundaryStart value="styleStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        assign target=i value="styleCursor"
        continue

      if cond="ch == \"\\\"\" || ch == \"'\""
        let name=quoteMark value="ch"
        let name=quoteStart value="i"
        assign target=i value="i + 1"
        let name=quoteInner value="\"\""
        while cond="i < n && Text.charAt(line, i) != quoteMark"
          if cond="Text.charAt(line, i) == \"\\\\\" && i + 1 < n"
            let name=quoteNext value="Text.charAt(line, i + 1)"
            if cond="quoteNext == quoteMark"
              assign target=quoteInner value="quoteInner + quoteMark"
              assign target=i value="i + 2"
              continue
            if cond="quoteNext == \"\\\\\""
              assign target=quoteInner value="quoteInner + \"\\\\\""
              assign target=i value="i + 2"
              continue
          assign target=quoteInner value="quoteInner + Text.charAt(line, i)"
          assign target=i value="i + 1"
        if cond="i >= n"
          if cond="records >= maxRecords"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
          if cond="diagnostics >= maxDiagnostics"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"DIAGNOSTIC_LIMIT\", \"\", \"\"]"
          do value="out.push(\"diagnostic\")"
          do value="out.push(\"UNCLOSED_STRING\")"
          do value="out.push(Text.slice(line, boundaryStart, quoteStart))"
          do value="out.push(Text.slice(line, quoteStart, quoteStart + 1))"
          assign target=boundaryStart value="quoteStart"
          assign target=diagnostics value="diagnostics + 1"
          assign target=records value="records + 1"
        else
          assign target=i value="i + 1"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        do value="out.push(\"token\")"
        do value="out.push(\"quoted\")"
        do value="out.push(quoteInner)"
        do value="out.push(Text.slice(line, boundaryStart, quoteStart))"
        assign target=boundaryStart value="quoteStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        continue

      if cond="ch == \"$\" && i + 1 < n && identstart(Text.charAt(line, i + 1))"
        let name=themeStart value="i"
        assign target=i value="i + 1"
        while cond="i < n && identchar(Text.charAt(line, i))"
          assign target=i value="i + 1"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        do value="out.push(\"token\")"
        do value="out.push(\"themeRef\")"
        do value="out.push(Text.slice(line, themeStart + 1, i))"
        do value="out.push(Text.slice(line, boundaryStart, themeStart))"
        assign target=boundaryStart value="themeStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        continue

      if cond="ch == \"=\" || ch == \",\""
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        let name=punctuationKind value="\"equals\""
        if cond="ch == \",\""
          assign target=punctuationKind value="\"comma\""
        do value="out.push(\"token\")"
        do value="out.push(punctuationKind)"
        do value="out.push(ch)"
        do value="out.push(Text.slice(line, boundaryStart, i))"
        assign target=boundaryStart value="i"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        assign target=i value="i + 1"
        continue

      if cond="ch == \"/\""
        let name=slashStart value="i"
        while cond="i < n && Text.charAt(line, i) != \" \" && Text.charAt(line, i) != \"\\t\" && Text.charAt(line, i) != \"{\" && Text.charAt(line, i) != \"$\""
          assign target=i value="i + 1"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        do value="out.push(\"token\")"
        do value="out.push(\"slash\")"
        do value="out.push(Text.slice(line, slashStart, i))"
        do value="out.push(Text.slice(line, boundaryStart, slashStart))"
        assign target=boundaryStart value="slashStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        continue

      if cond="validdigit(ch, 10) || (ch == \".\" && i + 1 < n && validdigit(Text.charAt(line, i + 1), 10))"
        let name=numberEnd value="numberend(line, i)"
        if cond="numberEnd >= 0"
          let name=numberStart value="i"
          let name=numberValue value="Text.slice(line, numberStart, numberEnd)"
          if cond="Text.indexOf(numberValue, \".\") >= 0 && Text.charAt(numberValue, Text.length(numberValue) - 1) == \"n\""
            if cond="records >= maxRecords"
              return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
            if cond="diagnostics >= maxDiagnostics"
              return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"DIAGNOSTIC_LIMIT\", \"\", \"\"]"
            do value="out.push(\"diagnostic\")"
            do value="out.push(\"INVALID_BIGINT\")"
            do value="out.push(Text.slice(line, boundaryStart, numberStart))"
            do value="out.push(Text.slice(line, numberStart, numberStart + 1))"
            assign target=boundaryStart value="numberStart"
            assign target=diagnostics value="diagnostics + 1"
            assign target=records value="records + 1"
          if cond="records >= maxRecords"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
          if cond="tokens >= maxTokens"
            return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
          do value="out.push(\"token\")"
          do value="out.push(\"number\")"
          do value="out.push(numberValue)"
          do value="out.push(Text.slice(line, boundaryStart, numberStart))"
          assign target=boundaryStart value="numberStart"
          assign target=tokens value="tokens + 1"
          assign target=records value="records + 1"
          assign target=i value="numberEnd"
          continue

      if cond="identstart(ch)"
        let name=identifierStart value="i"
        while cond="i < n && identchar(Text.charAt(line, i))"
          assign target=i value="i + 1"
        let name=identifierValue value="Text.slice(line, identifierStart, i)"
        if cond="i < n && Text.charAt(line, i) == \":\" && identifierValue == \"evolved\" && i + 1 < n && identstart(Text.charAt(line, i + 1))"
          assign target=i value="i + 1"
          let name=evolvedNameStart value="i"
          while cond="i < n && identchar(Text.charAt(line, i))"
            assign target=i value="i + 1"
          assign target=identifierValue value="Text.slice(line, evolvedNameStart, i)"
        if cond="records >= maxRecords"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
        if cond="tokens >= maxTokens"
          return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
        do value="out.push(\"token\")"
        do value="out.push(\"identifier\")"
        do value="out.push(identifierValue)"
        do value="out.push(Text.slice(line, boundaryStart, identifierStart))"
        assign target=boundaryStart value="identifierStart"
        assign target=tokens value="tokens + 1"
        assign target=records value="records + 1"
        continue

      if cond="ch > \"\\u007f\""
        return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"UNSUPPORTED_UNKNOWN\", \"\", \"\"]"
      if cond="records >= maxRecords"
        return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"RECORD_LIMIT\", \"\", \"\"]"
      if cond="tokens >= maxTokens"
        return value="[\"kern.frontend.tokenizer-shadow.2\", \"failure\", \"TOKEN_LIMIT\", \"\", \"\"]"
      do value="out.push(\"token\")"
      do value="out.push(\"unknown\")"
      do value="out.push(ch)"
      do value="out.push(Text.slice(line, boundaryStart, i))"
      assign target=boundaryStart value="i"
      assign target=tokens value="tokens + 1"
      assign target=records value="records + 1"
      assign target=i value="i + 1"
    do value="out.push(\"seal\")"
    do value="out.push(Text.slice(line, boundaryStart, n))"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    return value="out"
