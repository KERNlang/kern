fn name=classifyf4available returns="string[]"
  param name=moduleId type=string
  param name=source type=string
  param name=recordKinds type="number[]"
  param name=recordFlags type="number[]"
  param name=recordStarts type="number[]"
  param name=recordEnds type="number[]"
  param name=f1RecordTape type=string
  param name=segmentFirstRecords type="number[]"
  param name=segmentLastRecords type="number[]"
  param name=segmentOuterStarts type="number[]"
  param name=segmentOuterEnds type="number[]"
  param name=segmentBodyStarts type="number[]"
  param name=segmentBodyEnds type="number[]"
  param name=f3ExpectedFields type="string[]"
  param name=rawOpenerTypes type="string[]"
  param name=segmentBodies type="string[]"
  param name=segmentBodyDigests type="string[]"
  param name=segmentRecordDigests type="string[]"
  param name=f2bExpectedFields type="string[]"
  param name=maxSegments type=number
  param name=maxAggregateBodyScalars type=number
  param name=maxAggregateBatchNodes type=number
  param name=maxBatchAbsoluteSpans type=number
  param name=maxBatchWorkSteps type=number
  param name=maxExpressionSourceScalars type=number
  param name=maxExpressionTokens type=number
  param name=maxExpressionNodes type=number
  param name=expressionNodesPerChunk type=number
  param name=maxExpressionChunks type=number
  param name=maxExpressionTapeScalars type=number
  param name=maxExpressionNestingDepth type=number
  param name=maxExpressionWorkSteps type=number
  param name=maxRecords type=number
  param name=maxLogicalLines type=number
  param name=maxParentEdges type=number
  param name=maxDecoratorRuns type=number
  param name=maxRawBlocks type=number
  param name=maxStructuralDiagnostics type=number
  param name=maxF3WorkSteps type=number
  param name=lineFirstRecords type="number[]"
  param name=lineLastRecords type="number[]"
  param name=lineStarts type="number[]"
  param name=lineEnds type="number[]"
  param name=lineFirstPhysical type="number[]"
  param name=lineLastPhysical type="number[]"
  param name=lineIndents type="number[]"
  param name=lineContentStarts type="number[]"
  param name=lineRoles type="string[]"
  param name=lineFirstSegments type="number[]"
  param name=lineSegmentCounts type="number[]"
  param name=edgeChildren type="number[]"
  param name=edgeParents type="number[]"
  param name=edgeChildIndents type="number[]"
  param name=edgeParentIndents type="number[]"
  param name=decoratorFirsts type="number[]"
  param name=decoratorLasts type="number[]"
  param name=decoratorSuccessors type="number[]"
  param name=decoratorDispositions type="string[]"
  param name=rawOwners type="number[]"
  param name=rawOpeners type="number[]"
  param name=rawClosers type="number[]"
  param name=rawBodyStarts type="number[]"
  param name=rawBodyEnds type="number[]"
  param name=rawInlineFlags type="string[]"
  param name=rawTypes type="string[]"
  param name=nodeIds type="string[]"
  param name=nodeSchemaStatuses type="string[]"
  param name=nodeAllowedModes type="string[]"
  param name=nodeChildTapes type="string[]"
  param name=nodePropertyStarts type="number[]"
  param name=nodePropertyCounts type="number[]"
  param name=propertyNodes type="string[]"
  param name=propertyNames type="string[]"
  param name=propertyKinds type="string[]"
  param name=propertyRequired type="string[]"
  param name=propertyValueTapes type="string[]"
  param name=propertyDispositions type="string[]"
  param name=propertyReasonIds type="string[]"
  param name=keywordForms type="string[]"
  param name=keywordSourceProfiles type="string[]"
  param name=maxDeclarations type=number
  param name=maxOccurrences type=number
  param name=maxAttachments type=number
  param name=maxDecorators type=number
  param name=maxSymbols type=number
  param name=maxBindings type=number
  param name=maxDiagnostics type=number
  param name=maxEncodedBytes type=number
  param name=maxFacts type=number
  param name=maxWorkSteps type=number
  param name=forceLateFailure type=boolean
  param name=maxExpressionEvidence type=number
  param name=maxF4LocalF2Calls type=number
  param name=maxAggregateExpressionScalars type=number
  param name=maxAggregateExpressionNodes type=number
  param name=maxExpressionAbsoluteSpans type=number
  param name=maxExpressionBoundaryEntries type=number
  param name=maxExpressionReceiptScalars type=number
  param name=testPhaseKeyMutation type=string
  param name=maxModuleIdScalars type=number
  param name=maxModuleIdSegments type=number
  param name=maxImportSpecifierScalars type=number
  param name=maxImportSpecifierSegments type=number
  param name=moduleDirectory type=string
  param name=pathWorkSteps type=number
  handler lang="kern"
    let name=sourceScalars value="Text.length(source)"
    let name=workSteps value=pathWorkSteps
    let name=frozenNodes value="builtinnodetypes()"
    let name=nodeMap value="new Map()"
    let name=nodeStatusMap value="new Map()"
    let name=nodeModeMap value="new Map()"
    let name=nodeChildTapeMap value="new Map()"
    let name=propertyMap value="new Map()"
    let name=propertyKindMap value="new Map()"
    let name=propertyRequiredMap value="new Map()"
    let name=propertyValuesMap value="new Map()"
    let name=propertyDispositionMap value="new Map()"
    let name=nodePropertyTapeMap value="new Map()"
    for name=nodeAuthorityIndex from=0 to=nodeIds.length
      let name=currentNodeId value="nodeIds[nodeAuthorityIndex]"
      if cond="currentNodeId != frozenNodes[nodeAuthorityIndex]"
        let name=nodeOrderFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
        return value=nodeOrderFailure
      if cond="Map.has(nodeMap, String(currentNodeId))"
        let name=nodeDuplicateFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
        return value=nodeDuplicateFailure
      if cond="nodeAllowedModes[nodeAuthorityIndex] != \"unrestricted\" && nodeAllowedModes[nodeAuthorityIndex] != \"closed\" && nodeAllowedModes[nodeAuthorityIndex] != \"explicit\""
        let name=nodeAuthorityFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
        return value=nodeAuthorityFailure
      do value="Map.set(nodeMap, String(currentNodeId), nodeAuthorityIndex)"
      do value="Map.set(nodeStatusMap, String(currentNodeId), nodeSchemaStatuses[nodeAuthorityIndex])"
      do value="Map.set(nodeModeMap, String(currentNodeId), nodeAllowedModes[nodeAuthorityIndex])"
      do value="Map.set(nodeChildTapeMap, String(currentNodeId), nodeChildTapes[nodeAuthorityIndex])"
    for name=property from=0 to=propertyNodes.length
      let name=currentPropertyNode value="propertyNodes[property]"
      let name=currentPropertyName value="propertyNames[property]"
      let name=propertyKey value="currentPropertyNode + \".\" + currentPropertyName"
      if cond="!Map.has(nodeMap, String(currentPropertyNode)) || Map.has(propertyMap, String(propertyKey)) || (propertyRequired[property] != \"true\" && propertyRequired[property] != \"false\") || Text.indexOf(currentPropertyName, \"|\") >= 0 || Text.indexOf(currentPropertyName, \":\") >= 0"
        let name=propertyAuthorityFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
        return value=propertyAuthorityFailure
      do value="Map.set(propertyMap, String(propertyKey), property)"
      do value="Map.set(propertyKindMap, String(propertyKey), propertyKinds[property])"
      do value="Map.set(propertyRequiredMap, String(propertyKey), propertyRequired[property])"
      do value="Map.set(propertyValuesMap, String(propertyKey), propertyValueTapes[property])"
      do value="Map.set(propertyDispositionMap, String(propertyKey), propertyDispositions[property])"
      let name=priorPropertyTape value="Map.has(nodePropertyTapeMap, String(currentPropertyNode)) ? Map.get(nodePropertyTapeMap, String(currentPropertyNode)) : \"\""
      let name=nextPropertyTape value="priorPropertyTape + currentPropertyName + (propertyRequired[property] == \"true\" ? \":1|\" : \":0|\")"
      do value="Map.set(nodePropertyTapeMap, String(currentPropertyNode), nextPropertyTape)"
    let name=kinds value="[]"
    let name=declarations value="\"\""
    let name=occurrences value="\"\""
    let name=presence value="\"\""
    let name=attachments value="\"\""
    let name=decorators value="\"\""
    let name=symbols value="\"\""
    let name=bindings value="\"\""
    let name=factParts value="[]"
    let name=factBytes value=0
    let name=detached value="\"\""
    let name=effectiveValues value="new Map()"
    let name=effectiveOrdinals value="new Map()"
    let name=rejectedByLine value="new Map()"
    let name=occurrenceDispositions value="[]"
    let name=occurrenceRepresentations value="[]"
    let name=occurrenceSegments value="[]"
    let name=occurrenceValueStarts value="[]"
    let name=occurrenceValueEnds value="[]"
    let name=occurrenceRawValues value="[]"
    let name=decoratorExplicitExports value="[]"
    let name=syntaxDiagnosticParts value="[]"
    let name=syntaxDiagnosticStarts value="[]"
    let name=syntaxDiagnosticCounts value="[]"
    let name=eligibilityDiagnosticParts value="[]"
    let name=eligibilityDiagnosticCount value=0
    let name=eligibilityDiagnosticBytes value=0
    let name=lineSpanByOrdinal value="new Map()"
    let name=parentByLine value="new Map()"
    let name=detachedByLine value="new Map()"
    let name=kindByLine value="new Map()"
    let name=occurrenceCount value=0
    let name=declarationCount value=0
    let name=factCount value=0
    for name=classifyLine from=0 to=lineStarts.length
      let name=rawLine value="Text.slice(source, lineContentStarts[classifyLine], lineEnds[classifyLine])"
      let name=eligibility value="f4lineeligibility(rawLine)"
      let name=eligibilityStatus value="eligibility[0]"
      let name=effectiveLeft value="f2uint(eligibility[1])"
      let name=effectiveEnd value="f2uint(eligibility[2])"
      let name=effectiveLine value="Text.slice(rawLine, effectiveLeft, effectiveEnd)"
      let name=lineClassification value="f4classifyline(effectiveLine)"
      let name=kind value="eligibilityStatus == \"decorator-valid\" ? \"decorator\" : eligibilityStatus == \"decorator-invalid\" ? \"\" : lineClassification[0]"
      let name=cursor value="f2uint(lineClassification[1])"
      let name=lineSyntaxStart value=syntaxDiagnosticParts.length
      let name=lineSyntaxCount value=0
      do value="decoratorExplicitExports.push(eligibilityStatus == \"decorator-valid\" ? eligibility[3] : \"false\")"
      assign target=workSteps value="workSteps + f2uint(eligibility[11])"
      do value="kinds.push(kind)"
      do value="Map.set(kindByLine, String(classifyLine), kind)"
      let name=lineSpanValue value="f4item(String(lineStarts[classifyLine])) + f4item(String(lineEnds[classifyLine]))"
      do value="Map.set(lineSpanByOrdinal, String(classifyLine), lineSpanValue)"
      if cond="eligibilityStatus == \"decorator-invalid\""
        let name=invalidDecoratorValue value="Text.slice(rawLine, effectiveLeft, effectiveEnd)"
        let name=invalidDecoratorStart value="lineContentStarts[classifyLine] + effectiveLeft"
        let name=invalidDecoratorEnd value="lineContentStarts[classifyLine] + effectiveEnd"
        let name=invalidDecoratorFact value="f4row6(\"structural\", \"invalid-property\", String(invalidDecoratorStart), String(invalidDecoratorEnd), String(classifyLine), invalidDecoratorValue)"
        let name=invalidDecoratorFactAdmission value="f4eligibilityleafadmit(invalidDecoratorFact, 6, factCount, factBytes, workSteps, maxFacts, maxEncodedBytes, maxWorkSteps)"
        if cond="invalidDecoratorFactAdmission[0] != \"ok\""
          let name=invalidDecoratorFactFailure value="f4fatal(invalidDecoratorFactAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
          return value=invalidDecoratorFactFailure
        do value="factParts.push(invalidDecoratorFactAdmission[4])"
        assign target=factCount value="f2uint(invalidDecoratorFactAdmission[1])"
        assign target=factBytes value="f2uint(invalidDecoratorFactAdmission[2])"
        assign target=workSteps value="f2uint(invalidDecoratorFactAdmission[3])"
        do value="Map.set(rejectedByLine, String(classifyLine), true)"
        let name=invalidDecoratorDiagnostic value="f4row5(\"UNEXPECTED_TOKEN\", \"error\", String(invalidDecoratorStart), String(invalidDecoratorEnd), String(classifyLine))"
        let name=invalidDecoratorDiagnosticAdmission value="f4eligibilityleafadmit(invalidDecoratorDiagnostic, 5, eligibilityDiagnosticCount, eligibilityDiagnosticBytes, workSteps, maxDiagnostics, maxEncodedBytes, maxWorkSteps)"
        if cond="invalidDecoratorDiagnosticAdmission[0] != \"ok\""
          let name=invalidDecoratorDiagnosticFailure value="f4fatal(invalidDecoratorDiagnosticAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
          return value=invalidDecoratorDiagnosticFailure
        do value="syntaxDiagnosticParts.push(invalidDecoratorDiagnosticAdmission[4])"
        assign target=eligibilityDiagnosticCount value="f2uint(invalidDecoratorDiagnosticAdmission[1])"
        assign target=eligibilityDiagnosticBytes value="f2uint(invalidDecoratorDiagnosticAdmission[2])"
        assign target=workSteps value="f2uint(invalidDecoratorDiagnosticAdmission[3])"
        assign target=lineSyntaxCount value="lineSyntaxCount + 1"
      if cond="eligibilityStatus != \"decorator-invalid\""
        let name=catalogOrdinal value="Map.has(nodeMap, kind) ? Map.get(nodeMap, kind) : -1"
        let name=catalogStatus value="Map.has(nodeStatusMap, kind) ? Map.get(nodeStatusMap, kind) : \"\""
        if cond="catalogOrdinal < 0 || catalogStatus != \"bound\""
          let name=unknownFact value="f4row6(\"structural\", \"unknown-node-kind\", String(lineStarts[classifyLine]), String(lineEnds[classifyLine]), String(classifyLine), kind)"
          let name=unknownFactAdmission value="f4eligibilityleafadmit(unknownFact, 6, factCount, factBytes, workSteps, maxFacts, maxEncodedBytes, maxWorkSteps)"
          if cond="unknownFactAdmission[0] != \"ok\""
            let name=unknownFactFailure value="f4fatal(unknownFactAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
            return value=unknownFactFailure
          do value="factParts.push(unknownFactAdmission[4])"
          assign target=factCount value="f2uint(unknownFactAdmission[1])"
          assign target=factBytes value="f2uint(unknownFactAdmission[2])"
          assign target=workSteps value="f2uint(unknownFactAdmission[3])"
        else
          let name=declarationRow value="f4row10(String(declarationCount), String(classifyLine), kind, String(catalogOrdinal), catalogStatus, \"source\", String(lineStarts[classifyLine]), String(lineEnds[classifyLine]), \"-1\", \"false\")"
          assign target=declarations value="f4append(declarations, declarationRow)"
          assign target=declarationCount value="declarationCount + 1"
      if cond="eligibilityStatus == \"decorator-valid\""
        let name=decoratorPropertyNames value="[]"
        let name=decoratorPropertyValues value="[]"
        let name=decoratorPropertyStarts value="[]"
        let name=decoratorPropertyEnds value="[]"
        do value="decoratorPropertyNames.push(\"name\")"
        do value="decoratorPropertyValues.push(eligibility[4])"
        do value="decoratorPropertyStarts.push(f2uint(eligibility[5]))"
        do value="decoratorPropertyEnds.push(f2uint(eligibility[6]))"
        if cond="eligibility[7] == \"true\""
          do value="decoratorPropertyNames.push(\"args\")"
          do value="decoratorPropertyValues.push(eligibility[8])"
          do value="decoratorPropertyStarts.push(f2uint(eligibility[9]))"
          do value="decoratorPropertyEnds.push(f2uint(eligibility[10]))"
        for name=decoratorEligibilityProperty from=0 to=decoratorPropertyNames.length
          let name=decoratorPropertyName value="decoratorPropertyNames[decoratorEligibilityProperty]"
          let name=decoratorAuthorityKey value="\"decorator.\" + decoratorPropertyName"
          if cond="!Map.has(propertyMap, String(decoratorAuthorityKey))"
            let name=decoratorAuthorityFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
            return value=decoratorAuthorityFailure
          let name=decoratorPropertyOrdinal value="Map.get(propertyMap, String(decoratorAuthorityKey))"
          let name=decoratorPropertyKind value="Map.get(propertyKindMap, String(decoratorAuthorityKey))"
          let name=decoratorPropertyRequired value="Map.get(propertyRequiredMap, String(decoratorAuthorityKey))"
          let name=decoratorPropertyDisposition value="Map.get(propertyDispositionMap, String(decoratorAuthorityKey))"
          let name=decoratorPropertyValue value="decoratorPropertyValues[decoratorEligibilityProperty]"
          let name=decoratorAbsoluteStart value="lineContentStarts[classifyLine] + decoratorPropertyStarts[decoratorEligibilityProperty]"
          let name=decoratorAbsoluteEnd value="lineContentStarts[classifyLine] + decoratorPropertyEnds[decoratorEligibilityProperty]"
          let name=decoratorOccurrenceRow value="f4row13(String(occurrenceCount), String(classifyLine), \"decorator\", decoratorPropertyName, String(decoratorPropertyOrdinal), decoratorPropertyKind, decoratorPropertyRequired, decoratorPropertyDisposition, \"bare\", \"-1\", String(decoratorAbsoluteStart), String(decoratorAbsoluteEnd), decoratorPropertyValue)"
          assign target=occurrences value="f4append(occurrences, decoratorOccurrenceRow)"
          do value="occurrenceDispositions.push(decoratorPropertyDisposition)"
          do value="occurrenceRepresentations.push(\"bare\")"
          do value="occurrenceSegments.push(-1)"
          do value="occurrenceValueStarts.push(decoratorAbsoluteStart)"
          do value="occurrenceValueEnds.push(decoratorAbsoluteEnd)"
          do value="occurrenceRawValues.push(decoratorPropertyValue)"
          let name=decoratorEffectiveKey value="String(classifyLine) + \".\" + decoratorPropertyName"
          do value="Map.set(effectiveValues, String(decoratorEffectiveKey), decoratorPropertyValue)"
          do value="Map.set(effectiveOrdinals, String(decoratorEffectiveKey), occurrenceCount)"
          assign target=occurrenceCount value="occurrenceCount + 1"
          assign target=workSteps value="workSteps + 2"
      let name=tokenStart value="kind == \"decorator\" || eligibilityStatus == \"decorator-invalid\" ? Text.length(effectiveLine) : cursor"
      while cond="tokenStart < Text.length(effectiveLine)"
        while cond="tokenStart < Text.length(effectiveLine) && (Text.charAt(effectiveLine, tokenStart) == \" \" || Text.charAt(effectiveLine, tokenStart) == \"\\t\" || Text.charAt(effectiveLine, tokenStart) == \"\\n\" || Text.charAt(effectiveLine, tokenStart) == \"\\r\")"
          assign target=tokenStart value="tokenStart + 1"
        if cond="tokenStart >= Text.length(effectiveLine)"
          break
        let name=tokenEnd value=tokenStart
        let name=quote value="\"\""
        let name=expressionDepth value=0
        while cond="tokenEnd < Text.length(effectiveLine)"
          let name=character value="Text.charAt(effectiveLine, tokenEnd)"
          if cond="quote != \"\" && character == \"\\\\\" && tokenEnd + 1 < Text.length(effectiveLine)"
            assign target=tokenEnd value="tokenEnd + 2"
            continue
          if cond="quote == \"\" && (character == \"\\\"\" || character == \"'\")"
            assign target=quote value=character
          else
            if cond="quote != \"\" && character == quote"
              assign target=quote value="\"\""
          if cond="quote == \"\" && tokenEnd + 1 < Text.length(effectiveLine) && Text.slice(effectiveLine, tokenEnd, tokenEnd + 2) == \"{{\""
            assign target=expressionDepth value="expressionDepth + 1"
          if cond="quote == \"\" && tokenEnd + 1 < Text.length(effectiveLine) && Text.slice(effectiveLine, tokenEnd, tokenEnd + 2) == \"}}\""
            assign target=expressionDepth value="expressionDepth - 1"
          if cond="quote == \"\" && expressionDepth == 0 && (character == \" \" || character == \"\\t\" || character == \"\\n\" || character == \"\\r\")"
            break
          assign target=tokenEnd value="tokenEnd + 1"
        let name=token value="Text.slice(effectiveLine, tokenStart, tokenEnd)"
        let name=equals value="Text.indexOf(token, \"=\")"
        if cond="equals > 0"
          let name=propertyName value="Text.slice(token, 0, equals)"
          let name=authorityKey value="kind + \".\" + propertyName"
          let name=absoluteStart value="lineContentStarts[classifyLine] + effectiveLeft + tokenStart"
          let name=absoluteEnd value="lineContentStarts[classifyLine] + effectiveLeft + tokenEnd"
          if cond="!Map.has(propertyMap, authorityKey)"
            let name=unknownPropertyFact value="f4row6(\"structural\", \"unknown-property\", String(absoluteStart), String(absoluteEnd), String(classifyLine), propertyName)"
            let name=unknownPropertyFactAdmission value="f4eligibilityleafadmit(unknownPropertyFact, 6, factCount, factBytes, workSteps, maxFacts, maxEncodedBytes, maxWorkSteps)"
            if cond="unknownPropertyFactAdmission[0] != \"ok\""
              let name=unknownPropertyFactFailure value="f4fatal(unknownPropertyFactAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
              return value=unknownPropertyFactFailure
            do value="factParts.push(unknownPropertyFactAdmission[4])"
            assign target=factCount value="f2uint(unknownPropertyFactAdmission[1])"
            assign target=factBytes value="f2uint(unknownPropertyFactAdmission[2])"
            assign target=workSteps value="f2uint(unknownPropertyFactAdmission[3])"
          else
            let name=propertyOrdinal value="Map.get(propertyMap, authorityKey)"
            let name=rawValue value="Text.slice(token, equals + 1, Text.length(token))"
            let name=representation value="\"bare\""
            if cond="Text.length(rawValue) >= 2"
              if cond="Text.slice(rawValue, 0, 2) == \"{{\""
                assign target=representation value="\"expression\""
            if cond="representation == \"bare\""
              if cond="Text.length(rawValue) > 0"
                let name=firstValueCharacter value="Text.charAt(rawValue, 0)"
                if cond="firstValueCharacter == \"\\\"\" || firstValueCharacter == \"'\""
                  assign target=representation value="\"quoted\""
            let name=segmentOrdinal value=-1
            for name=segment from=0 to=segmentOuterStarts.length
              if cond="segmentOuterStarts[segment] >= absoluteStart && segmentOuterEnds[segment] <= absoluteEnd"
                assign target=segmentOrdinal value=segment
            let name=unquotedValue value="f4unquote(rawValue)"
            let name=propertyKind value="Map.get(propertyKindMap, authorityKey)"
            let name=required value="Map.get(propertyRequiredMap, authorityKey)"
            let name=disposition value="Map.get(propertyDispositionMap, authorityKey)"
            let name=admission value="f4propertyadmission(propertyKind, disposition, Map.get(propertyValuesMap, authorityKey), representation, unquotedValue)"
            let name=emittedValue value="admission[1]"
            let name=valueStart value="absoluteStart + equals + 1"
            let name=occurrenceRow value="f4row13(String(occurrenceCount), String(classifyLine), kind, propertyName, String(propertyOrdinal), propertyKind, required, disposition, representation, String(segmentOrdinal), String(absoluteStart), String(absoluteEnd), emittedValue)"
            assign target=occurrences value="f4append(occurrences, occurrenceRow)"
            do value="occurrenceDispositions.push(disposition)"
            do value="occurrenceRepresentations.push(representation)"
            do value="occurrenceSegments.push(segmentOrdinal)"
            do value="occurrenceValueStarts.push(valueStart)"
            do value="occurrenceValueEnds.push(absoluteEnd)"
            do value="occurrenceRawValues.push(rawValue)"
            let name=effectiveKey value="String(classifyLine) + \".\" + propertyName"
            if cond="admission[0] == \"admit\""
              do value="Map.set(effectiveValues, String(effectiveKey), emittedValue)"
            else
              let name=admissionFact value="f4row6(\"structural\", admission[3], String(valueStart), String(absoluteEnd), String(classifyLine), propertyName)"
              let name=admissionFactAdmission value="f4eligibilityleafadmit(admissionFact, 6, factCount, factBytes, workSteps, maxFacts, maxEncodedBytes, maxWorkSteps)"
              if cond="admissionFactAdmission[0] != \"ok\""
                let name=admissionFactFailure value="f4fatal(admissionFactAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
                return value=admissionFactFailure
              do value="factParts.push(admissionFactAdmission[4])"
              assign target=factCount value="f2uint(admissionFactAdmission[1])"
              assign target=factBytes value="f2uint(admissionFactAdmission[2])"
              assign target=workSteps value="f2uint(admissionFactAdmission[3])"
              do value="Map.set(rejectedByLine, String(classifyLine), true)"
            do value="Map.set(effectiveOrdinals, String(effectiveKey), occurrenceCount)"
            assign target=occurrenceCount value="occurrenceCount + 1"
        else
          let name=bareStart value="lineContentStarts[classifyLine] + effectiveLeft + tokenStart"
          let name=bareEnd value="lineContentStarts[classifyLine] + effectiveLeft + tokenEnd"
          let name=bareFact value="f4row6(\"structural\", \"invalid-property\", String(bareStart), String(bareEnd), String(classifyLine), token)"
          let name=bareFactAdmission value="f4eligibilityleafadmit(bareFact, 6, factCount, factBytes, workSteps, maxFacts, maxEncodedBytes, maxWorkSteps)"
          if cond="bareFactAdmission[0] != \"ok\""
            let name=bareFactFailure value="f4fatal(bareFactAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
            return value=bareFactFailure
          do value="factParts.push(bareFactAdmission[4])"
          assign target=factCount value="f2uint(bareFactAdmission[1])"
          assign target=factBytes value="f2uint(bareFactAdmission[2])"
          assign target=workSteps value="f2uint(bareFactAdmission[3])"
          do value="Map.set(rejectedByLine, String(classifyLine), true)"
          let name=bareDiagnostic value="f4row5(\"UNEXPECTED_TOKEN\", \"error\", String(bareStart), String(bareEnd), String(classifyLine))"
          let name=bareDiagnosticAdmission value="f4eligibilityleafadmit(bareDiagnostic, 5, eligibilityDiagnosticCount, eligibilityDiagnosticBytes, workSteps, maxDiagnostics, maxEncodedBytes, maxWorkSteps)"
          if cond="bareDiagnosticAdmission[0] != \"ok\""
            let name=bareDiagnosticFailure value="f4fatal(bareDiagnosticAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
            return value=bareDiagnosticFailure
          do value="syntaxDiagnosticParts.push(bareDiagnosticAdmission[4])"
          assign target=eligibilityDiagnosticCount value="f2uint(bareDiagnosticAdmission[1])"
          assign target=eligibilityDiagnosticBytes value="f2uint(bareDiagnosticAdmission[2])"
          assign target=workSteps value="f2uint(bareDiagnosticAdmission[3])"
          assign target=lineSyntaxCount value="lineSyntaxCount + 1"
        assign target=tokenStart value=tokenEnd
      do value="syntaxDiagnosticStarts.push(lineSyntaxStart)"
      do value="syntaxDiagnosticCounts.push(lineSyntaxCount)"
      assign target=workSteps value="workSteps + 1"
    for name=presenceLine from=0 to=lineStarts.length
      let name=presenceKind value="kinds[presenceLine]"
      let name=missingOnLine value=false
      if cond="Map.has(nodePropertyTapeMap, String(presenceKind))"
        let name=propertyTape value="Map.get(nodePropertyTapeMap, String(presenceKind))"
        let name=propertyCursor value=0
        while cond="propertyCursor < Text.length(propertyTape)"
          let name=propertySuffix value="Text.slice(propertyTape, propertyCursor, Text.length(propertyTape))"
          let name=colonRelative value="Text.indexOf(propertySuffix, \":\")"
          if cond="colonRelative <= 0"
            let name=propertyTapeFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
            return value=propertyTapeFailure
          let name=propertyColon value="propertyCursor + colonRelative"
          let name=propertyName value="Text.slice(propertyTape, propertyCursor, propertyColon)"
          let name=requiredFlag value="Text.charAt(propertyTape, propertyColon + 1)"
          if cond="Text.charAt(propertyTape, propertyColon + 2) != \"|\" || (requiredFlag != \"0\" && requiredFlag != \"1\")"
            let name=propertyFlagFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
            return value=propertyFlagFailure
          let name=presenceKey value="String(presenceLine) + \".\" + propertyName"
          let name=effectiveOrdinal value="Map.has(effectiveOrdinals, presenceKey) ? String(Map.get(effectiveOrdinals, presenceKey)) : \"-1\""
          let name=presenceRow value="f4row3(String(presenceLine), propertyName, effectiveOrdinal)"
          assign target=presence value="f4append(presence, presenceRow)"
          if cond="requiredFlag == \"1\" && effectiveOrdinal == \"-1\""
            let name=missingFact value="f4row6(\"structural\", \"missing-property\", String(lineStarts[presenceLine]), String(lineEnds[presenceLine]), String(presenceLine), propertyName)"
            let name=missingFactAdmission value="f4eligibilityleafadmit(missingFact, 6, factCount, factBytes, workSteps, maxFacts, maxEncodedBytes, maxWorkSteps)"
            if cond="missingFactAdmission[0] != \"ok\""
              let name=missingFactFailure value="f4fatal(missingFactAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
              return value=missingFactFailure
            do value="factParts.push(missingFactAdmission[4])"
            assign target=factCount value="f2uint(missingFactAdmission[1])"
            assign target=factBytes value="f2uint(missingFactAdmission[2])"
            assign target=workSteps value="f2uint(missingFactAdmission[3])"
            assign target=missingOnLine value=true
          assign target=propertyCursor value="propertyColon + 3"
      if cond=missingOnLine
        let name=missingDiagnostic value="f4row5(\"UNEXPECTED_TOKEN\", \"error\", String(lineStarts[presenceLine]), String(lineEnds[presenceLine]), String(presenceLine))"
        let name=missingDiagnosticAdmission value="f4eligibilityleafadmit(missingDiagnostic, 5, eligibilityDiagnosticCount, eligibilityDiagnosticBytes, workSteps, maxDiagnostics, maxEncodedBytes, maxWorkSteps)"
        if cond="missingDiagnosticAdmission[0] != \"ok\""
          let name=missingDiagnosticFailure value="f4fatal(missingDiagnosticAdmission[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
          return value=missingDiagnosticFailure
        do value="eligibilityDiagnosticParts.push(missingDiagnosticAdmission[4])"
        assign target=eligibilityDiagnosticCount value="f2uint(missingDiagnosticAdmission[1])"
        assign target=eligibilityDiagnosticBytes value="f2uint(missingDiagnosticAdmission[2])"
        assign target=workSteps value="f2uint(missingDiagnosticAdmission[3])"
      let name=syntaxStart value="syntaxDiagnosticStarts[presenceLine]"
      let name=syntaxEnd value="syntaxStart + syntaxDiagnosticCounts[presenceLine]"
      for name=syntaxDiagnosticIndex from=syntaxStart to=syntaxEnd
        do value="eligibilityDiagnosticParts.push(syntaxDiagnosticParts[syntaxDiagnosticIndex])"
    let name=eligibilityDiagnosticFold value="f4balancedtapefold(eligibilityDiagnosticParts, workSteps, maxWorkSteps)"
    if cond="eligibilityDiagnosticFold[0] != \"ok\""
      let name=eligibilityDiagnosticFailure value="f4fatal(eligibilityDiagnosticFold[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
      return value=eligibilityDiagnosticFailure
    let name=eligibilityDiagnostics value="eligibilityDiagnosticFold[1]"
    assign target=workSteps value="f2uint(eligibilityDiagnosticFold[2])"
    let name=propertyDiagnosticState value="f4diagpropertyphase(occurrences, occurrenceRawValues, occurrenceValueStarts, propertyValueTapes, maxDiagnostics, maxEncodedBytes, workSteps, maxWorkSteps)"
    let name=eligibilityDiagnosticState value="f4diagphasefrompublic(eligibilityDiagnostics, 0, 1, maxDiagnostics, maxEncodedBytes, workSteps, maxWorkSteps)"
    let name=combinedPropertyDiagnosticState value="f4diagtwomerge(propertyDiagnosticState, eligibilityDiagnosticState, workSteps, maxDiagnostics, maxEncodedBytes, maxWorkSteps)"
