fn name=f2lex returns=string
  param name=source type=string
  param name=maxTokens type=number
  handler lang="kern"
    let name=payload value="\"\""
    let name=frameCount value="0"
    let name=chunks value="[]"
    let name=n value="Text.length(source)"
    let name=cursor value="0"
    let name=count value="0"
    while cond="cursor < n"
      let name=ch value="Text.charAt(source, cursor)"
      if cond="f2space(ch)"
        assign target=cursor value="cursor + 1"
        continue
      if cond="count >= maxTokens"
        return value="\"l\" + f2item(String(cursor)) + f2item(String(cursor + 1))"
      let name=start value="cursor"
      let name=kind value="\"\""
      let name=value value="\"\""
      if cond="f2identstart(ch)"
        assign target=cursor value="cursor + 1"
        while cond="cursor < n && f2identnext(Text.charAt(source, cursor))"
          assign target=cursor value="cursor + 1"
        assign target=kind value="\"identifier\""
        assign target=value value="Text.slice(source, start, cursor)"
      else
        if cond="f2digit(ch)"
          assign target=cursor value="cursor + 1"
          while cond="cursor < n && f2digit(Text.charAt(source, cursor))"
            assign target=cursor value="cursor + 1"
          let name=decimal value=false
          if cond="cursor < n && Text.charAt(source, cursor) == \".\""
            assign target=decimal value=true
            assign target=cursor value="cursor + 1"
            if cond="cursor >= n || (!f2digit(Text.charAt(source, cursor)))"
              return value="\"i\" + f2item(String(start)) + f2item(String(cursor))"
            while cond="cursor < n && f2digit(Text.charAt(source, cursor))"
              assign target=cursor value="cursor + 1"
          if cond="(ch == \"0\" && cursor - start > 1 && (!decimal)) || (cursor < n && (f2identnext(Text.charAt(source, cursor)) || Text.charAt(source, cursor) == \".\"))"
            return value="\"i\" + f2item(String(start)) + f2item(String(cursor))"
          assign target=kind value="decimal ? \"decimal\" : \"integer\""
          assign target=value value="Text.slice(source, start, cursor)"
        else
          if cond="ch == \"\\\"\" || ch == \"'\""
            let name=quote value="ch"
            let name=decoded value="\"\""
            assign target=cursor value="cursor + 1"
            let name=closed value=false
            while cond="cursor < n"
              let name=point value="Text.charAt(source, cursor)"
              if cond="point == quote"
                assign target=cursor value="cursor + 1"
                assign target=closed value=true
                break
              if cond="point != \"\\\\\""
                assign target=decoded value="decoded + point"
                assign target=cursor value="cursor + 1"
                continue
              if cond="cursor + 1 >= n"
                return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 1))"
              let name=escape value="Text.charAt(source, cursor + 1)"
              if cond="escape == \"\\n\""
                assign target=cursor value="cursor + 2"
                continue
              if cond="escape == \"\\r\""
                if cond="cursor + 2 < n && Text.charAt(source, cursor + 2) == \"\\n\""
                  assign target=cursor value="cursor + 3"
                  continue
                return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 2))"
              let name=replacement value="\"\""
              if cond="escape == \"\\\\\""
                assign target=replacement value="\"\\\\\""
              else
                if cond="escape == \"\\\"\""
                  assign target=replacement value="\"\\\"\""
                else
                  if cond="escape == \"'\""
                    assign target=replacement value="\"'\""
                  else
                    if cond="escape == \"0\""
                      if cond="cursor + 2 < n && f2digit(Text.charAt(source, cursor + 2))"
                        return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 2))"
                      assign target=replacement value="\"\\0\""
                    else
                      if cond="escape == \"b\""
                        assign target=replacement value="\"\\b\""
                      else
                        if cond="escape == \"f\""
                          assign target=replacement value="\"\\f\""
                        else
                          if cond="escape == \"n\""
                            assign target=replacement value="\"\\n\""
                          else
                            if cond="escape == \"r\""
                              assign target=replacement value="\"\\r\""
                            else
                              if cond="escape == \"t\""
                                assign target=replacement value="\"\\t\""
                              else
                                if cond="escape == \"v\""
                                  assign target=replacement value="\"\\v\""
                                else
                                  let name=scalar value="-1"
                                  let name=advance value="0"
                                  if cond="escape == \"x\""
                                    if cond="cursor + 3 >= n || f2hex(Text.charAt(source, cursor + 2)) < 0 || f2hex(Text.charAt(source, cursor + 3)) < 0"
                                      return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 2))"
                                    assign target=scalar value="f2hex(Text.charAt(source, cursor + 2)) * 16 + f2hex(Text.charAt(source, cursor + 3))"
                                    assign target=advance value="4"
                                  else
                                    if cond="escape == \"u\""
                                      if cond="cursor + 2 < n && Text.charAt(source, cursor + 2) == \"{\""
                                        let name=hexCursor value="cursor + 3"
                                        let name=digits value="0"
                                        assign target=scalar value="0"
                                        while cond="hexCursor < n && Text.charAt(source, hexCursor) != \"}\""
                                          let name=hexDigit value="f2hex(Text.charAt(source, hexCursor))"
                                          if cond="hexDigit < 0 || digits >= 6"
                                            return value="\"i\" + f2item(String(cursor)) + f2item(String(hexCursor + 1))"
                                          assign target=scalar value="scalar * 16 + hexDigit"
                                          assign target=digits value="digits + 1"
                                          assign target=hexCursor value="hexCursor + 1"
                                        if cond="digits == 0 || hexCursor >= n"
                                          return value="\"i\" + f2item(String(cursor)) + f2item(String(hexCursor))"
                                        assign target=advance value="hexCursor - cursor + 1"
                                      else
                                        if cond="cursor + 5 >= n"
                                          return value="\"i\" + f2item(String(cursor)) + f2item(String(n))"
                                        assign target=scalar value="0"
                                        for name=hexIndex from=2 to=6
                                          let name=hexDigit value="f2hex(Text.charAt(source, cursor + hexIndex))"
                                          if cond="hexDigit < 0"
                                            return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + hexIndex + 1))"
                                          assign target=scalar value="scalar * 16 + hexDigit"
                                        assign target=advance value="6"
                                        if cond="scalar >= 55296 && scalar <= 56319"
                                          if cond="cursor + 11 >= n || Text.slice(source, cursor + 6, cursor + 8) != \"\\\\u\""
                                            return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 6))"
                                          let name=low value="0"
                                          for name=lowIndex from=8 to=12
                                            let name=lowDigit value="f2hex(Text.charAt(source, cursor + lowIndex))"
                                            if cond="lowDigit < 0"
                                              return value="\"i\" + f2item(String(cursor + 6)) + f2item(String(cursor + lowIndex + 1))"
                                            assign target=low value="low * 16 + lowDigit"
                                          if cond="low < 56320 || low > 57343"
                                            return value="\"i\" + f2item(String(cursor + 6)) + f2item(String(cursor + 12))"
                                          assign target=scalar value="65536 + (scalar - 55296) * 1024 + low - 56320"
                                          assign target=advance value="12"
                                        else
                                          if cond="scalar >= 56320 && scalar <= 57343"
                                            return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 6))"
                                  if cond="scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343)"
                                    return value="\"i\" + f2item(String(cursor)) + f2item(String(cursor + 2))"
                                  assign target=replacement value="KernInternal.textFromScalar(scalar)"
                                  assign target=decoded value="decoded + replacement"
                                  assign target=cursor value="cursor + advance"
                                  continue
              assign target=decoded value="decoded + replacement"
              assign target=cursor value="cursor + 2"
            if cond="!closed"
              return value="\"i\" + f2item(String(start)) + f2item(String(n))"
            assign target=kind value="\"text\""
            assign target=value value="decoded"
          else
            let name=three value="\"\""
            let name=two value="\"\""
            if cond="cursor + 3 <= n"
              assign target=three value="Text.slice(source, cursor, cursor + 3)"
            if cond="cursor + 2 <= n"
              assign target=two value="Text.slice(source, cursor, cursor + 2)"
            if cond="three == \">>>\" || three == \"===\" || three == \"!==\""
              assign target=value value="three"
              assign target=cursor value="cursor + 3"
            else
              if cond="two == \"**\" || two == \"==\" || two == \"!=\" || two == \"<=\" || two == \">=\" || two == \"&&\" || two == \"||\" || two == \"??\" || two == \"<<\" || two == \">>\" || two == \"?.\" || two == \"=>\""
                assign target=value value="two"
                assign target=cursor value="cursor + 2"
              else
                if cond="Text.indexOf(\"()[]{}.,:?-+*/%<>!~&|^\", ch) < 0"
                  return value="\"i\" + f2item(String(start)) + f2item(String(start + 1))"
                assign target=value value="ch"
                assign target=cursor value="cursor + 1"
            assign target=kind value="\"symbol\""
      assign target=payload value="payload + f2item(kind) + f2item(value) + f2item(String(start)) + f2item(String(cursor))"
      assign target=frameCount value="frameCount + 1"
      assign target=count value="count + 1"
      if cond="frameCount == 256"
        do value="chunks.push(payload)"
        assign target=payload value="\"\""
        assign target=frameCount value="0"
    if cond="frameCount > 0"
      do value="chunks.push(payload)"
    return value="\"o\" + f2item(String(count)) + f2concat(chunks)"
