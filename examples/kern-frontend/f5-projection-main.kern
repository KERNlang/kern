fn name=f5fieldread returns="string[]"
  param name=body type=string
  handler lang="kern"
    let name=values value="[]"
    let name=cursor value="0"
    let name=expected value="0"
    while cond="cursor < Text.length(body)"
      if cond="Text.charAt(body, cursor) != \"f\""
        return value="[]"
      assign target=cursor value="cursor + 1"
      let name=index value="0"
      while cond="cursor < Text.length(body) && Text.charAt(body, cursor) != \",\""
        assign target=index value="index * 10 + Text.indexOf(\"0123456789\", Text.charAt(body, cursor))"
        assign target=cursor value="cursor + 1"
      if cond="index != expected || cursor >= Text.length(body)"
        return value="[]"
      assign target=cursor value="cursor + 1"
      let name=length value="0"
      while cond="cursor < Text.length(body) && Text.charAt(body, cursor) != \":\""
        assign target=length value="length * 10 + Text.indexOf(\"0123456789\", Text.charAt(body, cursor))"
        assign target=cursor value="cursor + 1"
      assign target=cursor value="cursor + 1"
      let name=end value="cursor + length"
      if cond="end > Text.length(body)"
        return value="[]"
      do value="values.push(Text.slice(body, cursor, end))"
      assign target=cursor value=end
      assign target=expected value="expected + 1"
    return value=values

fn name=f5worklength returns=number
  param name=value type=string
  handler lang="kern"
    return value="Text.length(value)"

fn name=f5decodef2nodes returns="string[]"
  param name=tape type=string
  handler lang="kern"
    let name=kinds value="[]"
    let name=flags value="[]"
    let name=payloads value="[]"
    let name=children value="[]"
    let name=cursor value="0"
    while cond="cursor < Text.length(tape)"
      if cond="Text.charAt(tape, cursor) != \"c\""
        return value="[]"
      let name=commaCount value="0"
      let name=payloadLength value="0"
      while cond="cursor < Text.length(tape) && Text.charAt(tape, cursor) != \":\""
        let name=headerChar value="Text.charAt(tape, cursor)"
        if cond="headerChar == \",\""
          assign target=commaCount value="commaCount + 1"
        else
          if cond="commaCount == 3"
            assign target=payloadLength value="payloadLength * 10 + Text.indexOf(\"0123456789\", headerChar)"
        assign target=cursor value="cursor + 1"
      if cond="commaCount != 3"
        return value="[]"
      assign target=cursor value="cursor + 1"
      let name=payloadStart value=cursor
      let name=payloadEnd value="payloadStart + payloadLength"
      while cond="cursor < payloadEnd"
        if cond="Text.charAt(tape, cursor) != \"n\""
          return value="[]"
        assign target=cursor value="cursor + 1"
        let name=nodeLength value="0"
        while cond="cursor < payloadEnd && Text.charAt(tape, cursor) != \":\""
          assign target=nodeLength value="nodeLength * 10 + Text.indexOf(\"0123456789\", Text.charAt(tape, cursor))"
          assign target=cursor value="cursor + 1"
        assign target=cursor value="cursor + 1"
        let name=nodeEnd value="cursor + nodeLength"
        let name=nodeBody value="Text.slice(tape, cursor, nodeEnd)"
        let name=fields value="f5fieldread(nodeBody)"
        if cond="fields.length != 8"
          return value="[]"
        do value="kinds.push(f5frame(\"i\", fields[1]))"
        do value="flags.push(f5frame(\"i\", fields[4]))"
        do value="payloads.push(f5frame(\"i\", fields[6]))"
        do value="children.push(f5frame(\"i\", fields[7]))"
        assign target=cursor value=nodeEnd
      if cond="cursor != payloadEnd || Text.charAt(tape, cursor) != \"s\""
        return value="[]"
      assign target=cursor value="cursor + 1"
      while cond="cursor < Text.length(tape) && Text.indexOf(\"0123456789\", Text.charAt(tape, cursor)) >= 0"
        assign target=cursor value="cursor + 1"
    let name=result value="[]"
    do value="result.push(f5join(kinds))"
    do value="result.push(f5join(flags))"
    do value="result.push(f5join(payloads))"
    do value="result.push(f5join(children))"
    return value=result

fn name=projectf5moduleset returns="string[]" export=true
  param name=moduleIds type="string[]"
  param name=documentFields type="string[]"
  param name=moduleSetFields type="string[]"
  param name=maxWorkSteps type=number
  param name=maxInstructionScalars type=number
  handler lang="kern"
    let name=moduleCount value=moduleIds.length
    let name=documentFieldCount value=documentFields.length
    let name=moduleSetFieldCount value="List.length(moduleSetFields)"
    if cond="moduleCount == 0"
      return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", \"0\", \"failure\"]"
    if cond="documentFieldCount != moduleCount * 17"
      return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", \"0\", \"failure\"]"
    if cond="moduleSetFieldCount != 10"
      return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", \"0\", \"failure\"]"
    if cond="moduleSetFields[0] != \"kern.frontend.f4-module-set.4\""
      return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", \"0\", \"failure\"]"
    if cond="moduleSetFields[1] != \"linked\""
      return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", \"0\", \"failure\"]"
    let name=roots value="[]"
    let name=symbolTapes value="[]"
    let name=work value="0"
    for name=moduleIndex from=0 to=moduleCount
      let name=fields value="[]"
      let name=fieldOffset value="moduleIndex * 17"
      for name=fieldIndex from=0 to=17
        let name=fieldPosition value="fieldOffset + fieldIndex"
        let name=documentField value="List.index(documentFields, fieldPosition)"
        do value="fields.push(documentField)"
      if cond="fields.length != 17 || fields[0] != \"kern.frontend.f4-document.2\" || fields[1] != \"classified\" || fields[2] != moduleIds[moduleIndex]"
        return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", String(work), \"failure\"]"
      let name=declarationTape value="List.index(fields, 4)"
      let name=propertyOccurrenceTape value="List.index(fields, 5)"
      let name=propertyPresenceTape value="List.index(fields, 6)"
      let name=attachmentTape value="List.index(fields, 7)"
      let name=decoratorTape value="List.index(fields, 8)"
      let name=symbolTape value="List.index(fields, 9)"
      let name=evidenceTape value="List.index(fields, 14)"
      let name=evidenceRows value="f5rowread(evidenceTape)"
      let name=expressionOrdinals value="[]"
      let name=expressionValues value="[]"
      for name=evidenceIndex from=0 to=evidenceRows.length
        let name=evidenceRowTape value="List.index(evidenceRows, evidenceIndex)"
        let name=evidence value="f5rowread(evidenceRowTape)"
        if cond="evidence.length != 12"
          return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", String(work), \"failure\"]"
        let name=receiptTape value="List.index(evidence, 8)"
        let name=receipt value="f5rowread(receiptTape)"
        if cond="receipt.length != 9 || receipt[0] != \"kern.frontend.f2-expression.1\" || receipt[1] != \"parsed\""
          return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", String(work), \"failure\"]"
        let name=nodeTape value="List.index(receipt, 7)"
        let name=nodes value="f5decodef2nodes(nodeTape)"
        if cond="nodes.length != 4"
          return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", String(work), \"failure\"]"
        let name=nodeRows value="List.index(nodes, 0)"
        let name=payloadRows value="List.index(nodes, 1)"
        let name=childRows value="List.index(nodes, 2)"
        let name=rootOrdinal value="List.index(nodes, 3)"
        let name=expressionValue value="f5expression(nodeRows, payloadRows, childRows, rootOrdinal)"
        if cond="expressionValue == \"\""
          return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_F4_DRIFT\", \"\", String(work), \"failure\"]"
        let name=ordinalText value="List.index(evidence, 1)"
        let name=expressionOrdinal value="f5uint(ordinalText)"
        do value="expressionOrdinals.push(expressionOrdinal)"
        do value="expressionValues.push(expressionValue)"
        let name=decodedNodeRows value="f5rowread(nodeRows)"
        assign target=work value="work + decodedNodeRows.length + Text.length(receiptTape)"
      let name=moduleRoots value="f5projecttree(declarationTape, propertyOccurrenceTape, propertyPresenceTape, attachmentTape, decoratorTape, expressionOrdinals, expressionValues)"
      let name=rootTapeParts value="[]"
      for name=rootTapeIndex from=0 to=moduleRoots.length
        let name=moduleRoot value="List.index(moduleRoots, rootTapeIndex)"
        let name=rootFrame value="f5frame(\"i\", moduleRoot)"
        do value="rootTapeParts.push(rootFrame)"
      let name=rootTape value="f5join(rootTapeParts)"
      do value="roots.push(rootTape)"
      do value="symbolTapes.push(symbolTape)"
      let name=declarationWork value="f5worklength(declarationTape)"
      let name=occurrenceWork value="f5worklength(propertyOccurrenceTape)"
      let name=presenceWork value="f5worklength(propertyPresenceTape)"
      assign target=work value="work + declarationWork + occurrenceWork + presenceWork"
      if cond="work > maxWorkSteps"
        return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_LIMIT\", \"\", String(work), \"failure\"]"
    let name=resolvedBindingTape value="List.index(moduleSetFields, 6)"
    let name=instructions value="f5projectmodules(moduleIds, roots, symbolTapes, resolvedBindingTape)"
    if cond="instructions == \"\" || Text.length(instructions) > maxInstructionScalars"
      return value="[\"kern.frontend.f5-projection.1\", \"fatal\", \"F5_LIMIT\", \"\", String(work), \"failure\"]"
    return value="[\"kern.frontend.f5-projection.1\", \"projected\", \"\", instructions, String(work), \"projection:closed\"]"
