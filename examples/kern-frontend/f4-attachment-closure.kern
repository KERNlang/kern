fn name=f4closureeligibilityrow returns=string
  param name=ordinal type=number
  param name=eligibility type="string[]"
  param name=kind type=string
  param name=cursor type=number
  handler lang="kern"
    return value="f4item(String(ordinal)) + f4item(eligibility[0]) + f4item(eligibility[1]) + f4item(eligibility[2]) + f4item(eligibility[3]) + f4item(eligibility[4]) + f4item(eligibility[5]) + f4item(eligibility[6]) + f4item(eligibility[7]) + f4item(eligibility[8]) + f4item(eligibility[9]) + f4item(eligibility[10]) + f4item(eligibility[11]) + f4item(kind) + f4item(String(cursor))"

fn name=f4closurecachedeligibility returns="string[]"
  param name=tape type=string
  param name=cursor type=number
  param name=ordinal type=number
  handler lang="kern"
    let name=item value="f2batchmarked(tape, cursor, \"i\")"
    let name=next value="f2uint(item[1])"
    if cond="next < 0"
      return value="[\"drift\"]"
    if cond="f4tapecount(item[0]) != 15"
      return value="[\"drift\"]"
    if cond="f2uint(f4tapefield(item[0], 0)) != ordinal"
      return value="[\"drift\"]"
    return value="[\"ok\", String(next), f4tapefield(item[0], 1), f4tapefield(item[0], 2), f4tapefield(item[0], 3), f4tapefield(item[0], 4), f4tapefield(item[0], 5), f4tapefield(item[0], 6), f4tapefield(item[0], 7), f4tapefield(item[0], 8), f4tapefield(item[0], 9), f4tapefield(item[0], 10), f4tapefield(item[0], 11), f4tapefield(item[0], 12), f4tapefield(item[0], 13), f4tapefield(item[0], 14)]"

fn name=f4closurenextdetached returns="string[]"
  param name=tape type=string
  param name=cursor type=number
  handler lang="kern"
    if cond="cursor == Text.length(tape)"
      return value="[\"end\", String(cursor), \"-1\"]"
    let name=item value="f2batchmarked(tape, cursor, \"i\")"
    let name=next value="f2uint(item[1])"
    if cond="next < 0"
      return value="[\"drift\", String(cursor), \"-1\"]"
    if cond="f4tapecount(item[0]) != 1"
      return value="[\"drift\", String(cursor), \"-1\"]"
    let name=ordinal value="f2uint(f4tapefield(item[0], 0))"
    if cond="ordinal < 0"
      return value="[\"drift\", String(cursor), \"-1\"]"
    return value="[\"ok\", String(next), String(ordinal)]"

fn name=f4attachmentclosure returns="string[]"
  param name=source type=string
  param name=lineContentStarts type="number[]"
  param name=lineStarts type="number[]"
  param name=lineEnds type="number[]"
  param name=edgeChildren type="number[]"
  param name=edgeParents type="number[]"
  param name=nodeIds type="string[]"
  param name=nodeAllowedModes type="string[]"
  param name=nodeChildTapes type="string[]"
  param name=baseWorkSteps type=number
  param name=maxWorkSteps type=number
  handler lang="kern"
    if cond="lineContentStarts.length != lineStarts.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWorkSteps)]"
    if cond="lineEnds.length != lineStarts.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWorkSteps)]"
    if cond="edgeChildren.length != edgeParents.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWorkSteps)]"
    if cond="nodeAllowedModes.length != nodeIds.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWorkSteps)]"
    if cond="nodeChildTapes.length != nodeIds.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWorkSteps)]"
    let name=modeByKind value="new Map()"
    let name=childrenByKind value="new Map()"
    let name=kindByOrdinal value="new Map()"
    let name=startByOrdinal value="new Map()"
    let name=endByOrdinal value="new Map()"
    let name=detachedByOrdinal value="new Map()"
    let name=eligibilityParts value="[]"
    let name=attachmentParts value="[]"
    let name=detachedParts value="[]"
    let name=invalidEdgeParts value="[]"
    let name=parentParts value="[]"
    let name=work value=baseWorkSteps
    for name=closureAuthorityIndex from=0 to=nodeIds.length
      let name=authorityKind value="nodeIds[closureAuthorityIndex]"
      let name=authorityMode value="nodeAllowedModes[closureAuthorityIndex]"
      let name=authorityChildren value="nodeChildTapes[closureAuthorityIndex]"
      do value="Map.set(modeByKind, String(authorityKind), authorityMode)"
      do value="Map.set(childrenByKind, String(authorityKind), authorityChildren)"
    for name=closureLineIndex from=0 to=lineStarts.length
      let name=rawLine value="Text.slice(source, lineContentStarts[closureLineIndex], lineEnds[closureLineIndex])"
      let name=eligibility value="f4lineeligibility(rawLine)"
      if cond="eligibility.length != 12"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
      let name=eligibilityWork value="f2uint(eligibility[11])"
      if cond="eligibilityWork < 0"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
      let name=nextWork value="work + eligibilityWork"
      if cond="nextWork > maxWorkSteps"
        return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", String(nextWork)]"
      let name=effectiveLeft value="f2uint(eligibility[1])"
      let name=effectiveEnd value="f2uint(eligibility[2])"
      if cond="effectiveLeft < 0 || effectiveEnd < effectiveLeft || effectiveEnd > Text.length(rawLine)"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
      let name=effectiveLine value="Text.slice(rawLine, effectiveLeft, effectiveEnd)"
      let name=lineClassification value="f4classifyline(effectiveLine)"
      let name=classificationCursor value="f2uint(lineClassification[1])"
      if cond="classificationCursor < 0"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
      let name=kind value="eligibility[0] == \"decorator-valid\" ? \"decorator\" : eligibility[0] == \"decorator-invalid\" ? \"\" : lineClassification[0]"
      let name=eligibilityRow value="f4closureeligibilityrow(closureLineIndex, eligibility, kind, classificationCursor)"
      do value="eligibilityParts.push(f4item(eligibilityRow))"
      let name=lineKey value="String(closureLineIndex)"
      let name=lineStart value="lineStarts[closureLineIndex]"
      let name=lineEnd value="lineEnds[closureLineIndex]"
      do value="Map.set(kindByOrdinal, String(lineKey), kind)"
      do value="Map.set(startByOrdinal, String(lineKey), lineStart)"
      do value="Map.set(endByOrdinal, String(lineKey), lineEnd)"
      assign target=work value=nextWork
    for name=closureEdgeIndex from=0 to=edgeChildren.length
      let name=edgeWork value="work + 1"
      if cond="edgeWork > maxWorkSteps"
        return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", String(edgeWork)]"
      assign target=work value=edgeWork
      let name=child value="edgeChildren[closureEdgeIndex]"
      let name=parent value="edgeParents[closureEdgeIndex]"
      if cond="child < 0 || child >= lineStarts.length || parent < -1 || parent >= lineStarts.length"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
      let name=childKey value="String(child)"
      let name=parentRow value="f4item(String(child)) + f4item(String(parent))"
      do value="parentParts.push(f4item(parentRow))"
      if cond="parent >= 0"
        let name=parentKey value="String(parent)"
        if cond="!Map.has(kindByOrdinal, String(parentKey)) || !Map.has(kindByOrdinal, String(childKey))"
          return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
        let name=parentKind value="Map.get(kindByOrdinal, String(parentKey))"
        let name=childKind value="Map.get(kindByOrdinal, String(childKey))"
        let name=allowed value=false
        if cond="Map.has(modeByKind, String(parentKind))"
          let name=parentMode value="Map.get(modeByKind, String(parentKind))"
          if cond="parentMode == \"unrestricted\""
            assign target=allowed value=true
          if cond="parentMode == \"explicit\""
            if cond="Text.indexOf(childKind, \"|\") < 0 && Map.has(childrenByKind, String(parentKind))"
              let name=childTape value="Map.get(childrenByKind, String(parentKind))"
              if cond="Text.indexOf(\"|\" + childTape + \"|\", \"|\" + childKind + \"|\") >= 0"
                assign target=allowed value=true
        let name=parentDetached value="Map.has(detachedByOrdinal, String(parentKey))"
        if cond=parentDetached
          let name=propagationWork value="work + 1"
          if cond="propagationWork > maxWorkSteps"
            return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", String(propagationWork)]"
          assign target=work value=propagationWork
        let name=shouldDetach value="parentDetached || !allowed"
        if cond="shouldDetach && !Map.has(detachedByOrdinal, String(childKey))"
          let name=admissionWork value="work + 1"
          if cond="admissionWork > maxWorkSteps"
            return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", String(admissionWork)]"
          do value="Map.set(detachedByOrdinal, String(childKey), true)"
          let name=detachedRow value="f4row1(String(child))"
          do value="detachedParts.push(f4item(detachedRow))"
          assign target=work value=admissionWork
        if cond=allowed
          let name=attachmentDisposition value="parentDetached ? \"detached-local\" : \"attached\""
          let name=attachmentRow value="f4row3(String(parent), String(child), attachmentDisposition)"
          do value="attachmentParts.push(f4item(attachmentRow))"
        else
          if cond="!Map.has(startByOrdinal, String(childKey)) || !Map.has(endByOrdinal, String(childKey))"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
          let name=childStart value="Map.get(startByOrdinal, String(childKey))"
          let name=childEnd value="Map.get(endByOrdinal, String(childKey))"
          let name=invalidEdgeInput value="f4item(String(childStart)) + f4item(String(childEnd)) + f4item(String(child)) + f4item(childKind)"
          do value="invalidEdgeParts.push(f4item(invalidEdgeInput))"
    let name=eligibilityFold value="f4balancedtapefold(eligibilityParts, work, maxWorkSteps)"
    if cond="eligibilityFold[0] == \"limit\""
      return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", eligibilityFold[2]]"
    if cond="eligibilityFold[0] != \"ok\""
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
    let name=eligibilityTape value="eligibilityFold[1]"
    assign target=work value="f2uint(eligibilityFold[2])"
    let name=attachmentFold value="f4balancedtapefold(attachmentParts, work, maxWorkSteps)"
    if cond="attachmentFold[0] == \"limit\""
      return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", attachmentFold[2]]"
    if cond="attachmentFold[0] != \"ok\""
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
    let name=attachments value="attachmentFold[1]"
    assign target=work value="f2uint(attachmentFold[2])"
    let name=detachedFold value="f4balancedtapefold(detachedParts, work, maxWorkSteps)"
    if cond="detachedFold[0] == \"limit\""
      return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", detachedFold[2]]"
    if cond="detachedFold[0] != \"ok\""
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
    let name=detached value="detachedFold[1]"
    assign target=work value="f2uint(detachedFold[2])"
    let name=invalidEdgeFold value="f4balancedtapefold(invalidEdgeParts, work, maxWorkSteps)"
    if cond="invalidEdgeFold[0] == \"limit\""
      return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", invalidEdgeFold[2]]"
    if cond="invalidEdgeFold[0] != \"ok\""
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
    let name=invalidEdges value="invalidEdgeFold[1]"
    assign target=work value="f2uint(invalidEdgeFold[2])"
    let name=parentFold value="f4balancedtapefold(parentParts, work, maxWorkSteps)"
    if cond="parentFold[0] == \"limit\""
      return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", parentFold[2]]"
    if cond="parentFold[0] != \"ok\""
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(work)]"
    let name=parents value="parentFold[1]"
    assign target=work value="f2uint(parentFold[2])"
    return value="[\"ok\", eligibilityTape, attachments, detached, invalidEdges, parents, String(work)]"
