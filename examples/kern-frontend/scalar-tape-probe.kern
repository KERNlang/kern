fn name=epframe returns=string
  param name=kind type=string
  param name=value type=string
  handler lang="kern"
    return value="kind + String(Text.length(value)) + \":\" + value"

fn name=probescalartape returns="string[]" export=true
  param name=source type=string
  param name=maxCodePoints type=number
  param name=maxTapeCodePoints type=number
  handler lang="kern"
    if cond="Text.length(source) == 0 || Text.length(source) > maxCodePoints"
      return value="[\"kern.frontend.scalar-tape-probe.1\", \"failure\", \"SOURCE_LIMIT\", \"seal\", source]"
    let name=tape value="\"\""
    let name=cursor value="0"
    let name=count value="0"
    while cond="cursor < Text.length(source)"
      let name=ch value="Text.charAt(source, cursor)"
      if cond="epspace(ch)"
        assign target=cursor value="cursor + 1"
        continue
      let name=start value="cursor"
      if cond="epidentstart(ch)"
        assign target=cursor value="cursor + 1"
        while cond="cursor < Text.length(source) && epidentchar(Text.charAt(source, cursor))"
          assign target=cursor value="cursor + 1"
        let name=word value="Text.slice(source, start, cursor)"
        assign target=tape value="tape + epframe(\"V\", epexpr1(\"identifier\", \"name\", eptext(word)))"
      else
        if cond="epdigit(ch)"
          assign target=cursor value="cursor + 1"
          while cond="cursor < Text.length(source) && epdigit(Text.charAt(source, cursor))"
            assign target=cursor value="cursor + 1"
          let name=number value="Text.slice(source, start, cursor)"
          assign target=tape value="tape + epframe(\"V\", epexpr1(\"integer\", \"value\", epint(number)))"
        else
          if cond="ch != \"+\" && ch != \"*\""
            return value="[\"kern.frontend.scalar-tape-probe.1\", \"failure\", \"UNSUPPORTED\", \"seal\", source]"
          assign target=tape value="tape + epframe(\"O\", ch)"
          assign target=cursor value="cursor + 1"
      assign target=count value="count + 1"
    if cond="count != 5"
      return value="[\"kern.frontend.scalar-tape-probe.1\", \"failure\", \"SHAPE\", \"seal\", source]"
    let name=phase value="0"
    while cond="phase < 2"
      let name=target value="\"*\""
      if cond="phase == 1"
        assign target=target value="\"+\""
      assign target=cursor value="0"
      let name=previousStart value="0"
      let name=previousKnown value="false"
      let name=previous value="\"\""
      let name=reduced value="false"
      while cond="cursor < Text.length(tape)"
        let name=frameStart value="cursor"
        let name=kind value="Text.charAt(tape, cursor)"
        assign target=cursor value="cursor + 1"
        let name=length value="0"
        while cond="cursor < Text.length(tape) && Text.charAt(tape, cursor) != \":\""
          assign target=length value="length * 10 + Text.indexOf(\"0123456789\", Text.charAt(tape, cursor))"
          assign target=cursor value="cursor + 1"
        let name=valueStart value="cursor + 1"
        let name=frameEnd value="valueStart + length"
        let name=value value="Text.slice(tape, valueStart, frameEnd)"
        if cond="kind == \"V\""
          assign target=previousStart value="frameStart"
          assign target=previous value="value"
          assign target=previousKnown value="true"
        else
          if cond="kind == \"O\" && value == target && previousKnown"
            assign target=cursor value="frameEnd + 1"
            let name=nextLength value="0"
            while cond="cursor < Text.length(tape) && Text.charAt(tape, cursor) != \":\""
              assign target=nextLength value="nextLength * 10 + Text.indexOf(\"0123456789\", Text.charAt(tape, cursor))"
              assign target=cursor value="cursor + 1"
            let name=nextStart value="cursor + 1"
            let name=nextEnd value="nextStart + nextLength"
            let name=next value="Text.slice(tape, nextStart, nextEnd)"
            let name=replacement value="epframe(\"V\", epbinary(previous, target, next))"
            do value="Text.splice(tape, previousStart, nextEnd, replacement, maxTapeCodePoints)"
            assign target=reduced value="true"
            break
        assign target=cursor value="frameEnd"
      if cond="!reduced"
        return value="[\"kern.frontend.scalar-tape-probe.1\", \"failure\", \"REDUCE\", \"seal\", source]"
      assign target=phase value="phase + 1"
    assign target=cursor value="1"
    let name=finalLength value="0"
    while cond="Text.charAt(tape, cursor) != \":\""
      assign target=finalLength value="finalLength * 10 + Text.indexOf(\"0123456789\", Text.charAt(tape, cursor))"
      assign target=cursor value="cursor + 1"
    let name=result value="Text.slice(tape, cursor + 1, cursor + 1 + finalLength)"
    return value="[\"kern.frontend.scalar-tape-probe.1\", \"ok\", result, \"seal\", source]"
