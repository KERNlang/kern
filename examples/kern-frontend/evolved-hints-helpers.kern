fn name=validevolvedhintname returns=boolean
  param name=value type=string
  param name=maxCodePoints type=number
  param name=maxBytes type=number
  handler lang="kern"
    return value="Text.length(value) > 0 && Text.length(value) <= maxCodePoints && utf8bytes(value) <= maxBytes"

fn name=evolvedhintspaces returns=string
  param name=value type=string
  handler lang="kern"
    let name=out value="\"\""
    let name=cursor value="0"
    let name=n value="Text.length(value)"
    while cond="cursor < n"
      let name=ch value="Text.charAt(value, cursor)"
      assign target=out value="out + \" \""
      if cond="utf16units(ch) == 2"
        assign target=out value="out + \" \""
      assign target=cursor value="cursor + 1"
    return value="out"

fn name=maskevolvedhinttokens returns=string
  param name=content type=string
  param name=starts type="number[]"
  param name=ends type="number[]"
  handler lang="kern"
    let name=out value="\"\""
    let name=copyCursor value="0"
    for name=rangeIndex from=0 to="starts.length"
      let name=start value="starts[rangeIndex]"
      let name=end value="ends[rangeIndex]"
      assign target=out value="out + Text.slice(content, copyCursor, start)"
      assign target=out value="out + evolvedhintspaces(Text.slice(content, start, end))"
      assign target=copyCursor value="end"
    assign target=out value="out + Text.slice(content, copyCursor, Text.length(content))"
    return value="out"

fn name=evolvedhintfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  param name=content type=string
  param name=runtimeInstance type=number
  param name=parseEpoch type=number
  param name=hintsFormat type=string
  param name=maxFields type=number
  param name=maxBytes type=number
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(hintsFormat)"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    for name=padding from=0 to=15
      do value="out.push(\"\")"
    do value="out.push(\"failure-seal\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    do value="out.push(content)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    for name=sealPadding from=0 to=14
      do value="out.push(\"\")"
    if cond="out.length > maxFields"
      return value="[]"
    let name=envelopeBytes value="0"
    for name=fieldIndex from=0 to="out.length"
      assign target=envelopeBytes value="envelopeBytes + utf8bytes(out[fieldIndex])"
    if cond="envelopeBytes > maxBytes"
      return value="[]"
    return value="out"
