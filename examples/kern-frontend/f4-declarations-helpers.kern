fn name=f4frame returns=string
  param name=value type=string
  handler lang="kern"
    return value="String(Text.length(value)) + \"\u003a\" + value"

fn name=f4row returns=string
  param name=values type="string[]"
  handler lang="kern"
    let name=out value="\"\""
    for name=index from=0 to=values.length
      assign target=out value="out + \"i\" + f4frame(values[index])"
    return value=out

fn name=f4append returns=string
  param name=tape type=string
  param name=row type=string
  handler lang="kern"
    return value="tape + \"i\" + f4frame(row)"

fn name=f4item returns=string
  param name=value type=string
  handler lang="kern"
    return value="\"i\" + f4frame(value)"

fn name=f4row1 returns=string
  param name=a type=string
  handler lang="kern"
    return value="f4item(a)"

fn name=f4row3 returns=string
  param name=a type=string
  param name=b type=string
  param name=c type=string
  handler lang="kern"
    return value="f4item(a) + f4item(b) + f4item(c)"

fn name=f4row5 returns=string
  param name=a type=string
  param name=b type=string
  param name=c type=string
  param name=d type=string
  param name=e type=string
  handler lang="kern"
    return value="f4item(a) + f4item(b) + f4item(c) + f4item(d) + f4item(e)"

