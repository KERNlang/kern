        assign target=nodeStart value="Map.get(spanStarts, String(nodeCursor))"
      if cond="Map.has(spanEnds, String(nodeCursor))"
        assign target=nodeEnd value="Map.get(spanEnds, String(nodeCursor))"
      assign target=chunkPayload value="chunkPayload + f2nodeframe(nodeCursor, nodeKinds[nodeCursor], nodeStart, nodeEnd, nodeFlags[nodeCursor], nodeSubtrees[nodeCursor], nodePayloads[nodeCursor], nodeChildren[nodeCursor])"
      assign target=frameCount value="frameCount + 1"
      if cond="frameCount == nodesPerChunk"
        do value="chunks.push(\"c\" + String(chunkOrdinal) + \",\" + String(firstNode) + \",\" + String(frameCount) + \",\" + String(Text.length(chunkPayload)) + \":\" + chunkPayload + \"s\" + String(chunkOrdinal))"
        if cond="frameCount > maxGuest"
          assign target=maxGuest value="frameCount"
        assign target=chunkOrdinal value="chunkOrdinal + 1"
        assign target=firstNode value="nodeCursor + 1"
        assign target=chunkPayload value="\"\""
        assign target=frameCount value="0"
    if cond="frameCount > 0"
      do value="chunks.push(\"c\" + String(chunkOrdinal) + \",\" + String(firstNode) + \",\" + String(frameCount) + \",\" + String(Text.length(chunkPayload)) + \":\" + chunkPayload + \"s\" + String(chunkOrdinal))"
      if cond="frameCount > maxGuest"
        assign target=maxGuest value="frameCount"
    if cond="chunks.length > maxGuest"
      assign target=maxGuest value="chunks.length"
    let name=tape value="f2concat(chunks)"
    if cond="chunks.length > maxChunks || Text.length(tape) > maxTapeScalars"
      let name=transportFailure value="f2failure(\"TRANSPORT_LIMIT\", 0, n, n)"
      return value=transportFailure
    let name=root value="nodeKinds.length - 1"
    return value="[\"kern.frontend.f2-expression.1\", \"parsed\", \"\", String(n), String(nodeKinds.length), String(chunks.length), String(maxGuest), tape, \"root:\" + String(root) + \":\" + String(nodeKinds.length) + \":\" + String(chunks.length) + \":closed\"]"
