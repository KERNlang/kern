fn name=lexicalfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(\"kern.frontend.lexical-checkpoint-shadow.1\")"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    for name=padding from=0 to=9
      do value="out.push(\"\")"
    return value="out"

fn name=observelexical returns="string[]" export=true
  param name=source type=string
  param name=rawProfile type=string
  param name=maxCodePoints type=number
  param name=maxPhysicalRecords type=number
  param name=maxPhysicalRecordCodePoints type=number
  param name=maxGroups type=number
  param name=maxGroupRecords type=number
  param name=maxStitchDepth type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxEnvelopeRecords type=number
  param name=maxRawOpeners type=number
  param name=maxCheckpoints type=number
  param name=maxLexicalDepth type=number
  handler lang="kern"
    if cond="maxCheckpoints <= 0 || maxLexicalDepth <= 0"
      let name=invalidLimits value="lexicalfailure(\"INVALID_LIMITS\", \"\")"
      return value="invalidLimits"
    let name=base value="stitchdocument(source, rawProfile, maxCodePoints, maxPhysicalRecords, maxPhysicalRecordCodePoints, maxGroups, maxGroupRecords, maxStitchDepth, maxTokens, maxDiagnostics, maxEnvelopeRecords, maxRawOpeners)"
    if cond="base.length >= 2 && base[1] == \"failure\""
      let name=baseFailure value="lexicalfailure(base[2], base[3])"
      return value="baseFailure"

    let name=out value="[]"
    do value="out.push(\"kern.frontend.lexical-checkpoint-shadow.1\")"
    let name=checkpointIndex value="0"
    for name=groupOffset from=1 to="base.length" step=8
      if cond="base[groupOffset] != \"group\" || base[groupOffset + 4] != \"complete\""
        continue
      let name=groupIndexText value="base[groupOffset + 1]"
      let name=groupStartText value="base[groupOffset + 2]"
      let name=groupEndText value="base[groupOffset + 3]"
      let name=quoteCode value="0"
      let name=expressionDepth value="0"
      let name=styleDepth value="0"
      let name=ordinal value="0"
      let name=inGroup value="false"
      for name=physicalOffset from=1 to="base.length" step=8
        if cond="base[physicalOffset] != \"physical\""
          break
        let name=physicalIndexText value="base[physicalOffset + 1]"
        if cond="physicalIndexText == groupStartText"
          assign target=inGroup value="true"
        if cond="!inGroup"
          continue
        if cond="checkpointIndex >= maxCheckpoints"
          let name=checkpointFailure value="lexicalfailure(\"CHECKPOINT_LIMIT\", \"\")"
          return value="checkpointFailure"

        let name=content value="base[physicalOffset + 2]"
        let name=scan value="scanlexicalcontent(content, quoteCode, expressionDepth, styleDepth, maxLexicalDepth)"
        if cond="scan[0] == 1"
          let name=scanLimitsFailure value="lexicalfailure(\"INVALID_LIMITS\", \"\")"
          return value="scanLimitsFailure"
        if cond="scan[0] == 2"
          let name=scanDepthFailure value="lexicalfailure(\"LEXICAL_DEPTH_LIMIT\", \"\")"
          return value="scanDepthFailure"
        assign target=quoteCode value="scan[1]"
        let name=quote value="\"none\""
        if cond="quoteCode == 1"
          assign target=quote value="\"single\""
        if cond="quoteCode == 2"
          assign target=quote value="\"double\""
        let name=escapePending value="scan[2]"
        assign target=expressionDepth value="scan[3]"
        assign target=styleDepth value="scan[4]"
        let name=stop value="\"record-end\""
        let name=markerOffset value="\"none\""
        if cond="scan[5] == 1"
          assign target=stop value="\"eligible-marker\""
          assign target=markerOffset value="String(scan[6])"

        do value="out.push(\"checkpoint\")"
        do value="out.push(String(checkpointIndex))"
        do value="out.push(groupIndexText)"
        do value="out.push(String(ordinal))"
        do value="out.push(physicalIndexText)"
        do value="out.push(content)"
        do value="out.push(quote)"
        do value="out.push(String(escapePending))"
        do value="out.push(String(expressionDepth))"
        do value="out.push(String(styleDepth))"
        do value="out.push(stop)"
        do value="out.push(markerOffset)"
        assign target=checkpointIndex value="checkpointIndex + 1"
        assign target=ordinal value="ordinal + 1"
        if cond="physicalIndexText == groupEndText"
          break

    do value="out.push(\"seal\")"
    do value="out.push(source)"
    for name=sealPadding from=0 to=10
      do value="out.push(\"\")"
    return value="out"
