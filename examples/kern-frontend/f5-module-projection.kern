fn name=f5bindingvalue returns=string
  param name=limits type=string
  param name=row type="string[]"
  handler lang="kern"
    let name=imported value="List.index(row, 1)"
    let name=kind value="List.index(row, 3)"
    let name=local value="List.index(row, 2)"
    let name=reexport value="row[4] == \"true\""
    let name=importedValue value="f5text(limits, imported)"
    let name=kindValue value="f5text(limits, kind)"
    let name=localValue value="f5text(limits, local)"
    let name=reexportValue value="f5bool(limits, reexport)"
    let name=keys value="[]"
    do value="keys.push(\"imported\")"
    do value="keys.push(\"kind\")"
    do value="keys.push(\"local\")"
    do value="keys.push(\"reexport\")"
    let name=values value="[]"
    do value="values.push(importedValue)"
    do value="values.push(kindValue)"
    do value="values.push(localValue)"
    do value="values.push(reexportValue)"
    let name=binding value="f5record(limits, keys, values, 0)"
    return value=binding

fn name=f5exportvalue returns=string
  param name=limits type=string
  param name=kind type=string
  param name=name type=string
  param name=source type=string
  handler lang="kern"
    let name=sourceValue value="f5null(limits)"
    if cond="source != \"\""
      assign target=sourceValue value="f5text(limits, source)"
    let name=kindValue value="f5text(limits, kind)"
    let name=nameValue value="f5text(limits, name)"
    let name=keys value="[]"
    do value="keys.push(\"kind\")"
    do value="keys.push(\"name\")"
    do value="keys.push(\"source\")"
    let name=values value="[]"
    do value="values.push(kindValue)"
    do value="values.push(nameValue)"
    do value="values.push(sourceValue)"
    let name=exported value="f5record(limits, keys, values, 0)"
    return value=exported

fn name=f5projectmodules returns=string
  param name=limits type=string
  param name=moduleIds type="string[]"
  param name=rootTapes type="string[]"
  param name=symbolTapes type="string[]"
  param name=resolvedBindingTape type=string
  handler lang="kern"
    if cond="moduleIds.length != rootTapes.length || moduleIds.length != symbolTapes.length"
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", 0)"
    let name=bindings value="f5rowread(resolvedBindingTape)"
    let name=moduleWork value="f5rowcodecwork(resolvedBindingTape, bindings)"
    for name=bindingShapeIndex from=0 to=bindings.length
      let name=bindingShapeTape value="List.index(bindings, bindingShapeIndex)"
      let name=bindingShape value="f5rowread(bindingShapeTape)"
      assign target=moduleWork value="moduleWork + f5rowcodecwork(bindingShapeTape, bindingShape)"
      if cond="bindingShape.length != 8"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork)"
    let name=moduleEntries value="[]"
    let name=moduleEntryWork value=0
    for name=moduleIndex from=0 to=moduleIds.length
      let name=moduleId value="List.index(moduleIds, moduleIndex)"
      let name=exportEntries value="[]"
      let name=exportEntryWork value=0
      let name=symbolTape value="List.index(symbolTapes, moduleIndex)"
      let name=symbols value="f5rowread(symbolTape)"
      assign target=moduleWork value="moduleWork + f5rowcodecwork(symbolTape, symbols)"
      for name=symbolIndex from=0 to=symbols.length
        let name=symbolRowTape value="List.index(symbols, symbolIndex)"
        let name=symbol value="f5rowread(symbolRowTape)"
        assign target=moduleWork value="moduleWork + f5rowcodecwork(symbolRowTape, symbol)"
        if cond="symbol.length == 5 && symbol[2] == \"true\""
          let name=symbolKind value="List.index(symbol, 0)"
          let name=symbolName value="List.index(symbol, 1)"
          let name=exportValue value="f5exportvalue(limits, symbolKind, symbolName, \"\")"
          let name=exportEntry value="f5frame(\"i\", symbolName) + f5frame(\"i\", exportValue)"
          let name=exportResult value="f5resultread(exportValue)"
          assign target=exportEntryWork value="exportEntryWork + Text.length(exportValue) + 1 + f5uint(exportResult[3]) + Text.length(exportEntry)"
          do value="exportEntries.push(exportEntry)"
      for name=reexportIndex from=0 to=bindings.length
        let name=reexportRowTape value="List.index(bindings, reexportIndex)"
        let name=reexport value="f5rowread(reexportRowTape)"
        assign target=moduleWork value="moduleWork + f5rowcodecwork(reexportRowTape, reexport)"
        if cond="reexport.length == 8 && reexport[5] == moduleId && reexport[4] == \"true\""
          let name=reexportSource value="List.index(reexport, 0)"
          let name=reexportName value="List.index(reexport, 2)"
          let name=reexportKind value="List.index(reexport, 3)"
          let name=reexportValue value="f5exportvalue(limits, reexportKind, reexportName, reexportSource)"
          let name=reexportEntry value="f5frame(\"i\", reexportName) + f5frame(\"i\", reexportValue)"
          let name=reexportResult value="f5resultread(reexportValue)"
          assign target=exportEntryWork value="exportEntryWork + Text.length(reexportValue) + 1 + f5uint(reexportResult[3]) + Text.length(reexportEntry)"
          do value="exportEntries.push(reexportEntry)"
      let name=sortedExports value="f5chargedsort(exportEntries, exportEntryWork)"
      if cond="sortedExports.length == 2 && List.index(sortedExports, 0) == \"2\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork + f5uint(List.index(sortedExports, 1)))"
      if cond="sortedExports.length != exportEntries.length + 2 || List.index(sortedExports, 0) != \"0\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork + exportEntryWork)"
      let name=exportsValue value="f5listordinals(limits, exportEntries, sortedExports)"
      let name=sources value="[]"
      for name=bindingIndex from=0 to=bindings.length
        let name=bindingRowTape value="List.index(bindings, bindingIndex)"
        let name=binding value="f5rowread(bindingRowTape)"
        assign target=moduleWork value="moduleWork + f5rowcodecwork(bindingRowTape, binding)"
        if cond="binding.length == 8 && binding[5] == moduleId"
          let name=known value="false"
          for name=sourceIndex from=0 to=sources.length
            assign target=moduleWork value="moduleWork + 1"
            if cond="sources[sourceIndex] == binding[0]"
              assign target=known value="true"
          if cond="!known"
            let name=bindingSource value="List.index(binding, 0)"
            do value="sources.push(bindingSource)"
      let name=sourceEntries value="[]"
      let name=sourceEntryWork value=0
      for name=sourceValueIndex from=0 to=sources.length
        let name=sourceTextValue value="f5text(limits, List.index(sources, sourceValueIndex))"
        let name=sourceTextResult value="f5resultread(sourceTextValue)"
        let name=sourceEntry value="f5frame(\"i\", List.index(sources, sourceValueIndex)) + f5frame(\"i\", sourceTextValue)"
        assign target=sourceEntryWork value="sourceEntryWork + Text.length(sourceTextValue) + 1 + f5uint(sourceTextResult[3]) + Text.length(sourceEntry)"
        do value="sourceEntries.push(sourceEntry)"
      let name=sortedSources value="f5chargedsort(sourceEntries, moduleWork + sourceEntryWork)"
      if cond="sortedSources.length == 2 && List.index(sortedSources, 0) == \"2\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleEntryWork + f5uint(List.index(sortedSources, 1)))"
      if cond="sortedSources.length != sourceEntries.length + 2 || List.index(sortedSources, 0) != \"0\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork + sourceEntryWork)"
      assign target=moduleWork value="f5uint(List.index(sortedSources, sourceEntries.length + 1))"
      let name=imports value="[]"
      for name=sourceIndex from=0 to=sourceEntries.length
        let name=sourceOrdinal value="f5uint(List.index(sortedSources, sourceIndex + 1))"
        let name=sourceEntryFrame value="List.index(sourceEntries, sourceOrdinal)"
        let name=sourceEntry value="f5rowread(sourceEntryFrame)"
        assign target=moduleWork value="moduleWork + f5rowcodecwork(sourceEntryFrame, sourceEntry)"
        let name=source value="List.index(sourceEntry, 0)"
        let name=bindingEntries value="[]"
        let name=bindingEntryWork value=0
        for name=matchingIndex from=0 to=bindings.length
          let name=matchingRowTape value="List.index(bindings, matchingIndex)"
          let name=matching value="f5rowread(matchingRowTape)"
          assign target=moduleWork value="moduleWork + f5rowcodecwork(matchingRowTape, matching)"
          if cond="matching.length != 8"
            return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork + bindingEntryWork)"
          if cond="matching[5] == moduleId && matching[0] == source"
            let name=matchingKey value="matching[1] + \"|\" + matching[3] + \"|\" + matching[2] + \"|\" + matching[4]"
            let name=matchingValue value="f5bindingvalue(limits, matching)"
            let name=matchingEntry value="f5frame(\"i\", matchingKey) + f5frame(\"i\", matchingValue)"
            let name=matchingResult value="f5resultread(matchingValue)"
            assign target=bindingEntryWork value="bindingEntryWork + Text.length(matchingValue) + 1 + f5uint(matchingResult[3]) + Text.length(matchingEntry)"
            do value="bindingEntries.push(matchingEntry)"
        let name=sortedBindings value="f5chargedsort(bindingEntries, bindingEntryWork)"
        if cond="sortedBindings.length == 2 && List.index(sortedBindings, 0) == \"2\""
          return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork + f5uint(List.index(sortedBindings, 1)))"
        if cond="sortedBindings.length != bindingEntries.length + 2 || List.index(sortedBindings, 0) != \"0\""
          return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork + bindingEntryWork)"
        let name=bindingsValue value="f5listordinals(limits, bindingEntries, sortedBindings)"
        let name=sourceValue value="f5text(limits, source)"
        let name=importKeys value="[]"
        do value="importKeys.push(\"bindings\")"
        do value="importKeys.push(\"source\")"
        let name=importValues value="[]"
        do value="importValues.push(bindingsValue)"
        do value="importValues.push(sourceValue)"
        let name=importValue value="f5record(limits, importKeys, importValues, 0)"
        do value="imports.push(importValue)"
      let name=rootTape value="List.index(rootTapes, moduleIndex)"
      let name=moduleRoots value="f5rowread(rootTape)"
      assign target=moduleWork value="moduleWork + f5rowcodecwork(rootTape, moduleRoots)"
      let name=moduleIdValue value="f5text(limits, moduleId)"
      let name=importsValue value="f5list(limits, imports)"
      let name=rootsValue value="f5list(limits, moduleRoots)"
      let name=moduleKeys value="[]"
      do value="moduleKeys.push(\"exports\")"
      do value="moduleKeys.push(\"id\")"
      do value="moduleKeys.push(\"imports\")"
      do value="moduleKeys.push(\"roots\")"
      let name=moduleValues value="[]"
      do value="moduleValues.push(exportsValue)"
      do value="moduleValues.push(moduleIdValue)"
      do value="moduleValues.push(importsValue)"
      do value="moduleValues.push(rootsValue)"
      let name=moduleValue value="f5record(limits, moduleKeys, moduleValues, 0)"
      let name=moduleResult value="f5resultread(moduleValue)"
      let name=moduleEntry value="f5frame(\"i\", moduleId) + f5frame(\"i\", moduleValue)"
      assign target=moduleEntryWork value="moduleEntryWork + Text.length(moduleValue) + 1 + f5uint(moduleResult[3]) + Text.length(moduleEntry)"
      do value="moduleEntries.push(moduleEntry)"
    let name=sortedModules value="f5chargedsort(moduleEntries, moduleEntryWork)"
    if cond="sortedModules.length == 2 && List.index(sortedModules, 0) == \"2\""
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + f5uint(List.index(sortedModules, 1)))"
    if cond="sortedModules.length != moduleEntries.length + 2 || List.index(sortedModules, 0) != \"0\""
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", moduleWork + moduleEntryWork)"
    let name=constitutionValue value="f5text(limits, \"kern.kir.structural.r1.5i.1\")"
    let name=emptyDiagnostics value="[]"
    let name=diagnosticsValue value="f5list(limits, emptyDiagnostics)"
    let name=formatValue value="f5text(limits, \"kern.kir.modules.r1.5e.1-alpha\")"
    let name=modulesValue value="f5listordinals(limits, moduleEntries, sortedModules)"
    let name=proofLabelValue value="f5text(limits, \"ALPHA-NO-GO\")"
    let name=admittedKinds value="[]"
    let name=classKind value="f5text(limits, \"class\")"
    let name=fnKind value="f5text(limits, \"fn\")"
    do value="admittedKinds.push(classKind)"
    do value="admittedKinds.push(fnKind)"
    let name=admittedKindsValue value="f5list(limits, admittedKinds)"
    let name=symbolFormatValue value="f5text(limits, \"kern.symbol-admission.r1.5c.3\")"
    let name=symbolKeys value="[]"
    do value="symbolKeys.push(\"admittedKinds\")"
    do value="symbolKeys.push(\"format\")"
    let name=symbolValues value="[]"
    do value="symbolValues.push(admittedKindsValue)"
    do value="symbolValues.push(symbolFormatValue)"
    let name=symbolCatalogValue value="f5record(limits, symbolKeys, symbolValues, 0)"
    let name=artifactKeys value="[]"
    do value="artifactKeys.push(\"constitution\")"
    do value="artifactKeys.push(\"diagnostics\")"
    do value="artifactKeys.push(\"format\")"
    do value="artifactKeys.push(\"modules\")"
    do value="artifactKeys.push(\"proofLabel\")"
    do value="artifactKeys.push(\"symbolCatalog\")"
    let name=artifactValues value="[]"
    do value="artifactValues.push(constitutionValue)"
    do value="artifactValues.push(diagnosticsValue)"
    do value="artifactValues.push(formatValue)"
    do value="artifactValues.push(modulesValue)"
    do value="artifactValues.push(proofLabelValue)"
    do value="artifactValues.push(symbolCatalogValue)"
    let name=artifact value="f5record(limits, artifactKeys, artifactValues, moduleWork)"
    return value=artifact
