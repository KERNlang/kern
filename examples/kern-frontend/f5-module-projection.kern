fn name=f5bindingvalue returns=string
  param name=row type="string[]"
  handler lang="kern"
    let name=imported value="List.index(row, 1)"
    let name=kind value="List.index(row, 3)"
    let name=local value="List.index(row, 2)"
    let name=reexport value="row[4] == \"true\""
    let name=importedValue value="f5text(imported)"
    let name=kindValue value="f5text(kind)"
    let name=localValue value="f5text(local)"
    let name=reexportValue value="f5bool(reexport)"
    let name=keys value="[]"
    do value="keys.push(\"imported\")"
    do value="keys.push(\"kind\")"
    do value="keys.push(\"local\")"
    do value="keys.push(\"reexport\")"
    let name=values value="[]"
    do value="values.push(importedValue)"
    do value="values.push(kindValue)"
    do value="values.push(localValue)"
    do value="values.push(reexportValue)"
    let name=binding value="f5record(keys, values)"
    return value=binding

fn name=f5exportvalue returns=string
  param name=kind type=string
  param name=name type=string
  param name=source type=string
  handler lang="kern"
    let name=sourceValue value="f5null()"
    if cond="source != \"\""
      assign target=sourceValue value="f5text(source)"
    let name=kindValue value="f5text(kind)"
    let name=nameValue value="f5text(name)"
    let name=keys value="[]"
    do value="keys.push(\"kind\")"
    do value="keys.push(\"name\")"
    do value="keys.push(\"source\")"
    let name=values value="[]"
    do value="values.push(kindValue)"
    do value="values.push(nameValue)"
    do value="values.push(sourceValue)"
    let name=exported value="f5record(keys, values)"
    return value=exported

fn name=f5projectmodules returns=string
  param name=moduleIds type="string[]"
  param name=rootTapes type="string[]"
  param name=symbolTapes type="string[]"
  param name=resolvedBindingTape type=string
  handler lang="kern"
    if cond="moduleIds.length != rootTapes.length || moduleIds.length != symbolTapes.length"
      return value="\"\""
    let name=bindings value="f5rowread(resolvedBindingTape)"
    let name=orderedModuleIds value="[]"
    let name=orderedRootTapes value="[]"
    let name=orderedSymbolTapes value="[]"
    let name=usedModuleOrdinals value="[]"
    for name=sortIndex from=0 to=moduleIds.length
      let name=selectedIndex value="-1"
      for name=candidateIndex from=0 to=moduleIds.length
        let name=used value="false"
        for name=usedIndex from=0 to=usedModuleOrdinals.length
          if cond="usedModuleOrdinals[usedIndex] == candidateIndex"
            assign target=used value="true"
        if cond="!used"
          if cond="selectedIndex < 0"
            assign target=selectedIndex value=candidateIndex
          else
            let name=candidateModuleId value="List.index(moduleIds, candidateIndex)"
            let name=currentModuleId value="List.index(moduleIds, selectedIndex)"
            if cond="candidateModuleId < currentModuleId"
              assign target=selectedIndex value=candidateIndex
      if cond="selectedIndex < 0"
        return value="\"\""
      let name=selectedModuleId value="List.index(moduleIds, selectedIndex)"
      let name=selectedRootTape value="List.index(rootTapes, selectedIndex)"
      let name=selectedSymbolTape value="List.index(symbolTapes, selectedIndex)"
      do value="usedModuleOrdinals.push(selectedIndex)"
      do value="orderedModuleIds.push(selectedModuleId)"
      do value="orderedRootTapes.push(selectedRootTape)"
      do value="orderedSymbolTapes.push(selectedSymbolTape)"
    let name=modules value="[]"
    for name=moduleIndex from=0 to=orderedModuleIds.length
      let name=moduleId value="List.index(orderedModuleIds, moduleIndex)"
      let name=exportNames value="[]"
      let name=exportValues value="[]"
      let name=symbolTape value="List.index(orderedSymbolTapes, moduleIndex)"
      let name=symbols value="f5rowread(symbolTape)"
      for name=symbolIndex from=0 to=symbols.length
        let name=symbolRowTape value="List.index(symbols, symbolIndex)"
        let name=symbol value="f5rowread(symbolRowTape)"
        if cond="symbol.length == 5 && symbol[2] == \"true\""
          let name=symbolKind value="List.index(symbol, 0)"
          let name=symbolName value="List.index(symbol, 1)"
          let name=exportValue value="f5exportvalue(symbolKind, symbolName, \"\")"
          do value="exportNames.push(symbolName)"
          do value="exportValues.push(exportValue)"
      for name=reexportIndex from=0 to=bindings.length
        let name=reexportRowTape value="List.index(bindings, reexportIndex)"
        let name=reexport value="f5rowread(reexportRowTape)"
        if cond="reexport.length == 8 && reexport[5] == moduleId && reexport[4] == \"true\""
          let name=reexportSource value="List.index(reexport, 0)"
          let name=reexportName value="List.index(reexport, 2)"
          let name=reexportKind value="List.index(reexport, 3)"
          let name=reexportValue value="f5exportvalue(reexportKind, reexportName, reexportSource)"
          do value="exportNames.push(reexportName)"
          do value="exportValues.push(reexportValue)"
      let name=sortedExports value="f5sortproperties(exportNames, exportValues)"
      let name=sortedExportValues value="[]"
      for name=exportSortIndex from=1 to=sortedExports.length step=2
        let name=sortedExportValue value="List.index(sortedExports, exportSortIndex)"
        do value="sortedExportValues.push(sortedExportValue)"
      let name=sources value="[]"
      for name=bindingIndex from=0 to=bindings.length
        let name=bindingRowTape value="List.index(bindings, bindingIndex)"
        let name=binding value="f5rowread(bindingRowTape)"
        if cond="binding.length == 8 && binding[5] == moduleId"
          let name=known value="false"
          for name=sourceIndex from=0 to=sources.length
            if cond="sources[sourceIndex] == binding[0]"
              assign target=known value="true"
          if cond="!known"
            let name=bindingSource value="List.index(binding, 0)"
            do value="sources.push(bindingSource)"
      let name=orderedSources value="[]"
      let name=usedSourceOrdinals value="[]"
      for name=sourceSort from=0 to=sources.length
        let name=selectedSourceIndex value="-1"
        for name=sourceCandidateIndex from=0 to=sources.length
          let name=sourceUsed value="false"
          for name=sourceUsedIndex from=0 to=usedSourceOrdinals.length
            if cond="usedSourceOrdinals[sourceUsedIndex] == sourceCandidateIndex"
              assign target=sourceUsed value="true"
          if cond="!sourceUsed"
            if cond="selectedSourceIndex < 0"
              assign target=selectedSourceIndex value=sourceCandidateIndex
            else
              let name=candidateSource value="List.index(sources, sourceCandidateIndex)"
              let name=currentSource value="List.index(sources, selectedSourceIndex)"
              if cond="candidateSource < currentSource"
                assign target=selectedSourceIndex value=sourceCandidateIndex
        if cond="selectedSourceIndex < 0"
          return value="\"\""
        let name=selectedSource value="List.index(sources, selectedSourceIndex)"
        do value="usedSourceOrdinals.push(selectedSourceIndex)"
        do value="orderedSources.push(selectedSource)"
      let name=imports value="[]"
      for name=sourceIndex from=0 to=orderedSources.length
        let name=source value="List.index(orderedSources, sourceIndex)"
        let name=keys value="[]"
        let name=values value="[]"
        for name=matchingIndex from=0 to=bindings.length
          let name=matchingRowTape value="List.index(bindings, matchingIndex)"
          let name=matching value="f5rowread(matchingRowTape)"
          if cond="matching[5] == moduleId && matching[0] == source"
            let name=matchingKey value="matching[1] + \"|\" + matching[3] + \"|\" + matching[2] + \"|\" + matching[4]"
            let name=matchingValue value="f5bindingvalue(matching)"
            do value="keys.push(matchingKey)"
            do value="values.push(matchingValue)"
        let name=sortedBindings value="f5sortproperties(keys, values)"
        let name=sortedBindingValues value="[]"
        for name=bindingSortIndex from=1 to=sortedBindings.length step=2
          let name=sortedBindingValue value="List.index(sortedBindings, bindingSortIndex)"
          do value="sortedBindingValues.push(sortedBindingValue)"
        let name=bindingsValue value="f5list(sortedBindingValues)"
        let name=sourceValue value="f5text(source)"
        let name=importKeys value="[]"
        do value="importKeys.push(\"bindings\")"
        do value="importKeys.push(\"source\")"
        let name=importValues value="[]"
        do value="importValues.push(bindingsValue)"
        do value="importValues.push(sourceValue)"
        let name=importValue value="f5record(importKeys, importValues)"
        do value="imports.push(importValue)"
      let name=rootTape value="List.index(orderedRootTapes, moduleIndex)"
      let name=moduleRoots value="f5rowread(rootTape)"
      let name=exportsValue value="f5list(sortedExportValues)"
      let name=moduleIdValue value="f5text(moduleId)"
      let name=importsValue value="f5list(imports)"
      let name=rootsValue value="f5list(moduleRoots)"
      let name=moduleKeys value="[]"
      do value="moduleKeys.push(\"exports\")"
      do value="moduleKeys.push(\"id\")"
      do value="moduleKeys.push(\"imports\")"
      do value="moduleKeys.push(\"roots\")"
      let name=moduleValues value="[]"
      do value="moduleValues.push(exportsValue)"
      do value="moduleValues.push(moduleIdValue)"
      do value="moduleValues.push(importsValue)"
      do value="moduleValues.push(rootsValue)"
      let name=moduleValue value="f5record(moduleKeys, moduleValues)"
      do value="modules.push(moduleValue)"
    let name=constitutionValue value="f5text(\"kern.kir.structural.r1.5i.1\")"
    let name=emptyDiagnostics value="[]"
    let name=diagnosticsValue value="f5list(emptyDiagnostics)"
    let name=formatValue value="f5text(\"kern.kir.modules.r1.5e.1-alpha\")"
    let name=modulesValue value="f5list(modules)"
    let name=proofLabelValue value="f5text(\"ALPHA-NO-GO\")"
    let name=admittedKinds value="[]"
    let name=classKind value="f5text(\"class\")"
    let name=fnKind value="f5text(\"fn\")"
    do value="admittedKinds.push(classKind)"
    do value="admittedKinds.push(fnKind)"
    let name=admittedKindsValue value="f5list(admittedKinds)"
    let name=symbolFormatValue value="f5text(\"kern.symbol-admission.r1.5c.3\")"
    let name=symbolKeys value="[]"
    do value="symbolKeys.push(\"admittedKinds\")"
    do value="symbolKeys.push(\"format\")"
    let name=symbolValues value="[]"
    do value="symbolValues.push(admittedKindsValue)"
    do value="symbolValues.push(symbolFormatValue)"
    let name=symbolCatalogValue value="f5record(symbolKeys, symbolValues)"
    let name=artifactKeys value="[]"
    do value="artifactKeys.push(\"constitution\")"
    do value="artifactKeys.push(\"diagnostics\")"
    do value="artifactKeys.push(\"format\")"
    do value="artifactKeys.push(\"modules\")"
    do value="artifactKeys.push(\"proofLabel\")"
    do value="artifactKeys.push(\"symbolCatalog\")"
    let name=artifactValues value="[]"
    do value="artifactValues.push(constitutionValue)"
    do value="artifactValues.push(diagnosticsValue)"
    do value="artifactValues.push(formatValue)"
    do value="artifactValues.push(modulesValue)"
    do value="artifactValues.push(proofLabelValue)"
    do value="artifactValues.push(symbolCatalogValue)"
    let name=artifact value="f5record(artifactKeys, artifactValues)"
    return value=artifact
