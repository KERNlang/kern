fn name=f4bgraphclosure returns="string[]"
  param name=moduleIds type="string[]"
  param name=f4aStatuses type="string[]"
  param name=f4aSeals type="string[]"
  param name=bindingModuleIds type="string[]"
  param name=resolvedTargets type="string[]"
  param name=bindingOrdinals type="string[]"
  param name=bindingStarts type="string[]"
  param name=baseWork type=number
  param name=maxWorkSteps type=number
  handler lang="kern"
    let name=moduleCount value=moduleIds.length
    let name=bindingCount value=bindingModuleIds.length
    if cond="f4aStatuses.length != moduleCount || f4aSeals.length != moduleCount"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWork)]"
    if cond="resolvedTargets.length != bindingCount || bindingOrdinals.length != bindingCount || bindingStarts.length != bindingCount"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(baseWork)]"
    let name=workSteps value=baseWork
    let name=moduleSet value="new Map()"
    let name=statusByModule value="new Map()"
    let name=sealByModule value="new Map()"
    for name=moduleInputIndex from=0 to=moduleCount
      let name=inputModule value="moduleIds[moduleInputIndex]"
      do value="Map.set(moduleSet, String(inputModule), true)"
      do value="Map.set(statusByModule, String(inputModule), f4aStatuses[moduleInputIndex])"
      do value="Map.set(sealByModule, String(inputModule), f4aSeals[moduleInputIndex])"
      assign target=workSteps value="workSteps + 1"
    let name=canonicalModules value="f4bsortrows(moduleIds, \"string\")"
    if cond="canonicalModules.length != moduleCount"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"

    let name=edgeRows value="[]"
    for name=edgeInputIndex from=0 to=bindingCount
      let name=edgeSource value="bindingModuleIds[edgeInputIndex]"
      let name=edgeTarget value="resolvedTargets[edgeInputIndex]"
      if cond="Map.has(moduleSet, String(edgeTarget))"
        let name=edgeRow value="f4item(edgeSource) + f4item(edgeTarget) + f4item(bindingOrdinals[edgeInputIndex]) + f4item(bindingStarts[edgeInputIndex])"
        do value="edgeRows.push(edgeRow)"
      assign target=workSteps value="workSteps + 1"
    let name=sortedEdges value="f4bsortrows(edgeRows, \"edge-row\")"
    if cond="sortedEdges.length != edgeRows.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
    let name=uniqueEdges value="[]"
    let name=edgeSeen value="new Map()"
    let name=edgeWitness value="new Map()"
    for name=edgeSortIndex from=0 to=sortedEdges.length
      let name=sortedEdge value="sortedEdges[edgeSortIndex]"
      let name=sortedSource value="f4browfield(sortedEdge, 0)"
      let name=sortedTarget value="f4browfield(sortedEdge, 1)"
      let name=edgeKey value="f4item(sortedSource) + f4item(sortedTarget)"
      if cond="!Map.has(edgeSeen, String(edgeKey))"
        do value="Map.set(edgeSeen, String(edgeKey), true)"
        do value="Map.set(edgeWitness, String(edgeKey), sortedEdge)"
        do value="uniqueEdges.push(sortedEdge)"
      assign target=workSteps value="workSteps + 1"

    let name=forwardCarry value="new Map()"
    let name=reverseCarry value="new Map()"
    let name=maxCarryLevel value=0
    for name=carryEdgeIndex from=0 to=uniqueEdges.length
      let name=carryEdge value="uniqueEdges[carryEdgeIndex]"
      let name=carrySource value="f4browfield(carryEdge, 0)"
      let name=carryTarget value="f4browfield(carryEdge, 1)"
      let name=forwardPart value="f4item(carryTarget)"
      let name=forwardLevel value=0
      while cond="forwardPart != \"\""
        let name=forwardSlot value="f4item(carrySource) + f4item(String(forwardLevel))"
        if cond="Map.has(forwardCarry, String(forwardSlot))"
          let name=priorForward value="Map.get(forwardCarry, String(forwardSlot))"
          if cond="priorForward != \"\""
            assign target=forwardPart value="priorForward + forwardPart"
            do value="Map.set(forwardCarry, String(forwardSlot), \"\")"
            assign target=forwardLevel value="forwardLevel + 1"
          else
            do value="Map.set(forwardCarry, String(forwardSlot), forwardPart)"
            assign target=forwardPart value="\"\""
        else
          do value="Map.set(forwardCarry, String(forwardSlot), forwardPart)"
          assign target=forwardPart value="\"\""
        if cond="forwardLevel > maxCarryLevel"
          assign target=maxCarryLevel value=forwardLevel
        assign target=workSteps value="workSteps + 1"
      let name=reversePart value="f4item(carrySource)"
      let name=reverseLevel value=0
      while cond="reversePart != \"\""
        let name=reverseSlot value="f4item(carryTarget) + f4item(String(reverseLevel))"
        if cond="Map.has(reverseCarry, String(reverseSlot))"
          let name=priorReverse value="Map.get(reverseCarry, String(reverseSlot))"
          if cond="priorReverse != \"\""
            assign target=reversePart value="priorReverse + reversePart"
            do value="Map.set(reverseCarry, String(reverseSlot), \"\")"
            assign target=reverseLevel value="reverseLevel + 1"
          else
            do value="Map.set(reverseCarry, String(reverseSlot), reversePart)"
            assign target=reversePart value="\"\""
        else
          do value="Map.set(reverseCarry, String(reverseSlot), reversePart)"
          assign target=reversePart value="\"\""
        if cond="reverseLevel > maxCarryLevel"
          assign target=maxCarryLevel value=reverseLevel
        assign target=workSteps value="workSteps + 1"

    let name=forwardAdjacency value="new Map()"
    let name=reverseAdjacency value="new Map()"
    for name=adjacencyModuleIndex from=0 to=canonicalModules.length
      let name=adjacencyModule value="canonicalModules[adjacencyModuleIndex]"
      let name=forwardParts value="[]"
      let name=reverseParts value="[]"
      let name=adjacencyLevel value=maxCarryLevel
      while cond="adjacencyLevel >= 0"
        let name=forwardAdjacencySlot value="f4item(adjacencyModule) + f4item(String(adjacencyLevel))"
        if cond="Map.has(forwardCarry, String(forwardAdjacencySlot))"
          let name=forwardAdjacencyPart value="Map.get(forwardCarry, String(forwardAdjacencySlot))"
          if cond="forwardAdjacencyPart != \"\""
            do value="forwardParts.push(forwardAdjacencyPart)"
        let name=reverseAdjacencySlot value="f4item(adjacencyModule) + f4item(String(adjacencyLevel))"
        if cond="Map.has(reverseCarry, String(reverseAdjacencySlot))"
          let name=reverseAdjacencyPart value="Map.get(reverseCarry, String(reverseAdjacencySlot))"
          if cond="reverseAdjacencyPart != \"\""
            do value="reverseParts.push(reverseAdjacencyPart)"
        assign target=adjacencyLevel value="adjacencyLevel - 1"
      do value="Map.set(forwardAdjacency, String(adjacencyModule), f4bfoldparts(forwardParts))"
      do value="Map.set(reverseAdjacency, String(adjacencyModule), f4bfoldparts(reverseParts))"

    let name=finishByIndex value="new Map()"
    let name=finishCount value=0
    let name=forwardVisited value="new Map()"
    let name=dfsNodes value="new Map()"
    let name=dfsCursors value="new Map()"
    for name=forwardRootIndex from=0 to=canonicalModules.length
      let name=forwardRoot value="canonicalModules[forwardRootIndex]"
      if cond="!Map.has(forwardVisited, String(forwardRoot))"
        do value="Map.set(forwardVisited, String(forwardRoot), true)"
        do value="Map.set(dfsNodes, \"0\", forwardRoot)"
        do value="Map.set(dfsCursors, \"0\", 0)"
        let name=dfsDepth value=0
        while cond="dfsDepth >= 0"
          let name=depthKey value="String(dfsDepth)"
          if cond="!Map.has(dfsNodes, depthKey)"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          if cond="!Map.has(dfsCursors, depthKey)"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=dfsNode value="Map.get(dfsNodes, depthKey)"
          let name=dfsCursor value="Map.get(dfsCursors, depthKey)"
          if cond="!Map.has(forwardAdjacency, String(dfsNode))"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=dfsTape value="Map.get(forwardAdjacency, String(dfsNode))"
          if cond="dfsCursor >= Text.length(dfsTape)"
            do value="Map.set(finishByIndex, String(finishCount), dfsNode)"
            assign target=finishCount value="finishCount + 1"
            assign target=dfsDepth value="dfsDepth - 1"
          else
            let name=dfsItem value="f2batchmarked(dfsTape, dfsCursor, \"i\")"
            let name=dfsNext value="f2uint(dfsItem[1])"
            if cond="dfsNext <= dfsCursor"
              return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
            do value="Map.set(dfsCursors, depthKey, dfsNext)"
            let name=dfsTarget value="dfsItem[0]"
            if cond="!Map.has(forwardVisited, String(dfsTarget))"
              do value="Map.set(forwardVisited, String(dfsTarget), true)"
              assign target=dfsDepth value="dfsDepth + 1"
              do value="Map.set(dfsNodes, String(dfsDepth), dfsTarget)"
              do value="Map.set(dfsCursors, String(dfsDepth), 0)"
            assign target=workSteps value="workSteps + 1"

    let name=componentOf value="new Map()"
    let name=componentMembers value="new Map()"
    let name=componentSizes value="new Map()"
    let name=componentMinimums value="[]"
    let name=reverseVisited value="new Map()"
    let name=reverseStack value="new Map()"
    for name=finishPass from=0 to=finishCount
      let name=finishPosition value="finishCount - 1 - finishPass"
      let name=finishKey value="String(finishPosition)"
      if cond="!Map.has(finishByIndex, finishKey)"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
      let name=reverseRoot value="Map.get(finishByIndex, finishKey)"
      if cond="!Map.has(reverseVisited, String(reverseRoot))"
        let name=memberIds value="[]"
        let name=reverseDepth value=0
        do value="Map.set(reverseStack, \"0\", reverseRoot)"
        do value="Map.set(reverseVisited, String(reverseRoot), true)"
        while cond="reverseDepth >= 0"
          let name=reverseDepthKey value="String(reverseDepth)"
          if cond="!Map.has(reverseStack, reverseDepthKey)"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=reverseNode value="Map.get(reverseStack, reverseDepthKey)"
          assign target=reverseDepth value="reverseDepth - 1"
          do value="memberIds.push(reverseNode)"
          if cond="!Map.has(reverseAdjacency, String(reverseNode))"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=reverseTape value="Map.get(reverseAdjacency, String(reverseNode))"
          let name=reverseCursor value=0
          while cond="reverseCursor < Text.length(reverseTape)"
            let name=reverseItem value="f2batchmarked(reverseTape, reverseCursor, \"i\")"
            let name=reverseNext value="f2uint(reverseItem[1])"
            if cond="reverseNext <= reverseCursor"
              return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
            let name=reverseTarget value="reverseItem[0]"
            if cond="!Map.has(reverseVisited, String(reverseTarget))"
              do value="Map.set(reverseVisited, String(reverseTarget), true)"
              assign target=reverseDepth value="reverseDepth + 1"
              do value="Map.set(reverseStack, String(reverseDepth), reverseTarget)"
            assign target=reverseCursor value=reverseNext
            assign target=workSteps value="workSteps + 1"
        let name=sortedMembers value="f4bsortrows(memberIds, \"string\")"
        if cond="sortedMembers.length == 0"
          return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
        let name=componentMinimum value="sortedMembers[0]"
        let name=memberIdentityParts value="[]"
        for name=memberIndex from=0 to=sortedMembers.length
          let name=memberId value="sortedMembers[memberIndex]"
          do value="Map.set(componentOf, String(memberId), componentMinimum)"
          if cond="!Map.has(sealByModule, String(memberId))"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=memberRow value="f4item(memberId) + f4item(Map.get(sealByModule, String(memberId)))"
          do value="memberIdentityParts.push(f4item(memberRow))"
        do value="Map.set(componentMembers, String(componentMinimum), f4bfoldparts(memberIdentityParts))"
        do value="Map.set(componentSizes, String(componentMinimum), sortedMembers.length)"
        do value="componentMinimums.push(componentMinimum)"
    let name=canonicalComponents value="f4bsortrows(componentMinimums, \"string\")"

    let name=componentReason value="new Map()"
    for name=reasonSeedIndex from=0 to=canonicalModules.length
      let name=reasonModule value="canonicalModules[reasonSeedIndex]"
      if cond="!Map.has(statusByModule, String(reasonModule)) || !Map.has(componentOf, String(reasonModule))"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
      let name=reasonStatus value="Map.get(statusByModule, String(reasonModule))"
      let name=reasonComponent value="Map.get(componentOf, String(reasonModule))"
      if cond="reasonStatus != \"classified\""
        if cond="!Map.has(componentReason, String(reasonComponent))"
          do value="Map.set(componentReason, String(reasonComponent), reasonModule)"

    let name=componentOutdegree value="new Map()"
    let name=componentReverseParts value="new Map()"
    let name=componentEdgeSeen value="new Map()"
    for name=componentSeedIndex from=0 to=canonicalComponents.length
      do value="Map.set(componentOutdegree, String(canonicalComponents[componentSeedIndex]), 0)"
    for name=componentEdgeIndex from=0 to=uniqueEdges.length
      let name=componentEdge value="uniqueEdges[componentEdgeIndex]"
      let name=componentSourceModule value="f4browfield(componentEdge, 0)"
      let name=componentTargetModule value="f4browfield(componentEdge, 1)"
      if cond="!Map.has(componentOf, String(componentSourceModule)) || !Map.has(componentOf, String(componentTargetModule))"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
      let name=sourceComponent value="Map.get(componentOf, String(componentSourceModule))"
      let name=targetComponent value="Map.get(componentOf, String(componentTargetModule))"
      if cond="sourceComponent != targetComponent"
        let name=componentEdgeKey value="f4item(sourceComponent) + f4item(targetComponent)"
        if cond="!Map.has(componentEdgeSeen, String(componentEdgeKey))"
          do value="Map.set(componentEdgeSeen, String(componentEdgeKey), true)"
          if cond="!Map.has(componentOutdegree, String(sourceComponent))"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          do value="Map.set(componentOutdegree, String(sourceComponent), Map.get(componentOutdegree, String(sourceComponent)) + 1)"
          let name=priorImporters value="Map.has(componentReverseParts, String(targetComponent)) ? Map.get(componentReverseParts, String(targetComponent)) : \"\""
          do value="Map.set(componentReverseParts, String(targetComponent), priorImporters + f4item(sourceComponent))"
      assign target=workSteps value="workSteps + 1"

    let name=componentQueue value="new Map()"
    let name=componentQueueCount value=0
    for name=queueSeedIndex from=0 to=canonicalComponents.length
      let name=queueSeed value="canonicalComponents[queueSeedIndex]"
      if cond="!Map.has(componentOutdegree, String(queueSeed))"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
      if cond="Map.get(componentOutdegree, String(queueSeed)) == 0"
        do value="Map.set(componentQueue, String(componentQueueCount), queueSeed)"
        assign target=componentQueueCount value="componentQueueCount + 1"
    let name=componentQueueIndex value=0
    while cond="componentQueueIndex < componentQueueCount"
      let name=componentQueueKey value="String(componentQueueIndex)"
      if cond="!Map.has(componentQueue, componentQueueKey)"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
      let name=processedComponent value="Map.get(componentQueue, componentQueueKey)"
      let name=processedReason value="\"\""
      if cond="Map.has(componentReason, String(processedComponent))"
        assign target=processedReason value="Map.get(componentReason, String(processedComponent))"
      let name=importerTape value="Map.has(componentReverseParts, String(processedComponent)) ? Map.get(componentReverseParts, String(processedComponent)) : \"\""
      let name=importerCursor value=0
      while cond="importerCursor < Text.length(importerTape)"
        let name=importerItem value="f2batchmarked(importerTape, importerCursor, \"i\")"
        let name=importerNext value="f2uint(importerItem[1])"
        if cond="importerNext <= importerCursor"
          return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
        let name=importerComponent value="importerItem[0]"
        if cond="processedReason != \"\""
          if cond="!Map.has(componentReason, String(importerComponent))"
            do value="Map.set(componentReason, String(importerComponent), processedReason)"
          else
            let name=priorReason value="Map.get(componentReason, String(importerComponent))"
            if cond="processedReason < priorReason"
              do value="Map.set(componentReason, String(importerComponent), processedReason)"
        if cond="!Map.has(componentOutdegree, String(importerComponent))"
          return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
        let name=nextOutdegree value="Map.get(componentOutdegree, String(importerComponent)) - 1"
        do value="Map.set(componentOutdegree, String(importerComponent), nextOutdegree)"
        if cond="nextOutdegree == 0"
          do value="Map.set(componentQueue, String(componentQueueCount), importerComponent)"
          assign target=componentQueueCount value="componentQueueCount + 1"
        assign target=importerCursor value=importerNext
        assign target=workSteps value="workSteps + 1"
      assign target=componentQueueIndex value="componentQueueIndex + 1"
    if cond="componentQueueCount != canonicalComponents.length"
      return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"

    let name=rejectedParts value="[]"
    let name=blockedParts value="[]"
    let name=assignmentParts value="[]"
    for name=partitionIndex from=0 to=canonicalModules.length
      let name=partitionModule value="canonicalModules[partitionIndex]"
      if cond="!Map.has(statusByModule, String(partitionModule)) || !Map.has(componentOf, String(partitionModule))"
        return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
      let name=partitionStatus value="Map.get(statusByModule, String(partitionModule))"
      let name=partitionComponent value="Map.get(componentOf, String(partitionModule))"
      let name=assignmentRow value="f4item(partitionModule) + f4item(partitionComponent)"
      do value="assignmentParts.push(f4item(assignmentRow))"
      if cond="partitionStatus != \"classified\""
        if cond="!Map.has(sealByModule, String(partitionModule))"
          return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
        let name=rejectedRow value="f4item(partitionModule) + f4item(Map.get(sealByModule, String(partitionModule)))"
        do value="rejectedParts.push(f4item(rejectedRow))"
      else
        if cond="Map.has(componentReason, String(partitionComponent))"
          let name=blockedRow value="f4item(partitionModule) + f4item(Map.get(componentReason, String(partitionComponent)))"
          do value="blockedParts.push(f4item(blockedRow))"

    let name=componentParts value="[]"
    let name=cycleFactParts value="[]"
    let name=cycleColors value="new Map()"
    let name=cycleNodes value="new Map()"
    let name=cycleCursors value="new Map()"
    for name=visibleComponentIndex from=0 to=canonicalComponents.length
      let name=visibleComponent value="canonicalComponents[visibleComponentIndex]"
      if cond="!Map.has(componentReason, String(visibleComponent))"
        if cond="!Map.has(componentMembers, String(visibleComponent))"
          return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
        let name=visibleComponentRow value="f4item(visibleComponent) + f4item(Map.get(componentMembers, String(visibleComponent)))"
        do value="componentParts.push(f4item(visibleComponentRow))"
        let name=cycleCandidate value="\"\""
        do value="Map.set(cycleColors, String(visibleComponent), 1)"
        do value="Map.set(cycleNodes, \"0\", visibleComponent)"
        do value="Map.set(cycleCursors, \"0\", 0)"
        let name=cycleDepth value=0
        while cond="cycleDepth >= 0"
          let name=cycleDepthKey value="String(cycleDepth)"
          if cond="!Map.has(cycleNodes, cycleDepthKey) || !Map.has(cycleCursors, cycleDepthKey)"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=cycleNode value="Map.get(cycleNodes, cycleDepthKey)"
          let name=cycleCursor value="Map.get(cycleCursors, cycleDepthKey)"
          if cond="!Map.has(forwardAdjacency, String(cycleNode))"
            return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
          let name=cycleTape value="Map.get(forwardAdjacency, String(cycleNode))"
          if cond="cycleCursor >= Text.length(cycleTape)"
            do value="Map.set(cycleColors, String(cycleNode), 2)"
            assign target=cycleDepth value="cycleDepth - 1"
          else
            let name=cycleItem value="f2batchmarked(cycleTape, cycleCursor, \"i\")"
            let name=cycleNext value="f2uint(cycleItem[1])"
            if cond="cycleNext <= cycleCursor"
              return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
            do value="Map.set(cycleCursors, cycleDepthKey, cycleNext)"
            let name=cycleTarget value="cycleItem[0]"
            if cond="!Map.has(componentOf, String(cycleTarget))"
              return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
            if cond="Map.get(componentOf, String(cycleTarget)) == visibleComponent"
              if cond="!Map.has(cycleColors, String(cycleTarget))"
                do value="Map.set(cycleColors, String(cycleTarget), 1)"
                assign target=cycleDepth value="cycleDepth + 1"
                do value="Map.set(cycleNodes, String(cycleDepth), cycleTarget)"
                do value="Map.set(cycleCursors, String(cycleDepth), 0)"
              else
                if cond="Map.get(cycleColors, String(cycleTarget)) == 1"
                  let name=cycleEdgeKey value="f4item(cycleNode) + f4item(cycleTarget)"
                  if cond="!Map.has(edgeWitness, String(cycleEdgeKey))"
                    return value="[\"drift\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
                  let name=cycleEdge value="Map.get(edgeWitness, String(cycleEdgeKey))"
                  if cond="cycleCandidate == \"\" || f4browless(cycleEdge, cycleCandidate, \"edge-row\")"
                    assign target=cycleCandidate value=cycleEdge
            assign target=workSteps value="workSteps + 1"
        if cond="cycleCandidate != \"\""
          let name=cycleFact value="f4item(\"module-cycle\") + f4item(f4browfield(cycleCandidate, 1)) + f4item(f4browfield(cycleCandidate, 0)) + f4item(f4browfield(cycleCandidate, 2)) + f4item(f4browfield(cycleCandidate, 3))"
          do value="cycleFactParts.push(f4item(cycleFact))"

    if cond="workSteps > maxWorkSteps"
      return value="[\"limit\", \"\", \"\", \"\", \"\", \"\", String(workSteps)]"
    return value="[\"ok\", f4bfoldparts(rejectedParts), f4bfoldparts(blockedParts), f4bfoldparts(componentParts), f4bfoldparts(cycleFactParts), f4bfoldparts(assignmentParts), String(workSteps)]"
