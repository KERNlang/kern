fn name=f5recordordinals returns=string
  param name=limits type=string
  param name=entryFrames type="string[]"
  param name=order type="string[]"
  handler lang="kern"
    if cond="order.length == 2 && List.index(order, 0) == \"2\""
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", f5uint(List.index(order, 1)))"
    if cond="order.length != entryFrames.length + 2 || List.index(order, 0) != \"0\""
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", 0)"
    let name=header value="\"R\" + String(entryFrames.length) + \"{\""
    let name=instructionScalars value="Text.length(header) + 1"
    let name=work value="f5uint(List.index(order, entryFrames.length + 1))"
    let name=nodes value=1
    let name=depth value=1
    let name=maxCollection value=entryFrames.length
    let name=maxString value=0
    let name=firstLimit value="\"\""
    let name=previous value="\"\""
    for name=index from=0 to=entryFrames.length
      let name=ordinal value="f5uint(List.index(order, index + 1))"
      if cond="ordinal < 0 || ordinal >= entryFrames.length"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      let name=entryFrame value="List.index(entryFrames, ordinal)"
      let name=entry value="f5rowread(entryFrame)"
      assign target=work value="work + f5rowcodecwork(entryFrame, entry)"
      if cond="entry.length != 2"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      let name=key value="List.index(entry, 0)"
      if cond="index > 0"
        assign target=work value="work + f5scalarcomparework(previous, key)"
        if cond="!f5scalartextless(previous, key)"
          return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      assign target=previous value=key
      let name=childFrame value="List.index(entry, 1)"
      let name=child value="f5resultread(childFrame)"
      let name=validationResultReadWork value="Text.length(childFrame) + 1"
      assign target=work value="work + validationResultReadWork"
      if cond="child.length != 9"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      if cond="child[0] == \"2\""
        return value="f5resultfailure(\"2\", child[1], work)"
      if cond="child[0] != \"0\" && child[0] != \"1\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      if cond="child[0] == \"1\""
        if cond="firstLimit == \"\""
          assign target=firstLimit value=childFrame
      else
        let name=keyScalars value="2 + Text.length(String(Text.length(key))) + Text.length(key)"
        assign target=instructionScalars value="instructionScalars + keyScalars + f5uint(child[2])"
        assign target=work value="work + keyScalars + f5uint(child[2])"
        assign target=nodes value="nodes + f5uint(child[4])"
        if cond="f5uint(child[5]) + 1 > depth"
          assign target=depth value="f5uint(child[5]) + 1"
        if cond="f5uint(child[6]) > maxCollection"
          assign target=maxCollection value="f5uint(child[6])"
        if cond="Text.length(key) > maxString"
          assign target=maxString value="Text.length(key)"
        if cond="f5uint(child[7]) > maxString"
          assign target=maxString value="f5uint(child[7])"
    if cond="firstLimit != \"\""
      return value="f5resultfailure(\"1\", \"F5_LIMIT\", work)"
    let name=materializationWork value="Text.length(header) + 1"
    let name=lengthBuckets value="new Map()"
    do value="Map.set(lengthBuckets, \"0\", Text.length(header))"
    let name=lengthMax value=0
    for name=measureIndex from=0 to=entryFrames.length
      let name=measureOrdinal value="f5uint(List.index(order, measureIndex + 1))"
      let name=measureFrame value="List.index(entryFrames, measureOrdinal)"
      let name=measureEntry value="f5rowread(measureFrame)"
      let name=measureRowReadWork value="f5rowcodecwork(measureFrame, measureEntry)"
      let name=copyRowReadWork value="f5rowcodecwork(measureFrame, measureEntry)"
      assign target=materializationWork value="materializationWork + measureRowReadWork"
      if cond="measureEntry.length != 2"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work + materializationWork)"
      let name=measureChildFrame value="List.index(measureEntry, 1)"
      let name=measureChild value="f5resultread(measureChildFrame)"
      let name=measureResultReadWork value="Text.length(measureChildFrame) + 1"
      let name=copyResultReadWork value="Text.length(measureChildFrame) + 1"
      if cond="measureChild.length != 9 || measureChild[0] != \"0\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work + materializationWork + measureResultReadWork)"
      let name=measurePieceLength value="2 + Text.length(String(Text.length(List.index(measureEntry, 0)))) + Text.length(List.index(measureEntry, 0)) + f5uint(measureChild[2])"
      assign target=materializationWork value="materializationWork + measureResultReadWork + copyRowReadWork + copyResultReadWork + measurePieceLength"
      let name=lengthLevel value=0
      let name=combinedLength value=measurePieceLength
      let name=lengthPlaced value=false
      while cond="!lengthPlaced"
        let name=lengthKey value="String(lengthLevel)"
        if cond="Map.has(lengthBuckets, lengthKey) && Map.get(lengthBuckets, lengthKey) > 0"
          assign target=combinedLength value="Map.get(lengthBuckets, lengthKey) + combinedLength"
          assign target=materializationWork value="materializationWork + combinedLength"
          do value="Map.set(lengthBuckets, lengthKey, 0)"
          assign target=lengthLevel value="lengthLevel + 1"
        else
          do value="Map.set(lengthBuckets, lengthKey, combinedLength)"
          assign target=lengthPlaced value=true
      if cond="lengthLevel > lengthMax"
        assign target=lengthMax value=lengthLevel
    let name=endLengthLevel value=0
    let name=endLength value=1
    let name=endLengthPlaced value=false
    while cond="!endLengthPlaced"
      let name=endLengthKey value="String(endLengthLevel)"
      if cond="Map.has(lengthBuckets, endLengthKey) && Map.get(lengthBuckets, endLengthKey) > 0"
        assign target=endLength value="Map.get(lengthBuckets, endLengthKey) + endLength"
        assign target=materializationWork value="materializationWork + endLength"
        do value="Map.set(lengthBuckets, endLengthKey, 0)"
        assign target=endLengthLevel value="endLengthLevel + 1"
      else
        do value="Map.set(lengthBuckets, endLengthKey, endLength)"
        assign target=endLengthPlaced value=true
    if cond="endLengthLevel > lengthMax"
      assign target=lengthMax value=endLengthLevel
    let name=finishLength value=0
    let name=finishLengthLevel value=0
    while cond="finishLengthLevel <= lengthMax"
      let name=finishLengthKey value="String(finishLengthLevel)"
      if cond="Map.has(lengthBuckets, finishLengthKey) && Map.get(lengthBuckets, finishLengthKey) > 0"
        assign target=finishLength value="Map.get(lengthBuckets, finishLengthKey) + finishLength"
        assign target=materializationWork value="materializationWork + finishLength"
      assign target=finishLengthLevel value="finishLengthLevel + 1"
    assign target=work value="work + materializationWork"
    let name=gate value="f5resultgate(limits, instructionScalars, work, nodes, depth, maxCollection, maxString, instructionScalars)"
    if cond="!f5validuinttext(gate)"
      return value=gate
    let name=buckets value="new Map()"
    do value="Map.set(buckets, \"0\", header)"
    let name=maxLevel value=0
    for name=copyIndex from=0 to=entryFrames.length
      let name=copyOrdinal value="f5uint(List.index(order, copyIndex + 1))"
      let name=copyEntry value="f5rowread(List.index(entryFrames, copyOrdinal))"
      let name=copyChild value="f5resultread(List.index(copyEntry, 1))"
      let name=piece value="\"K\" + String(Text.length(List.index(copyEntry, 0))) + \":\" + List.index(copyEntry, 0) + List.index(copyChild, 8)"
      let name=pieceLevel value=0
      let name=combined value=piece
      let name=placed value=false
      while cond="!placed"
        let name=pieceKey value="String(pieceLevel)"
        if cond="Map.has(buckets, pieceKey)"
          let name=left value="Map.get(buckets, pieceKey)"
          if cond="left != \"\""
            assign target=combined value="left + combined"
            do value="Map.set(buckets, pieceKey, \"\")"
            assign target=pieceLevel value="pieceLevel + 1"
          else
            do value="Map.set(buckets, pieceKey, combined)"
            assign target=placed value=true
        else
          do value="Map.set(buckets, pieceKey, combined)"
          assign target=placed value=true
      if cond="pieceLevel > maxLevel"
        assign target=maxLevel value=pieceLevel
    let name=endLevel value=0
    let name=endCombined value="\"}\""
    let name=endPlaced value=false
    while cond="!endPlaced"
      let name=endKey value="String(endLevel)"
      if cond="Map.has(buckets, endKey)"
        let name=endLeft value="Map.get(buckets, endKey)"
        if cond="endLeft != \"\""
          assign target=endCombined value="endLeft + endCombined"
          do value="Map.set(buckets, endKey, \"\")"
          assign target=endLevel value="endLevel + 1"
        else
          do value="Map.set(buckets, endKey, endCombined)"
          assign target=endPlaced value=true
      else
        do value="Map.set(buckets, endKey, endCombined)"
        assign target=endPlaced value=true
    if cond="endLevel > maxLevel"
      assign target=maxLevel value=endLevel
    let name=text value="\"\""
    let name=finishLevel value=0
    while cond="finishLevel <= maxLevel"
      let name=finishKey value="String(finishLevel)"
      if cond="Map.has(buckets, finishKey)"
        let name=finishPiece value="Map.get(buckets, finishKey)"
        if cond="finishPiece != \"\""
          assign target=text value="finishPiece + text"
      assign target=finishLevel value="finishLevel + 1"
    return value="f5resultcommit(instructionScalars, f5uint(gate), nodes, depth, maxCollection, maxString, text)"

fn name=f5listordinals returns=string
  param name=limits type=string
  param name=entryFrames type="string[]"
  param name=order type="string[]"
  handler lang="kern"
    if cond="order.length == 2 && List.index(order, 0) == \"2\""
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", f5uint(List.index(order, 1)))"
    if cond="order.length != entryFrames.length + 2 || List.index(order, 0) != \"0\""
      return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", 0)"
    let name=header value="\"L\" + String(entryFrames.length) + \"[\""
    let name=instructionScalars value="Text.length(header) + 1"
    let name=work value="f5uint(List.index(order, entryFrames.length + 1))"
    let name=nodes value=1
    let name=depth value=1
    let name=maxCollection value=entryFrames.length
    let name=maxString value=0
    let name=firstLimit value="\"\""
    for name=index from=0 to=entryFrames.length
      let name=ordinal value="f5uint(List.index(order, index + 1))"
      if cond="ordinal < 0 || ordinal >= entryFrames.length"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      let name=entryFrame value="List.index(entryFrames, ordinal)"
      let name=entry value="f5rowread(entryFrame)"
      assign target=work value="work + f5rowcodecwork(entryFrame, entry)"
      if cond="entry.length != 2"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      let name=childFrame value="List.index(entry, 1)"
      let name=child value="f5resultread(childFrame)"
      let name=validationResultReadWork value="Text.length(childFrame) + 1"
      assign target=work value="work + validationResultReadWork"
      if cond="child.length != 9"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      if cond="child[0] == \"2\""
        return value="f5resultfailure(\"2\", child[1], work)"
      if cond="child[0] != \"0\" && child[0] != \"1\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work)"
      if cond="child[0] == \"1\""
        if cond="firstLimit == \"\""
          assign target=firstLimit value=childFrame
      else
        assign target=instructionScalars value="instructionScalars + f5uint(child[2])"
        assign target=work value="work + f5uint(child[2])"
        assign target=nodes value="nodes + f5uint(child[4])"
        if cond="f5uint(child[5]) + 1 > depth"
          assign target=depth value="f5uint(child[5]) + 1"
        if cond="f5uint(child[6]) > maxCollection"
          assign target=maxCollection value="f5uint(child[6])"
        if cond="f5uint(child[7]) > maxString"
          assign target=maxString value="f5uint(child[7])"
    if cond="firstLimit != \"\""
      return value="f5resultfailure(\"1\", \"F5_LIMIT\", work)"
    let name=materializationWork value="Text.length(header) + 1"
    let name=lengthBuckets value="new Map()"
    do value="Map.set(lengthBuckets, \"0\", Text.length(header))"
    let name=lengthMax value=0
    for name=measureIndex from=0 to=entryFrames.length
      let name=measureOrdinal value="f5uint(List.index(order, measureIndex + 1))"
      let name=measureFrame value="List.index(entryFrames, measureOrdinal)"
      let name=measureEntry value="f5rowread(measureFrame)"
      let name=measureRowReadWork value="f5rowcodecwork(measureFrame, measureEntry)"
      let name=copyRowReadWork value="f5rowcodecwork(measureFrame, measureEntry)"
      assign target=materializationWork value="materializationWork + measureRowReadWork"
      if cond="measureEntry.length != 2"
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work + materializationWork)"
      let name=measureChildFrame value="List.index(measureEntry, 1)"
      let name=measureChild value="f5resultread(measureChildFrame)"
      let name=measureResultReadWork value="Text.length(measureChildFrame) + 1"
      let name=copyResultReadWork value="Text.length(measureChildFrame) + 1"
      if cond="measureChild.length != 9 || measureChild[0] != \"0\""
        return value="f5resultfailure(\"2\", \"F5_F4_DRIFT\", work + materializationWork + measureResultReadWork)"
      assign target=materializationWork value="materializationWork + measureResultReadWork + copyRowReadWork + copyResultReadWork + f5uint(measureChild[2])"
      let name=lengthLevel value=0
      let name=combinedLength value="f5uint(measureChild[2])"
      let name=lengthPlaced value=false
      while cond="!lengthPlaced"
        let name=lengthKey value="String(lengthLevel)"
        if cond="Map.has(lengthBuckets, lengthKey) && Map.get(lengthBuckets, lengthKey) > 0"
          assign target=combinedLength value="Map.get(lengthBuckets, lengthKey) + combinedLength"
          assign target=materializationWork value="materializationWork + combinedLength"
          do value="Map.set(lengthBuckets, lengthKey, 0)"
          assign target=lengthLevel value="lengthLevel + 1"
        else
          do value="Map.set(lengthBuckets, lengthKey, combinedLength)"
          assign target=lengthPlaced value=true
      if cond="lengthLevel > lengthMax"
        assign target=lengthMax value=lengthLevel
    let name=endLengthLevel value=0
    let name=endLength value=1
    let name=endLengthPlaced value=false
    while cond="!endLengthPlaced"
      let name=endLengthKey value="String(endLengthLevel)"
      if cond="Map.has(lengthBuckets, endLengthKey) && Map.get(lengthBuckets, endLengthKey) > 0"
        assign target=endLength value="Map.get(lengthBuckets, endLengthKey) + endLength"
        assign target=materializationWork value="materializationWork + endLength"
        do value="Map.set(lengthBuckets, endLengthKey, 0)"
        assign target=endLengthLevel value="endLengthLevel + 1"
      else
        do value="Map.set(lengthBuckets, endLengthKey, endLength)"
        assign target=endLengthPlaced value=true
    if cond="endLengthLevel > lengthMax"
      assign target=lengthMax value=endLengthLevel
    let name=finishLength value=0
    let name=finishLengthLevel value=0
    while cond="finishLengthLevel <= lengthMax"
      let name=finishLengthKey value="String(finishLengthLevel)"
      if cond="Map.has(lengthBuckets, finishLengthKey) && Map.get(lengthBuckets, finishLengthKey) > 0"
        assign target=finishLength value="Map.get(lengthBuckets, finishLengthKey) + finishLength"
        assign target=materializationWork value="materializationWork + finishLength"
      assign target=finishLengthLevel value="finishLengthLevel + 1"
    assign target=work value="work + materializationWork"
    let name=gate value="f5resultgate(limits, instructionScalars, work, nodes, depth, maxCollection, maxString, instructionScalars)"
    if cond="!f5validuinttext(gate)"
      return value=gate
    let name=buckets value="new Map()"
    do value="Map.set(buckets, \"0\", header)"
    let name=maxLevel value=0
    for name=copyIndex from=0 to=entryFrames.length
      let name=copyOrdinal value="f5uint(List.index(order, copyIndex + 1))"
      let name=copyEntry value="f5rowread(List.index(entryFrames, copyOrdinal))"
      let name=copyChild value="f5resultread(List.index(copyEntry, 1))"
      let name=pieceLevel value=0
      let name=combined value="List.index(copyChild, 8)"
      let name=placed value=false
      while cond="!placed"
        let name=pieceKey value="String(pieceLevel)"
        if cond="Map.has(buckets, pieceKey)"
          let name=left value="Map.get(buckets, pieceKey)"
          if cond="left != \"\""
            assign target=combined value="left + combined"
            do value="Map.set(buckets, pieceKey, \"\")"
            assign target=pieceLevel value="pieceLevel + 1"
          else
            do value="Map.set(buckets, pieceKey, combined)"
            assign target=placed value=true
        else
          do value="Map.set(buckets, pieceKey, combined)"
          assign target=placed value=true
      if cond="pieceLevel > maxLevel"
        assign target=maxLevel value=pieceLevel
    let name=endLevel value=0
    let name=endCombined value="\"]\""
    let name=endPlaced value=false
    while cond="!endPlaced"
      let name=endKey value="String(endLevel)"
      if cond="Map.has(buckets, endKey)"
        let name=endLeft value="Map.get(buckets, endKey)"
        if cond="endLeft != \"\""
          assign target=endCombined value="endLeft + endCombined"
          do value="Map.set(buckets, endKey, \"\")"
          assign target=endLevel value="endLevel + 1"
        else
          do value="Map.set(buckets, endKey, endCombined)"
          assign target=endPlaced value=true
      else
        do value="Map.set(buckets, endKey, endCombined)"
        assign target=endPlaced value=true
    if cond="endLevel > maxLevel"
      assign target=maxLevel value=endLevel
    let name=text value="\"\""
    let name=finishLevel value=0
    while cond="finishLevel <= maxLevel"
      let name=finishKey value="String(finishLevel)"
      if cond="Map.has(buckets, finishKey)"
        let name=finishPiece value="Map.get(buckets, finishKey)"
        if cond="finishPiece != \"\""
          assign target=text value="finishPiece + text"
      assign target=finishLevel value="finishLevel + 1"
    return value="f5resultcommit(instructionScalars, f5uint(gate), nodes, depth, maxCollection, maxString, text)"
