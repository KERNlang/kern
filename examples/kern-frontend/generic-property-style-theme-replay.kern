fn name=stylethemereplayfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  param name=content type=string
  param name=runtimeInstance type=number
  param name=parseEpoch type=number
  param name=replayFormat type=string
  param name=maxReplayFields type=number
  param name=maxEnvelopeBytes type=number
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(replayFormat)"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    do value="out.push(content)"
    for name=padding from=0 to=18
      do value="out.push(\"\")"
    do value="out.push(\"failure-seal\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    do value="out.push(content)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    for name=sealPadding from=0 to=18
      do value="out.push(\"\")"
    if cond="out.length > maxReplayFields"
      return value="[]"
    let name=envelopeBytes value="0"
    for name=envelopeField from=0 to="out.length"
      assign target=envelopeBytes value="envelopeBytes + utf8bytes(out[envelopeField])"
    if cond="envelopeBytes > maxEnvelopeBytes"
      return value="[]"
    return value="out"

fn name=replaygenericpropertystyletheme returns="string[]"
  param name=content type=string
  param name=stream type="string[]"
  param name=state type=string
  param name=knownState type=string
  param name=admittedType type=string
  param name=predecessorState type=string
  param name=runtimeInstance type=number
  param name=parseEpoch type=number
  param name=maxProperties type=number
  param name=maxThemes type=number
  param name=maxStyles type=number
  param name=maxBlockCodePoints type=number
  param name=maxBlockUtf16Units type=number
  param name=maxBlockBytes type=number
  param name=maxSegments type=number
  param name=maxPairs type=number
  param name=maxStyleWrites type=number
  param name=maxParenDepth type=number
  param name=maxReplayFields type=number
  param name=maxEnvelopeBytes type=number
  param name=streamFormat type=string
  param name=styleFormat type=string
  param name=replayFormat type=string
  handler lang="kern"
    if cond="maxProperties <= 0 || maxThemes <= 0 || maxStyles <= 0 || maxBlockCodePoints <= 0 || maxBlockUtf16Units <= 0 || maxBlockBytes <= 0 || maxSegments <= 0 || maxPairs <= 0 || maxStyleWrites <= 0 || maxParenDepth <= 0 || maxReplayFields <= 0 || maxEnvelopeBytes <= 0"
      let name=invalidLimitsFailure value="stylethemereplayfailure(\"STYLE_INVALID_LIMITS\", \"\", content, runtimeInstance, parseEpoch, replayFormat, maxReplayFields, maxEnvelopeBytes)"
      return value="invalidLimitsFailure"

    let name=tokenKinds value="[]"
    let name=tokenValues value="[]"
    let name=tokenStarts value="[]"
    let name=streamValid value="true"
    let name=streamSealed value="false"
    let name=streamPhase value="\"token\""
    let name=diagnosticCount value="0"
    let name=tokenStart value="0"
    if cond="stream.length < 11 || stream[0] != streamFormat || (stream.length - 1) % 10 != 0 || stream[1] == \"failure\""
      assign target=streamValid value="false"
    else
      if cond="stream.length < 31 || stream[1] != \"stream\" || stream[2] != \"0\" || stream[3] != content"
        assign target=streamValid value="false"
      else
        for name=recordStart from=11 to="stream.length" step=10
          let name=recordTag value="stream[recordStart]"
          if cond="recordTag == \"token\""
            if cond="streamPhase != \"token\" || stream[recordStart + 1] != String(tokenKinds.length) || stream[recordStart + 9] != \"\""
              assign target=streamValid value="false"
            do value="tokenKinds.push(stream[recordStart + 2])"
            do value="tokenValues.push(stream[recordStart + 3])"
            assign target=tokenStart value="tokenStart + utf16units(stream[recordStart + 4])"
            do value="tokenStarts.push(tokenStart)"
          else
            if cond="recordTag == \"diagnostic\""
              assign target=streamPhase value="\"diagnostic\""
              if cond="stream[recordStart + 1] != String(diagnosticCount) || stream[recordStart + 9] != \"\""
                assign target=streamValid value="false"
              assign target=diagnosticCount value="diagnosticCount + 1"
            else
              if cond="recordTag == \"seal\""
                if cond="recordStart != stream.length - 10 || streamSealed || stream[recordStart + 1] != String(tokenKinds.length) || stream[recordStart + 2] != String(diagnosticCount) || stream[recordStart + 7] != content"
                  assign target=streamValid value="false"
                assign target=streamSealed value="true"
                assign target=streamPhase value="\"seal\""
              else
                assign target=streamValid value="false"
    if cond="!streamValid || !streamSealed"
      let name=invalidStreamFailure value="stylethemereplayfailure(\"STYLE_INVALID\", \"\", content, runtimeInstance, parseEpoch, replayFormat, maxReplayFields, maxEnvelopeBytes)"
      return value="invalidStreamFailure"

    let name=transitionRecords value="[]"
    let name=styleEvidenceRecords value="[]"
    let name=propertyFinalKeys value="[]"
    let name=propertyWriteKeys value="[]"
    let name=propertyWriteQuoted value="[]"
    let name=propertyWriteQuoteGenerations value="[]"
    let name=styleKeys value="[]"
    let name=pseudoNames value="[]"
    let name=pseudoEntryPseudos value="[]"
    let name=pseudoEntryKeys value="[]"
    let name=styleWriteKinds value="[]"
    let name=styleWritePseudos value="[]"
    let name=styleWriteKeys value="[]"
    let name=styleWriteValues value="[]"
    let name=styleWriteVisible value="[]"
    let name=propertyCount value="0"
    let name=themeCount value="0"
    let name=styleCount value="0"
    let name=segmentCount value="0"
    let name=pairCount value="0"
    let name=styleWriteCount value="0"
    let name=transitionCount value="0"
    let name=firstStyleCursorText value="\"none\""
    let name=failureCode value="\"\""
    let name=cursor value="0"

    if cond="state != \"dropped\""
      if cond="tokenKinds.length == 0 || tokenKinds[0] != \"identifier\" || tokenValues[0] != admittedType"
        assign target=failureCode value="\"STYLE_INVALID\""
      else
        let name=realTokenCount value="tokenKinds.length"
        do value="tokenKinds.push(\"whitespace\")"
        do value="tokenValues.push(\"\")"
        do value="tokenStarts.push(tokenStart)"
        let name=propertyPhase value="\"handoff\""
        let name=cursorBefore value="1"
        let name=propertyIndex value="0"
        let name=propertyStart value="0"
        let name=equalsIndex value="0"
        let name=key value="\"\""
        let name=valueIndexText value="\"none\""
        let name=valueKind value="\"empty\""
        let name=propertyValue value="\"\""
        let name=isQuoted value="false"
        let name=consumedCount value="0"
        for name=tokenIndex from=1 to="tokenKinds.length"
          let name=tokenKind value="tokenKinds[tokenIndex]"
          if cond="failureCode != \"\""
            assign target=tokenKind value="\"whitespace\""
            assign target=propertyPhase value="\"handoff\""
          let name=propertyReady value="false"
          let name=themeReady value="false"
          let name=styleReady value="false"
          if cond="propertyPhase == \"handoff\""
            if cond="tokenKind == \"style\""
              assign target=styleReady value="true"
            else
              if cond="tokenKind == \"themeRef\""
                assign target=themeReady value="true"
              else
                if cond="tokenKind != \"whitespace\""
                  if cond="tokenKind != \"identifier\""
                    assign target=failureCode value="\"STYLE_PROFILE\""
                  else
                    assign target=propertyIndex value="tokenIndex"
                    assign target=propertyStart value="tokenStarts[tokenIndex]"
                    assign target=key value="tokenValues[tokenIndex]"
                    assign target=propertyPhase value="\"equals\""
          else
            if cond="propertyPhase == \"equals\""
              if cond="tokenKind != \"equals\""
                assign target=failureCode value="\"STYLE_PROFILE\""
              else
                assign target=equalsIndex value="tokenIndex"
                assign target=propertyPhase value="\"value\""
            else
              if cond="propertyPhase == \"value\""
                if cond="tokenIndex < realTokenCount"
                  assign target=valueIndexText value="String(tokenIndex)"
                if cond="tokenKind == \"whitespace\""
                  assign target=cursor value="tokenIndex"
                  assign target=propertyReady value="true"
                else
                  if cond="tokenKind == \"style\" || tokenKind == \"themeRef\""
                    assign target=valueKind value="\"bare\""
                    assign target=cursor value="tokenIndex"
                    assign target=propertyReady value="true"
                    assign target=styleReady value="tokenKind == \"style\""
                    assign target=themeReady value="tokenKind == \"themeRef\""
                  else
                    if cond="tokenKind == \"quoted\" || tokenKind == \"expr\""
                      assign target=valueKind value="tokenKind"
                      assign target=propertyValue value="tokenValues[tokenIndex]"
                      assign target=isQuoted value="tokenKind == \"quoted\""
                      assign target=consumedCount value="1"
                      assign target=cursor value="tokenIndex + 1"
                      assign target=propertyReady value="true"
                    else
                      assign target=valueKind value="\"bare\""
                      assign target=propertyValue value="tokenValues[tokenIndex]"
                      assign target=consumedCount value="1"
                      assign target=cursor value="tokenIndex + 1"
                      assign target=propertyPhase value="\"bare\""
              else
                if cond="propertyPhase == \"bare\""
                  if cond="tokenKind == \"whitespace\""
                    assign target=cursor value="tokenIndex"
                    assign target=propertyReady value="true"
                  else
                    if cond="tokenKind == \"style\" || tokenKind == \"themeRef\""
                      assign target=cursor value="tokenIndex"
                      assign target=propertyReady value="true"
                      assign target=styleReady value="tokenKind == \"style\""
                      assign target=themeReady value="tokenKind == \"themeRef\""
                    else
                      assign target=propertyValue value="propertyValue + tokenValues[tokenIndex]"
                      assign target=consumedCount value="consumedCount + 1"
                      assign target=cursor value="tokenIndex + 1"

          if cond="propertyReady && failureCode == \"\""
            if cond="propertyCount >= maxProperties"
              assign target=failureCode value="\"THEME_LIMIT\""
            else
              let name=uniqueIndex value="-1"
              for name=searchIndex from=0 to="propertyFinalKeys.length"
                if cond="propertyFinalKeys[searchIndex] == key"
                  assign target=uniqueIndex value="searchIndex"
              let name=isDuplicate value="uniqueIndex >= 0"
              let name=diagnosticIndexText value="\"none\""
              let name=diagnosticColText value="\"none\""
              let name=diagnosticEndColText value="\"none\""
              if cond="isDuplicate"
                assign target=diagnosticIndexText value="String(propertyCount - propertyFinalKeys.length)"
                assign target=diagnosticColText value="String(1 + propertyStart)"
                assign target=diagnosticEndColText value="String(1 + propertyStart + utf16units(key))"
              else
                assign target=uniqueIndex value="propertyFinalKeys.length"
                do value="propertyFinalKeys.push(key)"
              let name=quoteGeneration value="0"
              if cond="isQuoted"
                assign target=quoteGeneration value="propertyCount + 1"
                let name=priorQuoted value="\"false\""
                let name=priorQuoteGeneration value="0"
                for name=priorIndex from=0 to="propertyWriteKeys.length"
                  if cond="propertyWriteKeys[priorIndex] == key"
                    assign target=priorQuoted value="propertyWriteQuoted[priorIndex]"
                    assign target=priorQuoteGeneration value="propertyWriteQuoteGenerations[priorIndex]"
                if cond="priorQuoted == \"true\""
                  assign target=quoteGeneration value="priorQuoteGeneration"
              do value="propertyWriteKeys.push(key)"
              do value="propertyWriteQuoted.push(String(isQuoted))"
              do value="propertyWriteQuoteGenerations.push(quoteGeneration)"
              do value="transitionRecords.push(\"property-write\")"
              do value="transitionRecords.push(String(transitionCount))"
              do value="transitionRecords.push(String(propertyCount))"
              do value="transitionRecords.push(key)"
              do value="transitionRecords.push(valueKind)"
              do value="transitionRecords.push(propertyValue)"
              do value="transitionRecords.push(String(isQuoted))"
              do value="transitionRecords.push(String(isDuplicate))"
              do value="transitionRecords.push(String(cursorBefore))"
              do value="transitionRecords.push(String(propertyIndex))"
              do value="transitionRecords.push(String(equalsIndex))"
              do value="transitionRecords.push(valueIndexText)"
              do value="transitionRecords.push(String(cursor))"
              do value="transitionRecords.push(String(consumedCount))"
              do value="transitionRecords.push(diagnosticIndexText)"
              do value="transitionRecords.push(diagnosticColText)"
              do value="transitionRecords.push(diagnosticEndColText)"
              do value="transitionRecords.push(String(uniqueIndex))"
              do value="transitionRecords.push(String(quoteGeneration))"
              for name=propertyPadding from=0 to=5
                do value="transitionRecords.push(\"\")"
              assign target=propertyCount value="propertyCount + 1"
              assign target=transitionCount value="transitionCount + 1"
              assign target=cursorBefore value="cursor"
              assign target=propertyPhase value="\"handoff\""
              assign target=key value="\"\""
              assign target=valueIndexText value="\"none\""
              assign target=valueKind value="\"empty\""
              assign target=propertyValue value="\"\""
              assign target=isQuoted value="false"
              assign target=consumedCount value="0"

          if cond="styleReady && failureCode == \"\""
            if cond="styleCount >= maxStyles"
              assign target=failureCode value="\"STYLE_TOKEN_LIMIT\""
            else
              let name=styleEvidence value="observestyleblockvalue(tokenValues[tokenIndex], styleCount, tokenIndex, tokenStarts[tokenIndex], segmentCount, pairCount, styleWriteCount, maxBlockCodePoints, maxBlockUtf16Units, maxBlockBytes, maxSegments, maxPairs, maxStyleWrites, maxParenDepth, styleFormat)"
              if cond="styleEvidence.length < 49 || styleEvidence[0] != styleFormat || (styleEvidence.length - 1) % 24 != 0"
                assign target=failureCode value="\"STYLE_INVALID\""
              else
                if cond="styleEvidence[1] == \"failure\""
                  assign target=failureCode value="styleEvidence[2]"
                else
                  let name=localSegments value="styleuint(styleEvidence[6])"
                  let name=localPairs value="styleuint(styleEvidence[7])"
                  let name=localWrites value="styleuint(styleEvidence[8])"
                  if cond="styleEvidence[1] != \"decision\" || styleEvidence[2] != String(styleCount) || styleEvidence[3] != String(tokenIndex) || styleEvidence[4] != String(tokenStarts[tokenIndex]) || styleEvidence[5] != tokenValues[tokenIndex] || styleEvidence.length != 1 + (2 + localSegments + localPairs + localWrites) * 24"
                    assign target=failureCode value="\"STYLE_INVALID\""
                  else
                    if cond="firstStyleCursorText == \"none\""
                      assign target=firstStyleCursorText value="String(tokenIndex)"
                    do value="transitionRecords.push(\"style\")"
                    do value="transitionRecords.push(String(transitionCount))"
                    do value="transitionRecords.push(String(styleCount))"
                    do value="transitionRecords.push(String(tokenIndex))"
                    do value="transitionRecords.push(String(tokenStarts[tokenIndex]))"
                    do value="transitionRecords.push(tokenValues[tokenIndex])"
                    do value="transitionRecords.push(String(tokenIndex))"
                    do value="transitionRecords.push(String(tokenIndex + 1))"
                    do value="transitionRecords.push(String(segmentCount))"
                    do value="transitionRecords.push(String(localSegments))"
                    do value="transitionRecords.push(String(pairCount))"
                    do value="transitionRecords.push(String(localPairs))"
                    do value="transitionRecords.push(String(styleWriteCount))"
                    do value="transitionRecords.push(String(localWrites))"
                    for name=stylePadding from=0 to=10
                      do value="transitionRecords.push(\"\")"
                    let name=styleSealSeen value="false"
                    for name=styleRecordStart from=25 to="styleEvidence.length" step=24
                      let name=tag value="styleEvidence[styleRecordStart]"
                      if cond="tag == \"seal\""
                        if cond="styleRecordStart != styleEvidence.length - 24 || styleEvidence[styleRecordStart + 1] != String(styleCount) || styleEvidence[styleRecordStart + 2] != String(tokenIndex)"
                          assign target=failureCode value="\"STYLE_INVALID\""
                        assign target=styleSealSeen value="true"
                      else
                        if cond="tag != \"segment\" && tag != \"pair\" && tag != \"style-write\""
                          assign target=failureCode value="\"STYLE_INVALID\""
                        for name=field from=0 to=24
                          do value="styleEvidenceRecords.push(styleEvidence[styleRecordStart + field])"
                      if cond="tag == \"style-write\""
                        let name=targetKind value="styleEvidence[styleRecordStart + 6]"
                        let name=pseudo value="styleEvidence[styleRecordStart + 7]"
                        let name=styleKey value="styleEvidence[styleRecordStart + 8]"
                        let name=styleValue value="styleEvidence[styleRecordStart + 9]"
                        let name=visible value="styleEvidence[styleRecordStart + 10] == \"true\""
                        do value="styleWriteKinds.push(targetKind)"
                        do value="styleWritePseudos.push(pseudo)"
                        do value="styleWriteKeys.push(styleKey)"
                        do value="styleWriteValues.push(styleValue)"
                        do value="styleWriteVisible.push(String(visible))"
                        if cond="targetKind == \"style\" && visible"
                          let name=found value="-1"
                          for name=searchIndex from=0 to="styleKeys.length"
                            if cond="styleKeys[searchIndex] == styleKey"
                              assign target=found value="searchIndex"
                          if cond="found < 0"
                            do value="styleKeys.push(styleKey)"
                        if cond="targetKind == \"pseudo\" && pseudo != \"constructor\""
                          let name=pseudoFound value="false"
                          for name=pseudoIndex from=0 to="pseudoNames.length"
                            if cond="pseudoNames[pseudoIndex] == pseudo"
                              assign target=pseudoFound value="true"
                          if cond="!pseudoFound"
                            do value="pseudoNames.push(pseudo)"
                          if cond="visible"
                            let name=found value="-1"
                            for name=searchIndex from=0 to="pseudoEntryKeys.length"
                              if cond="pseudoEntryPseudos[searchIndex] == pseudo && pseudoEntryKeys[searchIndex] == styleKey"
                                assign target=found value="searchIndex"
                            if cond="found < 0"
                              do value="pseudoEntryPseudos.push(pseudo)"
                              do value="pseudoEntryKeys.push(styleKey)"
                    if cond="!styleSealSeen"
                      assign target=failureCode value="\"STYLE_INVALID\""
                    assign target=segmentCount value="segmentCount + localSegments"
                    assign target=pairCount value="pairCount + localPairs"
                    assign target=styleWriteCount value="styleWriteCount + localWrites"
                    assign target=styleCount value="styleCount + 1"
                    assign target=transitionCount value="transitionCount + 1"
                    assign target=cursor value="tokenIndex + 1"
                    assign target=cursorBefore value="cursor"

          if cond="themeReady && failureCode == \"\""
            if cond="themeCount >= maxThemes"
              assign target=failureCode value="\"THEME_LIMIT\""
            else
              do value="transitionRecords.push(\"theme\")"
              do value="transitionRecords.push(String(transitionCount))"
              do value="transitionRecords.push(String(themeCount))"
              do value="transitionRecords.push(String(tokenIndex))"
              do value="transitionRecords.push(tokenValues[tokenIndex])"
              do value="transitionRecords.push(String(tokenIndex))"
              do value="transitionRecords.push(String(tokenIndex + 1))"
              for name=themePadding from=0 to=17
                do value="transitionRecords.push(\"\")"
              assign target=themeCount value="themeCount + 1"
              assign target=transitionCount value="transitionCount + 1"
              assign target=cursor value="tokenIndex + 1"
              assign target=cursorBefore value="cursor"

    if cond="failureCode == \"\" && state != \"dropped\""
      if cond="styleCount == 0 && predecessorState != \"success\""
        assign target=failureCode value="\"STYLE_INVALID\""
      if cond="styleCount > 0 && predecessorState != \"expected-profile\""
        assign target=failureCode value="\"STYLE_INVALID\""
    if cond="failureCode != \"\""
      let name=replayFailure value="stylethemereplayfailure(failureCode, \"\", content, runtimeInstance, parseEpoch, replayFormat, maxReplayFields, maxEnvelopeBytes)"
      return value="replayFailure"

    let name=finalRecords value="stylefinalrecords(styleKeys, pseudoNames, pseudoEntryPseudos, pseudoEntryKeys, styleWriteKinds, styleWritePseudos, styleWriteKeys, styleWriteValues, styleWriteVisible)"
    let name=out value="[]"
    do value="out.push(replayFormat)"
    do value="out.push(\"decision\")"
    do value="out.push(state)"
    do value="out.push(knownState)"
    do value="out.push(admittedType)"
    do value="out.push(String(transitionCount))"
    do value="out.push(String(propertyCount))"
    do value="out.push(String(themeCount))"
    do value="out.push(String(styleCount))"
    do value="out.push(String(segmentCount))"
    do value="out.push(String(pairCount))"
    do value="out.push(String(styleWriteCount))"
    do value="out.push(String(styleKeys.length))"
    do value="out.push(String(pseudoNames.length))"
    do value="out.push(String(pseudoEntryKeys.length))"
    do value="out.push(String(cursor))"
    if cond="state == \"dropped\""
      do value="out.push(\"dropped\")"
    else
      do value="out.push(\"eof\")"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    do value="out.push(firstStyleCursorText)"
    do value="out.push(predecessorState)"
    do value="out.push(styleFormat)"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    for name=transitionField from=0 to="transitionRecords.length"
      do value="out.push(transitionRecords[transitionField])"
    for name=evidenceField from=0 to="styleEvidenceRecords.length"
      do value="out.push(styleEvidenceRecords[evidenceField])"
    for name=finalField from=0 to="finalRecords.length"
      do value="out.push(finalRecords[finalField])"
    do value="out.push(\"seal\")"
    do value="out.push(state)"
    do value="out.push(knownState)"
    do value="out.push(admittedType)"
    do value="out.push(String(transitionCount))"
    do value="out.push(String(propertyCount))"
    do value="out.push(String(themeCount))"
    do value="out.push(String(styleCount))"
    do value="out.push(String(segmentCount))"
    do value="out.push(String(pairCount))"
    do value="out.push(String(styleWriteCount))"
    do value="out.push(String(styleKeys.length))"
    do value="out.push(String(pseudoNames.length))"
    do value="out.push(String(pseudoEntryKeys.length))"
    do value="out.push(String(cursor))"
    do value="out.push(content)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    do value="out.push(firstStyleCursorText)"
    do value="out.push(predecessorState)"
    do value="out.push(styleFormat)"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    if cond="out.length > maxReplayFields"
      let name=fieldLimitFailure value="stylethemereplayfailure(\"STYLE_ENVELOPE_FIELDS_LIMIT\", \"\", content, runtimeInstance, parseEpoch, replayFormat, maxReplayFields, maxEnvelopeBytes)"
      return value="fieldLimitFailure"
    let name=envelopeBytes value="0"
    for name=envelopeField from=0 to="out.length"
      assign target=envelopeBytes value="envelopeBytes + utf8bytes(out[envelopeField])"
    if cond="envelopeBytes > maxEnvelopeBytes"
      let name=byteLimitFailure value="stylethemereplayfailure(\"STYLE_ENVELOPE_BYTES_LIMIT\", \"\", content, runtimeInstance, parseEpoch, replayFormat, maxReplayFields, maxEnvelopeBytes)"
      return value="byteLimitFailure"
    return value="out"
