fn name=keywordtrimspace returns=boolean
  param name=ch type=string
  handler lang="kern"
    return value="ch == \" \" || ch == \"\\t\" || ch == \"\\n\" || ch == \"\\r\""

fn name=keywordtrim returns=string
  param name=value type=string
  handler lang="kern"
    let name=start value="0"
    let name=end value="Text.length(value)"
    while cond="start < end && keywordtrimspace(Text.charAt(value, start))"
      assign target=start value="start + 1"
    while cond="end > start && keywordtrimspace(Text.charAt(value, end - 1))"
      assign target=end value="end - 1"
    return value="Text.slice(value, start, end)"

fn name=keywordverb returns=string
  param name=value type=string
  handler lang="kern"
    if cond="value == \"GET\" || value == \"get\""
      return value="\"get\""
    if cond="value == \"POST\" || value == \"post\""
      return value="\"post\""
    if cond="value == \"PUT\" || value == \"put\""
      return value="\"put\""
    if cond="value == \"DELETE\" || value == \"delete\""
      return value="\"delete\""
    if cond="value == \"PATCH\" || value == \"patch\""
      return value="\"patch\""
    if cond="value == \"HEAD\" || value == \"head\""
      return value="\"head\""
    if cond="value == \"OPTIONS\" || value == \"options\""
      return value="\"options\""
    return value="\"\""

fn name=observekeywordhandlers returns="string[]"
  param name=content type=string
  param name=upstreamType type=string
  param name=upstreamCursor type=number
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxStreamRecords type=number
  param name=maxLexicalDepth type=number
  param name=format type=string
  param name=streamFormat type=string
  param name=maxWrites type=number
  param name=maxFields type=number
  param name=maxBytes type=number
  handler lang="kern"
    let name=stream value="observeretainedtokenstream(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth)"
    if cond="stream.length < 31 || stream[0] != streamFormat || stream[1] != \"stream\" || (stream.length - 1) % 10 != 0 || stream[3] != content"
      return value="[]"

    let name=kinds value="[]"
    let name=values value="[]"
    let name=starts value="[]"
    let name=ends value="[]"
    for name=recordStart from=11 to="stream.length" step=10
      if cond="stream[recordStart] != \"token\""
        break
      let name=tokenEnd value="parseboundeduinttext(stream[10], maxCodePoints)"
      if cond="recordStart + 10 < stream.length && stream[recordStart + 10] == \"token\""
        assign target=tokenEnd value="parseboundeduinttext(stream[recordStart + 15], maxCodePoints)"
      do value="kinds.push(stream[recordStart + 2])"
      do value="values.push(stream[recordStart + 3])"
      do value="starts.push(parseboundeduinttext(stream[recordStart + 5], maxCodePoints))"
      do value="ends.push(tokenEnd)"

    let name=cursor value="upstreamCursor"
    let name=initialCursor value="upstreamCursor"
    let name=type value="upstreamType"
    if cond="type == \"\""
      for name=typeIndex from=0 to="kinds.length"
        if cond="kinds[typeIndex] != \"whitespace\""
          if cond="kinds[typeIndex] != \"identifier\""
            return value="[]"
          assign target=type value="values[typeIndex]"
          assign target=cursor value="typeIndex + 1"
          assign target=initialCursor value="cursor"
          break
    if cond="type == \"\""
      return value="[]"
    let name=writeNames value="[]"
    let name=writeKinds value="[]"
    let name=writeValues value="[]"
    let name=writeStarts value="[]"
    let name=writeEnds value="[]"

    let name=bareName value="\"\""
    if cond="type == \"theme\" || type == \"derive\" || type == \"guard\" || type == \"effect\" || type == \"strategy\""
      assign target=bareName value="\"name\""
    if cond="type == \"auth\""
      assign target=bareName value="\"mode\""
    if cond="type == \"validate\""
      assign target=bareName value="\"schema\""
    if cond="type == \"trigger\""
      assign target=bareName value="\"kind\""
    if cond="type == \"rule\""
      assign target=bareName value="\"id\""
    if cond="bareName != \"\""
      for name=bareIndex from=cursor to="kinds.length"
        if cond="kinds[bareIndex] == \"whitespace\""
          assign target=cursor value="bareIndex + 1"
          continue
        let name=bareKeyValue value="kinds[bareIndex] == \"identifier\" && bareIndex + 1 < kinds.length && kinds[bareIndex + 1] == \"equals\""
        if cond="!bareKeyValue && kinds[bareIndex] == \"identifier\""
          do value="writeNames.push(bareName)"
          do value="writeKinds.push(\"text\")"
          do value="writeValues.push(values[bareIndex])"
          do value="writeStarts.push(starts[bareIndex])"
          do value="writeEnds.push(ends[bareIndex])"
          assign target=cursor value="bareIndex + 1"
        break

    let name=rawName value="\"\""
    if cond="type == \"return\" || type == \"throw\" || type == \"do\""
      assign target=rawName value="\"value\""
    if cond="type == \"if\" || type == \"while\""
      assign target=rawName value="\"cond\""
    if cond="rawName != \"\""
      for name=rawIndex from=cursor to="kinds.length"
        if cond="kinds[rawIndex] == \"whitespace\""
          assign target=cursor value="rawIndex + 1"
          continue
        let name=rawKeyValue value="kinds[rawIndex] == \"identifier\" && rawIndex + 1 < kinds.length && kinds[rawIndex + 1] == \"equals\""
        if cond="!rawKeyValue"
          do value="writeNames.push(rawName)"
          do value="writeKinds.push(\"text\")"
          do value="writeValues.push(keywordtrim(Text.slice(content, starts[rawIndex], Text.length(content))))"
          do value="writeStarts.push(starts[rawIndex])"
          do value="writeEnds.push(Text.length(content))"
          assign target=cursor value="kinds.length"
        break

    if cond="type == \"doc\""
      let name=docFirst value="-1"
      let name=docFirstValue value="\"\""
      let name=docFirstStart value="0"
      let name=docFirstEnd value="0"
      let name=docCount value="0"
      for name=docIndex from=cursor to="kinds.length"
        if cond="kinds[docIndex] == \"whitespace\""
          continue
        if cond="docFirst < 0"
          assign target=docFirst value="docIndex"
          assign target=docFirstValue value="values[docIndex]"
          assign target=docFirstStart value="starts[docIndex]"
          assign target=docFirstEnd value="ends[docIndex]"
        assign target=docCount value="docCount + 1"
      if cond="docCount == 1"
        do value="writeNames.push(\"text\")"
        do value="writeKinds.push(\"text\")"
        do value="writeValues.push(docFirstValue)"
        do value="writeStarts.push(docFirstStart)"
        do value="writeEnds.push(docFirstEnd)"
        assign target=cursor value="kinds.length"
      if cond="docCount > 1"
        do value="writeNames.push(\"text\")"
        do value="writeKinds.push(\"text\")"
        do value="writeValues.push(keywordtrim(Text.slice(content, docFirstStart, Text.length(content))))"
        do value="writeStarts.push(docFirstStart)"
        do value="writeEnds.push(Text.length(content))"
        assign target=cursor value="kinds.length"

    if cond="type == \"route\""
      for name=methodIndex from=cursor to="kinds.length"
        if cond="kinds[methodIndex] == \"whitespace\""
          assign target=cursor value="methodIndex + 1"
          continue
        if cond="kinds[methodIndex] == \"identifier\""
          let name=method value="keywordverb(values[methodIndex])"
          if cond="method != \"\""
            do value="writeNames.push(\"method\")"
            do value="writeKinds.push(\"text\")"
            do value="writeValues.push(method)"
            do value="writeStarts.push(starts[methodIndex])"
            do value="writeEnds.push(ends[methodIndex])"
            assign target=cursor value="methodIndex + 1"
            for name=pathIndex from=cursor to="kinds.length"
              if cond="kinds[pathIndex] == \"whitespace\""
                assign target=cursor value="pathIndex + 1"
                continue
              if cond="kinds[pathIndex] == \"slash\""
                do value="writeNames.push(\"path\")"
                do value="writeKinds.push(\"text\")"
                do value="writeValues.push(values[pathIndex])"
                do value="writeStarts.push(starts[pathIndex])"
                do value="writeEnds.push(ends[pathIndex])"
                assign target=cursor value="pathIndex + 1"
              break
        break

    if cond="type == \"error\" || type == \"respond\""
      for name=statusIndex from=cursor to="kinds.length"
        if cond="kinds[statusIndex] == \"whitespace\""
          assign target=cursor value="statusIndex + 1"
          continue
        if cond="kinds[statusIndex] == \"number\""
          let name=statusRaw value="values[statusIndex]"
          do value="writeNames.push(\"status\")"
          do value="writeKinds.push(\"number-token\")"
          do value="writeValues.push(statusRaw)"
          do value="writeStarts.push(starts[statusIndex])"
          do value="writeEnds.push(ends[statusIndex])"
          assign target=cursor value="statusIndex + 1"
          if cond="type == \"error\""
            for name=messageIndex from=cursor to="kinds.length"
              if cond="kinds[messageIndex] == \"whitespace\""
                assign target=cursor value="messageIndex + 1"
                continue
              if cond="kinds[messageIndex] == \"quoted\""
                do value="writeNames.push(\"message\")"
                do value="writeKinds.push(\"text\")"
                do value="writeValues.push(values[messageIndex])"
                do value="writeStarts.push(starts[messageIndex])"
                do value="writeEnds.push(ends[messageIndex])"
                assign target=cursor value="messageIndex + 1"
              break
        break

    if cond="type == \"expect\""
      for name=expectIndex from=cursor to="kinds.length"
        if cond="kinds[expectIndex] == \"whitespace\""
          assign target=cursor value="expectIndex + 1"
          continue
        let name=expectKeyValue value="kinds[expectIndex] == \"identifier\" && expectIndex + 1 < kinds.length && kinds[expectIndex + 1] == \"equals\""
        let name=expectValue value="values[expectIndex]"
        let name=expectAccepted value="\"no\""
        if cond="expectValue == \"codegen\""
          assign target=expectAccepted value="\"yes\""
        if cond="expectValue == \"decompile\""
          assign target=expectAccepted value="\"yes\""
        if cond="expectValue == \"roundtrip\""
          assign target=expectAccepted value="\"yes\""
        if cond="expectAccepted == \"yes\""
          if cond="!expectKeyValue && kinds[expectIndex] == \"identifier\""
            do value="writeNames.push(expectValue)"
            do value="writeKinds.push(\"boolean\")"
            do value="writeValues.push(\"true\")"
            do value="writeStarts.push(starts[expectIndex])"
            do value="writeEnds.push(ends[expectIndex])"
            assign target=cursor value="expectIndex + 1"
        break

    if cond="type == \"message\""
      for name=templateIndex from=cursor to="kinds.length"
        if cond="kinds[templateIndex] == \"whitespace\""
          assign target=cursor value="templateIndex + 1"
          continue
        if cond="kinds[templateIndex] == \"quoted\""
          do value="writeNames.push(\"template\")"
          do value="writeKinds.push(\"text\")"
          do value="writeValues.push(values[templateIndex])"
          do value="writeStarts.push(starts[templateIndex])"
          do value="writeEnds.push(ends[templateIndex])"
          assign target=cursor value="templateIndex + 1"
        break

    if cond="type == \"island\""
      let name=islandFirst value="\"\""
      let name=islandFirstStart value="0"
      let name=islandFirstEnd value="0"
      let name=islandResolved value="false"
      for name=islandFirstIndex from=cursor to="kinds.length"
        if cond="kinds[islandFirstIndex] == \"whitespace\""
          assign target=cursor value="islandFirstIndex + 1"
          continue
        let name=islandFirstKeyValue value="kinds[islandFirstIndex] == \"identifier\" && islandFirstIndex + 1 < kinds.length && kinds[islandFirstIndex + 1] == \"equals\""
        if cond="!islandFirstKeyValue && kinds[islandFirstIndex] == \"identifier\""
          assign target=islandFirst value="values[islandFirstIndex]"
          assign target=islandFirstStart value="starts[islandFirstIndex]"
          assign target=islandFirstEnd value="ends[islandFirstIndex]"
          assign target=cursor value="islandFirstIndex + 1"
          for name=islandSecondIndex from=cursor to="kinds.length"
            if cond="kinds[islandSecondIndex] == \"whitespace\""
              assign target=cursor value="islandSecondIndex + 1"
              continue
            let name=islandSecondKeyValue value="kinds[islandSecondIndex] == \"identifier\" && islandSecondIndex + 1 < kinds.length && kinds[islandSecondIndex + 1] == \"equals\""
            if cond="islandSecondKeyValue"
              assign target=islandResolved value="true"
            else
              if cond="kinds[islandSecondIndex] == \"identifier\""
                do value="writeNames.push(\"kind\")"
                do value="writeKinds.push(\"text\")"
                do value="writeValues.push(islandFirst)"
                do value="writeStarts.push(islandFirstStart)"
                do value="writeEnds.push(islandFirstEnd)"
                do value="writeNames.push(\"name\")"
                do value="writeKinds.push(\"text\")"
                do value="writeValues.push(values[islandSecondIndex])"
                do value="writeStarts.push(starts[islandSecondIndex])"
                do value="writeEnds.push(ends[islandSecondIndex])"
                assign target=cursor value="islandSecondIndex + 1"
                assign target=islandResolved value="true"
            break
          if cond="!islandResolved"
            assign target=islandResolved value="true"
          if cond="writeNames.length == 0"
            let name=islandReserved value="islandFirst == \"capability\" || islandFirst == \"engine\" || islandFirst == \"provider\" || islandFirst == \"service\" || islandFirst == \"sidecar\""
            if cond="islandReserved"
              do value="writeNames.push(\"kind\")"
            else
              do value="writeNames.push(\"name\")"
            do value="writeKinds.push(\"text\")"
            do value="writeValues.push(islandFirst)"
            do value="writeStarts.push(islandFirstStart)"
            do value="writeEnds.push(islandFirstEnd)"
        break

    if cond="type == \"middleware\""
      let name=middlewareStart value="-1"
      let name=middlewareHasEquals value="false"
      for name=middlewareIndex from=cursor to="kinds.length"
        if cond="middlewareStart < 0 && kinds[middlewareIndex] == \"whitespace\""
          assign target=cursor value="middlewareIndex + 1"
          continue
        if cond="middlewareStart < 0"
          assign target=middlewareStart value="starts[middlewareIndex]"
        if cond="kinds[middlewareIndex] == \"equals\""
          assign target=middlewareHasEquals value="true"
      if cond="middlewareStart >= 0 && !middlewareHasEquals"
        let name=middlewareRaw value="keywordtrim(Text.slice(content, middlewareStart, Text.length(content)))"
        if cond="middlewareRaw != \"\""
          if cond="Text.indexOf(middlewareRaw, \",\") >= 0"
            do value="writeNames.push(\"names\")"
            do value="writeKinds.push(\"middleware-list\")"
          else
            do value="writeNames.push(\"name\")"
            do value="writeKinds.push(\"text\")"
          do value="writeValues.push(middlewareRaw)"
          do value="writeStarts.push(middlewareStart)"
          do value="writeEnds.push(Text.length(content))"
          assign target=cursor value="kinds.length"

    let name=complexRaw value="\"\""
    let name=complexCursor value="cursor"
    let name=complexStart value="0"
    for name=complexIndex from=cursor to="kinds.length"
      if cond="kinds[complexIndex] == \"whitespace\""
        assign target=complexCursor value="complexIndex + 1"
        continue
      assign target=complexStart value="starts[complexIndex]"
      assign target=complexRaw value="Text.slice(content, complexStart, Text.length(content))"
      break
    let name=complexWrites value="structuredkeywordhandler(type, complexRaw)"
    if cond="complexWrites.length > 0"
      if cond="complexWrites[0] == \"commit\""
        for name=complexWriteIndex from=1 to="complexWrites.length" step=3
          do value="writeNames.push(complexWrites[complexWriteIndex])"
          do value="writeKinds.push(complexWrites[complexWriteIndex + 1])"
          do value="writeValues.push(complexWrites[complexWriteIndex + 2])"
          do value="writeStarts.push(complexStart)"
          do value="writeEnds.push(Text.length(content))"
        assign target=cursor value="kinds.length"
      else
        if cond="complexWrites[0] == \"rewind-tail\""
          assign target=cursor value="complexCursor"
          if cond="type == \"import\""
            for name=importIndex from=cursor to="kinds.length"
              let name=importKeyValue value="kinds[importIndex] == \"identifier\" && importIndex + 1 < kinds.length && kinds[importIndex + 1] == \"equals\""
              if cond="kinds[importIndex] == \"identifier\" && !importKeyValue"
                if cond="values[importIndex] == \"default\""
                  do value="writeNames.push(\"default\")"
                  do value="writeKinds.push(\"boolean\")"
                  do value="writeValues.push(\"true\")"
                  do value="writeStarts.push(starts[importIndex])"
                  do value="writeEnds.push(ends[importIndex])"
                  assign target=cursor value="importIndex + 1"
                  for name=importNameIndex from=cursor to="kinds.length"
                    if cond="kinds[importNameIndex] == \"whitespace\""
                      assign target=cursor value="importNameIndex + 1"
                      continue
                    let name=importNameKeyValue value="kinds[importNameIndex] == \"identifier\" && importNameIndex + 1 < kinds.length && kinds[importNameIndex + 1] == \"equals\""
                    if cond="kinds[importNameIndex] == \"identifier\" && !importNameKeyValue"
                      do value="writeNames.push(\"name\")"
                      do value="writeKinds.push(\"text\")"
                      do value="writeValues.push(values[importNameIndex])"
                      do value="writeStarts.push(starts[importNameIndex])"
                      do value="writeEnds.push(ends[importNameIndex])"
                      assign target=cursor value="importNameIndex + 1"
                    break
                else
                  do value="writeNames.push(\"name\")"
                  do value="writeKinds.push(\"text\")"
                  do value="writeValues.push(values[importIndex])"
                  do value="writeStarts.push(starts[importIndex])"
                  do value="writeEnds.push(ends[importIndex])"
                  assign target=cursor value="importIndex + 1"
              break
        if cond="complexWrites[0] == \"rewind-initial\""
          assign target=cursor value="initialCursor"

    if cond="writeNames.length > maxWrites"
      return value="[]"
    let name=out value="[]"
    do value="out.push(format)"
    do value="out.push(\"decision\")"
    do value="out.push(type)"
    do value="out.push(String(initialCursor))"
    do value="out.push(String(cursor))"
    do value="out.push(String(writeNames.length))"
    do value="out.push(content)"
    do value="out.push(streamFormat)"
    do value="out.push(String(maxWrites))"
    do value="out.push(String(maxFields))"
    do value="out.push(String(maxBytes))"
    do value="out.push(\"\")"
    for name=writeIndex from=0 to="writeNames.length"
      do value="out.push(\"write\")"
      do value="out.push(String(writeIndex))"
      do value="out.push(writeNames[writeIndex])"
      do value="out.push(writeKinds[writeIndex])"
      do value="out.push(writeValues[writeIndex])"
      do value="out.push(String(writeStarts[writeIndex]))"
      do value="out.push(String(writeEnds[writeIndex]))"
      do value="out.push(\"\")"
    do value="out.push(\"seal\")"
    do value="out.push(type)"
    do value="out.push(String(initialCursor))"
    do value="out.push(String(cursor))"
    do value="out.push(String(writeNames.length))"
    do value="out.push(content)"
    do value="out.push(streamFormat)"
    do value="out.push(String(maxWrites))"
    do value="out.push(String(maxFields))"
    do value="out.push(String(maxBytes))"
    do value="out.push(format)"
    do value="out.push(\"\")"
    if cond="out.length > maxFields"
      return value="[]"
    let name=bytes value="0"
    for name=fieldIndex from=0 to="out.length"
      assign target=bytes value="bytes + utf8bytes(out[fieldIndex])"
    if cond="bytes > maxBytes"
      return value="[]"
    return value="out"
