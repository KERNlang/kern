            let name=childSpan value="Map.get(lineSpanByOrdinal, String(child))"
            let name=childFact value="f4row6(\"structural\", \"invalid-child\", f4tapefield(childSpan, 0), f4tapefield(childSpan, 1), String(child), childKind)"
            do value="factParts.push(f4item(childFact))"
            assign target=factBytes value="factBytes + Text.utf8Length(f4item(childFact))"
            assign target=factCount value="factCount + 1"
    let name=decoratorResult value="f4decoratorrows(lineStarts, lineEnds, lineIndents, kinds, decoratorExplicitExports, decoratorFirsts, decoratorLasts, decoratorSuccessors, decoratorDispositions)"
    if cond="decoratorResult[0] != \"ok\""
      let name=decoratorDriftFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
      return value=decoratorDriftFailure
    assign target=decorators value="decoratorResult[1]"
    let name=exportCursor value=0
    while cond="exportCursor < Text.length(decoratorResult[2])"
      let name=exportItem value="f2batchmarked(decoratorResult[2], exportCursor, \"i\")"
      let name=exportNext value="f2uint(exportItem[1])"
      if cond="exportNext < 0 || f4tapecount(exportItem[0]) != 1"
        let name=exportDriftFailure value="f4fatal(\"F4_AUTHORITY_DRIFT\", sourceScalars)"
        return value=exportDriftFailure
      let name=exportTarget value="f4tapefield(exportItem[0], 0)"
