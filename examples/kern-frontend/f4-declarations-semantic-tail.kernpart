    if cond="factFold[0] != \"ok\""
      let name=factFoldFailure value="f4fatal(factFold[0] == \"limit\" ? \"F4_LIMIT\" : \"F4_AUTHORITY_DRIFT\", sourceScalars)"
      return value=factFoldFailure
    let name=facts value="factFold[1]"
    assign target=workSteps value="f2uint(factFold[2])"
    let name=status value="factCount == 0 ? \"classified\" : \"rejected\""
    if cond="status == \"rejected\""
      assign target=symbols value="\"\""
      assign target=bindings value="\"\""
    if cond="factCount > maxFacts"
      let name=factLimitFailure value="f4fatal(\"F4_LIMIT\", sourceScalars)"
      return value=factLimitFailure
    if cond="declarationCount > maxDeclarations || occurrenceCount > maxOccurrences || Text.length(attachments) > maxAttachments * 256 || Text.length(decorators) > maxDecorators * 512 || Text.length(symbols) > maxSymbols * 512 || Text.length(bindings) > maxBindings * 512 || workSteps > maxWorkSteps"
      let name=semanticLimitFailure value="f4fatal(\"F4_LIMIT\", sourceScalars)"
