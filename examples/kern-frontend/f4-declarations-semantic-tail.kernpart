          let name=parentMode value="Map.get(nodeModeMap, String(parentKind))"
          if cond="parentMode == \"unrestricted\""
            assign target=allowed value=true
          if cond="Text.indexOf(childKind, \"|\") < 0"
            if cond="parentMode == \"explicit\" && Text.indexOf(\"|\" + Map.get(nodeChildTapeMap, String(parentKind)) + \"|\", \"|\" + childKind + \"|\") >= 0"
              assign target=allowed value=true
        let name=parentDetached value="Map.has(detachedByLine, String(parent)) && Map.get(detachedByLine, String(parent))"
        if cond="allowed && !parentDetached"
          let name=attachmentRow value="f4row3(String(parent), String(child), \"attached\")"
