    let name=pathFactCount value="f2uint(pathBindings[3])"
    let name=pathWork value="f2uint(pathBindings[4])"
    assign target=factCount value="factCount + pathFactCount"
    assign target=workSteps value="workSteps + pathWork"
    for name=rootLine from=0 to=lineStarts.length
      let name=parent value="Map.has(parentByLine, String(rootLine)) ? Map.get(parentByLine, String(rootLine)) : -1"
      let name=isDetached value="Map.has(detachedByLine, String(rootLine)) && Map.get(detachedByLine, String(rootLine))"
      let name=rootKind value="kinds[rootLine]"
      if cond="!isDetached"
        if cond="parent == -1"
          if cond="rootKind != \"decorator\""
            if cond="rootKind != \"class\" && rootKind != \"fn\" && rootKind != \"from\" && rootKind != \"module\" && rootKind != \"use\" && !Map.has(rejectedByLine, String(rootLine))"
              let name=rootFact value="f4row6(\"module\", \"invalid-module-root\", String(lineStarts[rootLine]), String(lineEnds[rootLine]), String(rootLine), rootKind)"
