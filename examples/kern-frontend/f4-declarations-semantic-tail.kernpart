              assign target=factBytes value="factBytes + Text.utf8Length(f4item(rootFact))"
              assign target=factCount value="factCount + 1"
            if cond="rootKind == \"fn\" || rootKind == \"class\""
              if cond="Map.has(effectiveValues, String(rootLine) + \".name\")"
                let name=symbolRow value="f4row5(rootKind, Map.get(effectiveValues, String(rootLine) + \".name\"), Map.has(effectiveValues, String(rootLine) + \".export\") && Map.get(effectiveValues, String(rootLine) + \".export\") == \"true\" ? \"true\" : \"false\", String(rootLine), String(lineStarts[rootLine]))"
                assign target=symbols value="f4append(symbols, symbolRow)"
