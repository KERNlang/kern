fn name=attestationfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(\"kern.frontend.builtin-node-type-attestation-shadow.1\")"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    for name=padding from=0 to=13
      do value="out.push(\"\")"
    return value="out"

fn name=validadmissionfailurecode returns=boolean
  param name=code type=string
  handler lang="kern"
    return value="code == \"ADMISSION_INVALID\" || code == \"CODE_POINTS_LIMIT\" || code == \"DIAGNOSTIC_LIMIT\" || code == \"EMPTY_RETAINED_CODE\" || code == \"INVALID_LIMITS\" || code == \"LEXICAL_DEPTH_LIMIT\" || code == \"RECORD_LIMIT\" || code == \"STREAM_INVALID\" || code == \"TOKEN_LIMIT\" || code == \"TRIM_INVALID\" || code == \"UNSUPPORTED_UNKNOWN\""

fn name=observebuiltinnodetypeattestation returns="string[]" export=true
  param name=content type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxStreamRecords type=number
  param name=maxLexicalDepth type=number
  param name=maxCatalogEntries type=number
  handler lang="kern"
    let name=admission value="observenodetypetokenadmission(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth)"
    if cond="admission.length >= 2 && admission[1] == \"failure\""
      if cond="admission.length != 17 || admission[0] != \"kern.frontend.node-type-token-admission-shadow.1\" || !validadmissionfailurecode(admission[2]) || admission[3] != \"\""
        let name=inheritedEnvelopeFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
        return value="inheritedEnvelopeFailure"
      for name=inheritedPadding from=4 to=17
        if cond="admission[inheritedPadding] != \"\""
          let name=inheritedPaddingFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="inheritedPaddingFailure"
      let name=inheritedFailure value="attestationfailure(admission[2], admission[3])"
      return value="inheritedFailure"

    if cond="admission.length < 49 || admission[0] != \"kern.frontend.node-type-token-admission-shadow.1\" || (admission.length - 1) % 16 != 0"
      let name=envelopeFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
      return value="envelopeFailure"
    if cond="admission[1] != \"decision\" || (admission[2] != \"admitted\" && admission[2] != \"dropped\") || admission[4] != \"0\" || admission[13] != \"kern.frontend.retained-token-stream-shadow.1\""
      let name=decisionHeaderFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
      return value="decisionHeaderFailure"

    let name=status value="admission[2]"
    let name=retainedSource value="admission[3]"
    let name=cursorAfter value="parseboundeduinttext(admission[5], 1)"
    let name=tokenCount value="parseboundeduinttext(admission[6], maxTokens)"
    let name=tokenZeroStart value="parseboundeduinttext(admission[9], maxCodePoints)"
    let name=firstNonWhitespaceIndex value="parseboundeduinttext(admission[10], maxTokens)"
    let name=firstNonWhitespaceStart value="parseboundeduinttext(admission[11], maxCodePoints)"
    let name=admittedType value="admission[12]"
    let name=codeEnd value="parseboundeduinttext(admission[14], maxCodePoints)"
    let name=triviaEnd value="parseboundeduinttext(admission[15], maxCodePoints)"
    let name=inheritedStreamFieldCount value="parseboundeduinttext(admission[16], 1 + (maxStreamRecords + 2) * 10)"
    if cond="tokenCount <= 0 || tokenZeroStart != 0 || firstNonWhitespaceIndex < 0 || firstNonWhitespaceStart < 0 || codeEnd < 0 || triviaEnd < codeEnd || Text.slice(content, 0, codeEnd) != retainedSource || inheritedStreamFieldCount <= 0"
      let name=decisionValueFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
      return value="decisionValueFailure"
    let name=expectedStream value="observeretainedtokenstream(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth)"
    if cond="expectedStream.length != inheritedStreamFieldCount"
      let name=inheritedStreamLengthFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
      return value="inheritedStreamLengthFailure"
    if cond="status == \"admitted\""
      if cond="cursorAfter != 1 || admission[7] != \"identifier\" || admittedType != admission[8]"
        let name=admittedDecisionFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
        return value="admittedDecisionFailure"
    else
      if cond="cursorAfter != 0 || admission[7] == \"identifier\" || admittedType != \"\""
        let name=droppedDecisionFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
        return value="droppedDecisionFailure"

    let name=cursor value="17"
    let name=streamAuthIndex value="0"
    let name=streamAuthFields value="0"
    for name=streamAuthCursor from=17 to="admission.length" step=16
      if cond="streamAuthFields < inheritedStreamFieldCount"
        if cond="streamAuthCursor + 16 > admission.length || admission[streamAuthCursor] != \"stream-auth\" || parseboundeduinttext(admission[streamAuthCursor + 1], streamAuthIndex) != streamAuthIndex || parseboundeduinttext(admission[streamAuthCursor + 2], streamAuthFields) != streamAuthFields"
          let name=streamAuthHeaderFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="streamAuthHeaderFailure"
        let name=streamAuthCount value="parseboundeduinttext(admission[streamAuthCursor + 3], 12)"
        if cond="streamAuthCount <= 0 || streamAuthFields + streamAuthCount > inheritedStreamFieldCount"
          let name=streamAuthCountFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="streamAuthCountFailure"
        for name=streamAuthPadding from=4 to=16
          if cond="streamAuthPadding >= 4 + streamAuthCount && admission[streamAuthCursor + streamAuthPadding] != \"\""
            let name=streamAuthPaddingFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
            return value="streamAuthPaddingFailure"
        for name=streamAuthField from=0 to=12
          if cond="streamAuthField < streamAuthCount && admission[streamAuthCursor + 4 + streamAuthField] != List.index(expectedStream, streamAuthFields + streamAuthField)"
            let name=streamAuthPayloadFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
            return value="streamAuthPayloadFailure"
        assign target=streamAuthFields value="streamAuthFields + streamAuthCount"
        assign target=streamAuthIndex value="streamAuthIndex + 1"
        assign target=cursor value="streamAuthCursor + 16"

    let name=diagnosticRecordSeen value="false"
    let name=errorRecordSeen value="false"
    let name=sealRecordSeen value="false"
    let name=sealDiagnosticCount value="\"\""
    let name=sealErrorCount value="\"\""
    for name=terminalCursor from=17 to="admission.length" step=16
      if cond="status == \"dropped\" && terminalCursor == admission.length - 48"
        if cond="cursor != terminalCursor || admission[terminalCursor] != \"diagnostic\" || admission[terminalCursor + 1] != \"DROPPED_LINE\" || admission[terminalCursor + 2] != \"error\" || admission[terminalCursor + 3] != \"Dropped line 1: expected a node type at the start of the line\" || admission[terminalCursor + 4] != \"1\" || admission[terminalCursor + 7] != \"Rewrite this line so it starts with a valid KERN node type and move stray symbols into props.\" || admission[terminalCursor + 8] != \"parser\""
          let name=diagnosticFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="diagnosticFailure"
        for name=diagnosticPadding from=9 to=16
          if cond="admission[terminalCursor + diagnosticPadding] != \"\""
            let name=diagnosticPaddingFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
            return value="diagnosticPaddingFailure"
        assign target=diagnosticRecordSeen value="true"
      if cond="status == \"dropped\" && terminalCursor == admission.length - 32"
        if cond="admission[terminalCursor] != \"error\" || admission[terminalCursor + 1] != \"__error\" || admission[terminalCursor + 2] != \"0\" || admission[terminalCursor + 4] != \"Dropped line 1: expected a node type\" || admission[terminalCursor + 5] != retainedSource || admission[terminalCursor + 6] != \"DROPPED_LINE\" || admission[terminalCursor + 7] != \"absent\" || admission[terminalCursor + 8] != \"0\" || admission[terminalCursor + 9] != \"0\" || admission[terminalCursor + 10] != \"0\" || admission[terminalCursor + 11] != \"1\" || admission[terminalCursor + 12] != \"1\" || admission[terminalCursor + 13] != \"1\" || admission[terminalCursor + 15] != \"\""
          let name=errorFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="errorFailure"
        assign target=errorRecordSeen value="true"
      if cond="terminalCursor == admission.length - 16"
        if cond="status == \"admitted\" && cursor != terminalCursor"
          let name=admittedCursorFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="admittedCursorFailure"
        if cond="admission[terminalCursor] != \"seal\" || admission[terminalCursor + 1] != status || admission[terminalCursor + 2] != retainedSource || admission[terminalCursor + 3] != admission[6] || admission[terminalCursor + 4] != admission[5] || admission[terminalCursor + 5] != admission[10] || admission[terminalCursor + 6] != admittedType || admission[terminalCursor + 9] != String(Text.length(retainedSource)) || admission[terminalCursor + 10] != String(utf8bytes(retainedSource)) || admission[terminalCursor + 11] != content || admission[terminalCursor + 12] != admission[14] || admission[terminalCursor + 13] != admission[15] || admission[terminalCursor + 15] != \"\""
          let name=sealFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="sealFailure"
        if cond="status == \"admitted\" && (admission[terminalCursor + 7] != \"0\" || admission[terminalCursor + 8] != \"0\")"
          let name=admittedCountFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="admittedCountFailure"
        if cond="status == \"dropped\" && (admission[terminalCursor + 7] != \"1\" || admission[terminalCursor + 8] != \"1\")"
          let name=droppedCountFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
          return value="droppedCountFailure"
        assign target=sealDiagnosticCount value="admission[terminalCursor + 7]"
        assign target=sealErrorCount value="admission[terminalCursor + 8]"
        assign target=sealRecordSeen value="true"
    if cond="!sealRecordSeen || (status == \"dropped\" && (!diagnosticRecordSeen || !errorRecordSeen))"
      let name=terminalRecordFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
      return value="terminalRecordFailure"

    let name=catalog value="builtinnodetypes()"
    if cond="catalog.length <= 0 || catalog.length > maxCatalogEntries"
      let name=catalogBoundFailure value="attestationfailure(\"ATTESTATION_INVALID\", \"\")"
      return value="catalogBoundFailure"
    let name=attestation value="\"none\""
    let name=catalogIndex value="\"none\""
    if cond="status == \"admitted\""
      assign target=attestation value="\"unresolved\""
      for name=candidateIndex from=0 to="catalog.length"
        if cond="attestation == \"unresolved\" && catalog[candidateIndex] == admittedType"
          assign target=attestation value="\"builtin\""
          assign target=catalogIndex value="String(candidateIndex)"

    let name=out value="[]"
    do value="out.push(\"kern.frontend.builtin-node-type-attestation-shadow.1\")"
    do value="out.push(\"decision\")"
    do value="out.push(status)"
    do value="out.push(admittedType)"
    do value="out.push(attestation)"
    do value="out.push(catalogIndex)"
    do value="out.push(String(catalog.length))"
    do value="out.push(String(admission.length))"
    do value="out.push(content)"
    do value="out.push(admission[0])"
    do value="out.push(admission[13])"
    do value="out.push(retainedSource)"
    do value="out.push(admission[6])"
    do value="out.push(admission[5])"
    do value="out.push(sealDiagnosticCount)"
    do value="out.push(sealErrorCount)"
    do value="out.push(\"\")"

    let name=authIndex value="0"
    for name=authStart from=0 to="admission.length" step=12
      let name=authCount value="admission.length - authStart"
      if cond="authCount > 12"
        assign target=authCount value="12"
      do value="out.push(\"admission-auth\")"
      do value="out.push(String(authIndex))"
      do value="out.push(String(authStart))"
      do value="out.push(String(authCount))"
      for name=authField from=0 to=12
        if cond="authField < authCount"
          do value="out.push(admission[authStart + authField])"
        else
          do value="out.push(\"\")"
      assign target=authIndex value="authIndex + 1"

    do value="out.push(\"seal\")"
    do value="out.push(status)"
    do value="out.push(attestation)"
    do value="out.push(catalogIndex)"
    do value="out.push(admittedType)"
    do value="out.push(String(catalog.length))"
    do value="out.push(String(admission.length))"
    do value="out.push(content)"
    do value="out.push(String(Text.length(retainedSource)))"
    do value="out.push(String(utf8bytes(retainedSource)))"
    do value="out.push(admission[0])"
    do value="out.push(admission[13])"
    do value="out.push(retainedSource)"
    do value="out.push(admission[6])"
    do value="out.push(admission[5])"
    do value="out.push(\"\")"
    return value="out"
