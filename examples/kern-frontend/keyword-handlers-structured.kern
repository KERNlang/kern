fn name=structuredfindquoteend returns=number
  param name=value type=string
  param name=start type=number
  handler lang="kern"
    let name=quote value="Text.charAt(value, start)"
    let name=escaped value=false
    let name=n value="Text.length(value)"
    let name=begin value="start + 1"
    for name=index from=begin to=n
      let name=ch value="Text.charAt(value, index)"
      if cond=escaped
        assign target=escaped value=false
        continue
      if cond="ch == \"\\\\\""
        assign target=escaped value=true
        continue
      if cond="ch == quote"
        return value=index
    return value=-1

fn name=structuredbindings returns="string[]"
  param name=value type=string
  handler lang="kern"
    let name=out value="[]"
    let name=parts value="structuredsplit(value, \",\")"
    if cond="parts.length == 0"
      return value=out
    for name=index from=0 to="parts.length"
      let name=part value="parts[index]"
      let name=asIndex value="Text.indexOf(part, \" as \")"
      let name=name value=part
      let name=alias value="\"\""
      if cond="asIndex >= 0"
        assign target=name value="structuredtrim(Text.slice(part, 0, asIndex))"
        assign target=alias value="structuredtrim(Text.slice(part, asIndex + 4, Text.length(part)))"
      if cond="!structuredvalidname(name) || (asIndex >= 0 && !structuredvalidname(alias))"
        return value="[]"
      do value="out.push(name)"
      do value="out.push(alias)"
    return value=out

fn name=structuredbindingsencoding returns=string
  param name=bindings type="string[]"
  handler lang="kern"
    let name=count value=0
    for name=countIndex from=0 to="bindings.length" step=2
      assign target=count value="count + 1"
    let name=out value="String(count) + \":\""
    for name=index from=0 to="bindings.length" step=2
      assign target=out value="out + structuredencodefield(bindings[index])"
      if cond="bindings[index + 1] == \"\""
        assign target=out value="out + \"0\""
      else
        assign target=out value="out + \"1\" + structuredencodefield(bindings[index + 1])"
    return value=out

fn name=structuredforeignimport returns="string[]"
  param name=trimmed type=string
  param name=baseStart type=number
  handler lang="kern"
    let name=out value="[]"
    let name=keyword value="\"\""
    let name=cursor value=0
    if cond="Text.startsWith(trimmed, \"npm \")"
      assign target=keyword value="\"npm\""
      assign target=cursor value=4
    if cond="Text.startsWith(trimmed, \"py \")"
      assign target=keyword value="\"py\""
      assign target=cursor value=3
    if cond="Text.startsWith(trimmed, \"python \")"
      assign target=keyword value="\"python\""
      assign target=cursor value=7
    if cond="Text.startsWith(trimmed, \"pypi \")"
      assign target=keyword value="\"pypi\""
      assign target=cursor value=5
    if cond="keyword == \"\""
      return value=out
    let name=quote value="Text.charAt(trimmed, cursor)"
    if cond="quote != \"\\\"\" && quote != \"'\""
      return value=out
    let name=close value="structuredfindquoteend(trimmed, cursor)"
    if cond="close < 0"
      return value=out
    let name=packageName value="structuredtrim(Text.slice(trimmed, cursor + 1, close))"
    if cond="packageName == \"\""
      return value=out
    let name=restRange value="structuredtrimrange(trimmed, close + 1, Text.length(trimmed))"
    let name=restStart value="restRange[0]"
    let name=rest value="Text.slice(trimmed, restStart, restRange[1])"
    let name=defaultName value="\"\""
    let name=defaultStart value=restStart
    let name=defaultEnd value=restStart
    let name=trailing value=rest
    let name=trailingStart value=restStart
    if cond="Text.startsWith(rest, \"as \")"
      let name=aliasTail value="Text.slice(rest, 3, Text.length(rest))"
      let name=aliasEnd value=0
      while cond="aliasEnd < Text.length(aliasTail) && structurednamechar(Text.charAt(aliasTail, aliasEnd))"
        assign target=aliasEnd value="aliasEnd + 1"
      assign target=defaultName value="Text.slice(aliasTail, 0, aliasEnd)"
      assign target=defaultStart value="restStart + 3"
      assign target=defaultEnd value="defaultStart + aliasEnd"
      if cond="!structuredvalidname(defaultName)"
        return value="[]"
      assign target=trailing value="structuredtrim(Text.slice(aliasTail, aliasEnd, Text.length(aliasTail)))"
      let name=afterAliasRange value="structuredtrimrange(aliasTail, aliasEnd, Text.length(aliasTail))"
      assign target=trailingStart value="restStart + 3 + afterAliasRange[0]"
    let name=registry value="\"pypi\""
    let name=target value="\"python\""
    if cond="keyword == \"npm\""
      assign target=registry value="\"npm\""
      assign target=target value="\"ts\""
    do value="out.push(\"commit\")"
    do value="out.push(\"from\")"
    do value="out.push(\"text\")"
    do value="out.push(packageName)"
    do value="out.push(String(baseStart + cursor))"
    do value="out.push(String(baseStart + close + 1))"
    do value="out.push(\"package\")"
    do value="out.push(\"text\")"
    do value="out.push(packageName)"
    do value="out.push(String(baseStart + cursor))"
    do value="out.push(String(baseStart + close + 1))"
    do value="out.push(\"registry\")"
    do value="out.push(\"text\")"
    do value="out.push(registry)"
    do value="out.push(String(baseStart))"
    do value="out.push(String(baseStart + cursor - 1))"
    do value="out.push(\"target\")"
    do value="out.push(\"text\")"
    do value="out.push(target)"
    do value="out.push(String(baseStart))"
    do value="out.push(String(baseStart + cursor - 1))"
    do value="out.push(\"__firstClassImport\")"
    do value="out.push(\"boolean\")"
    do value="out.push(\"true\")"
    do value="out.push(String(baseStart))"
    do value="out.push(String(baseStart + close + 1))"
    if cond="defaultName != \"\""
      do value="out.push(\"default\")"
      do value="out.push(\"text\")"
      do value="out.push(defaultName)"
      do value="out.push(String(baseStart + defaultStart))"
      do value="out.push(String(baseStart + defaultEnd))"
    let name=bare value="structuredbareprops(trailing, baseStart + trailingStart)"
    for name=index from=0 to="bare.length"
      do value="out.push(bare[index])"
    return value=out

fn name=structuredimport returns="string[]"
  param name=raw type=string
  handler lang="kern"
    let name=out value="[]"
    let name=rawRange value="structuredtrimrange(raw, 0, Text.length(raw))"
    let name=trimmedStart value="rawRange[0]"
    let name=trimmedEnd value="rawRange[1]"
    let name=trimmed value="Text.slice(raw, trimmedStart, trimmedEnd)"
    if cond="trimmed == \"\" || (structurednamestart(Text.charAt(trimmed, 0)) && Text.indexOf(trimmed, \"=\") > 0 && Text.indexOf(trimmed, \"=\") < Text.indexOf(trimmed, \" \"))"
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=foreign value="structuredforeignimport(trimmed, trimmedStart)"
    if cond="foreign.length > 0"
      return value=foreign
    let name=sideEffect value="structuredquotedmodule(trimmed)"
    if cond="sideEffect != \"\" && !Text.startsWith(trimmed, \"from \")"
      do value="out.push(\"commit\")"
      do value="out.push(\"from\")"
      do value="out.push(\"text\")"
      do value="out.push(sideEffect)"
      do value="out.push(String(trimmedStart))"
      do value="out.push(String(trimmedEnd))"
      do value="out.push(\"__firstClassImport\")"
      do value="out.push(\"boolean\")"
      do value="out.push(\"true\")"
      do value="out.push(String(trimmedStart))"
      do value="out.push(String(trimmedEnd))"
      return value=out
    let name=typeOnly value=false
    let name=named value=trimmed
    let name=namedStart value=0
    if cond="Text.startsWith(named, \"type \")"
      assign target=typeOnly value=true
      let name=namedRange value="structuredtrimrange(trimmed, 5, Text.length(trimmed))"
      assign target=namedStart value="namedRange[0]"
      assign target=named value="Text.slice(trimmed, namedStart, namedRange[1])"
    if cond="Text.charAt(named, 0) != \"{\""
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=close value="structuredfindmatching(named, 0, \"{\", \"}\")"
    if cond="close <= 1"
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=afterRange value="structuredtrimrange(named, close + 1, Text.length(named))"
    let name=afterStart value="afterRange[0]"
    let name=after value="Text.slice(named, afterStart, afterRange[1])"
    if cond="!Text.startsWith(after, \"from \")"
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=bindings value="structuredbindings(Text.slice(named, 1, close))"
    let name=moduleRange value="structuredtrimrange(after, 5, Text.length(after))"
    let name=from value="structuredquotedmodule(Text.slice(after, moduleRange[0], moduleRange[1]))"
    if cond="bindings.length == 0 || bindings.length % 2 != 0 || from == \"\""
      do value="out.push(\"rewind-tail\")"
      return value=out
    let name=names value="\"\""
    for name=index from=0 to="bindings.length" step=2
      if cond="names != \"\""
        assign target=names value="names + \",\""
      assign target=names value="names + bindings[index]"
      if cond="bindings[index + 1] != \"\""
        assign target=names value="names + \" as \" + bindings[index + 1]"
    do value="out.push(\"commit\")"
    do value="out.push(\"from\")"
    do value="out.push(\"text\")"
    do value="out.push(from)"
    do value="out.push(String(trimmedStart + namedStart + afterStart + moduleRange[0]))"
    do value="out.push(String(trimmedStart + namedStart + afterStart + moduleRange[1]))"
    do value="out.push(\"names\")"
    do value="out.push(\"text\")"
    do value="out.push(names)"
    do value="out.push(String(trimmedStart + namedStart))"
    do value="out.push(String(trimmedStart + namedStart + close + 1))"
    if cond=typeOnly
      do value="out.push(\"types\")"
      do value="out.push(\"boolean\")"
      do value="out.push(\"true\")"
      do value="out.push(String(trimmedStart))"
      do value="out.push(String(trimmedStart + 4))"
    do value="out.push(\"__firstClassImport\")"
    do value="out.push(\"boolean\")"
    do value="out.push(\"true\")"
    do value="out.push(String(trimmedStart + namedStart))"
    do value="out.push(String(trimmedStart + namedStart + close + 1))"
    do value="out.push(\"__firstClassBindings\")"
    do value="out.push(\"bindings-v1\")"
    do value="out.push(structuredbindingsencoding(bindings))"
    do value="out.push(String(trimmedStart + namedStart))"
    do value="out.push(String(trimmedStart + namedStart + close + 1))"
    return value=out

fn name=structuredarrayparams returns="string[]"
  param name=value type=string
  handler lang="kern"
    let name=out value="[]"
    let name=body value="structuredunquote(value)"
    let name=n value="Text.length(body)"
    if cond="n > 0 && Text.charAt(body, 0) == \"[\""
      assign target=body value="Text.slice(body, 1, Text.length(body))"
    assign target=n value="Text.length(body)"
    if cond="n > 0 && Text.charAt(body, n - 1) == \"]\""
      assign target=body value="Text.slice(body, 0, n - 1)"
    let name=objects value="structuredsplit(body, \",\")"
    for name=index from=0 to="objects.length"
      let name=object value="structuredtrim(objects[index])"
      let name=objectLength value="Text.length(object)"
      if cond="objectLength > 0 && Text.charAt(object, 0) == \"{\""
        assign target=object value="Text.slice(object, 1, Text.length(object))"
      assign target=objectLength value="Text.length(object)"
      if cond="objectLength > 0 && Text.charAt(object, objectLength - 1) == \"}\""
        assign target=object value="Text.slice(object, 0, objectLength - 1)"
      let name=fields value="structuredsplit(object, \",\")"
      let name=itemName value="\"\""
      let name=itemType value="\"\""
      let name=hasDefault value="\"0\""
      let name=defaultValue value="\"\""
      for name=fieldIndex from=0 to="fields.length"
        let name=field value="fields[fieldIndex]"
        let name=colon value="Text.indexOf(field, \":\")"
        if cond="colon < 0"
          continue
        let name=key value="structuredunquote(Text.slice(field, 0, colon))"
        let name=rawValue value="structuredtrim(Text.slice(field, colon + 1, Text.length(field)))"
        if cond="key == \"name\""
          assign target=itemName value="structuredunquote(rawValue)"
        if cond="key == \"type\""
          assign target=itemType value="structuredunquote(rawValue)"
        if cond="key == \"default\""
          assign target=hasDefault value="\"1\""
          assign target=defaultValue value=rawValue
      if cond="itemName != \"\" && itemType != \"\""
        do value="out.push(itemName)"
        do value="out.push(itemType)"
        do value="out.push(hasDefault)"
        do value="out.push(defaultValue)"
    return value=out

fn name=structuredparams returns="string[]"
  param name=raw type=string
  handler lang="kern"
    let name=out value="[]"
    let name=rawRange value="structuredtrimrange(raw, 0, Text.length(raw))"
    let name=trimmedStart value="rawRange[0]"
    let name=trimmedEnd value="rawRange[1]"
    let name=trimmed value="Text.slice(raw, trimmedStart, trimmedEnd)"
    if cond="trimmed == \"\""
      return value=out
    if cond="Text.startsWith(trimmed, \"items\")"
      let name=cursor value=5
      while cond="cursor < Text.length(trimmed) && structuredspace(Text.charAt(trimmed, cursor))"
        assign target=cursor value="cursor + 1"
      if cond="Text.charAt(trimmed, cursor) == \"=\""
        let name=arrayRaw value="Text.slice(trimmed, cursor + 1, Text.length(trimmed))"
        let name=arrayItems value="structuredarrayparams(arrayRaw)"
        let name=arrayEncoding value="structuredparamencoding(arrayItems)"
        do value="out.push(\"commit\")"
        do value="out.push(\"items\")"
        do value="out.push(\"params-items-v1\")"
        do value="out.push(arrayEncoding)"
        do value="out.push(String(trimmedStart))"
        do value="out.push(String(trimmedEnd))"
        return value=out
    let name=items value="structuredbareparams(trimmed)"
    let name=encoding value="structuredparamencoding(items)"
    do value="out.push(\"commit\")"
    do value="out.push(\"items\")"
    do value="out.push(\"params-items-v1\")"
    do value="out.push(encoding)"
    do value="out.push(String(trimmedStart))"
    do value="out.push(String(trimmedEnd))"
    return value=out

fn name=structuredkeywordhandler returns="string[]"
  param name=type type=string
  param name=raw type=string
  handler lang="kern"
    if cond="type == \"fn\""
      let name=result value="structuredfn(raw)"
      return value=result
    if cond="type == \"let\""
      let name=result value="structuredlet(raw)"
      return value=result
    if cond="type == \"import\""
      let name=result value="structuredimport(raw)"
      return value=result
    if cond="type == \"params\""
      let name=result value="structuredparams(raw)"
      return value=result
    return value="[]"
