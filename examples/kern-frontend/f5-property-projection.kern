fn name=f5trim returns=string
  param name=value type=string
  handler lang="kern"
    let name=left value="0"
    let name=right value="Text.length(value)"
    while cond="left < right && Text.indexOf(\" \\t\\n\\r\", Text.charAt(value, left)) >= 0"
      assign target=left value="left + 1"
    while cond="right > left && Text.indexOf(\" \\t\\n\\r\", Text.charAt(value, right - 1)) >= 0"
      assign target=right value="right - 1"
    return value="Text.slice(value, left, right)"

fn name=f5includedproperty returns=string
  param name=limits type=string
  param name=schemaKind type=string
  param name=value type=string
  handler lang="kern"
    if cond="schemaKind == \"boolean\""
      return value="f5bool(limits, value == \"true\")"
    if cond="schemaKind == \"number\""
      if cond="Text.indexOf(value, \".\") >= 0"
        return value="f5decimal(limits, value)"
      return value="f5int(limits, value)"
    return value="f5text(limits, value)"

fn name=f5typekind returns=string
  param name=limits type=string
  param name=kind type=string
  handler lang="kern"
    let name=kindValue value="f5text(limits, kind)"
    let name=keys value="[]"
    do value="keys.push(\"kind\")"
    let name=values value="[]"
    do value="values.push(kindValue)"
    let name=result value="f5record(limits, keys, values)"
    return value=result

fn name=f5typelist returns=string
  param name=limits type=string
  param name=element type=string
  handler lang="kern"
    let name=elementValue value="f5text(limits, element)"
    let name=kindValue value="f5text(limits, \"list\")"
    let name=keys value="[]"
    do value="keys.push(\"element\")"
    do value="keys.push(\"kind\")"
    let name=values value="[]"
    do value="values.push(elementValue)"
    do value="values.push(kindValue)"
    let name=result value="f5record(limits, keys, values)"
    return value=result

fn name=f5recordone returns=string
  param name=limits type=string
  param name=key type=string
  param name=value type=string
  handler lang="kern"
    let name=keys value="[]"
    do value="keys.push(key)"
    let name=values value="[]"
    do value="values.push(value)"
    let name=result value="f5record(limits, keys, values)"
    return value=result

fn name=f5recordtwo returns=string
  param name=limits type=string
  param name=firstKey type=string
  param name=firstValue type=string
  param name=secondKey type=string
  param name=secondValue type=string
  handler lang="kern"
    let name=keys value="[]"
    do value="keys.push(firstKey)"
    do value="keys.push(secondKey)"
    let name=values value="[]"
    do value="values.push(firstValue)"
    do value="values.push(secondValue)"
    let name=result value="f5record(limits, keys, values)"
    return value=result

fn name=f5handlertype returns=string
  param name=limits type=string
  param name=value type=string
  param name=position type=string
  handler lang="kern"
    let name=source value="f5trim(value)"
    if cond="source == \"string\""
      let name=result value="f5typekind(limits, \"text\")"
      return value=result
    if cond="source == \"number\""
      let name=result value="f5typekind(limits, \"integer\")"
      return value=result
    if cond="source == \"boolean\" || (source == \"void\" && position == \"return\")"
      let name=result value="f5typekind(limits, source)"
      return value=result
    if cond="Text.length(source) > 2 && Text.slice(source, Text.length(source) - 2, Text.length(source)) == \"[]\""
      let name=elementSource value="Text.slice(source, 0, Text.length(source) - 2)"
      if cond="elementSource != \"string\" && elementSource != \"number\" && elementSource != \"boolean\""
        return value="\"__F5_AUTHORITY_DRIFT__\""
      let name=element value="elementSource == \"string\" ? \"text\" : elementSource == \"number\" ? \"integer\" : \"boolean\""
      let name=result value="f5typelist(limits, element)"
      return value=result
    return value="\"__F5_AUTHORITY_DRIFT__\""

fn name=f5identifier returns=boolean
  param name=value type=string
  handler lang="kern"
    if cond="Text.length(value) == 0"
      return value=false
    let name=first value="Text.charAt(value, 0)"
    if cond="Text.indexOf(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_\", first) < 0"
      return value=false
    let name=length value="Text.length(value)"
    for name=index from=1 to=length
      if cond="Text.indexOf(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789\", Text.charAt(value, index)) < 0"
        return value=false
    return value=true

fn name=f5canonicalnumber returns=boolean
  param name=value type=string
  handler lang="kern"
    let name=cursor value=0
    let name=negative value=false
    if cond="Text.length(value) > 0 && Text.charAt(value, 0) == \"-\""
      assign target=negative value=true
      assign target=cursor value=1
    if cond="cursor >= Text.length(value)"
      return value=false
    let name=integerStart value=cursor
    while cond="cursor < Text.length(value) && Text.indexOf(\"0123456789\", Text.charAt(value, cursor)) >= 0"
      assign target=cursor value="cursor + 1"
    if cond="cursor == integerStart || (cursor - integerStart > 1 && Text.charAt(value, integerStart) == \"0\")"
      return value=false
    let name=nonzero value=false
    for name=digitIndex from=integerStart to=cursor
      if cond="Text.charAt(value, digitIndex) != \"0\""
        assign target=nonzero value=true
    if cond="cursor < Text.length(value)"
      if cond="Text.charAt(value, cursor) != \".\""
        return value=false
      assign target=cursor value="cursor + 1"
      let name=fractionStart value=cursor
      while cond="cursor < Text.length(value) && Text.indexOf(\"0123456789\", Text.charAt(value, cursor)) >= 0"
        if cond="Text.charAt(value, cursor) != \"0\""
          assign target=nonzero value=true
        assign target=cursor value="cursor + 1"
      if cond="cursor == fractionStart"
        return value=false
    return value="cursor == Text.length(value) && !(negative && !nonzero)"

fn name=f5branchpath returns=string
  param name=limits type=string
  param name=value type=string
  param name=quoted type=boolean
  handler lang="kern"
    if cond="!quoted"
      if cond="!f5identifier(value)"
        if cond="!f5canonicalnumber(value)"
          return value="\"__F5_AUTHORITY_DRIFT__\""
    let name=form value="quoted ? \"quoted-text\" : \"unquoted-expression\""
    let name=formValue value="f5text(limits, form)"
    let name=sourceValue value="f5text(limits, value)"
    let name=result value="f5recordtwo(limits, \"form\", formValue, \"source\", sourceValue)"
    return value=result

fn name=f5eachcollection returns=string
  param name=limits type=string
  param name=value type=string
  handler lang="kern"
    let name=dot value="Text.indexOf(value, \".\")"
    if cond="dot < 0"
      if cond="!f5identifier(value)"
        return value="\"__F5_AUTHORITY_DRIFT__\""
    else
      let name=owner value="Text.slice(value, 0, dot)"
      let name=member value="Text.slice(value, dot + 1, Text.length(value))"
      if cond="Text.indexOf(member, \".\") >= 0"
        return value="\"__F5_AUTHORITY_DRIFT__\""
      if cond="!f5identifier(owner)"
        return value="\"__F5_AUTHORITY_DRIFT__\""
      if cond="!f5identifier(member)"
        return value="\"__F5_AUTHORITY_DRIFT__\""
    let name=form value="dot < 0 ? \"binding\" : \"record-array-field\""
    let name=formValue value="f5text(limits, form)"
    let name=sourceValue value="f5text(limits, value)"
    let name=result value="f5recordtwo(limits, \"form\", formValue, \"source\", sourceValue)"
    return value=result

fn name=f5projectproperty returns=string
  param name=limits type=string
  param name=schemaKind type=string
  param name=disposition type=string
  param name=value type=string
  param name=representation type=string
  param name=expressionValue type=string
  param name=position type=string
  handler lang="kern"
    if cond="disposition == \"included-value\""
      return value="f5includedproperty(limits, schemaKind, value)"
    if cond="disposition == \"lowered-import-path\""
      return value="f5text(limits, value)"
    if cond="disposition == \"lowered-type\""
      return value="f5handlertype(limits, value, position)"
    if cond="disposition == \"lowered-branch-path-value\""
      return value="f5branchpath(limits, value, representation == \"quoted\")"
    if cond="disposition == \"lowered-each-collection-reference\""
      return value="f5eachcollection(limits, value)"
    if cond="disposition == \"lowered-expression\""
      return value=expressionValue
    return value="\"\""
