fn name=retainedstreamfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(\"kern.frontend.retained-token-stream-shadow.1\")"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    for name=padding from=0 to=7
      do value="out.push(\"\")"
    return value="out"

fn name=parseboundeduinttext returns=number
  param name=text type=string
  param name=max type=number
  handler lang="kern"
    let name=n value="Text.length(text)"
    if cond="n == 0 || (n > 1 && Text.charAt(text, 0) == \"0\")"
      return value="-1"
    let name=value value="0"
    let name=i value="0"
    while cond="i < n"
      let name=digit value="Text.indexOf(\"0123456789\", Text.charAt(text, i))"
      if cond="digit < 0"
        return value="-1"
      assign target=value value="value * 10 + digit"
      if cond="value > max"
        return value="-1"
      assign target=i value="i + 1"
    return value="value"

fn name=utf8bytes returns=number
  param name=value type=string
  handler lang="kern"
    let name=bytes value="0"
    let name=i value="0"
    let name=n value="Text.length(value)"
    while cond="i < n"
      let name=ch value="Text.charAt(value, i)"
      if cond="ch <= \"\u007f\""
        assign target=bytes value="bytes + 1"
      else
        if cond="ch <= \"\u07ff\""
          assign target=bytes value="bytes + 2"
        else
          if cond="ch < \"\ud800\" || ch >= \"\ue000\""
            assign target=bytes value="bytes + 3"
          else
            assign target=bytes value="bytes + 4"
      assign target=i value="i + 1"
    return value="bytes"

fn name=observeretainedtokenstream returns="string[]" export=true
  param name=content type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxStreamRecords type=number
  param name=maxLexicalDepth type=number
  handler lang="kern"
    if cond="maxCodePoints <= 0 || maxTokens <= 0 || maxDiagnostics <= 0 || maxStreamRecords <= 0 || maxLexicalDepth <= 0 || maxStreamRecords != maxTokens + maxDiagnostics"
      let name=invalidLimits value="retainedstreamfailure(\"INVALID_LIMITS\", \"\")"
      return value="invalidLimits"

    let name=trimmed value="observewhitespacetrim(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth)"
    if cond="trimmed.length >= 2 && trimmed[1] == \"failure\""
      let name=trimFailure value="retainedstreamfailure(trimmed[2], trimmed[3])"
      return value="trimFailure"
    if cond="trimmed.length != 37 || trimmed[0] != \"kern.frontend.whitespace-trim-shadow.1\" || trimmed[1] != \"trim\" || trimmed[7] != content || trimmed[19] != \"seal\" || trimmed[20] != content"
      let name=trimEnvelopeFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
      return value="trimEnvelopeFailure"
    for name=trimPadding from=21 to=37
      if cond="trimmed[trimPadding] != \"\""
        let name=trimPaddingFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
        return value="trimPaddingFailure"

    let name=contentLength value="Text.length(content)"
    let name=codeEnd value="parseboundeduinttext(trimmed[17], contentLength)"
    let name=triviaEnd value="parseboundeduinttext(trimmed[18], contentLength)"
    if cond="codeEnd < 0 || triviaEnd < codeEnd || triviaEnd > contentLength"
      let name=trimOffsetFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
      return value="trimOffsetFailure"
    let name=markerOffsetText value="trimmed[13]"
    let name=markerOffset value="-1"
    if cond="markerOffsetText != \"none\""
      assign target=markerOffset value="parseboundeduinttext(markerOffsetText, contentLength)"
      if cond="markerOffset < 0 || markerOffset != triviaEnd || codeEnd >= triviaEnd"
        let name=markerOffsetFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
        return value="markerOffsetFailure"
    else
      if cond="trimmed[12] != \"record-end\" || trimmed[14] != \"none\" || trimmed[15] != \"\" || trimmed[16] != \"\" || codeEnd != contentLength || triviaEnd != contentLength"
        let name=recordEndFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
        return value="recordEndFailure"

    let name=retainedCode value="Text.slice(content, 0, codeEnd)"
    let name=hasSyntax value="false"
    let name=syntaxIndex value="0"
    while cond="syntaxIndex < codeEnd"
      let name=syntaxChar value="Text.charAt(retainedCode, syntaxIndex)"
      if cond="syntaxChar != \" \" && syntaxChar != \"\t\""
        assign target=hasSyntax value="true"
        break
      assign target=syntaxIndex value="syntaxIndex + 1"
    if cond="!hasSyntax"
      let name=emptyFailure value="retainedstreamfailure(\"EMPTY_RETAINED_CODE\", \"\")"
      return value="emptyFailure"

    let name=tokenized value="tokenizeline(retainedCode, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords)"
    if cond="tokenized.length == 5 && tokenized[1] == \"failure\""
      let name=tokenFailure value="retainedstreamfailure(tokenized[2], tokenized[3])"
      return value="tokenFailure"
    if cond="tokenized.length < 5 || tokenized[0] != \"kern.frontend.tokenizer-shadow.2\" || (tokenized.length - 1) % 4 != 0"
      let name=tokenEnvelopeFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
      return value="tokenEnvelopeFailure"

    let name=tokenCount value="0"
    let name=diagnosticCount value="0"
    let name=recordStart value="0"
    let name=sealed value="false"
    for name=validationCursor from=1 to="tokenized.length" step=4
      let name=tag value="tokenized[validationCursor]"
      if cond="tag == \"seal\""
        if cond="validationCursor != tokenized.length - 4 || tokenized[validationCursor + 2] != \"\" || tokenized[validationCursor + 3] != \"\" || Text.slice(retainedCode, recordStart, codeEnd) != tokenized[validationCursor + 1]"
          let name=tokenSealFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
          return value="tokenSealFailure"
        assign target=sealed value="true"
        break
      let name=recordDelta value="\"\""
      if cond="tag == \"token\""
        assign target=recordDelta value="tokenized[validationCursor + 3]"
        assign target=tokenCount value="tokenCount + 1"
      else
        if cond="tag == \"diagnostic\""
          assign target=recordDelta value="tokenized[validationCursor + 2]"
          assign target=diagnosticCount value="diagnosticCount + 1"
        else
          let name=recordTagFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
          return value="recordTagFailure"
      let name=nextRecordStart value="recordStart + Text.length(recordDelta)"
      if cond="nextRecordStart > codeEnd || Text.slice(retainedCode, recordStart, nextRecordStart) != recordDelta"
        let name=recordDeltaFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
        return value="recordDeltaFailure"
      assign target=recordStart value="nextRecordStart"
      if cond="tag == \"diagnostic\""
        let name=diagnosticSpan value="tokenized[validationCursor + 3]"
        if cond="recordStart + Text.length(diagnosticSpan) > codeEnd || Text.slice(retainedCode, recordStart, recordStart + Text.length(diagnosticSpan)) != diagnosticSpan"
          let name=diagnosticSpanFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
          return value="diagnosticSpanFailure"
    if cond="!sealed || tokenCount <= 0 || tokenCount > maxTokens || diagnosticCount > maxDiagnostics || tokenCount + diagnosticCount > maxStreamRecords"
      let name=countFailure value="retainedstreamfailure(\"STREAM_INVALID\", \"\")"
      return value="countFailure"

    let name=out value="[]"
    do value="out.push(\"kern.frontend.retained-token-stream-shadow.1\")"
    do value="out.push(\"stream\")"
    do value="out.push(\"0\")"
    do value="out.push(content)"
    do value="out.push(trimmed[17])"
    do value="out.push(trimmed[18])"
    do value="out.push(markerOffsetText)"
    do value="out.push(trimmed[14])"
    do value="out.push(trimmed[15])"
    do value="out.push(trimmed[16])"
    do value="out.push(String(codeEnd))"

    assign target=recordStart value="0"
    let name=previousTokenStart value="0"
    let name=tokenStartByte value="0"
    let name=tokenIndex value="0"
    for name=tokenCursor from=1 to="tokenized.length" step=4
      let name=tokenTag value="tokenized[tokenCursor]"
      if cond="tokenTag == \"seal\""
        break
      let name=tokenRecordDelta value="tokenized[tokenCursor + 2]"
      if cond="tokenTag == \"token\""
        assign target=tokenRecordDelta value="tokenized[tokenCursor + 3]"
      assign target=recordStart value="recordStart + Text.length(tokenRecordDelta)"
      if cond="tokenTag == \"token\""
        let name=tokenStart value="recordStart"
        let name=tokenDelta value="Text.slice(retainedCode, previousTokenStart, tokenStart)"
        assign target=tokenStartByte value="tokenStartByte + utf8bytes(tokenDelta)"
        do value="out.push(\"token\")"
        do value="out.push(String(tokenIndex))"
        do value="out.push(tokenized[tokenCursor + 1])"
        do value="out.push(tokenized[tokenCursor + 2])"
        do value="out.push(tokenDelta)"
        do value="out.push(String(tokenStart))"
        do value="out.push(String(tokenStartByte))"
        do value="out.push(\"\")"
        do value="out.push(\"\")"
        do value="out.push(\"\")"
        assign target=previousTokenStart value="tokenStart"
        assign target=tokenIndex value="tokenIndex + 1"

    assign target=recordStart value="0"
    let name=previousDiagnosticStart value="0"
    let name=diagnosticStartByte value="0"
    let name=diagnosticIndex value="0"
    for name=diagnosticCursor from=1 to="tokenized.length" step=4
      let name=diagnosticTag value="tokenized[diagnosticCursor]"
      if cond="diagnosticTag == \"seal\""
        break
      let name=diagnosticRecordDelta value="tokenized[diagnosticCursor + 2]"
      if cond="diagnosticTag == \"token\""
        assign target=diagnosticRecordDelta value="tokenized[diagnosticCursor + 3]"
      assign target=recordStart value="recordStart + Text.length(diagnosticRecordDelta)"
      if cond="diagnosticTag == \"diagnostic\""
        let name=diagnosticStart value="recordStart"
        let name=diagnosticDelta value="Text.slice(retainedCode, previousDiagnosticStart, diagnosticStart)"
        let name=diagnosticSourceSpan value="tokenized[diagnosticCursor + 3]"
        assign target=diagnosticStartByte value="diagnosticStartByte + utf8bytes(diagnosticDelta)"
        do value="out.push(\"diagnostic\")"
        do value="out.push(String(diagnosticIndex))"
        do value="out.push(tokenized[diagnosticCursor + 1])"
        do value="out.push(diagnosticDelta)"
        do value="out.push(diagnosticSourceSpan)"
        do value="out.push(String(diagnosticStart))"
        do value="out.push(String(diagnosticStart + Text.length(diagnosticSourceSpan)))"
        do value="out.push(String(diagnosticStartByte))"
        do value="out.push(String(diagnosticStartByte + utf8bytes(diagnosticSourceSpan)))"
        do value="out.push(\"\")"
        assign target=previousDiagnosticStart value="diagnosticStart"
        assign target=diagnosticIndex value="diagnosticIndex + 1"

    do value="out.push(\"seal\")"
    do value="out.push(String(tokenCount))"
    do value="out.push(String(diagnosticCount))"
    do value="out.push(Text.slice(retainedCode, previousTokenStart, codeEnd))"
    do value="out.push(Text.slice(retainedCode, previousDiagnosticStart, codeEnd))"
    do value="out.push(String(codeEnd))"
    do value="out.push(String(utf8bytes(retainedCode)))"
    do value="out.push(content)"
    do value="out.push(trimmed[17])"
    do value="out.push(trimmed[18])"
    return value="out"
