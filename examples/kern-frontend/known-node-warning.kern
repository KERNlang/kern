fn name=observeknownnodewarning returns="string[]" export=true
  param name=content type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxStreamRecords type=number
  param name=maxLexicalDepth type=number
  param name=maxCatalogEntries type=number
  param name=runtimeInstance type=number
  param name=parseEpoch type=number
  param name=evolvedTypes type="string[]"
  param name=multilineTypes type="string[]"
  param name=templateTypes type="string[]"
  param name=maxRegistryEntries type=number
  param name=maxNameCodePoints type=number
  param name=maxNameBytes type=number
  param name=maxInheritedFields type=number
  param name=inheritedFormat type=string
  param name=warningCode type=string
  param name=warningSeverity type=string
  handler lang="kern"
    let name=inherited value="observemutablenodetyperegistrysnapshot(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth, maxCatalogEntries, runtimeInstance, parseEpoch, evolvedTypes, multilineTypes, templateTypes, maxRegistryEntries, maxNameCodePoints, maxNameBytes)"
    let name=failureCode value="\"\""
    let name=failureDetail value="\"\""
    let name=state value="\"dropped\""
    let name=admission value="\"dropped\""
    let name=admittedType value="\"\""
    let name=builtin value="\"none\""
    let name=evolved value="\"none\""
    let name=multiline value="\"none\""
    let name=template value="\"none\""
    let name=warning value="\"none\""
    let name=warningCount value="0"
    let name=catalogIndex value="\"none\""

    if cond="inherited.length < 17 || inherited.length > maxInheritedFields || (inherited.length - 1) % 16 != 0 || inherited[0] != inheritedFormat"
      assign target=failureCode value="\"WARNING_INVALID\""
    else
      if cond="inherited[1] == \"failure\""
        if cond="inherited.length != 17"
          assign target=failureCode value="\"WARNING_INVALID\""
        else
          assign target=failureCode value="inherited[2]"
          assign target=failureDetail value="inherited[3]"
      else
        if cond="inherited[1] != \"decision\" || (inherited[2] != \"admitted\" && inherited[2] != \"dropped\")"
          assign target=failureCode value="\"WARNING_INVALID\""
        else
          assign target=admission value="inherited[2]"
          if cond="admission == \"admitted\""
            assign target=admittedType value="inherited[3]"
            assign target=builtin value="String(inherited[4] == \"builtin\")"
            assign target=evolved value="inherited[7]"
            assign target=multiline value="inherited[8]"
            assign target=template value="inherited[9]"
            assign target=catalogIndex value="inherited[5]"
            if cond="admittedType == \"\" || (evolved != \"true\" && evolved != \"false\") || (multiline != \"true\" && multiline != \"false\") || (template != \"true\" && template != \"false\")"
              assign target=failureCode value="\"WARNING_INVALID\""
            else
              assign target=state value="\"unknown\""
              assign target=warning value="\"true\""
              assign target=warningCount value="1"
              if cond="builtin == \"true\" || evolved == \"true\" || multiline == \"true\" || template == \"true\""
                assign target=state value="\"known\""
                assign target=warning value="\"false\""
                assign target=warningCount value="0"

    let name=out value="[]"
    do value="out.push(\"kern.frontend.known-node-warning-shadow.1\")"
    if cond="failureCode != \"\""
      do value="out.push(\"failure\")"
      do value="out.push(failureCode)"
      do value="out.push(failureDetail)"
      do value="out.push(String(inherited.length))"
      for name=failurePadding from=0 to=12
        do value="out.push(\"\")"
    else
      do value="out.push(\"decision\")"
      do value="out.push(state)"
      do value="out.push(admission)"
      do value="out.push(admittedType)"
      do value="out.push(builtin)"
      do value="out.push(evolved)"
      do value="out.push(multiline)"
      do value="out.push(template)"
      do value="out.push(warning)"
      do value="out.push(String(warningCount))"
      do value="out.push(String(runtimeInstance))"
      do value="out.push(String(parseEpoch))"
      do value="out.push(inheritedFormat)"
      do value="out.push(String(inherited.length))"
      do value="out.push(catalogIndex)"
      do value="out.push(\"\")"

    let name=authIndex value="0"
    for name=authStart from=0 to="inherited.length" step=12
      let name=authCount value="inherited.length - authStart"
      if cond="authCount > 12"
        assign target=authCount value="12"
      do value="out.push(\"snapshot-auth\")"
      do value="out.push(String(authIndex))"
      do value="out.push(String(authStart))"
      do value="out.push(String(authCount))"
      for name=authField from=0 to=12
        if cond="authField < authCount"
          do value="out.push(inherited[authStart + authField])"
        else
          do value="out.push(\"\")"
      assign target=authIndex value="authIndex + 1"

    if cond="failureCode != \"\""
      do value="out.push(\"failure-seal\")"
      do value="out.push(failureCode)"
      do value="out.push(failureDetail)"
      do value="out.push(content)"
      do value="out.push(inheritedFormat)"
      do value="out.push(String(inherited.length))"
      do value="out.push(String(runtimeInstance))"
      do value="out.push(String(parseEpoch))"
      for name=failureSealPadding from=0 to=8
        do value="out.push(\"\")"
      return value="out"

    if cond="state == \"unknown\""
      do value="out.push(\"diagnostic\")"
      do value="out.push(warningCode)"
      do value="out.push(warningSeverity)"
      do value="out.push(\"1\")"
      do value="out.push(\"1\")"
      do value="out.push(String(1 + utf16units(admittedType)))"
      do value="out.push(admittedType)"
      for name=diagnosticPadding from=0 to=9
        do value="out.push(\"\")"

    do value="out.push(\"seal\")"
    do value="out.push(state)"
    do value="out.push(warning)"
    do value="out.push(admittedType)"
    do value="out.push(builtin)"
    do value="out.push(evolved)"
    do value="out.push(multiline)"
    do value="out.push(template)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    do value="out.push(content)"
    do value="out.push(inheritedFormat)"
    do value="out.push(String(inherited.length))"
    do value="out.push(String(warningCount))"
    do value="out.push(admission)"
    do value="out.push(catalogIndex)"
    return value="out"
