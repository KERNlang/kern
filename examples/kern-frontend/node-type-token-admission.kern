fn name=admissionfailure returns="string[]"
  param name=code type=string
  param name=detail type=string
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(\"kern.frontend.node-type-token-admission-shadow.1\")"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    do value="out.push(detail)"
    for name=padding from=0 to=13
      do value="out.push(\"\")"
    return value="out"

fn name=utf16units returns=number
  param name=value type=string
  handler lang="kern"
    let name=units value="0"
    let name=i value="0"
    while cond="i < Text.length(value)"
      let name=ch value="Text.charAt(value, i)"
      if cond="utf8bytes(ch) == 4"
        assign target=units value="units + 2"
      else
        assign target=units value="units + 1"
      assign target=i value="i + 1"
    return value="units"

fn name=validretainedtokenkind returns=boolean
  param name=kind type=string
  handler lang="kern"
    return value="kind == \"comma\" || kind == \"equals\" || kind == \"expr\" || kind == \"identifier\" || kind == \"number\" || kind == \"quoted\" || kind == \"slash\" || kind == \"style\" || kind == \"themeRef\" || kind == \"unknown\" || kind == \"whitespace\""

fn name=validretaineddiagnosticcode returns=boolean
  param name=code type=string
  handler lang="kern"
    return value="code == \"INVALID_BIGINT\" || code == \"UNCLOSED_EXPR\" || code == \"UNCLOSED_STRING\" || code == \"UNCLOSED_STYLE\""

fn name=validretainedfailurecode returns=boolean
  param name=code type=string
  handler lang="kern"
    return value="code == \"CODE_POINTS_LIMIT\" || code == \"DIAGNOSTIC_LIMIT\" || code == \"EMPTY_RETAINED_CODE\" || code == \"INVALID_LIMITS\" || code == \"LEXICAL_DEPTH_LIMIT\" || code == \"RECORD_LIMIT\" || code == \"STREAM_INVALID\" || code == \"TOKEN_LIMIT\" || code == \"TRIM_INVALID\" || code == \"UNSUPPORTED_UNKNOWN\""

fn name=observenodetypetokenadmission returns="string[]" export=true
  param name=content type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxStreamRecords type=number
  param name=maxLexicalDepth type=number
  handler lang="kern"
    let name=stream value="observeretainedtokenstream(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth)"
    if cond="stream.length >= 2 && stream[1] == \"failure\""
      if cond="stream.length != 11 || stream[0] != \"kern.frontend.retained-token-stream-shadow.1\" || !validretainedfailurecode(stream[2]) || stream[3] != \"\""
        let name=inheritedEnvelopeFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
        return value="inheritedEnvelopeFailure"
      for name=inheritedPadding from=4 to=11
        if cond="stream[inheritedPadding] != \"\""
          let name=inheritedPaddingFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
          return value="inheritedPaddingFailure"
      let name=inheritedFailure value="admissionfailure(stream[2], stream[3])"
      return value="inheritedFailure"
    if cond="stream.length < 31 || stream[0] != \"kern.frontend.retained-token-stream-shadow.1\" || (stream.length - 1) % 10 != 0"
      let name=envelopeFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
      return value="envelopeFailure"
    if cond="stream[1] != \"stream\" || stream[2] != \"0\" || stream[3] != content || stream[10] != stream[4]"
      let name=headerFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
      return value="headerFailure"

    let name=contentLength value="Text.length(content)"
    let name=codeEnd value="parseboundeduinttext(stream[4], contentLength)"
    let name=triviaEnd value="parseboundeduinttext(stream[5], contentLength)"
    if cond="codeEnd < 0 || triviaEnd < codeEnd || triviaEnd > contentLength"
      let name=boundaryFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
      return value="boundaryFailure"
    let name=markerOffsetText value="stream[6]"
    if cond="markerOffsetText == \"none\""
      if cond="stream[7] != \"none\" || stream[8] != \"\" || stream[9] != \"\" || codeEnd != contentLength || triviaEnd != contentLength"
        let name=recordEndMarkerFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
        return value="recordEndMarkerFailure"
    else
      let name=markerOffset value="parseboundeduinttext(markerOffsetText, contentLength)"
      if cond="markerOffset < 0 || markerOffset != triviaEnd || codeEnd >= triviaEnd"
        let name=markerOffsetFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
        return value="markerOffsetFailure"
      let name=markerFirst value="Text.charAt(content, markerOffset)"
      let name=expectedMarkerKind value="\"hash\""
      let name=expectedMarkerText value="\"#\""
      let name=payloadStart value="markerOffset + 1"
      if cond="markerFirst != \"#\""
        if cond="markerFirst != \"/\" || markerOffset + 1 >= contentLength || Text.charAt(content, markerOffset + 1) != \"/\""
          let name=markerSyntaxFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
          return value="markerSyntaxFailure"
        assign target=expectedMarkerKind value="\"slash-slash\""
        assign target=expectedMarkerText value="\"//\""
        assign target=payloadStart value="markerOffset + 2"
      if cond="stream[7] != expectedMarkerKind || stream[8] != expectedMarkerText || stream[9] != Text.slice(content, payloadStart, contentLength)"
        let name=markerEvidenceFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
        return value="markerEvidenceFailure"
    let name=retainedSource value="Text.slice(content, 0, codeEnd)"
    if cond="Text.length(retainedSource) == 0"
      let name=emptySuccessFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
      return value="emptySuccessFailure"
    let name=retainedByteLength value="utf8bytes(retainedSource)"

    let name=tokenCount value="0"
    let name=diagnosticCount value="0"
    let name=tokenStartCursor value="0"
    let name=tokenStartByteCursor value="0"
    let name=diagnosticStartCursor value="0"
    let name=diagnosticStartByteCursor value="0"
    let name=tokenZeroKind value="\"\""
    let name=tokenZeroValue value="\"\""
    let name=tokenZeroStart value="-1"
    let name=firstNonWhitespaceIndex value="-1"
    let name=firstNonWhitespaceStart value="-1"
    let name=firstNonWhitespaceKind value="\"\""
    let name=phase value="\"token\""
    let name=sealed value="false"

    for name=cursor from=11 to="stream.length" step=10
      let name=tag value="stream[cursor]"
      if cond="tag == \"token\""
        if cond="phase != \"token\" || stream[cursor + 1] != String(tokenCount) || !validretainedtokenkind(stream[cursor + 2]) || stream[cursor + 7] != \"\" || stream[cursor + 8] != \"\" || stream[cursor + 9] != \"\""
          let name=tokenShapeFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
          return value="tokenShapeFailure"
        let name=tokenDelta value="stream[cursor + 4]"
        let name=tokenStart value="parseboundeduinttext(stream[cursor + 5], codeEnd)"
        let name=tokenStartByte value="parseboundeduinttext(stream[cursor + 6], retainedByteLength)"
        let name=nextTokenStart value="tokenStartCursor + Text.length(tokenDelta)"
        let name=nextTokenStartByte value="tokenStartByteCursor + utf8bytes(tokenDelta)"
        if cond="tokenStart < 0 || tokenStartByte < 0 || nextTokenStart != tokenStart || nextTokenStartByte != tokenStartByte || Text.slice(retainedSource, tokenStartCursor, tokenStart) != tokenDelta"
          let name=tokenCoordinateFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
          return value="tokenCoordinateFailure"
        assign target=tokenStartCursor value="nextTokenStart"
        assign target=tokenStartByteCursor value="nextTokenStartByte"
        if cond="tokenCount == 0"
          assign target=tokenZeroKind value="stream[cursor + 2]"
          assign target=tokenZeroValue value="stream[cursor + 3]"
          assign target=tokenZeroStart value="tokenStart"
        if cond="firstNonWhitespaceIndex < 0 && stream[cursor + 2] != \"whitespace\""
          assign target=firstNonWhitespaceIndex value="tokenCount"
          assign target=firstNonWhitespaceStart value="tokenStart"
          assign target=firstNonWhitespaceKind value="stream[cursor + 2]"
        assign target=tokenCount value="tokenCount + 1"
      else
        if cond="tag == \"diagnostic\""
          if cond="phase == \"seal\" || stream[cursor + 1] != String(diagnosticCount) || !validretaineddiagnosticcode(stream[cursor + 2]) || stream[cursor + 9] != \"\""
            let name=diagnosticShapeFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
            return value="diagnosticShapeFailure"
          assign target=phase value="\"diagnostic\""
          let name=diagnosticStart value="parseboundeduinttext(stream[cursor + 5], codeEnd)"
          let name=diagnosticEnd value="parseboundeduinttext(stream[cursor + 6], codeEnd)"
          let name=diagnosticStartByte value="parseboundeduinttext(stream[cursor + 7], retainedByteLength)"
          let name=diagnosticEndByte value="parseboundeduinttext(stream[cursor + 8], retainedByteLength)"
          let name=diagnosticDelta value="stream[cursor + 3]"
          let name=diagnosticSpan value="stream[cursor + 4]"
          let name=nextDiagnosticStart value="diagnosticStartCursor + Text.length(diagnosticDelta)"
          let name=nextDiagnosticStartByte value="diagnosticStartByteCursor + utf8bytes(diagnosticDelta)"
          if cond="diagnosticStart < 0 || diagnosticEnd < diagnosticStart || diagnosticStartByte < 0 || diagnosticEndByte < diagnosticStartByte || nextDiagnosticStart != diagnosticStart || nextDiagnosticStartByte != diagnosticStartByte || diagnosticEnd != diagnosticStart + Text.length(diagnosticSpan) || diagnosticEndByte != diagnosticStartByte + utf8bytes(diagnosticSpan) || Text.slice(retainedSource, diagnosticStartCursor, diagnosticStart) != diagnosticDelta || Text.slice(retainedSource, diagnosticStart, diagnosticEnd) != diagnosticSpan"
            let name=diagnosticCoordinateFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
            return value="diagnosticCoordinateFailure"
          assign target=diagnosticStartCursor value="nextDiagnosticStart"
          assign target=diagnosticStartByteCursor value="nextDiagnosticStartByte"
          assign target=diagnosticCount value="diagnosticCount + 1"
        else
          if cond="tag == \"seal\""
            if cond="cursor != stream.length - 10 || stream[cursor + 1] != String(tokenCount) || stream[cursor + 2] != String(diagnosticCount) || Text.slice(retainedSource, tokenStartCursor, codeEnd) != stream[cursor + 3] || Text.slice(retainedSource, diagnosticStartCursor, codeEnd) != stream[cursor + 4] || stream[cursor + 5] != String(Text.length(retainedSource)) || stream[cursor + 6] != String(retainedByteLength) || stream[cursor + 7] != content || stream[cursor + 8] != stream[4] || stream[cursor + 9] != stream[5]"
              let name=sealFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
              return value="sealFailure"
            assign target=phase value="\"seal\""
            assign target=sealed value="true"
          else
            let name=tagFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
            return value="tagFailure"

    if cond="!sealed || tokenCount <= 0 || tokenCount > maxTokens || diagnosticCount > maxDiagnostics || tokenCount + diagnosticCount > maxStreamRecords || tokenZeroStart != 0 || firstNonWhitespaceIndex < 0"
      let name=countFailure value="admissionfailure(\"ADMISSION_INVALID\", \"\")"
      return value="countFailure"

    let name=status value="\"dropped\""
    let name=cursorAfter value="0"
    let name=admittedType value="\"\""
    let name=retainedUtf16Length value="utf16units(retainedSource)"
    let name=firstNonWhitespaceUtf16Start value="utf16units(Text.slice(retainedSource, 0, firstNonWhitespaceStart))"
    if cond="tokenZeroKind == \"identifier\""
      assign target=status value="\"admitted\""
      assign target=cursorAfter value="1"
      assign target=admittedType value="tokenZeroValue"

    let name=out value="[]"
    let name=inheritedStreamFieldCount value="stream.length"
    do value="out.push(\"kern.frontend.node-type-token-admission-shadow.1\")"
    do value="out.push(\"decision\")"
    do value="out.push(status)"
    do value="out.push(retainedSource)"
    do value="out.push(\"0\")"
    do value="out.push(String(cursorAfter))"
    do value="out.push(String(tokenCount))"
    do value="out.push(tokenZeroKind)"
    do value="out.push(tokenZeroValue)"
    do value="out.push(String(tokenZeroStart))"
    do value="out.push(String(firstNonWhitespaceIndex))"
    do value="out.push(String(firstNonWhitespaceStart))"
    do value="out.push(admittedType)"
    do value="out.push(stream[0])"
    do value="out.push(stream[4])"
    do value="out.push(stream[5])"
    do value="out.push(String(inheritedStreamFieldCount))"

    let name=streamAuthIndex value="0"
    for name=streamAuthStart from=0 to="inheritedStreamFieldCount" step=12
      let name=streamAuthCount value="inheritedStreamFieldCount - streamAuthStart"
      if cond="streamAuthCount > 12"
        assign target=streamAuthCount value="12"
      let name=streamAuthField0 value="stream[streamAuthStart]"
      let name=streamAuthField1 value="\"\""
      let name=streamAuthField2 value="\"\""
      let name=streamAuthField3 value="\"\""
      let name=streamAuthField4 value="\"\""
      let name=streamAuthField5 value="\"\""
      let name=streamAuthField6 value="\"\""
      let name=streamAuthField7 value="\"\""
      let name=streamAuthField8 value="\"\""
      let name=streamAuthField9 value="\"\""
      let name=streamAuthField10 value="\"\""
      let name=streamAuthField11 value="\"\""
      if cond="streamAuthCount > 1"
        assign target=streamAuthField1 value="stream[streamAuthStart + 1]"
      if cond="streamAuthCount > 2"
        assign target=streamAuthField2 value="stream[streamAuthStart + 2]"
      if cond="streamAuthCount > 3"
        assign target=streamAuthField3 value="stream[streamAuthStart + 3]"
      if cond="streamAuthCount > 4"
        assign target=streamAuthField4 value="stream[streamAuthStart + 4]"
      if cond="streamAuthCount > 5"
        assign target=streamAuthField5 value="stream[streamAuthStart + 5]"
      if cond="streamAuthCount > 6"
        assign target=streamAuthField6 value="stream[streamAuthStart + 6]"
      if cond="streamAuthCount > 7"
        assign target=streamAuthField7 value="stream[streamAuthStart + 7]"
      if cond="streamAuthCount > 8"
        assign target=streamAuthField8 value="stream[streamAuthStart + 8]"
      if cond="streamAuthCount > 9"
        assign target=streamAuthField9 value="stream[streamAuthStart + 9]"
      if cond="streamAuthCount > 10"
        assign target=streamAuthField10 value="stream[streamAuthStart + 10]"
      if cond="streamAuthCount > 11"
        assign target=streamAuthField11 value="stream[streamAuthStart + 11]"
      do value="out.push(\"stream-auth\")"
      do value="out.push(String(streamAuthIndex))"
      do value="out.push(String(streamAuthStart))"
      do value="out.push(String(streamAuthCount))"
      do value="out.push(streamAuthField0)"
      do value="out.push(streamAuthField1)"
      do value="out.push(streamAuthField2)"
      do value="out.push(streamAuthField3)"
      do value="out.push(streamAuthField4)"
      do value="out.push(streamAuthField5)"
      do value="out.push(streamAuthField6)"
      do value="out.push(streamAuthField7)"
      do value="out.push(streamAuthField8)"
      do value="out.push(streamAuthField9)"
      do value="out.push(streamAuthField10)"
      do value="out.push(streamAuthField11)"
      assign target=streamAuthIndex value="streamAuthIndex + 1"

    if cond="status == \"dropped\""
      do value="out.push(\"diagnostic\")"
      do value="out.push(\"DROPPED_LINE\")"
      do value="out.push(\"error\")"
      do value="out.push(\"Dropped line 1: expected a node type at the start of the line\")"
      do value="out.push(\"1\")"
      do value="out.push(String(firstNonWhitespaceUtf16Start + 1))"
      do value="out.push(String(retainedUtf16Length + 1))"
      do value="out.push(\"Rewrite this line so it starts with a valid KERN node type and move stray symbols into props.\")"
      do value="out.push(\"parser\")"
      for name=diagnosticPadding from=0 to=7
        do value="out.push(\"\")"

      do value="out.push(\"error\")"
      do value="out.push(\"__error\")"
      do value="out.push(\"0\")"
      do value="out.push(String(retainedUtf16Length))"
      do value="out.push(\"Dropped line 1: expected a node type\")"
      do value="out.push(retainedSource)"
      do value="out.push(\"DROPPED_LINE\")"
      do value="out.push(\"absent\")"
      do value="out.push(\"0\")"
      do value="out.push(\"0\")"
      do value="out.push(\"0\")"
      do value="out.push(\"1\")"
      do value="out.push(\"1\")"
      do value="out.push(\"1\")"
      do value="out.push(String(retainedUtf16Length + 1))"
      do value="out.push(\"\")"

    do value="out.push(\"seal\")"
    do value="out.push(status)"
    do value="out.push(retainedSource)"
    do value="out.push(String(tokenCount))"
    do value="out.push(String(cursorAfter))"
    do value="out.push(String(firstNonWhitespaceIndex))"
    do value="out.push(admittedType)"
    if cond="status == \"admitted\""
      do value="out.push(\"0\")"
      do value="out.push(\"0\")"
    else
      do value="out.push(\"1\")"
      do value="out.push(\"1\")"
    do value="out.push(String(Text.length(retainedSource)))"
    do value="out.push(String(retainedByteLength))"
    do value="out.push(content)"
    do value="out.push(stream[4])"
    do value="out.push(stream[5])"
    do value="out.push(stream[7])"
    do value="out.push(\"\")"
    return value="out"
