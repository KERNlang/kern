fn name=f5sortproperties returns="string[]"
  param name=keys type="string[]"
  param name=values type="string[]"
  handler lang="kern"
    let name=out value="[]"
    let name=usedOrdinals value="[]"
    for name=outIndex from=0 to=keys.length
      let name=selectedIndex value="-1"
      for name=candidateIndex from=0 to=keys.length
        let name=used value="false"
        for name=usedIndex from=0 to=usedOrdinals.length
          if cond="usedOrdinals[usedIndex] == candidateIndex"
            assign target=used value="true"
        if cond="!used"
          if cond="selectedIndex < 0"
            assign target=selectedIndex value=candidateIndex
          else
            let name=candidateKey value="List.index(keys, candidateIndex)"
            let name=currentKey value="List.index(keys, selectedIndex)"
            if cond="candidateKey < currentKey"
              assign target=selectedIndex value=candidateIndex
      if cond="selectedIndex < 0"
        return value="[]"
      let name=selectedKey value="List.index(keys, selectedIndex)"
      let name=selectedValue value="List.index(values, selectedIndex)"
      do value="usedOrdinals.push(selectedIndex)"
      do value="out.push(selectedKey)"
      do value="out.push(selectedValue)"
    return value=out

fn name=f5projecttree returns="string[]"
  param name=declarationTape type=string
  param name=occurrenceTape type=string
  param name=presenceTape type=string
  param name=attachmentTape type=string
  param name=decoratorTape type=string
  param name=expressionOccurrenceOrdinals type="number[]"
  param name=expressionValues type="string[]"
  handler lang="kern"
    let name=declarations value="f5rowread(declarationTape)"
    let name=occurrences value="f5rowread(occurrenceTape)"
    let name=presences value="f5rowread(presenceTape)"
    let name=attachments value="f5rowread(attachmentTape)"
    let name=decorators value="f5rowread(decoratorTape)"
    let name=nodes value="new Map()"
    for name=seedIndex from=0 to=declarations.length
      let name=seedDeclaration value="f5rowread(List.index(declarations, seedIndex))"
      if cond="seedDeclaration[2] == \"decorator\""
        let name=seedLogical value="seedDeclaration[1]"
        let name=seedPropertyKeys value="[]"
        let name=seedPropertyValues value="[]"
        for name=seedPresenceIndex from=0 to=presences.length
          let name=seedPresence value="f5rowread(List.index(presences, seedPresenceIndex))"
          if cond="seedPresence.length == 3 && seedPresence[0] == seedLogical && seedPresence[2] != \"-1\""
            let name=seedOccurrenceOrdinal value="f5uint(seedPresence[2])"
            if cond="seedOccurrenceOrdinal < 0 || seedOccurrenceOrdinal >= occurrences.length"
              return value="[]"
            let name=seedOccurrence value="f5rowread(List.index(occurrences, seedOccurrenceOrdinal))"
            if cond="seedOccurrence.length != 13 || seedOccurrence[1] != seedLogical || seedOccurrence[3] != seedPresence[1]"
              return value="[]"
            let name=seedExpressionValue value="\"\""
            for name=seedEvidenceIndex from=0 to=expressionOccurrenceOrdinals.length
              if cond="expressionOccurrenceOrdinals[seedEvidenceIndex] == seedOccurrenceOrdinal"
                assign target=seedExpressionValue value="List.index(expressionValues, seedEvidenceIndex)"
            let name=seedProjected value="f5projectproperty(seedOccurrence[5], seedOccurrence[7], seedOccurrence[12], seedOccurrence[8], seedExpressionValue)"
            if cond="seedProjected == \"\""
              return value="[]"
            do value="seedPropertyKeys.push(seedOccurrence[3])"
            do value="seedPropertyValues.push(seedProjected)"
        let name=seedSorted value="f5sortproperties(seedPropertyKeys, seedPropertyValues)"
        let name=seedSortedKeys value="[]"
        let name=seedSortedValues value="[]"
        for name=seedSortedIndex from=0 to=seedSorted.length step=2
          do value="seedSortedKeys.push(List.index(seedSorted, seedSortedIndex))"
          let name=seedValueIndex value="seedSortedIndex + 1"
          do value="seedSortedValues.push(List.index(seedSorted, seedValueIndex))"
        let name=seedNodeKeys value="[]"
        do value="seedNodeKeys.push(\"children\")"
        do value="seedNodeKeys.push(\"kind\")"
        do value="seedNodeKeys.push(\"properties\")"
        let name=seedChildren value="[]"
        let name=seedNodeValues value="[]"
        do value="seedNodeValues.push(f5list(seedChildren))"
        do value="seedNodeValues.push(f5text(\"decorator\"))"
        do value="seedNodeValues.push(f5record(seedSortedKeys, seedSortedValues))"
        let name=seedNode value="f5record(seedNodeKeys, seedNodeValues)"
        do value="Map.set(nodes, String(seedLogical), seedNode)"
    let name=cursor value="declarations.length - 1"
    while cond="cursor >= 0"
      let name=declarationRow value="List.index(declarations, cursor)"
      let name=declaration value="f5rowread(declarationRow)"
      if cond="declaration.length != 10"
        return value="[]"
      let name=logical value="declaration[1]"
      let name=kind value="declaration[2]"
      let name=propertyKeys value="[]"
      let name=propertyValues value="[]"
      for name=presenceIndex from=0 to=presences.length
        let name=presenceRow value="List.index(presences, presenceIndex)"
        let name=presence value="f5rowread(presenceRow)"
        if cond="presence.length == 3 && presence[0] == logical && presence[2] != \"-1\""
          let name=occurrenceOrdinal value="f5uint(presence[2])"
          if cond="occurrenceOrdinal < 0 || occurrenceOrdinal >= occurrences.length"
            return value="[]"
          let name=occurrenceRow value="List.index(occurrences, occurrenceOrdinal)"
          let name=occurrence value="f5rowread(occurrenceRow)"
          if cond="occurrence.length != 13 || occurrence[1] != logical || occurrence[3] != presence[1]"
            return value="[]"
          if cond="!(kind == \"fn\" && occurrence[3] == \"params\" && f5trim(occurrence[12]) == \"\")"
            let name=expressionValue value="\"\""
            for name=evidenceIndex from=0 to=expressionOccurrenceOrdinals.length
              if cond="expressionOccurrenceOrdinals[evidenceIndex] == occurrenceOrdinal"
                assign target=expressionValue value="expressionValues[evidenceIndex]"
            let name=propertyTag value="List.index(occurrence, 5)"
            let name=propertyAtom value="List.index(occurrence, 7)"
            let name=propertyRaw value="List.index(occurrence, 12)"
            let name=propertyExtra value="List.index(occurrence, 8)"
            let name=projected value="f5projectproperty(propertyTag, propertyAtom, propertyRaw, propertyExtra, expressionValue)"
            if cond="projected == \"\""
              return value="[]"
            do value="propertyKeys.push(occurrence[3])"
            do value="propertyValues.push(projected)"
      let name=sorted value="f5sortproperties(propertyKeys, propertyValues)"
      let name=sortedPropertyKeys value="[]"
      let name=sortedPropertyValues value="[]"
      for name=sortedIndex from=0 to=sorted.length step=2
        let name=sortedKey value="List.index(sorted, sortedIndex)"
        let name=sortedValueIndex value="sortedIndex + 1"
        let name=sortedValue value="List.index(sorted, sortedValueIndex)"
        do value="sortedPropertyKeys.push(sortedKey)"
        do value="sortedPropertyValues.push(sortedValue)"
      let name=children value="[]"
      for name=attachmentIndex from=0 to=attachments.length
        let name=attachmentRow value="List.index(attachments, attachmentIndex)"
        let name=attachment value="f5rowread(attachmentRow)"
        if cond="attachment.length == 3 && attachment[0] == logical && attachment[2] == \"attached\""
          let name=childKey value="attachment[1]"
          if cond="!Map.has(nodes, childKey)"
            return value="[]"
          let name=childValue value="Map.get(nodes, childKey)"
          do value="children.push(childValue)"
      let name=decoratorChildren value="[]"
      for name=decoratorIndex from=0 to=decorators.length
        let name=decoratorRow value="List.index(decorators, decoratorIndex)"
        let name=decorator value="f5rowread(decoratorRow)"
        if cond="decorator.length == 6 && decorator[1] == \"attached\" && decorator[2] == logical"
          let name=decoratorKey value="decorator[0]"
          if cond="!Map.has(nodes, decoratorKey)"
            return value="[]"
          let name=decoratorChild value="Map.get(nodes, decoratorKey)"
          do value="decoratorChildren.push(decoratorChild)"
      let name=orderedChildren value="[]"
      let name=decoratorCursor value="decoratorChildren.length - 1"
      while cond="decoratorCursor >= 0"
        let name=orderedDecorator value="List.index(decoratorChildren, decoratorCursor)"
        do value="orderedChildren.push(orderedDecorator)"
        assign target=decoratorCursor value="decoratorCursor - 1"
      for name=existingChildIndex from=0 to=children.length
        let name=orderedChild value="List.index(children, existingChildIndex)"
        do value="orderedChildren.push(orderedChild)"
      let name=childrenValue value="f5list(orderedChildren)"
      let name=kindValue value="f5text(kind)"
      let name=propertiesValue value="f5record(sortedPropertyKeys, sortedPropertyValues)"
      let name=nodeKeys value="[]"
      do value="nodeKeys.push(\"children\")"
      do value="nodeKeys.push(\"kind\")"
      do value="nodeKeys.push(\"properties\")"
      let name=nodeValues value="[]"
      do value="nodeValues.push(childrenValue)"
      do value="nodeValues.push(kindValue)"
      do value="nodeValues.push(propertiesValue)"
      let name=node value="f5record(nodeKeys, nodeValues)"
      do value="Map.set(nodes, String(logical), node)"
      assign target=cursor value="cursor - 1"
    let name=roots value="[]"
    for name=rootIndex from=0 to=declarations.length
      let name=root value="f5rowread(declarations[rootIndex])"
      if cond="root[8] == \"-1\" && root[9] == \"false\" && root[2] != \"decorator\""
        let name=attached value="false"
        for name=edgeIndex from=0 to=attachments.length
          let name=edge value="f5rowread(attachments[edgeIndex])"
          if cond="edge[1] == root[1] && edge[2] == \"attached\""
            assign target=attached value="true"
        if cond="!attached"
          do value="roots.push(Map.get(nodes, root[1]))"
    return value=roots
