fn name=f4bframebytes returns=number
  param name=value type=string
  handler lang="kern"
    let name=scalarLength value="Text.length(value)"
    return value="2 + Text.length(String(scalarLength)) + Text.utf8Length(value)"

fn name=f4bframescalars returns=number
  param name=value type=string
  handler lang="kern"
    let name=scalarLength value="Text.length(value)"
    return value="2 + Text.length(String(scalarLength)) + scalarLength"

fn name=f4btenbytes returns=number
  param name=field0 type=string
  param name=field1 type=string
  param name=field2 type=string
  param name=field3 type=string
  param name=field4 type=string
  param name=field5 type=string
  param name=field6 type=string
  param name=field7 type=string
  param name=field8 type=string
  param name=field9 type=string
  handler lang="kern"
    return value="Text.utf8Length(field0) + Text.utf8Length(field1) + Text.utf8Length(field2) + Text.utf8Length(field3) + Text.utf8Length(field4) + Text.utf8Length(field5) + Text.utf8Length(field6) + Text.utf8Length(field7) + Text.utf8Length(field8) + Text.utf8Length(field9)"

fn name=f4bnonprooffailure returns="string[]"
  param name=code type=string
  handler lang="kern"
    let name=fact value="f4item(code) + f4item(\"\") + f4item(\"\")"
    let name=facts value="f4item(fact)"
    return value="[\"kern.frontend.f4-module-set.4\", \"fatal\", \"\", \"\", facts, \"\", \"\", \"\", \"\", \"failure\"]"

fn name=f4bproofresult returns="string[]"
  param name=kind type=string
  param name=moduleCount type=number
  param name=prefixCount type=number
  param name=priorSymbols type=number
  param name=priorBindings type=number
  param name=crossingSymbols type=number
  param name=crossingBindings type=number
  param name=maxEncodedBytes type=number
  handler lang="kern"
    let name=fact value="f4item(\"F4_LIMIT\") + f4item(\"\") + f4item(\"\")"
    let name=facts value="f4item(fact)"
    let name=witnessRow value="f4item(\"resource-prefix\") + f4item(kind) + f4item(String(moduleCount)) + f4item(String(prefixCount)) + f4item(String(priorSymbols)) + f4item(String(priorBindings)) + f4item(String(crossingSymbols)) + f4item(String(crossingBindings))"
    let name=witness value="f4item(witnessRow)"
    let name=terminal value="\"module-set:fatal:\" + String(moduleCount) + \":0:0:1:0:0:0:\" + String(Text.length(witness)) + \":\" + kind + \":closed\""
    let name=bytes value="f4btenbytes(\"kern.frontend.f4-module-set.4\", \"fatal\", \"\", \"\", facts, \"\", \"\", \"\", witness, terminal)"
    if cond="bytes > maxEncodedBytes"
      let name=overflow value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=overflow
    return value="[\"kern.frontend.f4-module-set.4\", \"fatal\", \"\", \"\", facts, \"\", \"\", \"\", witness, terminal]"

fn name=f4bfullresult returns="string[]"
  param name=status type=string
  param name=moduleCount type=number
  param name=rejectedRows type="string[]"
  param name=blockedRows type="string[]"
  param name=linkFacts type="string[]"
  param name=componentRows type="string[]"
  param name=resolvedBindings type="string[]"
  param name=identityRows type="string[]"
  param name=maxEncodedBytes type=number
  param name=baseWork type=number
  param name=maxWorkSteps type=number
  handler lang="kern"
    let name=workSteps value=baseWork
    let name=rejectedScalars value=0
    let name=rejectedBytes value=0
    for name=index from=0 to=rejectedRows.length
      assign target=rejectedScalars value="rejectedScalars + f4bframescalars(rejectedRows[index])"
      assign target=rejectedBytes value="rejectedBytes + f4bframebytes(rejectedRows[index])"
      assign target=workSteps value="workSteps + f4bframescalars(rejectedRows[index]) + f4bframebytes(rejectedRows[index]) + 1"
    let name=blockedScalars value=0
    let name=blockedBytes value=0
    for name=blockedMeasureIndex from=0 to=blockedRows.length
      assign target=blockedScalars value="blockedScalars + f4bframescalars(blockedRows[blockedMeasureIndex])"
      assign target=blockedBytes value="blockedBytes + f4bframebytes(blockedRows[blockedMeasureIndex])"
      assign target=workSteps value="workSteps + f4bframescalars(blockedRows[blockedMeasureIndex]) + f4bframebytes(blockedRows[blockedMeasureIndex]) + 1"
    let name=factScalars value=0
    let name=factBytes value=0
    for name=factMeasureIndex from=0 to=linkFacts.length
      assign target=factScalars value="factScalars + f4bframescalars(linkFacts[factMeasureIndex])"
      assign target=factBytes value="factBytes + f4bframebytes(linkFacts[factMeasureIndex])"
      assign target=workSteps value="workSteps + f4bframescalars(linkFacts[factMeasureIndex]) + f4bframebytes(linkFacts[factMeasureIndex]) + 1"
    let name=componentScalars value=0
    let name=componentBytes value=0
    for name=componentMeasureIndex from=0 to=componentRows.length
      assign target=componentScalars value="componentScalars + f4bframescalars(componentRows[componentMeasureIndex])"
      assign target=componentBytes value="componentBytes + f4bframebytes(componentRows[componentMeasureIndex])"
      assign target=workSteps value="workSteps + f4bframescalars(componentRows[componentMeasureIndex]) + f4bframebytes(componentRows[componentMeasureIndex]) + 1"
    let name=bindingScalars value=0
    let name=bindingBytes value=0
    let name=bindingOutputCount value=0
    if cond="status == \"linked\""
      assign target=bindingOutputCount value=resolvedBindings.length
      for name=index from=0 to=resolvedBindings.length
        assign target=bindingScalars value="bindingScalars + f4bframescalars(resolvedBindings[index])"
        assign target=bindingBytes value="bindingBytes + f4bframebytes(resolvedBindings[index])"
        assign target=workSteps value="workSteps + f4bframescalars(resolvedBindings[index]) + f4bframebytes(resolvedBindings[index]) + 1"
    let name=identityScalars value=0
    let name=identityBytes value=0
    for name=identityMeasureIndex from=0 to=identityRows.length
      assign target=identityScalars value="identityScalars + f4bframescalars(identityRows[identityMeasureIndex])"
      assign target=identityBytes value="identityBytes + f4bframebytes(identityRows[identityMeasureIndex])"
      assign target=workSteps value="workSteps + f4bframescalars(identityRows[identityMeasureIndex]) + f4bframebytes(identityRows[identityMeasureIndex]) + 1"
    if cond="workSteps > maxWorkSteps"
      let name=workOverflow value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=workOverflow
    let name=terminal value="\"module-set:\" + status + \":\" + String(moduleCount) + \":\" + String(rejectedRows.length) + \":\" + String(blockedRows.length) + \":\" + String(linkFacts.length) + \":\" + String(componentRows.length) + \":\" + String(bindingOutputCount) + \":\" + String(identityScalars) + \":0:full:closed\""
    let name=totalBytes value="Text.utf8Length(\"kern.frontend.f4-module-set.4\") + Text.utf8Length(status) + rejectedBytes + blockedBytes + factBytes + componentBytes + bindingBytes + identityBytes + Text.utf8Length(terminal)"
    if cond="totalBytes > maxEncodedBytes"
      let name=overflow value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=overflow
    let name=rejectedParts value="[]"
    for name=rejectedTapeIndex from=0 to=rejectedRows.length
      do value="rejectedParts.push(f4item(rejectedRows[rejectedTapeIndex]))"
    let name=rejectedFold value="f4bfoldcharged(rejectedParts, workSteps, maxWorkSteps)"
    if cond="rejectedFold[0] != \"ok\""
      let name=rejectedLimit value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=rejectedLimit
    assign target=workSteps value="f2uint(rejectedFold[2])"
    let name=blockedParts value="[]"
    for name=blockedTapeIndex from=0 to=blockedRows.length
      do value="blockedParts.push(f4item(blockedRows[blockedTapeIndex]))"
    let name=blockedFold value="f4bfoldcharged(blockedParts, workSteps, maxWorkSteps)"
    if cond="blockedFold[0] != \"ok\""
      let name=blockedLimit value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=blockedLimit
    assign target=workSteps value="f2uint(blockedFold[2])"
    let name=factParts value="[]"
    for name=factTapeIndex from=0 to=linkFacts.length
      do value="factParts.push(f4item(linkFacts[factTapeIndex]))"
    let name=factFold value="f4bfoldcharged(factParts, workSteps, maxWorkSteps)"
    if cond="factFold[0] != \"ok\""
      let name=factLimit value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=factLimit
    assign target=workSteps value="f2uint(factFold[2])"
    let name=componentParts value="[]"
    for name=componentTapeIndex from=0 to=componentRows.length
      do value="componentParts.push(f4item(componentRows[componentTapeIndex]))"
    let name=componentFold value="f4bfoldcharged(componentParts, workSteps, maxWorkSteps)"
    if cond="componentFold[0] != \"ok\""
      let name=componentLimit value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=componentLimit
    assign target=workSteps value="f2uint(componentFold[2])"
    let name=bindingParts value="[]"
    if cond="status == \"linked\""
      for name=bindingTapeIndex from=0 to=resolvedBindings.length
        do value="bindingParts.push(f4item(resolvedBindings[bindingTapeIndex]))"
    let name=bindingFold value="f4bfoldcharged(bindingParts, workSteps, maxWorkSteps)"
    if cond="bindingFold[0] != \"ok\""
      let name=bindingLimit value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=bindingLimit
    assign target=workSteps value="f2uint(bindingFold[2])"
    let name=identityParts value="[]"
    for name=identityTapeIndex from=0 to=identityRows.length
      do value="identityParts.push(f4item(identityRows[identityTapeIndex]))"
    let name=identityFold value="f4bfoldcharged(identityParts, workSteps, maxWorkSteps)"
    if cond="identityFold[0] != \"ok\""
      let name=identityLimit value="f4bnonprooffailure(\"F4_LIMIT\")"
      return value=identityLimit
    return value="[\"kern.frontend.f4-module-set.4\", status, rejectedFold[1], blockedFold[1], factFold[1], componentFold[1], bindingFold[1], identityFold[1], \"\", terminal]"
