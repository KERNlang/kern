fn name=styletrimspace returns=boolean
  param name=c type=string
  handler lang="kern"
    if cond="c == \"\\u0009\" || c == \"\\u000a\" || c == \"\\u000b\" || c == \"\\u000c\" || c == \"\\u000d\" || c == \" \""
      return value="true"
    if cond="c == \"\\u00a0\" || c == \"\\u1680\" || (c >= \"\\u2000\" && c <= \"\\u200a\")"
      return value="true"
    return value="c == \"\\u2028\" || c == \"\\u2029\" || c == \"\\u202f\" || c == \"\\u205f\" || c == \"\\u3000\" || c == \"\\ufeff\""

fn name=styletrim returns=string
  param name=value type=string
  handler lang="kern"
    let name=start value="0"
    let name=end value="Text.length(value)"
    while cond="start < end"
      let name=startChar value="Text.charAt(value, start)"
      if cond="startChar == \"\\u0009\" || startChar == \"\\u000a\" || startChar == \"\\u000b\" || startChar == \"\\u000c\" || startChar == \"\\u000d\" || startChar == \" \" || startChar == \"\\u00a0\" || startChar == \"\\u1680\" || (startChar >= \"\\u2000\" && startChar <= \"\\u200a\") || startChar == \"\\u2028\" || startChar == \"\\u2029\" || startChar == \"\\u202f\" || startChar == \"\\u205f\" || startChar == \"\\u3000\" || startChar == \"\\ufeff\""
        assign target=start value="start + 1"
      else
        break
    while cond="end > start"
      let name=endChar value="Text.charAt(value, end - 1)"
      if cond="endChar == \"\\u0009\" || endChar == \"\\u000a\" || endChar == \"\\u000b\" || endChar == \"\\u000c\" || endChar == \"\\u000d\" || endChar == \" \" || endChar == \"\\u00a0\" || endChar == \"\\u1680\" || (endChar >= \"\\u2000\" && endChar <= \"\\u200a\") || endChar == \"\\u2028\" || endChar == \"\\u2029\" || endChar == \"\\u202f\" || endChar == \"\\u205f\" || endChar == \"\\u3000\" || endChar == \"\\ufeff\""
        assign target=end value="end - 1"
      else
        break
    return value="Text.slice(value, start, end)"

fn name=styleunquote returns=string
  param name=value type=string
  handler lang="kern"
    let name=n value="Text.length(value)"
    if cond="n == 0 || Text.charAt(value, 0) != \"\\\"\" || Text.charAt(value, n - 1) != \"\\\"\""
      return value="value"
    let name=inner value="\"\""
    if cond="n > 1"
      assign target=inner value="Text.slice(value, 1, n - 1)"
    let name=first value="\"\""
    let name=i value="0"
    while cond="i < Text.length(inner)"
      let name=ch value="Text.charAt(inner, i)"
      if cond="ch == \"\\\\\" && i + 1 < Text.length(inner) && Text.charAt(inner, i + 1) == \"\\\"\""
        assign target=first value="first + \"\\\"\""
        assign target=i value="i + 2"
      else
        assign target=first value="first + ch"
        assign target=i value="i + 1"
    let name=second value="\"\""
    assign target=i value="0"
    while cond="i < Text.length(first)"
      let name=ch value="Text.charAt(first, i)"
      if cond="ch == \"\\\\\" && i + 1 < Text.length(first) && Text.charAt(first, i + 1) == \"\\\\\""
        assign target=second value="second + \"\\\\\""
        assign target=i value="i + 2"
      else
        assign target=second value="second + ch"
        assign target=i value="i + 1"
    return value="second"

fn name=stylelowerletter returns=boolean
  param name=c type=string
  handler lang="kern"
    return value="c >= \"a\" && c <= \"z\""

fn name=stylekeychar returns=boolean
  param name=c type=string
  handler lang="kern"
    return value="(c >= \"A\" && c <= \"Z\") || (c >= \"a\" && c <= \"z\") || (c >= \"0\" && c <= \"9\") || c == \"_\" || c == \"-\""

fn name=styleuint returns=number
  param name=text type=string
  handler lang="kern"
    let name=n value="Text.length(text)"
    if cond="n == 0 || (n > 1 && Text.charAt(text, 0) == \"0\")"
      return value="-1"
    let name=value value="0"
    for name=i from=0 to=n
      let name=digit value="Text.indexOf(\"0123456789\", Text.charAt(text, i))"
      if cond="digit < 0"
        return value="-1"
      assign target=value value="value * 10 + digit"
    return value="value"

fn name=stylearrayindex returns=number
  param name=key type=string
  handler lang="kern"
    if cond="Text.length(key) > 10"
      return value="-1"
    let name=value value="styleuint(key)"
    if cond="value > 4294967294"
      return value="-1"
    return value="value"

fn name=interpretstylepair returns="string[]"
  param name=pair type=string
  handler lang="kern"
    let name=out value="[]"
    let name=n value="Text.length(pair)"
    let name=kind value="\"ignored\""
    let name=pseudo value="\"\""
    let name=key value="\"\""
    let name=parsedValue value="\"\""
    let name=matched value="false"

    if cond="n > 4"
      if cond="Text.charAt(pair, 0) == \":\""
        let name=firstColon value="1"
        while cond="firstColon < n && Text.charAt(pair, firstColon) != \":\""
          assign target=firstColon value="firstColon + 1"
        if cond="firstColon > 1 && firstColon < n"
          let name=pseudoValid value="true"
          let name=pseudoIndex value="1"
          while cond="pseudoIndex < firstColon"
            if cond="!stylelowerletter(Text.charAt(pair, pseudoIndex))"
              assign target=pseudoValid value="false"
            assign target=pseudoIndex value="pseudoIndex + 1"
          let name=secondColon value="firstColon + 1"
          while cond="secondColon < n && Text.charAt(pair, secondColon) != \":\""
            assign target=secondColon value="secondColon + 1"
          if cond="pseudoValid && secondColon > firstColon + 1 && secondColon + 1 < n"
            let name=keyValid value="true"
            let name=keyIndex value="firstColon + 1"
            while cond="keyIndex < secondColon"
              if cond="!stylekeychar(Text.charAt(pair, keyIndex))"
                assign target=keyValid value="false"
              assign target=keyIndex value="keyIndex + 1"
            if cond="keyValid"
              assign target=kind value="\"pseudo\""
              assign target=pseudo value="Text.slice(pair, 1, firstColon)"
              assign target=key value="Text.slice(pair, firstColon + 1, secondColon)"
              assign target=parsedValue value="styletrim(Text.slice(pair, secondColon + 1, n))"
              assign target=matched value="true"

    if cond="!matched"
      if cond="n > 2"
        if cond="Text.charAt(pair, 0) == \"\\\"\""
          let name=closeQuote value="1"
          while cond="closeQuote < n && Text.charAt(pair, closeQuote) != \"\\\"\""
            assign target=closeQuote value="closeQuote + 1"
          if cond="closeQuote > 1 && closeQuote < n"
            let name=quotedColonIndex value="closeQuote + 1"
            while cond="quotedColonIndex < n && (Text.charAt(pair, quotedColonIndex) == \"\\u0009\" || Text.charAt(pair, quotedColonIndex) == \"\\u000a\" || Text.charAt(pair, quotedColonIndex) == \"\\u000b\" || Text.charAt(pair, quotedColonIndex) == \"\\u000c\" || Text.charAt(pair, quotedColonIndex) == \"\\u000d\" || Text.charAt(pair, quotedColonIndex) == \" \" || Text.charAt(pair, quotedColonIndex) == \"\\u00a0\" || Text.charAt(pair, quotedColonIndex) == \"\\u1680\" || (Text.charAt(pair, quotedColonIndex) >= \"\\u2000\" && Text.charAt(pair, quotedColonIndex) <= \"\\u200a\") || Text.charAt(pair, quotedColonIndex) == \"\\u2028\" || Text.charAt(pair, quotedColonIndex) == \"\\u2029\" || Text.charAt(pair, quotedColonIndex) == \"\\u202f\" || Text.charAt(pair, quotedColonIndex) == \"\\u205f\" || Text.charAt(pair, quotedColonIndex) == \"\\u3000\" || Text.charAt(pair, quotedColonIndex) == \"\\ufeff\")"
              assign target=quotedColonIndex value="quotedColonIndex + 1"
            if cond="quotedColonIndex < n && Text.charAt(pair, quotedColonIndex) == \":\""
              assign target=kind value="\"quoted-key\""
              assign target=key value="Text.slice(pair, 1, closeQuote)"
              let name=quotedTrimmedValue value="styletrim(Text.slice(pair, quotedColonIndex + 1, n))"
              assign target=parsedValue value="styleunquote(quotedTrimmedValue)"
              assign target=matched value="true"

    if cond="!matched"
      let name=normalColonIndex value="Text.indexOf(pair, \":\")"
      if cond="normalColonIndex > 0"
        assign target=kind value="\"normal\""
        assign target=key value="styletrim(Text.slice(pair, 0, normalColonIndex))"
        let name=normalTrimmedValue value="styletrim(Text.slice(pair, normalColonIndex + 1, n))"
        assign target=parsedValue value="styleunquote(normalTrimmedValue)"

    do value="out.push(kind)"
    do value="out.push(pseudo)"
    do value="out.push(key)"
    do value="out.push(parsedValue)"
    return value="out"

fn name=observestyleblockvalue returns="string[]"
  param name=block type=string
  param name=styleOrdinal type=number
  param name=tokenIndex type=number
  param name=tokenStart type=number
  param name=segmentBase type=number
  param name=pairBase type=number
  param name=writeBase type=number
  param name=maxBlockCodePoints type=number
  param name=maxBlockUtf16Units type=number
  param name=maxBlockBytes type=number
  param name=maxSegments type=number
  param name=maxPairs type=number
  param name=maxWrites type=number
  param name=maxParenDepth type=number
  param name=styleFormat type=string
  handler lang="kern"
    let name=failureCode value="\"\""
    let name=blockCodePoints value="Text.length(block)"
    let name=blockUtf16 value="utf16units(block)"
    let name=blockBytes value="utf8bytes(block)"
    if cond="maxBlockCodePoints <= 0 || maxBlockUtf16Units <= 0 || maxBlockBytes <= 0 || maxSegments <= 0 || maxPairs <= 0 || maxWrites <= 0 || maxParenDepth <= 0"
      assign target=failureCode value="\"STYLE_INVALID_LIMITS\""
    else
      if cond="blockCodePoints > maxBlockCodePoints"
        assign target=failureCode value="\"STYLE_BLOCK_CODE_POINTS_LIMIT\""
      else
        if cond="blockUtf16 > maxBlockUtf16Units"
          assign target=failureCode value="\"STYLE_BLOCK_UTF16_LIMIT\""
        else
          if cond="blockBytes > maxBlockBytes"
            assign target=failureCode value="\"STYLE_BLOCK_BYTES_LIMIT\""

    let name=records value="[]"
    let name=segmentCount value="0"
    let name=pairCount value="0"
    let name=writeCount value="0"
    let name=segmentStart value="0"
    let name=segmentStartUtf16 value="0"
    let name=offsetUtf16 value="0"
    let name=inQuote value="false"
    let name=parenDepth value="0"
    let name=n value="Text.length(block)"

    let name=i value="0"
    while cond="i <= n"
      let name=atEnd value="i == n"
      let name=ch value="\"\""
      if cond="!atEnd"
        assign target=ch value="Text.charAt(block, i)"
      let name=delimiter value="atEnd"
      if cond="!atEnd"
        assign target=delimiter value="!inQuote && parenDepth == 0 && ch == \",\""
      if cond="failureCode == \"\" && !atEnd && ch == \"\\\\\" && i + 1 < n"
        assign target=offsetUtf16 value="offsetUtf16 + utf16units(ch) + utf16units(Text.charAt(block, i + 1))"
        assign target=i value="i + 1"
      else
        if cond="failureCode == \"\" && !atEnd && ch == \"\\\"\""
          assign target=inQuote value="!inQuote"
          assign target=offsetUtf16 value="offsetUtf16 + 1"
        else
          if cond="failureCode == \"\" && !atEnd && !inQuote && ch == \"(\""
            assign target=parenDepth value="parenDepth + 1"
            assign target=offsetUtf16 value="offsetUtf16 + 1"
            if cond="parenDepth > maxParenDepth"
              assign target=failureCode value="\"STYLE_PAREN_DEPTH_LIMIT\""
          else
            if cond="failureCode == \"\" && !atEnd && !inQuote && ch == \")\""
              assign target=parenDepth value="parenDepth - 1"
              assign target=offsetUtf16 value="offsetUtf16 + 1"
            else
              if cond="failureCode == \"\" && delimiter"
                if cond="segmentBase + segmentCount >= maxSegments"
                  assign target=failureCode value="\"STYLE_SEGMENT_LIMIT\""
                else
                  let name=segmentEnd value="i"
                  let name=segmentEndUtf16 value="offsetUtf16"
                  let name=trimStart value="segmentStart"
                  while cond="trimStart < segmentEnd && styletrimspace(Text.charAt(block, trimStart))"
                    assign target=trimStart value="trimStart + 1"
                  let name=trimEnd value="segmentEnd"
                  while cond="trimEnd > trimStart && styletrimspace(Text.charAt(block, trimEnd - 1))"
                    assign target=trimEnd value="trimEnd - 1"
                  let name=raw value="Text.slice(block, segmentStart, segmentEnd)"
                  let name=pair value="Text.slice(block, trimStart, trimEnd)"
                  let name=trimStartUtf16 value="segmentStartUtf16 + utf16units(Text.slice(block, segmentStart, trimStart))"
                  let name=trimEndUtf16 value="segmentStartUtf16 + utf16units(Text.slice(block, segmentStart, trimEnd))"
                  if cond="pair == \"\""
                    assign target=trimStartUtf16 value="segmentEndUtf16"
                    assign target=trimEndUtf16 value="segmentEndUtf16"
                  do value="records.push(\"segment\")"
                  do value="records.push(String(segmentBase + segmentCount))"
                  do value="records.push(String(styleOrdinal))"
                  do value="records.push(String(tokenIndex))"
                  do value="records.push(String(segmentCount))"
                  do value="records.push(String(segmentStartUtf16))"
                  do value="records.push(String(segmentEndUtf16))"
                  do value="records.push(String(trimStartUtf16))"
                  do value="records.push(String(trimEndUtf16))"
                  if cond="atEnd"
                    do value="records.push(\"none\")"
                  else
                    do value="records.push(String(offsetUtf16))"
                  do value="records.push(String(pair != \"\"))"
                  do value="records.push(raw)"
                  do value="records.push(pair)"
                  for name=segmentPadding from=0 to=11
                    do value="records.push(\"\")"

                  if cond="pair != \"\""
                    if cond="pairBase + pairCount >= maxPairs"
                      assign target=failureCode value="\"STYLE_PAIR_LIMIT\""
                    else
                      let name=interpretation value="interpretstylepair(pair)"
                      do value="records.push(\"pair\")"
                      do value="records.push(String(pairBase + pairCount))"
                      do value="records.push(String(styleOrdinal))"
                      do value="records.push(String(tokenIndex))"
                      do value="records.push(String(segmentBase + segmentCount))"
                      do value="records.push(interpretation[0])"
                      do value="records.push(interpretation[2])"
                      do value="records.push(interpretation[1])"
                      do value="records.push(interpretation[3])"
                      for name=pairPadding from=0 to=15
                        do value="records.push(\"\")"
                      assign target=pairCount value="pairCount + 1"
                      if cond="interpretation[0] != \"ignored\""
                        if cond="writeBase + writeCount >= maxWrites"
                          assign target=failureCode value="\"STYLE_WRITE_LIMIT\""
                        else
                          let name=visible value="interpretation[2] != \"__proto__\" && interpretation[1] != \"constructor\""
                          let name=targetKind value="\"style\""
                          if cond="interpretation[0] == \"pseudo\""
                            assign target=targetKind value="\"pseudo\""
                          do value="records.push(\"style-write\")"
                          do value="records.push(String(writeBase + writeCount))"
                          do value="records.push(String(styleOrdinal))"
                          do value="records.push(String(tokenIndex))"
                          do value="records.push(String(pairBase + pairCount - 1))"
                          do value="records.push(String(segmentBase + segmentCount))"
                          do value="records.push(targetKind)"
                          do value="records.push(interpretation[1])"
                          do value="records.push(interpretation[2])"
                          do value="records.push(interpretation[3])"
                          do value="records.push(String(visible))"
                          for name=writePadding from=0 to=13
                            do value="records.push(\"\")"
                          assign target=writeCount value="writeCount + 1"
                  assign target=segmentCount value="segmentCount + 1"
                  if cond="!atEnd"
                    assign target=offsetUtf16 value="offsetUtf16 + 1"
                    assign target=segmentStart value="i + 1"
                    assign target=segmentStartUtf16 value="offsetUtf16"
              else
                if cond="failureCode == \"\" && !atEnd"
                  assign target=offsetUtf16 value="offsetUtf16 + utf16units(ch)"
      assign target=i value="i + 1"

    let name=out value="[]"
    do value="out.push(styleFormat)"
    if cond="failureCode != \"\""
      do value="out.push(\"failure\")"
      do value="out.push(failureCode)"
      do value="out.push(\"\")"
      do value="out.push(String(styleOrdinal))"
      do value="out.push(String(tokenIndex))"
      do value="out.push(String(tokenStart))"
      do value="out.push(block)"
      do value="out.push(String(blockCodePoints))"
      do value="out.push(String(blockUtf16))"
      do value="out.push(String(blockBytes))"
      for name=failurePadding from=0 to=14
        do value="out.push(\"\")"
    else
      do value="out.push(\"decision\")"
      do value="out.push(String(styleOrdinal))"
      do value="out.push(String(tokenIndex))"
      do value="out.push(String(tokenStart))"
      do value="out.push(block)"
      do value="out.push(String(segmentCount))"
      do value="out.push(String(pairCount))"
      do value="out.push(String(writeCount))"
      do value="out.push(String(blockCodePoints))"
      do value="out.push(String(blockUtf16))"
      do value="out.push(String(blockBytes))"
      do value="out.push(String(inQuote))"
      do value="out.push(String(parenDepth))"
      for name=headerPadding from=0 to=11
        do value="out.push(\"\")"
      for name=recordField from=0 to="records.length"
        do value="out.push(records[recordField])"

    if cond="failureCode != \"\""
      do value="out.push(\"failure-seal\")"
      do value="out.push(failureCode)"
      do value="out.push(\"\")"
    else
      do value="out.push(\"seal\")"
      do value="out.push(String(styleOrdinal))"
      do value="out.push(String(tokenIndex))"
    do value="out.push(String(tokenStart))"
    do value="out.push(block)"
    do value="out.push(String(segmentCount))"
    do value="out.push(String(pairCount))"
    do value="out.push(String(writeCount))"
    do value="out.push(String(blockCodePoints))"
    do value="out.push(String(blockUtf16))"
    do value="out.push(String(blockBytes))"
    for name=sealPadding from=0 to=13
      do value="out.push(\"\")"
    return value="out"

fn name=stylefinalrecords returns="string[]"
  param name=styleKeys type="string[]"
  param name=pseudoNames type="string[]"
  param name=pseudoEntryPseudos type="string[]"
  param name=pseudoEntryKeys type="string[]"
  param name=writeKinds type="string[]"
  param name=writePseudos type="string[]"
  param name=writeKeys type="string[]"
  param name=writeValues type="string[]"
  param name=writeVisible type="string[]"
  handler lang="kern"
    let name=out value="[]"
    let name=styleOrder value="0"
    let name=lastNumeric value="-1"
    while cond="true"
      let name=candidateFound value="false"
      let name=candidateKey value="\"\""
      let name=candidateNumber value="4294967295"
      for name=i from=0 to="styleKeys.length"
        let name=numeric value="stylearrayindex(styleKeys[i])"
        if cond="numeric > lastNumeric && numeric < candidateNumber"
          assign target=candidateFound value="true"
          assign target=candidateKey value="styleKeys[i]"
          assign target=candidateNumber value="numeric"
      if cond="!candidateFound"
        break
      let name=finalValue value="\"\""
      for name=writeIndex from=0 to="writeKeys.length"
        if cond="writeKinds[writeIndex] == \"style\" && writeVisible[writeIndex] == \"true\" && writeKeys[writeIndex] == candidateKey"
          assign target=finalValue value="writeValues[writeIndex]"
      do value="out.push(\"final-style\")"
      do value="out.push(String(styleOrder))"
      do value="out.push(candidateKey)"
      do value="out.push(finalValue)"
      for name=padding from=0 to=20
        do value="out.push(\"\")"
      assign target=lastNumeric value="candidateNumber"
      assign target=styleOrder value="styleOrder + 1"
    for name=i from=0 to="styleKeys.length"
      if cond="stylearrayindex(styleKeys[i]) < 0"
        let name=finalValue value="\"\""
        for name=writeIndex from=0 to="writeKeys.length"
          if cond="writeKinds[writeIndex] == \"style\" && writeVisible[writeIndex] == \"true\" && writeKeys[writeIndex] == styleKeys[i]"
            assign target=finalValue value="writeValues[writeIndex]"
        do value="out.push(\"final-style\")"
        do value="out.push(String(styleOrder))"
        do value="out.push(styleKeys[i])"
        do value="out.push(finalValue)"
        for name=padding from=0 to=20
          do value="out.push(\"\")"
        assign target=styleOrder value="styleOrder + 1"

    for name=pseudoOrder from=0 to="pseudoNames.length"
      let name=pseudo value="pseudoNames[pseudoOrder]"
      let name=entryCount value="0"
      for name=i from=0 to="pseudoEntryKeys.length"
        if cond="pseudoEntryPseudos[i] == pseudo"
          assign target=entryCount value="entryCount + 1"
      do value="out.push(\"final-pseudo\")"
      do value="out.push(String(pseudoOrder))"
      do value="out.push(pseudo)"
      do value="out.push(String(entryCount))"
      for name=padding from=0 to=20
        do value="out.push(\"\")"

    let name=globalEntryOrder value="0"
    for name=finalPseudoOrder from=0 to="pseudoNames.length"
      let name=pseudo value="pseudoNames[finalPseudoOrder]"
      let name=entryCount value="0"
      for name=countIndex from=0 to="pseudoEntryKeys.length"
        if cond="pseudoEntryPseudos[countIndex] == pseudo"
          assign target=entryCount value="entryCount + 1"
      let name=keyOrder value="0"
      assign target=lastNumeric value="-1"
      while cond="true"
        let name=candidateFound value="false"
        let name=candidateKey value="\"\""
        let name=candidateNumber value="4294967295"
        for name=candidateIndex from=0 to="pseudoEntryKeys.length"
          let name=numeric value="stylearrayindex(pseudoEntryKeys[candidateIndex])"
          if cond="pseudoEntryPseudos[candidateIndex] == pseudo && numeric > lastNumeric && numeric < candidateNumber"
            assign target=candidateFound value="true"
            assign target=candidateKey value="pseudoEntryKeys[candidateIndex]"
            assign target=candidateNumber value="numeric"
        if cond="!candidateFound"
          break
        let name=finalValue value="\"\""
        for name=writeIndex from=0 to="writeKeys.length"
          if cond="writeKinds[writeIndex] == \"pseudo\" && writeVisible[writeIndex] == \"true\" && writePseudos[writeIndex] == pseudo && writeKeys[writeIndex] == candidateKey"
            assign target=finalValue value="writeValues[writeIndex]"
        do value="out.push(\"final-pseudo-entry\")"
        do value="out.push(String(globalEntryOrder))"
        do value="out.push(String(finalPseudoOrder))"
        do value="out.push(pseudo)"
        do value="out.push(String(keyOrder))"
        do value="out.push(candidateKey)"
        do value="out.push(finalValue)"
        for name=padding from=0 to=17
          do value="out.push(\"\")"
        assign target=lastNumeric value="candidateNumber"
        assign target=keyOrder value="keyOrder + 1"
        assign target=globalEntryOrder value="globalEntryOrder + 1"
      for name=stringIndex from=0 to="pseudoEntryKeys.length"
        if cond="pseudoEntryPseudos[stringIndex] == pseudo && stylearrayindex(pseudoEntryKeys[stringIndex]) < 0"
          let name=finalValue value="\"\""
          for name=writeIndex from=0 to="writeKeys.length"
            if cond="writeKinds[writeIndex] == \"pseudo\" && writeVisible[writeIndex] == \"true\" && writePseudos[writeIndex] == pseudo && writeKeys[writeIndex] == pseudoEntryKeys[stringIndex]"
              assign target=finalValue value="writeValues[writeIndex]"
          do value="out.push(\"final-pseudo-entry\")"
          do value="out.push(String(globalEntryOrder))"
          do value="out.push(String(finalPseudoOrder))"
          do value="out.push(pseudo)"
          do value="out.push(String(keyOrder))"
          do value="out.push(pseudoEntryKeys[stringIndex])"
          do value="out.push(finalValue)"
          for name=padding from=0 to=17
            do value="out.push(\"\")"
          assign target=keyOrder value="keyOrder + 1"
          assign target=globalEntryOrder value="globalEntryOrder + 1"
    return value="out"
