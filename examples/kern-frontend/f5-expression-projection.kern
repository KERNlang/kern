fn name=f5expression returns=string
  param name=limits type=string
  param name=kindTape type=string
  param name=flagTape type=string
  param name=payloadTape type=string
  param name=childTape type=string
  handler lang="kern"
    let name=kindTexts value="f5rowread(kindTape)"
    let name=flagTexts value="f5rowread(flagTape)"
    let name=payloadTapes value="f5rowread(payloadTape)"
    let name=childTapes value="f5rowread(childTape)"
    let name=kindIds value="[]"
    let name=flags value="[]"
    for name=numberIndex from=0 to=kindTexts.length
      let name=kindText value="List.index(kindTexts, numberIndex)"
      let name=flagText value="List.index(flagTexts, numberIndex)"
      let name=kindId value="f5uint(kindText)"
      let name=flag value="f5uint(flagText)"
      do value="kindIds.push(kindId)"
      do value="flags.push(flag)"
    if cond="kindIds.length == 0 || flags.length != kindIds.length || payloadTapes.length != kindIds.length || childTapes.length != kindIds.length"
      return value="\"\""
    let name=projected value="[]"
    let name=result value="\"\""
    let name=expressionWork value="Text.length(kindTape) + Text.length(flagTape) + Text.length(payloadTape) + Text.length(childTape)"
    for name=index from=0 to=kindIds.length
      let name=kind value="List.index(kindIds, index)"
      let name=payloadTapeValue value="List.index(payloadTapes, index)"
      let name=childTapeValue value="List.index(childTapes, index)"
      let name=payload value="f5rowread(payloadTapeValue)"
      let name=childText value="f5rowread(childTapeValue)"
      let name=children value="[]"
      for name=childIndex from=0 to=childText.length
        let name=childOrdinalText value="List.index(childText, childIndex)"
        let name=ordinal value="f5uint(childOrdinalText)"
        if cond="ordinal < 0 || ordinal >= index"
          return value="\"\""
        let name=projectedChild value="List.index(projected, ordinal)"
        do value="children.push(projectedChild)"
      let name=fieldKeys value="[]"
      let name=fieldValues value="[]"
      let name=kindName value="\"\""
      if cond="kind == 0"
        assign target=kindName value="\"identifier\""
        do value="fieldKeys.push(\"name\")"
        let name=identifierText value="List.index(payload, 0)"
        let name=identifierValue value="f5text(limits, identifierText)"
        do value="fieldValues.push(identifierValue)"
      else
        if cond="kind == 1"
          assign target=kindName value="\"null\""
        else
          if cond="kind == 2"
            assign target=kindName value="\"boolean\""
            do value="fieldKeys.push(\"value\")"
            let name=booleanText value="List.index(payload, 0)"
            let name=booleanValue value="f5bool(limits, booleanText == \"true\")"
            do value="fieldValues.push(booleanValue)"
          else
            if cond="kind == 3 || kind == 4 || kind == 5"
              assign target=kindName value="kind == 3 ? \"integer\" : kind == 4 ? \"decimal\" : \"text\""
              do value="fieldKeys.push(\"value\")"
              let name=literalText value="List.index(payload, 0)"
              if cond="kind == 3"
                let name=integerValue value="f5int(limits, literalText)"
                do value="fieldValues.push(integerValue)"
              else
                if cond="kind == 4"
                  let name=decimalValue value="f5decimal(limits, literalText)"
                  do value="fieldValues.push(decimalValue)"
                else
                  let name=textValue value="f5text(limits, literalText)"
                  do value="fieldValues.push(textValue)"
            else
              if cond="kind == 6"
                assign target=kindName value="\"list\""
                do value="fieldKeys.push(\"items\")"
                let name=itemsValue value="f5list(limits, children)"
                do value="fieldValues.push(itemsValue)"
              else
                if cond="kind == 7"
                  assign target=kindName value="\"record\""
                  if cond="payload.length != children.length"
                    return value="\"__F5_F4_DRIFT__\""
                  let name=sortedKeys value="[]"
                  let name=sortedValues value="[]"
                  let name=usedOrdinals value="[]"
                  for name=outIndex from=0 to=payload.length
                    let name=selected value="-1"
                    for name=candidate from=0 to=payload.length
                      assign target=expressionWork value="expressionWork + 1"
                      let name=candidateUsed value=false
                      for name=usedIndex from=0 to=usedOrdinals.length
                        assign target=expressionWork value="expressionWork + 1"
                        if cond="List.index(usedOrdinals, usedIndex) == candidate"
                          assign target=candidateUsed value=true
                      if cond="!candidateUsed"
                        if cond="selected < 0"
                          assign target=selected value=candidate
                        else
                          let name=candidateKey value="List.index(payload, candidate)"
                          let name=currentKey value="List.index(payload, selected)"
                          assign target=expressionWork value="expressionWork + f5scalarcomparework(candidateKey, currentKey)"
                          if cond="f5scalartextless(candidateKey, currentKey)"
                            assign target=selected value=candidate
                            assign target=expressionWork value="expressionWork + 1"
                    if cond="selected < 0"
                      return value="\"__F5_F4_DRIFT__\""
                    let name=selectedKey value="List.index(payload, selected)"
                    if cond="sortedKeys.length > 0 && List.index(sortedKeys, sortedKeys.length - 1) == selectedKey"
                      return value="\"__F5_F4_DRIFT__\""
                    assign target=expressionWork value="expressionWork + Text.length(selectedKey) + 3"
                    do value="usedOrdinals.push(selected)"
                    do value="sortedKeys.push(selectedKey)"
                    do value="sortedValues.push(List.index(children, selected))"
                  do value="fieldKeys.push(\"entries\")"
                  let name=entriesValue value="f5record(limits, sortedKeys, sortedValues, expressionWork)"
                  do value="fieldValues.push(entriesValue)"
                else
                  if cond="kind == 8"
                    assign target=kindName value="\"member\""
                    do value="fieldKeys.push(\"object\")"
                    do value="fieldKeys.push(\"optional\")"
                    do value="fieldKeys.push(\"property\")"
                    let name=memberObject value="List.index(children, 0)"
                    let name=memberFlag value="List.index(flags, index)"
                    let name=memberOptional value="f5bool(limits, memberFlag == 1)"
                    let name=memberPropertyText value="List.index(payload, 0)"
                    let name=memberProperty value="f5text(limits, memberPropertyText)"
                    do value="fieldValues.push(memberObject)"
                    do value="fieldValues.push(memberOptional)"
                    do value="fieldValues.push(memberProperty)"
                  else
                    if cond="kind == 9"
                      assign target=kindName value="\"index\""
                      do value="fieldKeys.push(\"index\")"
                      do value="fieldKeys.push(\"object\")"
                      do value="fieldKeys.push(\"optional\")"
                      let name=indexValue value="List.index(children, 1)"
                      let name=indexObject value="List.index(children, 0)"
                      let name=indexFlag value="List.index(flags, index)"
                      let name=indexOptional value="f5bool(limits, indexFlag == 1)"
                      do value="fieldValues.push(indexValue)"
                      do value="fieldValues.push(indexObject)"
                      do value="fieldValues.push(indexOptional)"
                    else
                      if cond="kind == 10"
                        assign target=kindName value="\"call\""
                        let name=args value="[]"
                        for name=argumentIndex from=1 to=children.length
                          let name=argumentValue value="List.index(children, argumentIndex)"
                          do value="args.push(argumentValue)"
                        do value="fieldKeys.push(\"args\")"
                        do value="fieldKeys.push(\"callee\")"
                        do value="fieldKeys.push(\"optional\")"
                        let name=argsValue value="f5list(limits, args)"
                        let name=calleeValue value="List.index(children, 0)"
                        let name=callFlag value="List.index(flags, index)"
                        let name=callOptional value="f5bool(limits, callFlag == 1)"
                        do value="fieldValues.push(argsValue)"
                        do value="fieldValues.push(calleeValue)"
                        do value="fieldValues.push(callOptional)"
                      else
                        if cond="kind == 11"
                          assign target=kindName value="\"new\""
                          do value="fieldKeys.push(\"args\")"
                          do value="fieldKeys.push(\"constructor\")"
                          let name=newArgs value="f5list(limits, children)"
                          let name=constructorText value="List.index(payload, 0)"
                          let name=constructorValue value="f5text(limits, constructorText)"
                          do value="fieldValues.push(newArgs)"
                          do value="fieldValues.push(constructorValue)"
                        else
                          if cond="kind == 12"
                            assign target=kindName value="\"lambda\""
                            let name=params value="[]"
                            for name=paramIndex from=0 to=payload.length
                              let name=paramText value="List.index(payload, paramIndex)"
                              let name=paramValue value="f5text(limits, paramText)"
                              do value="params.push(paramValue)"
                            do value="fieldKeys.push(\"body\")"
                            do value="fieldKeys.push(\"params\")"
                            let name=lambdaBody value="List.index(children, 0)"
                            let name=paramsValue value="f5list(limits, params)"
                            do value="fieldValues.push(lambdaBody)"
                            do value="fieldValues.push(paramsValue)"
                          else
                            if cond="kind == 13"
                              assign target=kindName value="\"binary\""
                              do value="fieldKeys.push(\"left\")"
                              do value="fieldKeys.push(\"op\")"
                              do value="fieldKeys.push(\"right\")"
                              let name=binaryLeft value="List.index(children, 0)"
                              let name=binaryOpText value="List.index(payload, 0)"
                              let name=binaryOp value="f5text(limits, binaryOpText)"
                              let name=binaryRight value="List.index(children, 1)"
                              do value="fieldValues.push(binaryLeft)"
                              do value="fieldValues.push(binaryOp)"
                              do value="fieldValues.push(binaryRight)"
                            else
                              if cond="kind == 14"
                                assign target=kindName value="\"unary\""
                                do value="fieldKeys.push(\"argument\")"
                                do value="fieldKeys.push(\"op\")"
                                let name=unaryArgument value="List.index(children, 0)"
                                let name=unaryOpText value="List.index(payload, 0)"
                                let name=unaryOp value="f5text(limits, unaryOpText)"
                                do value="fieldValues.push(unaryArgument)"
                                do value="fieldValues.push(unaryOp)"
                              else
                                if cond="kind != 15"
                                  return value="\"\""
                                assign target=kindName value="\"conditional\""
                                do value="fieldKeys.push(\"alternate\")"
                                do value="fieldKeys.push(\"consequent\")"
                                do value="fieldKeys.push(\"test\")"
                                let name=alternateValue value="List.index(children, 2)"
                                let name=consequentValue value="List.index(children, 1)"
                                let name=testValue value="List.index(children, 0)"
                                do value="fieldValues.push(alternateValue)"
                                do value="fieldValues.push(consequentValue)"
                                do value="fieldValues.push(testValue)"
      let name=fields value="f5record(limits, fieldKeys, fieldValues, 0)"
      let name=kindValue value="f5text(limits, kindName)"
      let name=projectedKeys value="[]"
      do value="projectedKeys.push(\"fields\")"
      do value="projectedKeys.push(\"kind\")"
      let name=projectedValues value="[]"
      do value="projectedValues.push(fields)"
      do value="projectedValues.push(kindValue)"
      let name=projectedValue value="f5record(limits, projectedKeys, projectedValues, 0)"
      do value="projected.push(projectedValue)"
      assign target=result value=projectedValue
    return value=result
