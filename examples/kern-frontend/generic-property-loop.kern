fn name=observegenericpropertyloop returns="string[]" export=true
  param name=content type=string
  param name=maxCodePoints type=number
  param name=maxTokens type=number
  param name=maxDiagnostics type=number
  param name=maxStreamRecords type=number
  param name=maxLexicalDepth type=number
  param name=maxCatalogEntries type=number
  param name=runtimeInstance type=number
  param name=parseEpoch type=number
  param name=evolvedTypes type="string[]"
  param name=multilineTypes type="string[]"
  param name=templateTypes type="string[]"
  param name=maxRegistryEntries type=number
  param name=maxNameCodePoints type=number
  param name=maxNameBytes type=number
  param name=maxMutableFields type=number
  param name=mutableFormat type=string
  param name=warningCode type=string
  param name=warningSeverity type=string
  param name=maxWarningFields type=number
  param name=warningFormat type=string
  param name=streamFormat type=string
  param name=maxProperties type=number
  param name=admissionFormat type=string
  param name=loopFormat type=string
  handler lang="kern"
    let name=inherited value="observegenericpropertyadmission(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth, maxCatalogEntries, runtimeInstance, parseEpoch, evolvedTypes, multilineTypes, templateTypes, maxRegistryEntries, maxNameCodePoints, maxNameBytes, maxMutableFields, mutableFormat, warningCode, warningSeverity, maxWarningFields, warningFormat, streamFormat)"
    let name=stream value="observeretainedtokenstream(content, maxCodePoints, maxTokens, maxDiagnostics, maxStreamRecords, maxLexicalDepth)"
    let name=failureCode value="\"\""
    let name=failureDetail value="\"\""
    let name=state value="\"loop\""
    let name=knownState value="\"dropped\""
    let name=admittedType value="\"\""
    let name=terminalCursor value="0"
    let name=terminalKind value="\"eof\""

    if cond="inherited.length < 21 || inherited[0] != admissionFormat || (inherited.length - 1) % 20 != 0"
      assign target=failureCode value="\"LOOP_INVALID\""
    else
      if cond="inherited[1] == \"failure\""
        assign target=failureCode value="inherited[2]"
        assign target=failureDetail value="inherited[3]"
      else
        if cond="inherited[1] != \"decision\" || (inherited[2] != \"dropped\" && inherited[2] != \"none\" && inherited[2] != \"property\") || inherited[15] != String(runtimeInstance) || inherited[16] != String(parseEpoch)"
          assign target=failureCode value="\"LOOP_INVALID\""
        else
          assign target=knownState value="inherited[3]"
          assign target=admittedType value="inherited[4]"
          if cond="inherited[2] == \"dropped\""
            assign target=state value="\"dropped\""
            assign target=terminalKind value="\"dropped\""

    let name=tokenKinds value="[]"
    let name=tokenValues value="[]"
    let name=tokenStarts value="[]"
    let name=streamValid value="true"
    let name=streamSealed value="false"
    let name=streamPhase value="\"token\""
    let name=streamDiagnosticCount value="0"
    let name=tokenStart value="0"
    if cond="stream.length < 11 || stream[0] != streamFormat || (stream.length - 1) % 10 != 0"
      assign target=streamValid value="false"
    else
      if cond="stream[1] == \"failure\""
        if cond="failureCode == \"\""
          assign target=failureCode value="stream[2]"
          assign target=failureDetail value="stream[3]"
      else
        if cond="stream.length < 31 || stream[1] != \"stream\" || stream[2] != \"0\" || stream[3] != content"
          assign target=streamValid value="false"
        else
          for name=recordStart from=11 to="stream.length" step=10
            let name=recordTag value="stream[recordStart]"
            if cond="recordTag == \"token\""
              if cond="streamPhase != \"token\" || stream[recordStart + 1] != String(tokenKinds.length) || stream[recordStart + 7] != \"\" || stream[recordStart + 8] != \"\" || stream[recordStart + 9] != \"\""
                assign target=streamValid value="false"
              do value="tokenKinds.push(stream[recordStart + 2])"
              do value="tokenValues.push(stream[recordStart + 3])"
              assign target=tokenStart value="tokenStart + utf16units(stream[recordStart + 4])"
              do value="tokenStarts.push(tokenStart)"
            else
              if cond="recordTag == \"diagnostic\""
                assign target=streamPhase value="\"diagnostic\""
                if cond="stream[recordStart + 1] != String(streamDiagnosticCount) || stream[recordStart + 9] != \"\""
                  assign target=streamValid value="false"
                assign target=streamDiagnosticCount value="streamDiagnosticCount + 1"
              else
                if cond="recordTag == \"seal\""
                  if cond="recordStart != stream.length - 10 || streamSealed || stream[recordStart + 1] != String(tokenKinds.length) || stream[recordStart + 2] != String(streamDiagnosticCount) || stream[recordStart + 7] != content"
                    assign target=streamValid value="false"
                  assign target=streamSealed value="true"
                  assign target=streamPhase value="\"seal\""
                else
                  assign target=streamValid value="false"
    if cond="!streamValid || (!streamSealed && stream[1] != \"failure\")"
      assign target=failureCode value="\"LOOP_INVALID\""

    let name=writeRecords value="[]"
    let name=diagnosticRecords value="[]"
    let name=finalKeys value="[]"
    let name=finalKinds value="[]"
    let name=finalValues value="[]"
    let name=finalQuoted value="[]"
    let name=firstWrites value="[]"
    let name=lastWrites value="[]"
    let name=quoteGenerations value="[]"
    let name=writeKeys value="[]"
    let name=writeKinds value="[]"
    let name=writeValues value="[]"
    let name=writeQuoted value="[]"
    let name=writeQuoteGenerations value="[]"
    let name=writeCount value="0"
    let name=duplicateCount value="0"
    let name=cursor value="0"

    if cond="failureCode == \"\" && state != \"dropped\""
      assign target=cursor value="1"
      if cond="tokenKinds.length == 0 || tokenKinds[0] != \"identifier\" || tokenValues[0] != admittedType"
        assign target=failureCode value="\"LOOP_INVALID\""
      else
        let name=realTokenCount value="tokenKinds.length"
        do value="tokenKinds.push(\"whitespace\")"
        do value="tokenValues.push(\"\")"
        do value="tokenStarts.push(tokenStart)"
        let name=propertyPhase value="\"handoff\""
        let name=cursorBefore value="1"
        let name=propertyIndex value="0"
        let name=propertyStart value="0"
        let name=equalsIndex value="0"
        let name=key value="\"\""
        let name=valueIndexText value="\"none\""
        let name=valueKind value="\"empty\""
        let name=propertyValue value="\"\""
        let name=isQuoted value="false"
        let name=consumedCount value="0"
        for name=tokenIndex from=1 to="tokenKinds.length"
          let name=tokenKind value="tokenKinds[tokenIndex]"
          let name=propertyReady value="false"
          if cond="propertyPhase == \"handoff\""
            if cond="tokenKind != \"whitespace\""
              if cond="tokenKind != \"identifier\""
                assign target=failureCode value="\"LOOP_PROFILE\""
              else
                assign target=propertyIndex value="tokenIndex"
                assign target=propertyStart value="tokenStarts[tokenIndex]"
                assign target=key value="tokenValues[tokenIndex]"
                assign target=propertyPhase value="\"equals\""
          else
            if cond="propertyPhase == \"equals\""
              if cond="tokenKind != \"equals\""
                assign target=failureCode value="\"LOOP_PROFILE\""
              else
                assign target=equalsIndex value="tokenIndex"
                assign target=propertyPhase value="\"value\""
            else
              if cond="propertyPhase == \"value\""
                if cond="tokenIndex < realTokenCount"
                  assign target=valueIndexText value="String(tokenIndex)"
                if cond="tokenKind == \"whitespace\""
                  assign target=valueKind value="\"empty\""
                  assign target=cursor value="tokenIndex"
                  assign target=propertyReady value="true"
                else
                  if cond="tokenKind == \"style\" || tokenKind == \"themeRef\""
                    assign target=failureCode value="\"LOOP_PROFILE\""
                  else
                    if cond="tokenKind == \"quoted\" || tokenKind == \"expr\""
                      assign target=valueKind value="tokenKind"
                      assign target=propertyValue value="tokenValues[tokenIndex]"
                      assign target=isQuoted value="tokenKind == \"quoted\""
                      assign target=consumedCount value="1"
                      assign target=cursor value="tokenIndex + 1"
                      assign target=propertyReady value="true"
                    else
                      assign target=valueKind value="\"bare\""
                      assign target=propertyValue value="tokenValues[tokenIndex]"
                      assign target=consumedCount value="1"
                      assign target=cursor value="tokenIndex + 1"
                      assign target=propertyPhase value="\"bare\""
              else
                if cond="propertyPhase == \"bare\""
                  if cond="tokenKind == \"whitespace\""
                    assign target=cursor value="tokenIndex"
                    assign target=propertyReady value="true"
                  else
                    if cond="tokenKind == \"style\" || tokenKind == \"themeRef\""
                      assign target=failureCode value="\"LOOP_PROFILE\""
                    else
                      assign target=propertyValue value="propertyValue + tokenValues[tokenIndex]"
                      assign target=consumedCount value="consumedCount + 1"
                      assign target=cursor value="tokenIndex + 1"

          if cond="propertyReady && failureCode == \"\""
            if cond="writeCount >= maxProperties"
              assign target=failureCode value="\"LOOP_LIMIT\""
            else
              let name=uniqueIndex value="-1"
              for name=searchIndex from=0 to="finalKeys.length"
                if cond="finalKeys[searchIndex] == key"
                  assign target=uniqueIndex value="searchIndex"
                  break
              let name=isDuplicate value="uniqueIndex >= 0"
              let name=diagnosticIndexText value="\"none\""
              let name=diagnosticColText value="\"none\""
              let name=diagnosticEndColText value="\"none\""
              if cond="isDuplicate"
                assign target=diagnosticIndexText value="String(duplicateCount)"
                assign target=diagnosticColText value="String(1 + propertyStart)"
                assign target=diagnosticEndColText value="String(1 + propertyStart + utf16units(key))"
                do value="diagnosticRecords.push(\"duplicate\")"
                do value="diagnosticRecords.push(String(duplicateCount))"
                do value="diagnosticRecords.push(String(writeCount))"
                do value="diagnosticRecords.push(\"DUPLICATE_PROP\")"
                do value="diagnosticRecords.push(\"warning\")"
                do value="diagnosticRecords.push(\"Duplicate property '\" + key + \"' at line 1\")"
                do value="diagnosticRecords.push(\"1\")"
                do value="diagnosticRecords.push(diagnosticColText)"
                do value="diagnosticRecords.push(\"1\")"
                do value="diagnosticRecords.push(diagnosticEndColText)"
                for name=diagnosticPadding from=0 to=10
                  do value="diagnosticRecords.push(\"\")"
                assign target=duplicateCount value="duplicateCount + 1"
              else
                assign target=uniqueIndex value="finalKeys.length"
                do value="finalKeys.push(key)"

              let name=quoteGeneration value="0"
              if cond="isQuoted"
                assign target=quoteGeneration value="writeCount + 1"
                let name=priorQuoted value="\"false\""
                let name=priorQuoteGeneration value="0"
                for name=priorIndex from=0 to="writeKeys.length"
                  if cond="writeKeys[priorIndex] == key"
                    assign target=priorQuoted value="writeQuoted[priorIndex]"
                    assign target=priorQuoteGeneration value="writeQuoteGenerations[priorIndex]"
                if cond="priorQuoted == \"true\""
                  assign target=quoteGeneration value="priorQuoteGeneration"

              do value="writeKeys.push(key)"
              do value="writeKinds.push(valueKind)"
              do value="writeValues.push(propertyValue)"
              do value="writeQuoted.push(String(isQuoted))"
              do value="writeQuoteGenerations.push(quoteGeneration)"
              do value="writeRecords.push(\"write\")"
              do value="writeRecords.push(String(writeCount))"
              do value="writeRecords.push(key)"
              do value="writeRecords.push(valueKind)"
              do value="writeRecords.push(propertyValue)"
              do value="writeRecords.push(String(isQuoted))"
              do value="writeRecords.push(String(isDuplicate))"
              do value="writeRecords.push(String(cursorBefore))"
              do value="writeRecords.push(String(propertyIndex))"
              do value="writeRecords.push(String(equalsIndex))"
              do value="writeRecords.push(valueIndexText)"
              do value="writeRecords.push(String(cursor))"
              do value="writeRecords.push(String(consumedCount))"
              do value="writeRecords.push(diagnosticIndexText)"
              do value="writeRecords.push(diagnosticColText)"
              do value="writeRecords.push(diagnosticEndColText)"
              do value="writeRecords.push(String(uniqueIndex))"
              do value="writeRecords.push(String(quoteGeneration))"
              do value="writeRecords.push(\"\")"
              do value="writeRecords.push(\"\")"
              assign target=writeCount value="writeCount + 1"
              assign target=cursorBefore value="cursor"
              assign target=propertyPhase value="\"handoff\""
              assign target=key value="\"\""
              assign target=valueIndexText value="\"none\""
              assign target=valueKind value="\"empty\""
              assign target=propertyValue value="\"\""
              assign target=isQuoted value="false"
              assign target=consumedCount value="0"

    assign target=terminalCursor value="cursor"
    if cond="failureCode == \"\" && state != \"dropped\""
      if cond="writeCount == 0 && inherited[2] != \"none\""
        assign target=failureCode value="\"LOOP_INVALID\""
      if cond="writeCount > 0 && (inherited[2] != \"property\" || inherited[5] != writeRecords[2] || inherited[6] != writeRecords[3] || inherited[7] != writeRecords[4] || inherited[8] != writeRecords[5] || inherited[10] != writeRecords[8] || inherited[11] != writeRecords[9] || inherited[12] != writeRecords[10] || inherited[13] != writeRecords[11] || inherited[14] != writeRecords[12])"
        assign target=failureCode value="\"LOOP_INVALID\""

    for name=propertyIndex from=0 to="finalKeys.length"
      let name=finalKey value="finalKeys[propertyIndex]"
      let name=firstWrite value="-1"
      let name=lastWrite value="-1"
      let name=finalKind value="\"\""
      let name=finalValue value="\"\""
      let name=finalQuote value="\"false\""
      let name=finalGeneration value="0"
      for name=writeIndex from=0 to="writeKeys.length"
        if cond="writeKeys[writeIndex] == finalKey"
          if cond="firstWrite < 0"
            assign target=firstWrite value="writeIndex"
          assign target=lastWrite value="writeIndex"
          assign target=finalKind value="writeKinds[writeIndex]"
          assign target=finalValue value="writeValues[writeIndex]"
          assign target=finalQuote value="writeQuoted[writeIndex]"
          assign target=finalGeneration value="writeQuoteGenerations[writeIndex]"
      do value="finalKinds.push(finalKind)"
      do value="finalValues.push(finalValue)"
      do value="finalQuoted.push(finalQuote)"
      do value="firstWrites.push(String(firstWrite))"
      do value="lastWrites.push(String(lastWrite))"
      do value="quoteGenerations.push(finalGeneration)"

    let name=quotedCount value="0"
    for name=quotedIndex from=0 to="finalKeys.length"
      if cond="finalQuoted[quotedIndex] == \"true\""
        assign target=quotedCount value="quotedCount + 1"

    let name=out value="[]"
    do value="out.push(loopFormat)"
    if cond="failureCode != \"\""
      do value="out.push(\"failure\")"
      do value="out.push(failureCode)"
      do value="out.push(failureDetail)"
      do value="out.push(String(runtimeInstance))"
      do value="out.push(String(parseEpoch))"
      do value="out.push(String(inherited.length))"
      do value="out.push(String(stream.length))"
      for name=failurePadding from=0 to=13
        do value="out.push(\"\")"
    else
      do value="out.push(\"decision\")"
      do value="out.push(state)"
      do value="out.push(knownState)"
      do value="out.push(admittedType)"
      do value="out.push(String(writeCount))"
      do value="out.push(String(finalKeys.length))"
      do value="out.push(String(duplicateCount))"
      do value="out.push(String(quotedCount))"
      do value="out.push(String(terminalCursor))"
      do value="out.push(terminalKind)"
      do value="out.push(String(runtimeInstance))"
      do value="out.push(String(parseEpoch))"
      do value="out.push(admissionFormat)"
      do value="out.push(String(inherited.length))"
      do value="out.push(streamFormat)"
      do value="out.push(String(stream.length))"
      for name=headerPadding from=0 to=4
        do value="out.push(\"\")"

      for name=writeField from=0 to="writeRecords.length"
        do value="out.push(writeRecords[writeField])"
      for name=propertyIndex from=0 to="finalKeys.length"
        do value="out.push(\"property\")"
        do value="out.push(String(propertyIndex))"
        do value="out.push(finalKeys[propertyIndex])"
        do value="out.push(finalKinds[propertyIndex])"
        do value="out.push(finalValues[propertyIndex])"
        do value="out.push(String(finalKinds[propertyIndex] == \"expr\"))"
        do value="out.push(finalQuoted[propertyIndex])"
        do value="out.push(firstWrites[propertyIndex])"
        do value="out.push(lastWrites[propertyIndex])"
        do value="out.push(String(quoteGenerations[propertyIndex]))"
        for name=propertyPadding from=0 to=10
          do value="out.push(\"\")"
      for name=diagnosticField from=0 to="diagnosticRecords.length"
        do value="out.push(diagnosticRecords[diagnosticField])"

    let name=authIndex value="0"
    for name=authStart from=0 to="inherited.length" step=16
      let name=authCount value="inherited.length - authStart"
      if cond="authCount > 16"
        assign target=authCount value="16"
      do value="out.push(\"admission-auth\")"
      do value="out.push(String(authIndex))"
      do value="out.push(String(authStart))"
      do value="out.push(String(authCount))"
      for name=authField from=0 to=16
        if cond="authField < authCount"
          do value="out.push(inherited[authStart + authField])"
        else
          do value="out.push(\"\")"
      assign target=authIndex value="authIndex + 1"

    assign target=authIndex value="0"
    for name=streamAuthStart from=0 to="stream.length" step=16
      let name=streamAuthCount value="stream.length - streamAuthStart"
      if cond="streamAuthCount > 16"
        assign target=streamAuthCount value="16"
      do value="out.push(\"stream-auth\")"
      do value="out.push(String(authIndex))"
      do value="out.push(String(streamAuthStart))"
      do value="out.push(String(streamAuthCount))"
      for name=streamAuthField from=0 to=16
        if cond="streamAuthField < streamAuthCount"
          do value="out.push(stream[streamAuthStart + streamAuthField])"
        else
          do value="out.push(\"\")"
      assign target=authIndex value="authIndex + 1"

    if cond="failureCode != \"\""
      do value="out.push(\"failure-seal\")"
      do value="out.push(failureCode)"
      do value="out.push(failureDetail)"
      do value="out.push(content)"
      do value="out.push(String(runtimeInstance))"
      do value="out.push(String(parseEpoch))"
      do value="out.push(String(inherited.length))"
      do value="out.push(String(stream.length))"
      for name=failureSealPadding from=0 to=12
        do value="out.push(\"\")"
      return value="out"

    do value="out.push(\"seal\")"
    do value="out.push(state)"
    do value="out.push(knownState)"
    do value="out.push(admittedType)"
    do value="out.push(String(writeCount))"
    do value="out.push(String(finalKeys.length))"
    do value="out.push(String(duplicateCount))"
    do value="out.push(String(quotedCount))"
    do value="out.push(String(terminalCursor))"
    do value="out.push(terminalKind)"
    do value="out.push(String(runtimeInstance))"
    do value="out.push(String(parseEpoch))"
    do value="out.push(content)"
    do value="out.push(admissionFormat)"
    do value="out.push(String(inherited.length))"
    do value="out.push(streamFormat)"
    do value="out.push(String(stream.length))"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    do value="out.push(\"\")"
    return value="out"
