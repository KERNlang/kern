fn name=indentation params="level:number" returns=string export=true
  handler lang="kern"
    let name=out value="\"\""
    for name=i from=0 to="level"
      assign target=out value="out + \"  \""
    return value="out"

fn name=validstatementlist params="parent:number,returnType:string,nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns=boolean export=true
  handler lang="kern"
    let name=count value="childcount(parent, nodeParent)"
    for name=i from=0 to="count"
      let name=id value="childat(parent, i, nodeParent, nodeOrder)"
      if cond="id <= 0 || !validstatement(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
        return value="false"
      let name=kind value="stringat(id, nodeKind)"
      if cond="kind == \"else\""
        if cond="i == 0"
          return value="false"
        let name=previous value="childat(parent, i - 1, nodeParent, nodeOrder)"
        if cond="previous <= 0 || stringat(previous, nodeKind) != \"if\""
          return value="false"
      if cond="kind == \"return\" && i != count - 1"
        return value="false"
    return value="true"

fn name=validstatement params="id:number,returnType:string,nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns=boolean export=true
  handler lang="kern"
    let name=kind value="stringat(id, nodeKind)"
    if cond="kind == \"return\""
      if cond="childcount(id, nodeParent) != 0"
        return value="false"
      let name=valueId value="propid(id, \"value\", propNode, propKey, propValue)"
      if cond="returnType == \"void\""
        return value="valueId == 0 && propcount(id, propNode) == 0"
      return value="valueId > 0 && propcount(id, propNode) == 1 && exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) != \"\""
    if cond="kind == \"if\""
      let name=condId value="propid(id, \"cond\", propNode, propKey, propValue)"
      if cond="condId <= 0 || propcount(id, propNode) != 1 || exprsource(condId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) == \"\""
        return value="false"
      return value="validstatementlist(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    if cond="kind == \"else\""
      if cond="propcount(id, propNode) != 0"
        return value="false"
      return value="validstatementlist(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    return value="false"

fn name=emitstatementlist params="parent:number,level:number,returnType:string,nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns="string[]" export=true
  handler lang="kern"
    let name=out value="[]"
    let name=count value="childcount(parent, nodeParent)"
    for name=i from=0 to="count"
      let name=id value="childat(parent, i, nodeParent, nodeOrder)"
      let name=statementLines value="emitstatement(id, level, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      for name=j from=0 to="statementLines.length"
        do value="out.push(statementLines[j])"
    return value="out"

fn name=emitstatement params="id:number,level:number,returnType:string,nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns="string[]" export=true
  handler lang="kern"
    let name=out value="[]"
    let name=kind value="stringat(id, nodeKind)"
    let name=prefix value="indentation(level)"
    if cond="kind == \"return\""
      let name=valueId value="propid(id, \"value\", propNode, propKey, propValue)"
      if cond="valueId == 0"
        do value="out.push(prefix + \"return\")"
      else
        let name=expression value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
        do value="out.push(prefix + \"return value=\" + quotesource(expression))"
      return value="out"
    if cond="kind == \"if\""
      let name=condId value="propid(id, \"cond\", propNode, propKey, propValue)"
      let name=condition value="exprsource(condId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"if cond=\" + quotesource(condition))"
    if cond="kind == \"else\""
      do value="out.push(prefix + \"else\")"
    let name=children value="emitstatementlist(id, level + 1, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    for name=i from=0 to="children.length"
      do value="out.push(children[i])"
    return value="out"
