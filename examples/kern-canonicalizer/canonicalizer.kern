fn name=typesource params="id:number,allowVoid:boolean,valueTag:string[],valueParent:number[],valueRole:string[],valueText:string[]" returns=string export=true
  handler lang="kern"
    if cond="id <= 0 || id > valueTag.length || stringat(id, valueTag) != \"record\""
      return value="\"\""
    let name=count value="valuechildcount(id, valueParent)"
    let name=kindId value="recordfield(id, \"kind\", valueParent, valueRole)"
    if cond="kindId <= 0 || stringat(kindId, valueTag) != \"text\""
      return value="\"\""
    let name=kind value="stringat(kindId, valueText)"
    if cond="count == 1"
      if cond="kind == \"boolean\""
        return value="\"boolean\""
      if cond="kind == \"integer\""
        return value="\"number\""
      if cond="kind == \"text\""
        return value="\"string\""
      if cond="allowVoid && kind == \"void\""
        return value="\"void\""
      return value="\"\""
    if cond="count != 2 || kind != \"list\""
      return value="\"\""
    let name=elementId value="recordfield(id, \"element\", valueParent, valueRole)"
    if cond="elementId <= 0 || stringat(elementId, valueTag) != \"text\""
      return value="\"\""
    let name=element value="stringat(elementId, valueText)"
    if cond="element == \"boolean\""
      return value="\"boolean[]\""
    if cond="element == \"integer\""
      return value="\"number[]\""
    if cond="element == \"text\""
      return value="\"string[]\""
    return value="\"\""

fn name=validbinaryop params="op:string" returns=boolean export=true
  handler lang="kern"
    if cond="op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" || op == \"%\""
      return value="true"
    if cond="op == \"**\" || op == \"==\" || op == \"!=\" || op == \"===\" || op == \"!==\""
      return value="true"
    if cond="op == \"<\" || op == \"<=\" || op == \">\" || op == \">=\" || op == \"instanceof\""
      return value="true"
    if cond="op == \"&&\" || op == \"||\" || op == \"??\" || op == \"&\" || op == \"|\""
      return value="true"
    return value="op == \"^\" || op == \"<<\" || op == \">>\" || op == \">>>\""

fn name=exprsource params="id:number,valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns=string export=true
  handler lang="kern"
    if cond="id <= 0 || id > valueTag.length || stringat(id, valueTag) != \"record\""
      return value="\"\""
    if cond="valuechildcount(id, valueParent) != 2"
      return value="\"\""
    let name=fieldsId value="recordfield(id, \"fields\", valueParent, valueRole)"
    let name=kindId value="recordfield(id, \"kind\", valueParent, valueRole)"
    if cond="fieldsId <= 0 || kindId <= 0 || stringat(fieldsId, valueTag) != \"record\" || stringat(kindId, valueTag) != \"text\""
      return value="\"\""
    let name=kind value="stringat(kindId, valueText)"
    if cond="kind == \"null\""
      if cond="valuechildcount(fieldsId, valueParent) == 0"
        return value="\"null\""
      return value="\"\""
    if cond="kind == \"identifier\""
      let name=nameId value="recordfield(fieldsId, \"name\", valueParent, valueRole)"
      if cond="valuechildcount(fieldsId, valueParent) == 1 && nameId > 0 && stringat(nameId, valueTag) == \"text\" && validexpressionidentifier(stringat(nameId, valueText))"
        return value="stringat(nameId, valueText)"
      return value="\"\""
    let name=valueId value="recordfield(fieldsId, \"value\", valueParent, valueRole)"
    if cond="kind == \"boolean\""
      if cond="valuechildcount(fieldsId, valueParent) == 1 && valueId > 0 && stringat(valueId, valueTag) == \"bool\""
        if cond="numberat(valueId, valueBool) == 1"
          return value="\"true\""
        return value="\"false\""
      return value="\"\""
    if cond="kind == \"integer\""
      if cond="valuechildcount(fieldsId, valueParent) == 1 && valueId > 0 && stringat(valueId, valueTag) == \"int\" && validinteger(stringat(valueId, valueText)) && !Text.startsWith(stringat(valueId, valueText), \"-\")"
        return value="stringat(valueId, valueText)"
      return value="\"\""
    if cond="kind == \"text\""
      if cond="valuechildcount(fieldsId, valueParent) == 1 && valueId > 0 && stringat(valueId, valueTag) == \"text\""
        return value="quotesource(stringat(valueId, valueText))"
      return value="\"\""
    if cond="kind == \"binary\""
      if cond="valuechildcount(fieldsId, valueParent) != 3"
        return value="\"\""
      let name=leftId value="recordfield(fieldsId, \"left\", valueParent, valueRole)"
      let name=opId value="recordfield(fieldsId, \"op\", valueParent, valueRole)"
      let name=rightId value="recordfield(fieldsId, \"right\", valueParent, valueRole)"
      if cond="leftId <= 0 || opId <= 0 || rightId <= 0 || stringat(opId, valueTag) != \"text\""
        return value="\"\""
      let name=op value="stringat(opId, valueText)"
      if cond="!validbinaryop(op)"
        return value="\"\""
      let name=left value="exprsource(leftId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      let name=right value="exprsource(rightId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="left == \"\" || right == \"\""
        return value="\"\""
      return value="\"(\" + left + \" \" + op + \" \" + right + \")\""
    if cond="kind == \"unary\""
      if cond="valuechildcount(fieldsId, valueParent) != 2"
        return value="\"\""
      let name=argumentId value="recordfield(fieldsId, \"argument\", valueParent, valueRole)"
      let name=opId value="recordfield(fieldsId, \"op\", valueParent, valueRole)"
      if cond="argumentId <= 0 || opId <= 0 || stringat(opId, valueTag) != \"text\""
        return value="\"\""
      let name=op value="stringat(opId, valueText)"
      let name=validUnaryOp value="op == \"!\" || op == \"-\" || op == \"~\" || op == \"typeof\""
      if cond="!validUnaryOp"
        return value="\"\""
      let name=argument value="exprsource(argumentId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="argument == \"\" || (op == \"-\" && argument == \"0\")"
        return value="\"\""
      if cond="op == \"typeof\""
        return value="\"(\" + op + \" \" + argument + \")\""
      return value="\"(\" + op + argument + \")\""
    if cond="kind == \"member\""
      if cond="valuechildcount(fieldsId, valueParent) != 3"
        return value="\"\""
      let name=objectId value="recordfield(fieldsId, \"object\", valueParent, valueRole)"
      let name=optionalId value="recordfield(fieldsId, \"optional\", valueParent, valueRole)"
      let name=propertyId value="recordfield(fieldsId, \"property\", valueParent, valueRole)"
      if cond="objectId <= 0 || optionalId <= 0 || propertyId <= 0"
        return value="\"\""
      if cond="stringat(optionalId, valueTag) != \"bool\" || numberat(optionalId, valueBool) != 0 || stringat(propertyId, valueTag) != \"text\""
        return value="\"\""
      let name=property value="stringat(propertyId, valueText)"
      if cond="!valididentifier(property)"
        return value="\"\""
      if cond="property == \"null\" || property == \"none\" || property == \"undefined\""
        return value="\"\""
      if cond="property == \"true\" || property == \"false\" || property == \"await\""
        return value="\"\""
      let name=object value="exprsource(objectId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="object == \"\""
        return value="\"\""
      return value="object + \".\" + property"
    if cond="kind == \"index\""
      if cond="valuechildcount(fieldsId, valueParent) != 3"
        return value="\"\""
      let name=indexId value="recordfield(fieldsId, \"index\", valueParent, valueRole)"
      let name=objectId value="recordfield(fieldsId, \"object\", valueParent, valueRole)"
      let name=optionalId value="recordfield(fieldsId, \"optional\", valueParent, valueRole)"
      if cond="indexId <= 0 || objectId <= 0 || optionalId <= 0"
        return value="\"\""
      if cond="stringat(optionalId, valueTag) != \"bool\" || numberat(optionalId, valueBool) != 0"
        return value="\"\""
      let name=object value="exprsource(objectId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      let name=index value="exprsource(indexId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="object == \"\" || index == \"\""
        return value="\"\""
      return value="object + \"[\" + index + \"]\""
    if cond="kind == \"call\""
      if cond="valuechildcount(fieldsId, valueParent) != 3"
        return value="\"\""
      let name=argsId value="recordfield(fieldsId, \"args\", valueParent, valueRole)"
      let name=calleeId value="recordfield(fieldsId, \"callee\", valueParent, valueRole)"
      let name=optionalId value="recordfield(fieldsId, \"optional\", valueParent, valueRole)"
      if cond="argsId <= 0 || calleeId <= 0 || optionalId <= 0"
        return value="\"\""
      if cond="stringat(argsId, valueTag) != \"list\" || stringat(optionalId, valueTag) != \"bool\" || numberat(optionalId, valueBool) != 0"
        return value="\"\""
      let name=callee value="exprsource(calleeId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="callee == \"\""
        return value="\"\""
      let name=out value="callee + \"(\""
      let name=count value="valuechildcount(argsId, valueParent)"
      for name=i from=0 to="count"
        let name=argId value="valuechildat(argsId, i, valueParent, valueOrder)"
        if cond="argId <= 0"
          return value="\"\""
        let name=arg value="exprsource(argId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
        if cond="arg == \"\""
          return value="\"\""
        if cond="i > 0"
          assign target=out value="out + \", \""
        assign target=out value="out + arg"
      return value="out + \")\""
    if cond="kind != \"list\""
      return value="\"\""
    let name=itemsId value="recordfield(fieldsId, \"items\", valueParent, valueRole)"
    if cond="valuechildcount(fieldsId, valueParent) != 1 || itemsId <= 0 || stringat(itemsId, valueTag) != \"list\""
      return value="\"\""
    let name=out value="\"[\""
    let name=count value="valuechildcount(itemsId, valueParent)"
    for name=i from=0 to="count"
      let name=itemId value="valuechildat(itemsId, i, valueParent, valueOrder)"
      if cond="itemId <= 0"
        return value="\"\""
      let name=item value="exprsource(itemId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="item == \"\""
        return value="\"\""
      if cond="i > 0"
        assign target=out value="out + \", \""
      assign target=out value="out + item"
    return value="out + \"]\""

fn name=tablesok params="nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns=boolean export=true
  handler lang="kern"
    if cond="nodeKind.length == 0 || nodeKind.length != nodeParent.length || nodeKind.length != nodeOrder.length"
      return value="false"
    if cond="propNode.length != propKey.length || propNode.length != propValue.length"
      return value="false"
    if cond="valueTag.length != valueParent.length || valueTag.length != valueRole.length || valueTag.length != valueOrder.length || valueTag.length != valueText.length || valueTag.length != valueBool.length"
      return value="false"
    let name=nodeSiblingCounts value="new Map()"
    let name=nodeOrders value="new Map()"
    for name=i from=0 to="nodeKind.length"
      if cond="nodeParent[i] < 0 || nodeParent[i] > nodeKind.length || nodeOrder[i] < 0"
        return value="false"
      if cond="nodeParent[i] != 0 && nodeParent[i] >= i + 1"
        return value="false"
      let name=nodeParentKey value="String(nodeParent[i])"
      if cond="Map.has(nodeSiblingCounts, nodeParentKey)"
        do value="Map.set(nodeSiblingCounts, String(nodeParent[i]), Map.get(nodeSiblingCounts, nodeParentKey) + 1)"
      else
        do value="Map.set(nodeSiblingCounts, String(nodeParent[i]), 1)"
      let name=nodeOrderKey value="nodeParentKey + \":\" + String(nodeOrder[i])"
      if cond="Map.has(nodeOrders, nodeOrderKey)"
        return value="false"
      do value="Map.set(nodeOrders, String(nodeParent[i]) + \":\" + String(nodeOrder[i]), true)"
    for name=nodeCheck from=0 to="nodeKind.length"
      let name=nodeParentKey value="String(nodeParent[nodeCheck])"
      if cond="nodeOrder[nodeCheck] >= Map.get(nodeSiblingCounts, nodeParentKey)"
        return value="false"
    let name=propertyKeys value="new Map()"
    let name=propertyOwnerCounts value="new Map()"
    for name=propertyIndex from=0 to="propNode.length"
      if cond="propNode[propertyIndex] < 1 || propNode[propertyIndex] > nodeKind.length || propValue[propertyIndex] < 1 || propValue[propertyIndex] > valueTag.length"
        return value="false"
      if cond="numberat(propValue[propertyIndex], valueParent) != 0 || stringat(propValue[propertyIndex], valueRole) != \"\""
        return value="false"
      let name=propertyKey value="String(propNode[propertyIndex]) + \":\" + String(Text.length(propKey[propertyIndex])) + \":\" + propKey[propertyIndex]"
      if cond="Map.has(propertyKeys, propertyKey)"
        return value="false"
      do value="Map.set(propertyKeys, String(propNode[propertyIndex]) + \":\" + String(Text.length(propKey[propertyIndex])) + \":\" + String(propKey[propertyIndex]), true)"
      let name=ownerKey value="String(propValue[propertyIndex])"
      if cond="Map.has(propertyOwnerCounts, ownerKey)"
        do value="Map.set(propertyOwnerCounts, String(propValue[propertyIndex]), Map.get(propertyOwnerCounts, ownerKey) + 1)"
      else
        do value="Map.set(propertyOwnerCounts, String(propValue[propertyIndex]), 1)"
    let name=valueChildCounts value="new Map()"
    let name=valueOrders value="new Map()"
    let name=valueRolesByOrder value="new Map()"
    for name=valueIndex from=0 to="valueTag.length"
      if cond="valueParent[valueIndex] < 0 || valueParent[valueIndex] > valueTag.length || valueOrder[valueIndex] < 0"
        return value="false"
      if cond="valueParent[valueIndex] != 0 && valueParent[valueIndex] >= valueIndex + 1"
        return value="false"
      let name=tag value="valueTag[valueIndex]"
      if cond="tag != \"null\" && tag != \"bool\" && tag != \"text\" && tag != \"int\" && tag != \"list\" && tag != \"record\""
        return value="false"
      let name=valueParentKey value="String(valueParent[valueIndex])"
      if cond="Map.has(valueChildCounts, valueParentKey)"
        do value="Map.set(valueChildCounts, String(valueParent[valueIndex]), Map.get(valueChildCounts, valueParentKey) + 1)"
      else
        do value="Map.set(valueChildCounts, String(valueParent[valueIndex]), 1)"
      if cond="valueParent[valueIndex] > 0"
        let name=valueOrderKey value="valueParentKey + \":\" + String(valueOrder[valueIndex])"
        if cond="Map.has(valueOrders, valueOrderKey)"
          return value="false"
        do value="Map.set(valueOrders, String(valueParent[valueIndex]) + \":\" + String(valueOrder[valueIndex]), true)"
        do value="Map.set(valueRolesByOrder, String(valueParent[valueIndex]) + \":\" + String(valueOrder[valueIndex]), valueRole[valueIndex])"
    let name=recordRoles value="new Map()"
    for name=valueCheck from=0 to="valueTag.length"
      let name=tag value="valueTag[valueCheck]"
      let name=children value="0"
      let name=valueIdKey value="String(valueCheck + 1)"
      if cond="Map.has(valueChildCounts, valueIdKey)"
        assign target=children value="Map.get(valueChildCounts, valueIdKey)"
      if cond="valueParent[valueCheck] > 0"
        let name=valueParentKey value="String(valueParent[valueCheck])"
        if cond="valueOrder[valueCheck] >= Map.get(valueChildCounts, valueParentKey)"
          return value="false"
      if cond="tag == \"null\" || tag == \"bool\" || tag == \"text\" || tag == \"int\""
        if cond="children != 0"
          return value="false"
      if cond="tag == \"null\" && (valueText[valueCheck] != \"\" || valueBool[valueCheck] != 0)"
        return value="false"
      if cond="tag == \"bool\" && (valueText[valueCheck] != \"\" || (valueBool[valueCheck] != 0 && valueBool[valueCheck] != 1))"
        return value="false"
      if cond="(tag == \"text\" || tag == \"int\") && valueBool[valueCheck] != 0"
        return value="false"
      if cond="(tag == \"list\" || tag == \"record\") && (valueText[valueCheck] != \"\" || valueBool[valueCheck] != 0)"
        return value="false"
      if cond="tag == \"int\" && !validinteger(valueText[valueCheck])"
        return value="false"
      if cond="valueParent[valueCheck] == 0"
        let name=owners value="0"
        if cond="Map.has(propertyOwnerCounts, valueIdKey)"
          assign target=owners value="Map.get(propertyOwnerCounts, valueIdKey)"
        if cond="owners != 1 || valueRole[valueCheck] != \"\" || valueOrder[valueCheck] != 0"
          return value="false"
      else
        if cond="Map.has(propertyOwnerCounts, valueIdKey)"
          return value="false"
        let name=parentTag value="stringat(valueParent[valueCheck], valueTag)"
        if cond="parentTag == \"list\""
          if cond="valueRole[valueCheck] != \"list-item\""
            return value="false"
        else
          if cond="parentTag != \"record\" || !Text.startsWith(valueRole[valueCheck], \"record:\")"
            return value="false"
          if cond="Text.length(valueRole[valueCheck]) <= 7"
            return value="false"
          let name=recordRoleKey value="String(valueParent[valueCheck]) + \":\" + String(Text.length(valueRole[valueCheck])) + \":\" + valueRole[valueCheck]"
          if cond="Map.has(recordRoles, recordRoleKey)"
            return value="false"
          do value="Map.set(recordRoles, String(valueParent[valueCheck]) + \":\" + String(Text.length(valueRole[valueCheck])) + \":\" + String(valueRole[valueCheck]), true)"
          if cond="valueOrder[valueCheck] > 0"
            let name=previousValueKey value="String(valueParent[valueCheck]) + \":\" + String(valueOrder[valueCheck] - 1)"
            if cond="!Map.has(valueRolesByOrder, previousValueKey)"
              return value="false"
            let name=previousValueRole value="Map.get(valueRolesByOrder, previousValueKey)"
            if cond="previousValueRole >= valueRole[valueCheck]"
              return value="false"
    return value="true"

fn name=canonicalize params="nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[],maxNodeRows:number,maxPropertyRows:number,maxValueRows:number" returns=string[] export=true
  handler lang="kern"
    if cond="maxNodeRows <= 0 || maxPropertyRows <= 0 || maxValueRows <= 0 || nodeKind.length > maxNodeRows || propNode.length > maxPropertyRows || valueTag.length > maxValueRows"
      throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    if cond="!tablesok(nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    let name=roots value="childcount(0, nodeParent)"
    if cond="roots == 0"
      throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    for name=outputRoot from=0 to="roots"
      let name=fnId value="childat(0, outputRoot, nodeParent, nodeOrder)"
      if cond="fnId <= 0 || stringat(fnId, nodeKind) != \"fn\""
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      let name=nameId value="propid(fnId, \"name\", propNode, propKey, propValue)"
      let name=returnsId value="propid(fnId, \"returns\", propNode, propKey, propValue)"
      let name=exportId value="propid(fnId, \"export\", propNode, propKey, propValue)"
      if cond="nameId <= 0 || returnsId <= 0 || exportId < 0 || propcount(fnId, propNode) < 2 || propcount(fnId, propNode) > 3"
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      for name=fnProperty from=0 to="propNode.length"
        if cond="propNode[fnProperty] == fnId && propKey[fnProperty] != \"name\" && propKey[fnProperty] != \"returns\" && propKey[fnProperty] != \"export\""
          throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      if cond="stringat(nameId, valueTag) != \"text\" || structuralname(stringat(nameId, valueText)) == \"\" || typesource(returnsId, true, valueTag, valueParent, valueRole, valueText) == \"\""
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      for name=previousRoot from=0 to="outputRoot"
        let name=previousFnId value="childat(0, previousRoot, nodeParent, nodeOrder)"
        let name=previousNameId value="propid(previousFnId, \"name\", propNode, propKey, propValue)"
        if cond="previousNameId > 0 && stringat(previousNameId, valueText) == stringat(nameId, valueText)"
          throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      if cond="exportId > 0 && stringat(exportId, valueTag) != \"bool\""
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      let name=fnChildren value="childcount(fnId, nodeParent)"
      if cond="fnChildren == 0"
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      for name=c from=0 to="fnChildren"
        let name=childId value="childat(fnId, c, nodeParent, nodeOrder)"
        if cond="childId <= 0"
          throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
        if cond="c < fnChildren - 1"
          if cond="stringat(childId, nodeKind) != \"param\" || childcount(childId, nodeParent) != 0 || propcount(childId, propNode) != 2"
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          let name=paramName value="propid(childId, \"name\", propNode, propKey, propValue)"
          let name=paramType value="propid(childId, \"type\", propNode, propKey, propValue)"
          if cond="paramName <= 0 || paramType <= 0 || stringat(paramName, valueTag) != \"text\" || structuralname(stringat(paramName, valueText)) == \"\" || typesource(paramType, false, valueTag, valueParent, valueRole, valueText) == \"\""
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          for name=previousParam from=0 to="c"
            let name=previousParamId value="childat(fnId, previousParam, nodeParent, nodeOrder)"
            let name=previousParamName value="propid(previousParamId, \"name\", propNode, propKey, propValue)"
            if cond="previousParamName > 0 && stringat(previousParamName, valueText) == stringat(paramName, valueText)"
              throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
        else
          if cond="stringat(childId, nodeKind) != \"handler\" || propcount(childId, propNode) != 1 || childcount(childId, nodeParent) == 0"
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          let name=langId value="propid(childId, \"lang\", propNode, propKey, propValue)"
          if cond="langId <= 0 || stringat(langId, valueTag) != \"text\" || stringat(langId, valueText) != \"kern\""
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          let name=returnType value="typesource(returnsId, true, valueTag, valueParent, valueRole, valueText)"
          if cond="!validstatementlist(childId, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    let name=lines value="[]"
    for name=r from=0 to="roots"
      let name=fnId value="childat(0, r, nodeParent, nodeOrder)"
      let name=nameId value="propid(fnId, \"name\", propNode, propKey, propValue)"
      let name=returnsId value="propid(fnId, \"returns\", propNode, propKey, propValue)"
      let name=exportId value="propid(fnId, \"export\", propNode, propKey, propValue)"
      let name=line value="\"fn name=\" + structuralname(stringat(nameId, valueText)) + \" returns=\" + typesource(returnsId, true, valueTag, valueParent, valueRole, valueText)"
      if cond="exportId > 0"
        if cond="numberat(exportId, valueBool) == 1"
          assign target=line value="line + \" export=true\""
        else
          assign target=line value="line + \" export=false\""
      do value="lines.push(line)"
      let name=fnChildren value="childcount(fnId, nodeParent)"
      for name=c from=0 to="fnChildren"
        let name=childId value="childat(fnId, c, nodeParent, nodeOrder)"
        if cond="stringat(childId, nodeKind) == \"param\""
          let name=paramName value="propid(childId, \"name\", propNode, propKey, propValue)"
          let name=paramType value="propid(childId, \"type\", propNode, propKey, propValue)"
          do value="lines.push(\"  param name=\" + structuralname(stringat(paramName, valueText)) + \" type=\" + typesource(paramType, false, valueTag, valueParent, valueRole, valueText))"
        else
          do value="lines.push(\"  handler lang=\" + quotesource(\"kern\"))"
          let name=returnType value="typesource(returnsId, true, valueTag, valueParent, valueRole, valueText)"
          let name=statementLines value="emitstatementlist(childId, 2, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
          for name=s from=0 to="statementLines.length"
            do value="lines.push(statementLines[s])"
    return value="lines"
