fn name=validfirst returns=boolean export=true
  param name=c type=string
  handler lang="kern"
    if cond="c >= \"A\" && c <= \"Z\""
      return value="true"
    if cond="c >= \"a\" && c <= \"z\""
      return value="true"
    return value="c == \"_\" || c == \"$\""

fn name=validnext returns=boolean export=true
  param name=c type=string
  handler lang="kern"
    if cond="validfirst(c)"
      return value="true"
    return value="c >= \"0\" && c <= \"9\""

fn name=valididentifier returns=boolean export=true
  param name=value type=string
  handler lang="kern"
    if cond="Text.length(value) == 0 || !validfirst(Text.charAt(value, 0))"
      return value="false"
    let name=n value="Text.length(value)"
    for name=i from=1 to="n"
      if cond="!validnext(Text.charAt(value, i))"
        return value="false"
    return value="true"

fn name=validexpressionidentifier returns=boolean export=true
  param name=value type=string
  handler lang="kern"
    if cond="value == \"true\" || value == \"false\" || value == \"null\" || value == \"none\" || value == \"undefined\""
      return value="false"
    if cond="value == \"await\" || value == \"new\" || value == \"typeof\""
      return value="false"
    return value="valididentifier(value)"

fn name=validinteger returns=boolean export=true
  param name=value type=string
  handler lang="kern"
    let name=start value="0"
    if cond="Text.length(value) == 0"
      return value="false"
    if cond="Text.charAt(value, 0) == \"-\""
      assign target=start value="1"
    if cond="start == Text.length(value)"
      return value="false"
    if cond="Text.charAt(value, start) == \"0\" && Text.length(value) - start > 1"
      return value="false"
    let name=n value="Text.length(value)"
    for name=i from=0 to="n"
      if cond="i >= start"
        let name=c value="Text.charAt(value, i)"
        if cond="c < \"0\" || c > \"9\""
          return value="false"
    return value="value != \"-0\""

fn name=quotesource params="value:string,validated:boolean" returns=string export=true
  handler lang="kern"
    if cond="validated && Text.indexOf(value, \"\\\\\\\\\") < 0"
      let name=fastOut value="\"\\\"\""
      let name=rest value="value"
      while cond="Text.length(rest) > 0"
        let name=next value="Text.indexOf(rest, \"\\\\\")"
        let name=escaped value="\"\\\\\\\\\""
        let name=candidate value="Text.indexOf(rest, \"\\\"\")"
        if cond="candidate >= 0 && (next < 0 || candidate < next)"
          assign target=next value="candidate"
          assign target=escaped value="\"\\\\\\\"\""
        assign target=candidate value="Text.indexOf(rest, \"\\n\")"
        if cond="candidate >= 0 && (next < 0 || candidate < next)"
          assign target=next value="candidate"
          assign target=escaped value="\"\\\\n\""
        assign target=candidate value="Text.indexOf(rest, \"\\r\")"
        if cond="candidate >= 0 && (next < 0 || candidate < next)"
          assign target=next value="candidate"
          assign target=escaped value="\"\\\\r\""
        assign target=candidate value="Text.indexOf(rest, \"\\t\")"
        if cond="candidate >= 0 && (next < 0 || candidate < next)"
          assign target=next value="candidate"
          assign target=escaped value="\"\\\\t\""
        if cond="next < 0"
          return value="fastOut + rest + \"\\\"\""
        assign target=fastOut value="fastOut + Text.slice(rest, 0, next) + escaped"
        assign target=rest value="Text.slice(rest, next + 1, Text.length(rest))"
      return value="fastOut + \"\\\"\""
    let name=out value="\"\\\"\""
    let name=n value="Text.length(value)"
    for name=i from=0 to="n"
      let name=c value="Text.charAt(value, i)"
      if cond="c == \"\\\\\""
        assign target=out value="out + \"\\\\\\\\\""
      else
        if cond="c == \"\\\"\""
          assign target=out value="out + \"\\\\\\\"\""
        else
          if cond="c == \"\\n\""
            assign target=out value="out + \"\\\\n\""
          else
            if cond="c == \"\\r\""
              assign target=out value="out + \"\\\\r\""
            else
              if cond="c == \"\\t\""
                assign target=out value="out + \"\\\\t\""
              else
                if cond="c < \" \" || c == \"\\u007f\" || (c >= \"\\u0080\" && c <= \"\\u009f\") || c == \"\\u2028\" || c == \"\\u2029\" || c == \"\\ufeff\""
                  return value="\"\""
                assign target=out value="out + c"
    return value="out + \"\\\"\""

fn name=structuralname returns=string export=true
  param name=value type=string
  handler lang="kern"
    if cond="!valididentifier(value)"
      return value="\"\""
    let name=n value="Text.length(value)"
    for name=i from=0 to="n"
      if cond="Text.charAt(value, i) == \"$\""
        return value="quotesource(value, false)"
    return value="value"

fn name=propcount returns=number export=false
  param name=node type=number
  param name=propNode type=number[]
  handler lang="kern"
    let name=count value="0"
    for name=i from=0 to="propNode.length"
      if cond="propNode[i] > node"
        return value="count"
      if cond="propNode[i] == node"
        assign target=count value="count + 1"
    return value="count"

fn name=stringat returns=string export=true
  param name=id type=number
  param name=values type=string[]
  handler lang="kern"
    return value="List.index(values, id - 1) ?? \"\""

fn name=numberat returns=number export=true
  param name=id type=number
  param name=values type=number[]
  handler lang="kern"
    return value="List.index(values, id - 1) ?? -1"

fn name=propid returns=number export=false
  param name=node type=number
  param name=key type=string
  param name=propNode type="number[]"
  param name=propKey type="string[]"
  param name=propValue type="number[]"
  handler lang="kern"
    let name=result value="0"
    for name=i from=0 to="propNode.length"
      if cond="propNode[i] > node"
        return value="result"
      if cond="propNode[i] == node && propKey[i] == key"
        if cond="result != 0"
          return value="-1"
        assign target=result value="propValue[i]"
    return value="result"

fn name=childcount returns=number export=true
  param name=parent type=number
  param name=nodeParent type=number[]
  handler lang="kern"
    let name=count value="0"
    for name=i from=0 to="nodeParent.length"
      if cond="nodeParent[i] == parent"
        assign target=count value="count + 1"
    return value="count"

fn name=childat returns=number export=true
  param name=parent type=number
  param name=order type=number
  param name=nodeParent type="number[]"
  param name=nodeOrder type="number[]"
  handler lang="kern"
    for name=i from="parent" to="nodeParent.length"
      if cond="nodeParent[i] == parent && nodeOrder[i] == order"
        return value="i + 1"
    return value="0"

fn name=valuechildcount returns=number export=true
  param name=parent type=number
  param name=valueParent type=number[]
  handler lang="kern"
    let name=count value="0"
    for name=i from=0 to="valueParent.length"
      if cond="valueParent[i] == parent"
        assign target=count value="count + 1"
    return value="count"

fn name=valuechildat returns=number export=true
  param name=parent type=number
  param name=order type=number
  param name=valueParent type="number[]"
  param name=valueOrder type="number[]"
  handler lang="kern"
    let name=result value="0"
    for name=i from=0 to="valueParent.length"
      if cond="valueParent[i] == parent && valueOrder[i] == order"
        if cond="result != 0"
          return value="-1"
        assign target=result value="i + 1"
    return value="result"

fn name=recordfield returns=number export=true
  param name=parent type=number
  param name=key type=string
  param name=valueParent type="number[]"
  param name=valueRole type="string[]"
  handler lang="kern"
    let name=result value="0"
    let name=role value="\"record:\" + key"
    for name=i from=0 to="valueParent.length"
      if cond="valueParent[i] == parent && valueRole[i] == role"
        if cond="result != 0"
          return value="-1"
        assign target=result value="i + 1"
    return value="result"

fn name=typefields returns="number[]" export=true
  param name=parent type=number
  param name=valueParent type="number[]"
  param name=valueRole type="string[]"
  handler lang="kern"
    let name=count value="0"
    let name=kindId value="0"
    let name=elementId value="0"
    for name=i from=0 to="valueParent.length"
      if cond="valueParent[i] == parent"
        assign target=count value="count + 1"
        if cond="valueRole[i] == \"record:kind\""
          if cond="kindId != 0"
            return value="[-1, -1, -1]"
          assign target=kindId value="i + 1"
        if cond="valueRole[i] == \"record:element\""
          if cond="elementId != 0"
            return value="[-1, -1, -1]"
          assign target=elementId value="i + 1"
    return value="[count, kindId, elementId]"

fn name=statementtablefacts returns="number[]" export=false
  param name=nodeParent type="number[]"
  param name=propNode type="number[]"
  param name=propKey type="string[]"
  param name=propValue type="number[]"
  handler lang="kern"
    let name=childCounts value="new Map()"
    let name=propertyCounts value="new Map()"
    let name=valueIds value="new Map()"
    let name=nameIds value="new Map()"
    let name=targetIds value="new Map()"
    let name=condIds value="new Map()"
    let name=fromIds value="new Map()"
    let name=toIds value="new Map()"
    let name=rowCount value="propNode.length"
    if cond="nodeParent.length > rowCount"
      assign target=rowCount value="nodeParent.length"
    for name=i from=0 to="rowCount"
      if cond="i < nodeParent.length"
        let name=parentKey value="String(nodeParent[i])"
        if cond="Map.has(childCounts, parentKey)"
          do value="Map.set(childCounts, String(nodeParent[i]), Map.get(childCounts, parentKey) + 1)"
        else
          do value="Map.set(childCounts, String(nodeParent[i]), 1)"
      if cond="i < propNode.length"
        let name=nodeKey value="String(propNode[i])"
        if cond="Map.has(propertyCounts, nodeKey)"
          do value="Map.set(propertyCounts, String(propNode[i]), Map.get(propertyCounts, nodeKey) + 1)"
        else
          do value="Map.set(propertyCounts, String(propNode[i]), 1)"
        let name=key value="propKey[i]"
        let name=propertyValue value="propValue[i]"
        if cond="key == \"value\""
          if cond="Map.has(valueIds, nodeKey)"
            do value="Map.set(valueIds, String(propNode[i]), -1)"
          else
            do value="Map.set(valueIds, String(propNode[i]), propertyValue)"
        if cond="key == \"name\""
          if cond="Map.has(nameIds, nodeKey)"
            do value="Map.set(nameIds, String(propNode[i]), -1)"
          else
            do value="Map.set(nameIds, String(propNode[i]), propertyValue)"
        if cond="key == \"target\""
          if cond="Map.has(targetIds, nodeKey)"
            do value="Map.set(targetIds, String(propNode[i]), -1)"
          else
            do value="Map.set(targetIds, String(propNode[i]), propertyValue)"
        if cond="key == \"cond\""
          if cond="Map.has(condIds, nodeKey)"
            do value="Map.set(condIds, String(propNode[i]), -1)"
          else
            do value="Map.set(condIds, String(propNode[i]), propertyValue)"
        if cond="key == \"from\""
          if cond="Map.has(fromIds, nodeKey)"
            do value="Map.set(fromIds, String(propNode[i]), -1)"
          else
            do value="Map.set(fromIds, String(propNode[i]), propertyValue)"
        if cond="key == \"to\""
          if cond="Map.has(toIds, nodeKey)"
            do value="Map.set(toIds, String(propNode[i]), -1)"
          else
            do value="Map.set(toIds, String(propNode[i]), propertyValue)"
    let name=facts value="[]"
    let name=nodeCount value="nodeParent.length + 1"
    for name=node from=0 to="nodeCount"
      let name=nodeKey value="String(node)"
      let name=childCount value="0"
      let name=propertyCount value="0"
      let name=valueId value="0"
      let name=nameId value="0"
      let name=targetId value="0"
      let name=condId value="0"
      let name=fromId value="0"
      let name=toId value="0"
      if cond="Map.has(childCounts, nodeKey)"
        assign target=childCount value="Map.get(childCounts, nodeKey)"
      if cond="Map.has(propertyCounts, nodeKey)"
        assign target=propertyCount value="Map.get(propertyCounts, nodeKey)"
      if cond="Map.has(valueIds, nodeKey)"
        assign target=valueId value="Map.get(valueIds, nodeKey)"
      if cond="Map.has(nameIds, nodeKey)"
        assign target=nameId value="Map.get(nameIds, nodeKey)"
      if cond="Map.has(targetIds, nodeKey)"
        assign target=targetId value="Map.get(targetIds, nodeKey)"
      if cond="Map.has(condIds, nodeKey)"
        assign target=condId value="Map.get(condIds, nodeKey)"
      if cond="Map.has(fromIds, nodeKey)"
        assign target=fromId value="Map.get(fromIds, nodeKey)"
      if cond="Map.has(toIds, nodeKey)"
        assign target=toId value="Map.get(toIds, nodeKey)"
      do value="facts.push(childCount)"
      do value="facts.push(propertyCount)"
      do value="facts.push(valueId)"
      do value="facts.push(nameId)"
      do value="facts.push(targetId)"
      do value="facts.push(condId)"
      do value="facts.push(fromId)"
      do value="facts.push(toId)"
    return value="facts"

fn name=statementfacts returns="number[]" export=false
  param name=node type=number
  param name=nodeParent type="number[]"
  param name=propNode type="number[]"
  param name=propKey type="string[]"
  param name=propValue type="number[]"
  handler lang="kern"
    let name=facts value="statementtablefacts(nodeParent, propNode, propKey, propValue)"
    let name=offset value="node * 8"
    let name=childCount value="numberat(offset + 1, facts)"
    let name=propertyCount value="numberat(offset + 2, facts)"
    let name=valueId value="numberat(offset + 3, facts)"
    let name=nameId value="numberat(offset + 4, facts)"
    let name=targetId value="numberat(offset + 5, facts)"
    let name=condId value="numberat(offset + 6, facts)"
    let name=fromId value="numberat(offset + 7, facts)"
    let name=toId value="numberat(offset + 8, facts)"
    return value="[childCount, propertyCount, valueId, nameId, targetId, condId, fromId, toId]"
fn name=indentation returns=string export=true
  param name=level type=number
  handler lang="kern"
    let name=out value="\"\""
    for name=i from=0 to="level"
      assign target=out value="out + \"  \""
    return value="out"

fn name=validstatementlist returns=boolean export=true
  param name=parent type=number
  param name=returnType type=string
  param name=nodeKind type=string[]
  param name=nodeParent type=number[]
  param name=nodeOrder type=number[]
  param name=propNode type=number[]
  param name=propKey type=string[]
  param name=propValue type=number[]
  param name=valueTag type=string[]
  param name=valueParent type=number[]
  param name=valueRole type=string[]
  param name=valueOrder type=number[]
  param name=valueText type=string[]
  param name=valueBool type=number[]
  handler lang="kern"
    let name=facts value="statementfacts(parent, nodeParent, propNode, propKey, propValue)"
    let name=count value="facts[0]"
    for name=i from=0 to="count"
      let name=id value="childat(parent, i, nodeParent, nodeOrder)"
      if cond="id <= 0 || !validstatement(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
        return value="false"
      let name=kind value="stringat(id, nodeKind)"
      if cond="kind == \"else\""
        if cond="i == 0"
          return value="false"
        let name=previous value="childat(parent, i - 1, nodeParent, nodeOrder)"
        if cond="previous <= 0 || stringat(previous, nodeKind) != \"if\""
          return value="false"
      if cond="kind == \"return\" && i != count - 1"
        return value="false"
    return value="true"

fn name=validstatement params="id:number,returnType:string,nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns=boolean export=true
  handler lang="kern"
    let name=kind value="stringat(id, nodeKind)"
    let name=facts value="statementfacts(id, nodeParent, propNode, propKey, propValue)"
    if cond="kind == \"return\""
      if cond="facts[0] != 0"
        return value="false"
      let name=valueId value="facts[2]"
      if cond="returnType == \"void\""
        return value="valueId == 0 && facts[1] == 0"
      return value="valueId > 0 && facts[1] == 1 && exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) != \"\""
    if cond="kind == \"let\""
      if cond="facts[0] != 0"
        return value="false"
      let name=nameId value="facts[3]"
      let name=valueId value="facts[2]"
      if cond="nameId <= 0 || valueId <= 0 || facts[1] != 2 || stringat(nameId, valueTag) != \"text\""
        return value="false"
      if cond="structuralname(stringat(nameId, valueText)) == \"\""
        return value="false"
      return value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) != \"\""
    if cond="kind == \"assign\""
      if cond="facts[0] != 0"
        return value="false"
      let name=targetId value="facts[4]"
      let name=valueId value="facts[2]"
      if cond="targetId <= 0 || valueId <= 0 || facts[1] != 2"
        return value="false"
      let name=targetKindId value="recordfield(targetId, \"kind\", valueParent, valueRole)"
      if cond="targetKindId <= 0 || stringat(targetKindId, valueTag) != \"text\""
        return value="false"
      let name=targetKind value="stringat(targetKindId, valueText)"
      if cond="targetKind != \"identifier\" && targetKind != \"member\" && targetKind != \"index\""
        return value="false"
      let name=targetExpression value="exprsource(targetId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      let name=valueExpression value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      return value="targetExpression != \"\" && valueExpression != \"\""
    if cond="kind == \"do\""
      if cond="facts[0] != 0"
        return value="false"
      let name=valueId value="facts[2]"
      if cond="valueId <= 0 || facts[1] != 1"
        return value="false"
      return value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) != \"\""
    if cond="kind == \"if\""
      let name=condId value="facts[5]"
      if cond="condId <= 0 || facts[1] != 1 || exprsource(condId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) == \"\""
        return value="false"
      return value="validstatementlist(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    if cond="kind == \"else\""
      if cond="facts[1] != 0"
        return value="false"
      return value="validstatementlist(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    if cond="kind == \"for\""
      let name=fromId value="facts[6]"
      let name=nameId value="facts[3]"
      let name=toId value="facts[7]"
      if cond="fromId <= 0 || nameId <= 0 || toId <= 0 || facts[1] != 3 || stringat(nameId, valueTag) != \"text\""
        return value="false"
      let name=name value="stringat(nameId, valueText)"
      if cond="!valididentifier(name)"
        return value="false"
      if cond="Text.indexOf(name, \"$\") >= 0"
        return value="false"
      let name=fromExpression value="exprsource(fromId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      let name=toExpression value="exprsource(toId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      if cond="fromExpression == \"\" || toExpression == \"\""
        return value="false"
      return value="validstatementlist(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    if cond="kind == \"while\""
      let name=condId value="facts[5]"
      if cond="condId <= 0 || facts[1] != 1 || exprsource(condId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool) == \"\""
        return value="false"
      return value="validstatementlist(id, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    return value="false"

fn name=emitstatementlist returns="string[]" export=true
  param name=parent type=number
  param name=level type=number
  param name=returnType type=string
  param name=nodeKind type=string[]
  param name=nodeParent type=number[]
  param name=nodeOrder type=number[]
  param name=propNode type=number[]
  param name=propKey type=string[]
  param name=propValue type=number[]
  param name=valueTag type=string[]
  param name=valueParent type=number[]
  param name=valueRole type=string[]
  param name=valueOrder type=number[]
  param name=valueText type=string[]
  param name=valueBool type=number[]
  handler lang="kern"
    let name=out value="[]"
    let name=facts value="statementfacts(parent, nodeParent, propNode, propKey, propValue)"
    let name=count value="facts[0]"
    for name=i from=0 to="count"
      let name=id value="childat(parent, i, nodeParent, nodeOrder)"
      let name=statementLines value="emitstatement(id, level, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      for name=j from=0 to="statementLines.length"
        do value="out.push(statementLines[j])"
    return value="out"

fn name=emitstatement params="id:number,level:number,returnType:string,nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns="string[]" export=true
  handler lang="kern"
    let name=out value="[]"
    let name=kind value="stringat(id, nodeKind)"
    let name=prefix value="indentation(level)"
    let name=facts value="statementfacts(id, nodeParent, propNode, propKey, propValue)"
    if cond="kind == \"return\""
      let name=valueId value="facts[2]"
      if cond="valueId == 0"
        do value="out.push(prefix + \"return\")"
      else
        let name=expression value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
        do value="out.push(prefix + \"return value=\" + quotesource(expression, true))"
      return value="out"
    if cond="kind == \"let\""
      let name=nameId value="facts[3]"
      let name=valueId value="facts[2]"
      let name=name value="structuralname(stringat(nameId, valueText))"
      let name=expression value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"let name=\" + name + \" value=\" + quotesource(expression, true))"
      return value="out"
    if cond="kind == \"assign\""
      let name=targetId value="facts[4]"
      let name=valueId value="facts[2]"
      let name=targetExpression value="exprsource(targetId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      let name=valueExpression value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"assign target=\" + quotesource(targetExpression, true) + \" value=\" + quotesource(valueExpression, true))"
      return value="out"
    if cond="kind == \"do\""
      let name=valueId value="facts[2]"
      let name=expression value="exprsource(valueId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"do value=\" + quotesource(expression, true))"
      return value="out"
    if cond="kind == \"if\""
      let name=condId value="facts[5]"
      let name=condition value="exprsource(condId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"if cond=\" + quotesource(condition, true))"
    if cond="kind == \"else\""
      do value="out.push(prefix + \"else\")"
    if cond="kind == \"for\""
      let name=fromId value="facts[6]"
      let name=nameId value="facts[3]"
      let name=toId value="facts[7]"
      let name=name value="stringat(nameId, valueText)"
      let name=fromExpression value="exprsource(fromId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      let name=toExpression value="exprsource(toId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"for name=\" + name + \" from=\" + quotesource(fromExpression, true) + \" to=\" + quotesource(toExpression, true))"
    if cond="kind == \"while\""
      let name=condId value="facts[5]"
      let name=condition value="exprsource(condId, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      do value="out.push(prefix + \"while cond=\" + quotesource(condition, true))"
    let name=children value="emitstatementlist(id, level + 1, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    for name=i from=0 to="children.length"
      do value="out.push(children[i])"
    return value="out"
fn name=typesource returns=string export=true
  param name=id type=number
  param name=allowVoid type=boolean
  param name=valueTag type=string[]
  param name=valueParent type=number[]
  param name=valueRole type=string[]
  param name=valueText type=string[]
  handler lang="kern"
    if cond="id <= 0 || id > valueTag.length || stringat(id, valueTag) != \"record\""
      return value="\"\""
    let name=fields value="typefields(id, valueParent, valueRole)"
    let name=kindId value="fields[1]"
    if cond="kindId <= 0 || stringat(kindId, valueTag) != \"text\""
      return value="\"\""
    let name=kind value="stringat(kindId, valueText)"
    if cond="fields[0] == 1"
      if cond="kind == \"boolean\""
        return value="\"boolean\""
      if cond="kind == \"integer\""
        return value="\"number\""
      if cond="kind == \"text\""
        return value="\"string\""
      if cond="allowVoid && kind == \"void\""
        return value="\"void\""
      return value="\"\""
    if cond="fields[0] != 2 || kind != \"list\""
      return value="\"\""
    let name=elementId value="fields[2]"
    if cond="elementId <= 0 || stringat(elementId, valueTag) != \"text\""
      return value="\"\""
    let name=element value="stringat(elementId, valueText)"
    if cond="element == \"boolean\""
      return value="\"boolean[]\""
    if cond="element == \"integer\""
      return value="\"number[]\""
    if cond="element == \"text\""
      return value="\"string[]\""
    return value="\"\""

fn name=validbinaryop returns=boolean export=true
  param name=op type=string
  handler lang="kern"
    if cond="op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" || op == \"%\""
      return value="true"
    if cond="op == \"**\" || op == \"==\" || op == \"!=\" || op == \"===\" || op == \"!==\""
      return value="true"
    if cond="op == \"<\" || op == \"<=\" || op == \">\" || op == \">=\" || op == \"instanceof\""
      return value="true"
    if cond="op == \"&&\" || op == \"||\" || op == \"??\" || op == \"&\" || op == \"|\""
      return value="true"
    return value="op == \"^\" || op == \"<<\" || op == \">>\" || op == \">>>\""

fn name=exprsource returns=string export=true
  param name=id type=number
  param name=valueTag type=string[]
  param name=valueParent type=number[]
  param name=valueRole type=string[]
  param name=valueOrder type=number[]
  param name=valueText type=string[]
  param name=valueBool type=number[]
  handler lang="kern"
    if cond="id <= 0 || id > valueTag.length || stringat(id, valueTag) != \"record\""
      return value="\"\""
    let name=sources value="expressionsources(valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
    return value="List.index(sources, valueTag.length - id) ?? \"\""

fn name=expressionsources params="valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[]" returns="string[]" export=true
  handler lang="kern"
    let name=childCounts value="new Map()"
    let name=childrenByOrder value="new Map()"
    let name=childrenByRole value="new Map()"
    for name=i from=0 to="valueParent.length"
      let name=parent value="valueParent[i]"
      if cond="parent > 0"
        if cond="parent >= i + 1 || valueOrder[i] < 0"
          return value="[]"
        let name=parentKey value="String(parent)"
        if cond="Map.has(childCounts, parentKey)"
          do value="Map.set(childCounts, String(parent), Map.get(childCounts, parentKey) + 1)"
        else
          do value="Map.set(childCounts, String(parent), 1)"
        let name=orderKey value="parentKey + \":\" + String(valueOrder[i])"
        if cond="Map.has(childrenByOrder, orderKey)"
          return value="[]"
        do value="Map.set(childrenByOrder, String(parent) + \":\" + String(valueOrder[i]), i + 1)"
        if cond="Text.startsWith(valueRole[i], \"record:\")"
          let name=roleKey value="parentKey + \":\" + String(Text.length(valueRole[i])) + \":\" + valueRole[i]"
          if cond="Map.has(childrenByRole, roleKey)"
            return value="[]"
          do value="Map.set(childrenByRole, String(parent) + \":\" + String(Text.length(valueRole[i])) + \":\" + String(valueRole[i]), i + 1)"
    let name=sources value="new Map()"
    let name=ordered value="[]"
    for name=scan from=0 to="valueTag.length"
      let name=current value="valueTag.length - scan"
      let name=source value="\"\""
      if cond="stringat(current, valueTag) == \"record\""
        let name=currentKey value="String(current)"
        let name=directChildren value="0"
        if cond="Map.has(childCounts, currentKey)"
          assign target=directChildren value="Map.get(childCounts, currentKey)"
        if cond="directChildren == 2"
          let name=fieldsRole value="\"record:fields\""
          let name=kindRole value="\"record:kind\""
          let name=fieldsKey value="currentKey + \":\" + String(Text.length(fieldsRole)) + \":\" + fieldsRole"
          let name=kindKey value="currentKey + \":\" + String(Text.length(kindRole)) + \":\" + kindRole"
          if cond="Map.has(childrenByRole, fieldsKey) && Map.has(childrenByRole, kindKey)"
            let name=fieldsId value="Map.get(childrenByRole, fieldsKey)"
            let name=kindId value="Map.get(childrenByRole, kindKey)"
            if cond="stringat(fieldsId, valueTag) == \"record\" && stringat(kindId, valueTag) == \"text\""
              let name=kind value="stringat(kindId, valueText)"
              let name=fieldsKeyPrefix value="String(fieldsId) + \":\""
              let name=fieldCount value="0"
              if cond="Map.has(childCounts, String(fieldsId))"
                assign target=fieldCount value="Map.get(childCounts, String(fieldsId))"
              let name=valueRoleName value="\"record:value\""
              let name=valueKey value="fieldsKeyPrefix + String(Text.length(valueRoleName)) + \":\" + valueRoleName"
              let name=valueId value="0"
              if cond="Map.has(childrenByRole, valueKey)"
                assign target=valueId value="Map.get(childrenByRole, valueKey)"
              if cond="kind == \"null\" && fieldCount == 0"
                assign target=source value="\"null\""
              if cond="kind == \"identifier\" && fieldCount == 1"
                let name=nameRole value="\"record:name\""
                let name=nameKey value="fieldsKeyPrefix + String(Text.length(nameRole)) + \":\" + nameRole"
                if cond="Map.has(childrenByRole, nameKey)"
                  let name=nameId value="Map.get(childrenByRole, nameKey)"
                  if cond="stringat(nameId, valueTag) == \"text\" && validexpressionidentifier(stringat(nameId, valueText))"
                    assign target=source value="stringat(nameId, valueText)"
              if cond="kind == \"boolean\" && fieldCount == 1 && valueId > 0 && stringat(valueId, valueTag) == \"bool\""
                if cond="numberat(valueId, valueBool) == 1"
                  assign target=source value="\"true\""
                else
                  assign target=source value="\"false\""
              if cond="kind == \"integer\" && fieldCount == 1 && valueId > 0 && stringat(valueId, valueTag) == \"int\" && validinteger(stringat(valueId, valueText)) && !Text.startsWith(stringat(valueId, valueText), \"-\")"
                assign target=source value="stringat(valueId, valueText)"
              if cond="kind == \"text\" && fieldCount == 1 && valueId > 0 && stringat(valueId, valueTag) == \"text\""
                assign target=source value="quotesource(stringat(valueId, valueText), false)"
              if cond="kind == \"binary\" && fieldCount == 3"
                let name=leftRole value="\"record:left\""
                let name=opRole value="\"record:op\""
                let name=rightRole value="\"record:right\""
                let name=leftKey value="fieldsKeyPrefix + String(Text.length(leftRole)) + \":\" + leftRole"
                let name=opKey value="fieldsKeyPrefix + String(Text.length(opRole)) + \":\" + opRole"
                let name=rightKey value="fieldsKeyPrefix + String(Text.length(rightRole)) + \":\" + rightRole"
                if cond="Map.has(childrenByRole, leftKey) && Map.has(childrenByRole, opKey) && Map.has(childrenByRole, rightKey)"
                  let name=leftId value="Map.get(childrenByRole, leftKey)"
                  let name=opId value="Map.get(childrenByRole, opKey)"
                  let name=rightId value="Map.get(childrenByRole, rightKey)"
                  if cond="stringat(opId, valueTag) == \"text\" && validbinaryop(stringat(opId, valueText)) && Map.has(sources, String(leftId)) && Map.has(sources, String(rightId))"
                    assign target=source value="\"(\" + Map.get(sources, String(leftId)) + \" \" + stringat(opId, valueText) + \" \" + Map.get(sources, String(rightId)) + \")\""
              if cond="kind == \"unary\" && fieldCount == 2"
                let name=argumentRole value="\"record:argument\""
                let name=opRole value="\"record:op\""
                let name=argumentKey value="fieldsKeyPrefix + String(Text.length(argumentRole)) + \":\" + argumentRole"
                let name=opKey value="fieldsKeyPrefix + String(Text.length(opRole)) + \":\" + opRole"
                if cond="Map.has(childrenByRole, argumentKey) && Map.has(childrenByRole, opKey)"
                  let name=argumentId value="Map.get(childrenByRole, argumentKey)"
                  let name=opId value="Map.get(childrenByRole, opKey)"
                  if cond="stringat(opId, valueTag) == \"text\" && Map.has(sources, String(argumentId))"
                    let name=op value="stringat(opId, valueText)"
                    let name=argument value="Map.get(sources, String(argumentId))"
                    if cond="(op == \"!\" || op == \"-\" || op == \"~\" || op == \"typeof\") && !(op == \"-\" && argument == \"0\")"
                      if cond="op == \"typeof\""
                        assign target=source value="\"(\" + op + \" \" + argument + \")\""
                      else
                        assign target=source value="\"(\" + op + argument + \")\""
              if cond="kind == \"member\" && fieldCount == 3"
                let name=objectRole value="\"record:object\""
                let name=optionalRole value="\"record:optional\""
                let name=propertyRole value="\"record:property\""
                let name=objectKey value="fieldsKeyPrefix + String(Text.length(objectRole)) + \":\" + objectRole"
                let name=optionalKey value="fieldsKeyPrefix + String(Text.length(optionalRole)) + \":\" + optionalRole"
                let name=propertyKey value="fieldsKeyPrefix + String(Text.length(propertyRole)) + \":\" + propertyRole"
                if cond="Map.has(childrenByRole, objectKey) && Map.has(childrenByRole, optionalKey) && Map.has(childrenByRole, propertyKey)"
                  let name=objectId value="Map.get(childrenByRole, objectKey)"
                  let name=optionalId value="Map.get(childrenByRole, optionalKey)"
                  let name=propertyId value="Map.get(childrenByRole, propertyKey)"
                  if cond="stringat(optionalId, valueTag) == \"bool\" && numberat(optionalId, valueBool) == 0 && stringat(propertyId, valueTag) == \"text\" && Map.has(sources, String(objectId))"
                    let name=property value="stringat(propertyId, valueText)"
                    if cond="valididentifier(property) && property != \"null\" && property != \"none\" && property != \"undefined\" && property != \"true\" && property != \"false\" && property != \"await\""
                      assign target=source value="Map.get(sources, String(objectId)) + \".\" + property"
              if cond="kind == \"index\" && fieldCount == 3"
                let name=indexRole value="\"record:index\""
                let name=objectRole value="\"record:object\""
                let name=optionalRole value="\"record:optional\""
                let name=indexKey value="fieldsKeyPrefix + String(Text.length(indexRole)) + \":\" + indexRole"
                let name=objectKey value="fieldsKeyPrefix + String(Text.length(objectRole)) + \":\" + objectRole"
                let name=optionalKey value="fieldsKeyPrefix + String(Text.length(optionalRole)) + \":\" + optionalRole"
                if cond="Map.has(childrenByRole, indexKey) && Map.has(childrenByRole, objectKey) && Map.has(childrenByRole, optionalKey)"
                  let name=indexId value="Map.get(childrenByRole, indexKey)"
                  let name=objectId value="Map.get(childrenByRole, objectKey)"
                  let name=optionalId value="Map.get(childrenByRole, optionalKey)"
                  if cond="stringat(optionalId, valueTag) == \"bool\" && numberat(optionalId, valueBool) == 0 && Map.has(sources, String(indexId)) && Map.has(sources, String(objectId))"
                    assign target=source value="Map.get(sources, String(objectId)) + \"[\" + Map.get(sources, String(indexId)) + \"]\""
              if cond="kind == \"call\" && fieldCount == 3"
                let name=argsRole value="\"record:args\""
                let name=calleeRole value="\"record:callee\""
                let name=optionalRole value="\"record:optional\""
                let name=argsKey value="fieldsKeyPrefix + String(Text.length(argsRole)) + \":\" + argsRole"
                let name=calleeKey value="fieldsKeyPrefix + String(Text.length(calleeRole)) + \":\" + calleeRole"
                let name=optionalKey value="fieldsKeyPrefix + String(Text.length(optionalRole)) + \":\" + optionalRole"
                if cond="Map.has(childrenByRole, argsKey) && Map.has(childrenByRole, calleeKey) && Map.has(childrenByRole, optionalKey)"
                  let name=argsId value="Map.get(childrenByRole, argsKey)"
                  let name=calleeId value="Map.get(childrenByRole, calleeKey)"
                  let name=optionalId value="Map.get(childrenByRole, optionalKey)"
                  if cond="stringat(argsId, valueTag) == \"list\" && stringat(optionalId, valueTag) == \"bool\" && numberat(optionalId, valueBool) == 0 && Map.has(sources, String(calleeId))"
                    let name=out value="Map.get(sources, String(calleeId)) + \"(\""
                    let name=argsValid value="true"
                    let name=argCount value="0"
                    if cond="Map.has(childCounts, String(argsId))"
                      assign target=argCount value="Map.get(childCounts, String(argsId))"
                    for name=argOrder from=0 to="argCount"
                      let name=argOrderKey value="String(argsId) + \":\" + String(argOrder)"
                      if cond="!Map.has(childrenByOrder, argOrderKey)"
                        assign target=argsValid value="false"
                      else
                        let name=argId value="Map.get(childrenByOrder, argOrderKey)"
                        if cond="!Map.has(sources, String(argId))"
                          assign target=argsValid value="false"
                        else
                          if cond="argOrder > 0"
                            assign target=out value="out + \", \""
                          assign target=out value="out + Map.get(sources, String(argId))"
                    if cond="argsValid"
                      assign target=source value="out + \")\""
              if cond="kind == \"list\" && fieldCount == 1"
                let name=itemsRole value="\"record:items\""
                let name=itemsKey value="fieldsKeyPrefix + String(Text.length(itemsRole)) + \":\" + itemsRole"
                if cond="Map.has(childrenByRole, itemsKey)"
                  let name=itemsId value="Map.get(childrenByRole, itemsKey)"
                  if cond="stringat(itemsId, valueTag) == \"list\""
                    let name=out value="\"[\""
                    let name=itemsValid value="true"
                    let name=itemCount value="0"
                    if cond="Map.has(childCounts, String(itemsId))"
                      assign target=itemCount value="Map.get(childCounts, String(itemsId))"
                    for name=itemOrder from=0 to="itemCount"
                      let name=itemOrderKey value="String(itemsId) + \":\" + String(itemOrder)"
                      if cond="!Map.has(childrenByOrder, itemOrderKey)"
                        assign target=itemsValid value="false"
                      else
                        let name=itemId value="Map.get(childrenByOrder, itemOrderKey)"
                        if cond="!Map.has(sources, String(itemId))"
                          assign target=itemsValid value="false"
                        else
                          if cond="itemOrder > 0"
                            assign target=out value="out + \", \""
                          assign target=out value="out + Map.get(sources, String(itemId))"
                    if cond="itemsValid"
                      assign target=source value="out + \"]\""
              if cond="source != \"\""
                do value="Map.set(sources, String(current), source)"
      do value="ordered.push(source)"
    return value="ordered"

fn name=tablesok returns=boolean export=true
  param name=nodeKind type=string[]
  param name=nodeParent type=number[]
  param name=nodeOrder type=number[]
  param name=propNode type=number[]
  param name=propKey type=string[]
  param name=propValue type=number[]
  param name=valueTag type=string[]
  param name=valueParent type=number[]
  param name=valueRole type=string[]
  param name=valueOrder type=number[]
  param name=valueText type=string[]
  param name=valueBool type=number[]
  handler lang="kern"
    if cond="!nodetablesok(nodeKind, nodeParent, nodeOrder)"
      return value="false"
    if cond="!propertyfacts(nodeKind, propNode, propKey, propValue, valueTag)"
      return value="false"
    return value="valuefacts(propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"

fn name=canonicalize params="nodeKind:string[],nodeParent:number[],nodeOrder:number[],propNode:number[],propKey:string[],propValue:number[],valueTag:string[],valueParent:number[],valueRole:string[],valueOrder:number[],valueText:string[],valueBool:number[],maxNodeRows:number,maxPropertyRows:number,maxValueRows:number" returns=string[] export=true
  handler lang="kern"
    if cond="maxNodeRows <= 0 || maxPropertyRows <= 0 || maxValueRows <= 0 || nodeKind.length > maxNodeRows || propNode.length > maxPropertyRows || valueTag.length > maxValueRows"
      throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    if cond="!tablesok(nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
      throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    let name=roots value="childcount(0, nodeParent)"
    if cond="roots == 0"
      throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    for name=outputRoot from=0 to="roots"
      let name=fnId value="childat(0, outputRoot, nodeParent, nodeOrder)"
      if cond="fnId <= 0 || stringat(fnId, nodeKind) != \"fn\""
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      let name=nameId value="propid(fnId, \"name\", propNode, propKey, propValue)"
      let name=returnsId value="propid(fnId, \"returns\", propNode, propKey, propValue)"
      let name=exportId value="propid(fnId, \"export\", propNode, propKey, propValue)"
      if cond="nameId <= 0 || returnsId <= 0 || exportId < 0 || propcount(fnId, propNode) < 2 || propcount(fnId, propNode) > 3"
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      for name=fnProperty from=0 to="propNode.length"
        if cond="propNode[fnProperty] == fnId && propKey[fnProperty] != \"name\" && propKey[fnProperty] != \"returns\" && propKey[fnProperty] != \"export\""
          throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      if cond="stringat(nameId, valueTag) != \"text\" || structuralname(stringat(nameId, valueText)) == \"\" || typesource(returnsId, true, valueTag, valueParent, valueRole, valueText) == \"\""
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      for name=previousRoot from=0 to="outputRoot"
        let name=previousFnId value="childat(0, previousRoot, nodeParent, nodeOrder)"
        let name=previousNameId value="propid(previousFnId, \"name\", propNode, propKey, propValue)"
        if cond="previousNameId > 0 && stringat(previousNameId, valueText) == stringat(nameId, valueText)"
          throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      if cond="exportId > 0 && stringat(exportId, valueTag) != \"bool\""
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      let name=fnChildren value="childcount(fnId, nodeParent)"
      if cond="fnChildren == 0"
        throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
      for name=c from=0 to="fnChildren"
        let name=childId value="childat(fnId, c, nodeParent, nodeOrder)"
        if cond="childId <= 0"
          throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
        if cond="c < fnChildren - 1"
          if cond="stringat(childId, nodeKind) != \"param\" || childcount(childId, nodeParent) != 0 || propcount(childId, propNode) != 2"
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          let name=paramName value="propid(childId, \"name\", propNode, propKey, propValue)"
          let name=paramType value="propid(childId, \"type\", propNode, propKey, propValue)"
          if cond="paramName <= 0 || paramType <= 0 || stringat(paramName, valueTag) != \"text\" || structuralname(stringat(paramName, valueText)) == \"\" || typesource(paramType, false, valueTag, valueParent, valueRole, valueText) == \"\""
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          for name=previousParam from=0 to="c"
            let name=previousParamId value="childat(fnId, previousParam, nodeParent, nodeOrder)"
            let name=previousParamName value="propid(previousParamId, \"name\", propNode, propKey, propValue)"
            if cond="previousParamName > 0 && stringat(previousParamName, valueText) == stringat(paramName, valueText)"
              throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
        else
          if cond="stringat(childId, nodeKind) != \"handler\" || propcount(childId, propNode) != 1 || childcount(childId, nodeParent) == 0"
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          let name=langId value="propid(childId, \"lang\", propNode, propKey, propValue)"
          if cond="langId <= 0 || stringat(langId, valueTag) != \"text\" || stringat(langId, valueText) != \"kern\""
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
          let name=returnType value="typesource(returnsId, true, valueTag, valueParent, valueRole, valueText)"
          if cond="!validstatementlist(childId, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
            throw value="new Error(\"KERN_CANONICALIZER_PROFILE\")"
    let name=lines value="[]"
    for name=r from=0 to="roots"
      let name=fnId value="childat(0, r, nodeParent, nodeOrder)"
      let name=nameId value="propid(fnId, \"name\", propNode, propKey, propValue)"
      let name=returnsId value="propid(fnId, \"returns\", propNode, propKey, propValue)"
      let name=exportId value="propid(fnId, \"export\", propNode, propKey, propValue)"
      let name=line value="\"fn name=\" + structuralname(stringat(nameId, valueText)) + \" returns=\" + typesource(returnsId, true, valueTag, valueParent, valueRole, valueText)"
      if cond="exportId > 0"
        if cond="numberat(exportId, valueBool) == 1"
          assign target=line value="line + \" export=true\""
        else
          assign target=line value="line + \" export=false\""
      do value="lines.push(line)"
      let name=fnChildren value="childcount(fnId, nodeParent)"
      for name=c from=0 to="fnChildren"
        let name=childId value="childat(fnId, c, nodeParent, nodeOrder)"
        if cond="stringat(childId, nodeKind) == \"param\""
          let name=paramName value="propid(childId, \"name\", propNode, propKey, propValue)"
          let name=paramType value="propid(childId, \"type\", propNode, propKey, propValue)"
          do value="lines.push(\"  param name=\" + structuralname(stringat(paramName, valueText)) + \" type=\" + typesource(paramType, false, valueTag, valueParent, valueRole, valueText))"
        else
          do value="lines.push(\"  handler lang=\" + quotesource(\"kern\", false))"
          let name=returnType value="typesource(returnsId, true, valueTag, valueParent, valueRole, valueText)"
          let name=statementLines value="emitstatementlist(childId, 2, returnType, nodeKind, nodeParent, nodeOrder, propNode, propKey, propValue, valueTag, valueParent, valueRole, valueOrder, valueText, valueBool)"
          for name=s from=0 to="statementLines.length"
            do value="lines.push(statementLines[s])"
    return value="lines"

fn name=nodetablesok returns=boolean export=true
  param name=nodeKind type=string[]
  param name=nodeParent type=number[]
  param name=nodeOrder type=number[]
  handler lang="kern"
    if cond="nodeKind.length == 0 || nodeKind.length != nodeParent.length || nodeKind.length != nodeOrder.length"
      return value="false"
    let name=orders value="new Map()"
    let name=siblingCounts value="new Map()"
    let name=orderTotal value="0"
    let name=expectedOrderTotal value="0"
    for name=nodeIndex from=0 to="nodeKind.length"
      if cond="nodeParent[nodeIndex] < 0 || nodeParent[nodeIndex] > nodeKind.length || nodeOrder[nodeIndex] < 0"
        return value="false"
      if cond="nodeParent[nodeIndex] != 0 && nodeParent[nodeIndex] >= nodeIndex + 1"
        return value="false"
      let name=orderKey value="String(nodeParent[nodeIndex]) + \":\" + String(nodeOrder[nodeIndex])"
      if cond="Map.has(orders, orderKey)"
        return value="false"
      let name=parentKey value="String(nodeParent[nodeIndex])"
      let name=siblingCount value="0"
      if cond="Map.has(siblingCounts, parentKey)"
        assign target=siblingCount value="Map.get(siblingCounts, parentKey)"
      assign target=orderTotal value="orderTotal + nodeOrder[nodeIndex]"
      assign target=expectedOrderTotal value="expectedOrderTotal + siblingCount"
      do value="Map.set(orders, String(nodeParent[nodeIndex]) + \":\" + String(nodeOrder[nodeIndex]), true)"
      do value="Map.set(siblingCounts, String(nodeParent[nodeIndex]), siblingCount + 1)"
    return value="orderTotal == expectedOrderTotal"

fn name=propertyfacts returns=boolean export=true
  param name=nodeKind type=string[]
  param name=propNode type=number[]
  param name=propKey type=string[]
  param name=propValue type=number[]
  param name=valueTag type=string[]
  handler lang="kern"
    if cond="propNode.length != propKey.length || propNode.length != propValue.length"
      return value="false"
    let name=propertyKeys value="new Map()"
    let name=ownerKeys value="new Map()"
    for name=propertyIndex from=0 to="propNode.length"
      if cond="propNode[propertyIndex] < 1 || propNode[propertyIndex] > nodeKind.length || propValue[propertyIndex] < 1 || propValue[propertyIndex] > valueTag.length"
        return value="false"
      if cond="propertyIndex > 0 && propNode[propertyIndex] < propNode[propertyIndex - 1]"
        return value="false"
      let name=propertyKey value="String(propNode[propertyIndex]) + \":\" + String(Text.length(propKey[propertyIndex])) + \":\" + propKey[propertyIndex]"
      if cond="Map.has(propertyKeys, propertyKey)"
        return value="false"
      do value="Map.set(propertyKeys, String(propNode[propertyIndex]) + \":\" + String(Text.length(propKey[propertyIndex])) + \":\" + String(propKey[propertyIndex]), true)"
      let name=ownerKey value="String(propValue[propertyIndex])"
      if cond="Map.has(ownerKeys, ownerKey)"
        return value="false"
      do value="Map.set(ownerKeys, String(propValue[propertyIndex]), true)"
    return value="true"

fn name=valuefacts returns=boolean export=true
  param name=propValue type=number[]
  param name=valueTag type=string[]
  param name=valueParent type=number[]
  param name=valueRole type=string[]
  param name=valueOrder type=number[]
  param name=valueText type=string[]
  param name=valueBool type=number[]
  handler lang="kern"
    if cond="valueTag.length != valueParent.length || valueTag.length != valueRole.length || valueTag.length != valueOrder.length || valueTag.length != valueText.length || valueTag.length != valueBool.length"
      return value="false"
    let name=ownedValues value="new Map()"
    for name=propertyIndex from=0 to="propValue.length"
      if cond="propValue[propertyIndex] < 1 || propValue[propertyIndex] > valueTag.length"
        return value="false"
      let name=ownerKey value="String(propValue[propertyIndex])"
      if cond="Map.has(ownedValues, ownerKey)"
        return value="false"
      do value="Map.set(ownedValues, String(propValue[propertyIndex]), true)"
    let name=orders value="new Map()"
    let name=siblingCounts value="new Map()"
    let name=roles value="new Map()"
    let name=recordRoles value="new Map()"
    let name=orderTotal value="0"
    let name=expectedOrderTotal value="0"
    for name=valueIndex from=0 to="valueTag.length"
      if cond="valueParent[valueIndex] < 0 || valueParent[valueIndex] > valueTag.length || valueOrder[valueIndex] < 0 || (valueParent[valueIndex] == 0 && (!Map.has(ownedValues, String(valueIndex + 1)) || valueRole[valueIndex] != \"\" || valueOrder[valueIndex] != 0))"
        return value="false"
      if cond="valueParent[valueIndex] != 0 && valueParent[valueIndex] >= valueIndex + 1"
        return value="false"
      let name=tag value="valueTag[valueIndex]"
      if cond="tag != \"null\" && tag != \"bool\" && tag != \"text\" && tag != \"int\" && tag != \"list\" && tag != \"record\""
        return value="false"
      if cond="tag == \"int\" && !validinteger(valueText[valueIndex])"
        return value="false"
      if cond="tag == \"null\" && (valueText[valueIndex] != \"\" || valueBool[valueIndex] != 0)"
        return value="false"
      if cond="tag == \"bool\" && (valueText[valueIndex] != \"\" || (valueBool[valueIndex] != 0 && valueBool[valueIndex] != 1))"
        return value="false"
      if cond="(tag == \"text\" || tag == \"int\") && valueBool[valueIndex] != 0"
        return value="false"
      if cond="(tag == \"list\" || tag == \"record\") && (valueText[valueIndex] != \"\" || valueBool[valueIndex] != 0)"
        return value="false"
      if cond="valueParent[valueIndex] > 0"
        if cond="Map.has(ownedValues, String(valueIndex + 1))"
          return value="false"
        let name=parentKey value="String(valueParent[valueIndex])"
        let name=orderKey value="parentKey + \":\" + String(valueOrder[valueIndex])"
        if cond="Map.has(orders, orderKey)"
          return value="false"
        let name=siblingCount value="0"
        if cond="Map.has(siblingCounts, parentKey)"
          assign target=siblingCount value="Map.get(siblingCounts, parentKey)"
        assign target=orderTotal value="orderTotal + valueOrder[valueIndex]"
        assign target=expectedOrderTotal value="expectedOrderTotal + siblingCount"
        if cond="valueOrder[valueIndex] > 0"
          let name=previousKey value="parentKey + \":\" + String(valueOrder[valueIndex] - 1)"
          if cond="Map.has(roles, previousKey)"
            if cond="List.index(valueTag, valueParent[valueIndex] - 1) == \"record\" && Map.get(roles, previousKey) >= valueRole[valueIndex]"
              return value="false"
        let name=nextKey value="parentKey + \":\" + String(valueOrder[valueIndex] + 1)"
        if cond="Map.has(roles, nextKey) && List.index(valueTag, valueParent[valueIndex] - 1) == \"record\" && valueRole[valueIndex] >= Map.get(roles, nextKey)"
          return value="false"
        do value="Map.set(orders, String(valueParent[valueIndex]) + \":\" + String(valueOrder[valueIndex]), true)"
        do value="Map.set(siblingCounts, String(valueParent[valueIndex]), siblingCount + 1)"
        do value="Map.set(roles, String(valueParent[valueIndex]) + \":\" + String(valueOrder[valueIndex]), valueRole[valueIndex])"
        let name=parentTag value="List.index(valueTag, valueParent[valueIndex] - 1) ?? \"\""
        if cond="parentTag == \"list\""
          if cond="valueRole[valueIndex] != \"list-item\""
            return value="false"
        else
          if cond="parentTag != \"record\" || !Text.startsWith(valueRole[valueIndex], \"record:\") || Text.length(valueRole[valueIndex]) <= 7"
            return value="false"
          let name=recordRoleKey value="parentKey + \":\" + String(Text.length(valueRole[valueIndex])) + \":\" + valueRole[valueIndex]"
          if cond="Map.has(recordRoles, recordRoleKey)"
            return value="false"
          do value="Map.set(recordRoles, String(valueParent[valueIndex]) + \":\" + String(Text.length(valueRole[valueIndex])) + \":\" + String(valueRole[valueIndex]), true)"
    if cond="orderTotal != expectedOrderTotal"
      return value="false"
    return value="true"
