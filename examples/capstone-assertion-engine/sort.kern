fn name=halfFloor returns=number export=true
  param name=n type=number
  handler lang="kern"
    if cond="n <= 1"
      return value="0"
    return value="halfFloor(n - 2) + 1"

fn name=mergeStrings returns=string[]
  param name=left type="string[]"
  param name=i type=number
  param name=right type="string[]"
  param name=j type=number
  param name=acc type="string[]"
  handler lang="kern"
    if cond="i >= left.length"
      if cond="j >= right.length"
        return value="acc"
      let name=drainedRight value="[]"
      for name=k from=0 to="acc.length"
        do value="drainedRight.push(acc[k])"
      do value="drainedRight.push(right[j])"
      return value="mergeStrings(left, i, right, j + 1, drainedRight)"
    if cond="j >= right.length"
      let name=drainedLeft value="[]"
      for name=k from=0 to="acc.length"
        do value="drainedLeft.push(acc[k])"
      do value="drainedLeft.push(left[i])"
      return value="mergeStrings(left, i + 1, right, j, drainedLeft)"
    let name=grown value="[]"
    for name=k from=0 to="acc.length"
      do value="grown.push(acc[k])"
    if cond="left[i] <= right[j]"
      do value="grown.push(left[i])"
      return value="mergeStrings(left, i + 1, right, j, grown)"
    do value="grown.push(right[j])"
    return value="mergeStrings(left, i, right, j + 1, grown)"

fn name=sortStrings returns=string[] export=true
  param name=xs type="string[]"
  handler lang="kern"
    if cond="xs.length <= 1"
      return value="xs"
    let name=mid value="halfFloor(xs.length)"
    let name=left value="[]"
    for name=i from=0 to="mid"
      do value="left.push(xs[i])"
    let name=right value="[]"
    for name=j from="mid" to="xs.length"
      do value="right.push(xs[j])"
    let name=sortedLeft value="sortStrings(left)"
    let name=sortedRight value="sortStrings(right)"
    let name=empty value="[]"
    return value="mergeStrings(sortedLeft, 0, sortedRight, 0, empty)"
