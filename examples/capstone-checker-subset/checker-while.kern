fn name=isDecimalDigit returns=boolean
  param name=ch type=string
  handler lang="kern"
    if cond="ch < \"0\""
      return value="false"
    if cond="ch > \"9\""
      return value="false"
    return value="true"

fn name=isSafeMagnitude returns=boolean
  param name=raw type=string
  param name=start type=number
  handler lang="kern"
    let name=n value="Text.length(raw)"
    let name=digits value="n - start"
    if cond="digits <= 0"
      return value="false"
    if cond="digits > 1"
      if cond="Text.charAt(raw, start) == \"0\""
        return value="false"
    for name=i from="start" to="n"
      if cond="!isDecimalDigit(Text.charAt(raw, i))"
        return value="false"
    if cond="digits < 16"
      return value="true"
    if cond="digits > 16"
      return value="false"
    let name=bound value="\"9007199254740991\""
    for name=j from=0 to=16
      let name=actual value="Text.charAt(raw, start + j)"
      let name=maximum value="Text.charAt(bound, j)"
      if cond="actual < maximum"
        return value="true"
      if cond="actual > maximum"
        return value="false"
    return value="true"

fn name=checkerSafeIntText returns=boolean export=true
  param name=raw type=string
  handler lang="kern"
    let name=n value="Text.length(raw)"
    if cond="n == 0"
      return value="false"
    let name=start value="0"
    if cond="Text.charAt(raw, 0) == \"-\""
      assign target=start value="1"
    if cond="start == 1"
      if cond="n == 2"
        if cond="Text.charAt(raw, 1) == \"0\""
          return value="false"
    return value="isSafeMagnitude(raw, start)"

fn name=previousSiblingKind returns=string
  param name=row type=number
  param name=stmtKind type=string[]
  param name=stmtParent type=number[]
  handler lang="kern"
    let name=previous value="\"\""
    for name=i from=0 to="row"
      if cond="stmtParent[i] == stmtParent[row]"
        assign target=previous value="stmtKind[i]"
    return value="previous"

fn name=hasDirectChild returns=boolean
  param name=row type=number
  param name=stmtParent type=number[]
  handler lang="kern"
    for name=i from=0 to="stmtParent.length"
      if cond="stmtParent[i] == row"
        return value="true"
    return value="false"

fn name=checkerElseRejectDetail returns=string export=true
  param name=row type=number
  param name=stmtKind type="string[]"
  param name=stmtParent type="number[]"
  handler lang="kern"
    let name=previous value="previousSiblingKind(row, stmtKind, stmtParent)"
    if cond="previous == \"\""
      return value="\"orphan_else\""
    if cond="previous == \"else\""
      return value="\"duplicate_else\""
    if cond="previous != \"if\""
      return value="\"invalid_predecessor\""
    if cond="!hasDirectChild(row, stmtParent)"
      return value="\"empty_body\""
    return value="\"\""

fn name=subtreeEnd returns=number
  param name=row type=number
  param name=stmtParent type=number[]
  handler lang="kern"
    # Preorder descendants are contiguous and their parent row is >= row.
    for name=i from=0 to="stmtParent.length"
      if cond="i > row"
        if cond="stmtParent[i] < row"
          return value="i"
    return value="stmtParent.length"

fn name=functionRow returns=number
  param name=fnName type=string
  param name=stmtKind type=string[]
  param name=stmtName type=string[]
  handler lang="kern"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtKind[i] == \"fn\" && stmtName[i] == fnName"
        return value="i"
    return value="-1"

fn name=isPositiveSafeIntText returns=boolean
  param name=raw type=string
  handler lang="kern"
    if cond="raw == \"0\""
      return value="false"
    if cond="Text.charAt(raw, 0) == \"-\""
      return value="false"
    return value="checkerSafeIntText(raw)"

fn name=numericBindingProven params="row:number,fnName:string,binding:string,requiredStep:string,stmtKind:string[],stmtFn:string[],stmtParent:number[],stmtName:string[],stmtTarget:string[],stmtExprKind:string[],stmtExprName:string[],stmtExprNum:string[],stmtExprLeftKind:string[],stmtExprLeftName:string[],stmtExprRightKind:string[],stmtExprRightNum:string[]" returns=boolean
  handler lang="kern"
    let name=declared value="false"
    let name=stepped value="false"
    let name=end value="subtreeEnd(row, stmtParent)"
    let name=fnRow value="functionRow(fnName, stmtKind, stmtName)"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="i < row"
          # Only a direct function-body declaration is definitely available.
          if cond="stmtParent[i] == fnRow && stmtKind[i] == \"let\""
            if cond="stmtName[i] == binding"
              if cond="declared"
                return value="false"
              if cond="stmtExprKind[i] != \"numLit\""
                return value="false"
              if cond="!checkerSafeIntText(stmtExprNum[i])"
                return value="false"
              assign target=declared value="true"
        let name=relevant value="i < row || (i > row && i < end)"
        if cond="i > row && i < end"
          if cond="stmtKind[i] == \"let\" && stmtName[i] == binding"
            return value="false"
        if cond="relevant"
          if cond="stmtKind[i] == \"assign\""
            if cond="stmtTarget[i] == binding"
              if cond="stmtExprKind[i] != \"binary\""
                return value="false"
              if cond="stmtExprName[i] != requiredStep"
                return value="false"
              if cond="stmtExprLeftKind[i] != \"ident\" || stmtExprLeftName[i] != binding"
                return value="false"
              if cond="stmtExprRightKind[i] != \"numLit\""
                return value="false"
              if cond="!isPositiveSafeIntText(stmtExprRightNum[i])"
                return value="false"
              if cond="i > row"
                assign target=stepped value="true"
    return value="declared && stepped"

fn name=isLengthType returns=boolean
  param name=raw type=string
  handler lang="kern"
    if cond="raw == \"string\""
      return value="true"
    let name=n value="Text.length(raw)"
    if cond="n < 2"
      return value="false"
    return value="Text.charAt(raw, n - 2) == \"[\" && Text.charAt(raw, n - 1) == \"]\""

fn name=lengthReceiverProven params="row:number,fnName:string,binding:string,stmtKind:string[],stmtFn:string[],stmtParent:number[],stmtName:string[],stmtTarget:string[],stmtExprKind:string[],paramFn:string[],paramName:string[],paramType:string[]" returns=boolean
  handler lang="kern"
    let name=declared value="false"
    let name=end value="subtreeEnd(row, stmtParent)"
    let name=fnRow value="functionRow(fnName, stmtKind, stmtName)"
    for name=p from=0 to="paramFn.length"
      if cond="paramFn[p] == fnName && paramName[p] == binding"
        if cond="isLengthType(paramType[p])"
          assign target=declared value="true"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="i < row"
          if cond="stmtParent[i] == fnRow && stmtKind[i] == \"let\" && stmtName[i] == binding"
            if cond="declared"
              return value="false"
            if cond="stmtExprKind[i] != \"arrayLit\" && stmtExprKind[i] != \"strLit\""
              return value="false"
            assign target=declared value="true"
        let name=relevant value="i < row || (i > row && i < end)"
        if cond="relevant && stmtKind[i] == \"assign\" && stmtTarget[i] == binding"
          return value="false"
    return value="declared"

fn name=isLiteralKind returns=boolean
  param name=kind type=string
  handler lang="kern"
    return value="kind == \"numLit\" || kind == \"strLit\" || kind == \"boolLit\" || kind == \"nullLit\""

fn name=literalToken returns=string
  param name=kind type=string
  param name=name type=string
  param name=num type=string
  handler lang="kern"
    if cond="kind == \"numLit\""
      return value="num"
    if cond="kind == \"nullLit\""
      return value="\"null\""
    return value="name"

fn name=literalTrue returns=boolean
  param name=operator type=string
  param name=leftKind type=string
  param name=leftName type=string
  param name=leftNum type=string
  param name=rightKind type=string
  param name=rightName type=string
  param name=rightNum type=string
  handler lang="kern"
    if cond="!isLiteralKind(leftKind) || leftKind != rightKind"
      return value="false"
    if cond="leftKind == \"numLit\""
      if cond="!checkerSafeIntText(leftNum)"
        return value="false"
      if cond="!checkerSafeIntText(rightNum)"
        return value="false"
    let name=left value="literalToken(leftKind, leftName, leftNum)"
    let name=right value="literalToken(rightKind, rightName, rightNum)"
    if cond="operator == \"==\" || operator == \"===\""
      return value="left == right"
    if cond="operator == \"!=\" || operator == \"!==\""
      return value="left != right"
    return value="false"

fn name=comparisonOperandsOk params="row:number,fnName:string,operator:string,stmtKind:string[],stmtFn:string[],stmtParent:number[],stmtName:string[],stmtTarget:string[],stmtExprKind:string[],stmtExprName:string[],stmtExprNum:string[],stmtExprLeftKind:string[],stmtExprLeftName:string[],stmtExprLeftNum:string[],stmtExprLeftMemberObject:string[],stmtExprLeftMemberProp:string[],stmtExprRightKind:string[],stmtExprRightName:string[],stmtExprRightNum:string[],stmtExprRightMemberObject:string[],stmtExprRightMemberProp:string[],paramFn:string[],paramName:string[],paramType:string[]" returns=boolean
  handler lang="kern"
    let name=operatorIsOrdered value="operator == \"<\" || operator == \"<=\" || operator == \">\" || operator == \">=\""
    if cond="!operatorIsOrdered"
      return value="false"
    let name=leftStep value="\"-\""
    let name=rightStep value="\"+\""
    if cond="operator == \"<\" || operator == \"<=\""
      assign target=leftStep value="\"+\""
      assign target=rightStep value="\"-\""
    let name=leftBinding value="false"
    let name=leftLiteral value="false"
    if cond="stmtExprLeftKind[row] == \"numLit\""
      assign target=leftLiteral value="checkerSafeIntText(stmtExprLeftNum[row])"
    if cond="stmtExprLeftKind[row] == \"ident\""
      assign target=leftBinding value="numericBindingProven(row, fnName, stmtExprLeftName[row], leftStep, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprRightKind, stmtExprRightNum)"
    let name=rightBinding value="false"
    let name=rightLiteral value="false"
    if cond="stmtExprRightKind[row] == \"numLit\""
      assign target=rightLiteral value="checkerSafeIntText(stmtExprRightNum[row])"
    if cond="stmtExprRightKind[row] == \"ident\""
      assign target=rightBinding value="numericBindingProven(row, fnName, stmtExprRightName[row], rightStep, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprRightKind, stmtExprRightNum)"
    let name=leftLength value="false"
    if cond="stmtExprLeftKind[row] == \"member\" && stmtExprLeftMemberProp[row] == \"length\""
      assign target=leftLength value="lengthReceiverProven(row, fnName, stmtExprLeftMemberObject[row], stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, paramFn, paramName, paramType)"
    let name=rightLength value="false"
    if cond="stmtExprRightKind[row] == \"member\" && stmtExprRightMemberProp[row] == \"length\""
      assign target=rightLength value="lengthReceiverProven(row, fnName, stmtExprRightMemberObject[row], stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, paramFn, paramName, paramType)"
    return value="(leftBinding && (rightBinding || rightLiteral || rightLength)) || (rightBinding && (leftLiteral || leftLength))"

fn name=checkWhileCore params="row:number,stmtKind:string[],stmtFn:string[],stmtParent:number[],stmtName:string[],stmtTarget:string[],stmtExprKind:string[],stmtExprName:string[],stmtExprNum:string[],stmtExprLeftKind:string[],stmtExprLeftName:string[],stmtExprLeftNum:string[],stmtExprLeftMemberObject:string[],stmtExprLeftMemberProp:string[],stmtExprRightKind:string[],stmtExprRightName:string[],stmtExprRightNum:string[],stmtExprRightMemberObject:string[],stmtExprRightMemberProp:string[],paramFn:string[],paramName:string[],paramType:string[]" returns=string
  handler lang="kern"
    if cond="!hasDirectChild(row, stmtParent)"
      return value="\"empty_body\""
    if cond="stmtExprKind[row] == \"boolLit\""
      if cond="stmtExprName[row] == \"true\""
        return value="\"literal_true\""
      return value="\"\""
    if cond="stmtExprKind[row] == \"binary\""
      if cond="literalTrue(stmtExprName[row], stmtExprLeftKind[row], stmtExprLeftName[row], stmtExprLeftNum[row], stmtExprRightKind[row], stmtExprRightName[row], stmtExprRightNum[row])"
        return value="\"literal_true\""
      if cond="isLiteralKind(stmtExprLeftKind[row]) && isLiteralKind(stmtExprRightKind[row])"
        return value="\"non_boolean_condition\""
      if cond="comparisonOperandsOk(row, stmtFn[row], stmtExprName[row], stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprLeftNum, stmtExprLeftMemberObject, stmtExprLeftMemberProp, stmtExprRightKind, stmtExprRightName, stmtExprRightNum, stmtExprRightMemberObject, stmtExprRightMemberProp, paramFn, paramName, paramType)"
        return value="\"\""
    return value="\"non_boolean_condition\""

fn name=checkerWhileRejectDetail returns=string export=true
  param name=row type=number
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  handler lang="kern"
    return value="checkWhileCore(row, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprLeftNum, stmtExprLeftMemberObject, stmtExprLeftMemberProp, stmtExprRightKind, stmtExprRightName, stmtExprRightNum, stmtExprRightMemberObject, stmtExprRightMemberProp, paramFn, paramName, paramType)"
