fn name=isDecimalDigit returns=boolean
  param name=ch type=string
  handler lang="kern"
    if cond="ch < \"0\""
      return value="false"
    if cond="ch > \"9\""
      return value="false"
    return value="true"

fn name=isSafeMagnitude returns=boolean
  param name=raw type=string
  param name=start type=number
  handler lang="kern"
    let name=n value="Text.length(raw)"
    let name=digits value="n - start"
    if cond="digits <= 0"
      return value="false"
    if cond="digits > 1"
      if cond="Text.charAt(raw, start) == \"0\""
        return value="false"
    for name=i from="start" to="n"
      if cond="!isDecimalDigit(Text.charAt(raw, i))"
        return value="false"
    if cond="digits < 16"
      return value="true"
    if cond="digits > 16"
      return value="false"
    let name=bound value="\"9007199254740991\""
    for name=j from=0 to=16
      let name=actual value="Text.charAt(raw, start + j)"
      let name=maximum value="Text.charAt(bound, j)"
      if cond="actual < maximum"
        return value="true"
      if cond="actual > maximum"
        return value="false"
    return value="true"

fn name=checkerSafeIntText returns=boolean export=true
  param name=raw type=string
  handler lang="kern"
    let name=n value="Text.length(raw)"
    if cond="n == 0"
      return value="false"
    let name=start value="0"
    if cond="Text.charAt(raw, 0) == \"-\""
      assign target=start value="1"
    if cond="start == 1"
      if cond="n == 2"
        if cond="Text.charAt(raw, 1) == \"0\""
          return value="false"
    return value="isSafeMagnitude(raw, start)"

fn name=previousSiblingKind returns=string
  param name=row type=number
  param name=stmtKind type=string[]
  param name=stmtParent type=number[]
  handler lang="kern"
    let name=previous value="\"\""
    for name=i from=0 to="row"
      if cond="stmtParent[i] == stmtParent[row]"
        assign target=previous value="stmtKind[i]"
    return value="previous"

fn name=hasDirectChild returns=boolean
  param name=row type=number
  param name=stmtParent type=number[]
  handler lang="kern"
    for name=i from=0 to="stmtParent.length"
      if cond="stmtParent[i] == row"
        return value="true"
    return value="false"

fn name=checkerElseRejectDetail returns=string export=true
  param name=row type=number
  param name=stmtKind type="string[]"
  param name=stmtParent type="number[]"
  handler lang="kern"
    let name=previous value="previousSiblingKind(row, stmtKind, stmtParent)"
    if cond="previous == \"\""
      return value="\"orphan_else\""
    if cond="previous == \"else\""
      return value="\"duplicate_else\""
    if cond="previous != \"if\""
      return value="\"invalid_predecessor\""
    if cond="!hasDirectChild(row, stmtParent)"
      return value="\"empty_body\""
    return value="\"\""

fn name=subtreeEnd returns=number
  param name=row type=number
  param name=stmtParent type=number[]
  handler lang="kern"
    # Preorder descendants are contiguous and their parent row is >= row.
    for name=i from=0 to="stmtParent.length"
      if cond="i > row"
        if cond="stmtParent[i] < row"
          return value="i"
    return value="stmtParent.length"

fn name=functionRow returns=number
  param name=fnName type=string
  param name=stmtKind type=string[]
  param name=stmtName type=string[]
  handler lang="kern"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtKind[i] == \"fn\" && stmtName[i] == fnName"
        return value="i"
    return value="-1"

fn name=isPositiveSafeIntText returns=boolean
  param name=raw type=string
  handler lang="kern"
    if cond="raw == \"0\""
      return value="false"
    if cond="Text.charAt(raw, 0) == \"-\""
      return value="false"
    return value="checkerSafeIntText(raw)"

fn name=numericBindingProven returns=boolean
  param name=row type=number
  param name=fnName type=string
  param name=binding type=string
  param name=requiredStep type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightNum type=string[]
  handler lang="kern"
    let name=declared value="false"
    let name=stepped value="false"
    let name=end value="subtreeEnd(row, stmtParent)"
    let name=fnRow value="functionRow(fnName, stmtKind, stmtName)"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="i < row"
          # Only a direct function-body declaration is definitely available.
          if cond="stmtParent[i] == fnRow && stmtKind[i] == \"let\""
            if cond="stmtName[i] == binding"
              if cond="declared"
                return value="false"
              if cond="stmtExprKind[i] != \"numLit\""
                return value="false"
              if cond="!checkerSafeIntText(stmtExprNum[i])"
                return value="false"
              assign target=declared value="true"
        let name=relevant value="i < row || (i > row && i < end)"
        if cond="i > row && i < end"
          if cond="stmtKind[i] == \"let\" && stmtName[i] == binding"
            return value="false"
        if cond="relevant"
          if cond="stmtKind[i] == \"assign\""
            if cond="stmtTarget[i] == binding"
              if cond="stmtExprKind[i] != \"binary\""
                return value="false"
              if cond="stmtExprName[i] != requiredStep"
                return value="false"
              if cond="stmtExprLeftKind[i] != \"ident\" || stmtExprLeftName[i] != binding"
                return value="false"
              if cond="stmtExprRightKind[i] != \"numLit\""
                return value="false"
              if cond="!isPositiveSafeIntText(stmtExprRightNum[i])"
                return value="false"
              if cond="i > row"
                assign target=stepped value="true"
    return value="declared && stepped"

fn name=isLengthType returns=boolean
  param name=raw type=string
  handler lang="kern"
    if cond="raw == \"string\""
      return value="true"
    let name=n value="Text.length(raw)"
    if cond="n < 2"
      return value="false"
    return value="Text.charAt(raw, n - 2) == \"[\" && Text.charAt(raw, n - 1) == \"]\""

fn name=lengthReceiverProven returns=boolean
  param name=row type=number
  param name=fnName type=string
  param name=binding type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  handler lang="kern"
    let name=declared value="false"
    let name=end value="subtreeEnd(row, stmtParent)"
    let name=fnRow value="functionRow(fnName, stmtKind, stmtName)"
    for name=p from=0 to="paramFn.length"
      if cond="paramFn[p] == fnName && paramName[p] == binding"
        if cond="isLengthType(paramType[p])"
          assign target=declared value="true"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="i < row"
          if cond="stmtParent[i] == fnRow && stmtKind[i] == \"let\" && stmtName[i] == binding"
            if cond="declared"
              return value="false"
            if cond="stmtExprKind[i] != \"arrayLit\" && stmtExprKind[i] != \"strLit\""
              return value="false"
            assign target=declared value="true"
        let name=relevant value="i < row || (i > row && i < end)"
        if cond="relevant && stmtKind[i] == \"assign\" && stmtTarget[i] == binding"
          return value="false"
    return value="declared"

fn name=isLiteralKind returns=boolean
  param name=kind type=string
  handler lang="kern"
    return value="kind == \"numLit\" || kind == \"strLit\" || kind == \"boolLit\" || kind == \"nullLit\""

fn name=literalToken returns=string
  param name=kind type=string
  param name=name type=string
  param name=num type=string
  handler lang="kern"
    if cond="kind == \"numLit\""
      return value="num"
    if cond="kind == \"nullLit\""
      return value="\"null\""
    return value="name"

fn name=literalTrue returns=boolean
  param name=operator type=string
  param name=leftKind type=string
  param name=leftName type=string
  param name=leftNum type=string
  param name=rightKind type=string
  param name=rightName type=string
  param name=rightNum type=string
  handler lang="kern"
    if cond="!isLiteralKind(leftKind) || leftKind != rightKind"
      return value="false"
    if cond="leftKind == \"numLit\""
      if cond="!checkerSafeIntText(leftNum)"
        return value="false"
      if cond="!checkerSafeIntText(rightNum)"
        return value="false"
    let name=left value="literalToken(leftKind, leftName, leftNum)"
    let name=right value="literalToken(rightKind, rightName, rightNum)"
    if cond="operator == \"==\" || operator == \"===\""
      return value="left == right"
    if cond="operator == \"!=\" || operator == \"!==\""
      return value="left != right"
    return value="false"

fn name=comparisonOperandsOk returns=boolean
  param name=row type=number
  param name=fnName type=string
  param name=operator type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  handler lang="kern"
    let name=operatorIsOrdered value="operator == \"<\" || operator == \"<=\" || operator == \">\" || operator == \">=\""
    if cond="!operatorIsOrdered"
      return value="false"
    let name=leftStep value="\"-\""
    let name=rightStep value="\"+\""
    if cond="operator == \"<\" || operator == \"<=\""
      assign target=leftStep value="\"+\""
      assign target=rightStep value="\"-\""
    let name=leftBinding value="false"
    let name=leftLiteral value="false"
    if cond="stmtExprLeftKind[row] == \"numLit\""
      assign target=leftLiteral value="checkerSafeIntText(stmtExprLeftNum[row])"
    if cond="stmtExprLeftKind[row] == \"ident\""
      assign target=leftBinding value="numericBindingProven(row, fnName, stmtExprLeftName[row], leftStep, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprRightKind, stmtExprRightNum)"
    let name=rightBinding value="false"
    let name=rightLiteral value="false"
    if cond="stmtExprRightKind[row] == \"numLit\""
      assign target=rightLiteral value="checkerSafeIntText(stmtExprRightNum[row])"
    if cond="stmtExprRightKind[row] == \"ident\""
      assign target=rightBinding value="numericBindingProven(row, fnName, stmtExprRightName[row], rightStep, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprRightKind, stmtExprRightNum)"
    let name=leftLength value="false"
    if cond="stmtExprLeftKind[row] == \"member\" && stmtExprLeftMemberProp[row] == \"length\""
      assign target=leftLength value="lengthReceiverProven(row, fnName, stmtExprLeftMemberObject[row], stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, paramFn, paramName, paramType)"
    let name=rightLength value="false"
    if cond="stmtExprRightKind[row] == \"member\" && stmtExprRightMemberProp[row] == \"length\""
      assign target=rightLength value="lengthReceiverProven(row, fnName, stmtExprRightMemberObject[row], stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, paramFn, paramName, paramType)"
    return value="(leftBinding && (rightBinding || rightLiteral || rightLength)) || (rightBinding && (leftLiteral || leftLength))"

fn name=checkWhileCore returns=string
  param name=row type=number
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  handler lang="kern"
    if cond="!hasDirectChild(row, stmtParent)"
      return value="\"empty_body\""
    if cond="stmtExprKind[row] == \"boolLit\""
      if cond="stmtExprName[row] == \"true\""
        return value="\"literal_true\""
      return value="\"\""
    if cond="stmtExprKind[row] == \"binary\""
      if cond="literalTrue(stmtExprName[row], stmtExprLeftKind[row], stmtExprLeftName[row], stmtExprLeftNum[row], stmtExprRightKind[row], stmtExprRightName[row], stmtExprRightNum[row])"
        return value="\"literal_true\""
      if cond="isLiteralKind(stmtExprLeftKind[row]) && isLiteralKind(stmtExprRightKind[row])"
        return value="\"non_boolean_condition\""
      if cond="comparisonOperandsOk(row, stmtFn[row], stmtExprName[row], stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprLeftNum, stmtExprLeftMemberObject, stmtExprLeftMemberProp, stmtExprRightKind, stmtExprRightName, stmtExprRightNum, stmtExprRightMemberObject, stmtExprRightMemberProp, paramFn, paramName, paramType)"
        return value="\"\""
    return value="\"non_boolean_condition\""

fn name=checkerWhileRejectDetail returns=string export=true
  param name=row type=number
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  handler lang="kern"
    return value="checkWhileCore(row, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprLeftNum, stmtExprLeftMemberObject, stmtExprLeftMemberProp, stmtExprRightKind, stmtExprRightName, stmtExprRightNum, stmtExprRightMemberObject, stmtExprRightMemberProp, paramFn, paramName, paramType)"

fn name=acceptLine returns=string export=true
  param name=path type=string
  handler lang="kern"
    return value="path + \":1:1|T10_MODULE|accept|ok\""

fn name=rejectLine returns=string export=true
  param name=path type=string
  param name=line type=number
  param name=col type=number
  param name=code type=string
  param name=detail type=string
  handler lang="kern"
    return value="path + \":\" + String(line) + \":\" + String(col) + \"|\" + code + \"|reject|\" + detail"

fn name=isSurfaceKind returns=boolean
  param name=kind type=string
  handler lang="kern"
    if cond="kind == \"use\""
      return value="true"
    if cond="kind == \"from\""
      return value="true"
    if cond="kind == \"fn\""
      return value="true"
    if cond="kind == \"let\""
      return value="true"
    if cond="kind == \"assign\""
      return value="true"
    if cond="kind == \"do\""
      return value="true"
    if cond="kind == \"for\""
      return value="true"
    if cond="kind == \"if\""
      return value="true"
    if cond="kind == \"else\""
      return value="true"
    if cond="kind == \"while\""
      return value="true"
    if cond="kind == \"return\""
      return value="true"
    if cond="kind == \"print\""
      return value="true"
    if cond="kind == \"fmt\""
      return value="true"
    return value="false"

fn name=isSafeIntText returns=boolean export=true
  param name=raw type=string
  handler lang="kern"
    return value="checkerSafeIntText(raw)"

fn name=elseRejectDetail returns=string
  param name=row type=number
  param name=stmtKind type="string[]"
  param name=stmtParent type="number[]"
  handler lang="kern"
    return value="checkerElseRejectDetail(row, stmtKind, stmtParent)"

fn name=whileRejectDetail returns=string
  param name=row type=number
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  handler lang="kern"
    return value="checkerWhileRejectDetail(row, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprLeftNum, stmtExprLeftMemberObject, stmtExprLeftMemberProp, stmtExprRightKind, stmtExprRightName, stmtExprRightNum, stmtExprRightMemberObject, stmtExprRightMemberProp, paramFn, paramName, paramType)"

fn name=isPrintNumberText returns=boolean
  param name=raw type=string
  handler lang="kern"
    return value="isSafeIntText(raw)"

fn name=isArrayBinding returns=boolean
  param name=fnName type=string
  param name=binding type=string
  param name=stmtKind type="string[]"
  param name=stmtFn type="string[]"
  param name=stmtName type="string[]"
  param name=stmtExprKind type="string[]"
  handler lang="kern"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="stmtKind[i] == \"let\""
          if cond="stmtName[i] == binding"
            if cond="stmtExprKind[i] == \"arrayLit\""
              return value="true"
    return value="false"

fn name=isUserCallable returns=boolean
  param name=name type=string
  param name=stmtKind type="string[]"
  param name=stmtName type="string[]"
  param name=stmtTarget type="string[]"
  handler lang="kern"
    if cond="name == \"\""
      return value="false"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtKind[i] == \"fn\""
        if cond="stmtName[i] == name"
          return value="true"
      if cond="stmtKind[i] == \"from\""
        # An aliased import binds only its local target, never both names.
        if cond="stmtTarget[i] == name"
          return value="true"
        if cond="stmtTarget[i] == \"\""
          if cond="stmtName[i] == name"
            return value="true"
    return value="false"

fn name=isForCounter returns=boolean
  param name=fnName type=string
  param name=binding type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtName type=string[]
  handler lang="kern"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="stmtKind[i] == \"for\""
          if cond="stmtName[i] == binding"
            return value="true"
    return value="false"

fn name=isAssigned returns=boolean
  param name=fnName type=string
  param name=binding type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtTarget type=string[]
  handler lang="kern"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="stmtKind[i] == \"assign\""
          if cond="stmtTarget[i] == binding"
            return value="true"
    return value="false"

fn name=isIndexRebound returns=boolean
  param name=fnName type=string
  param name=binding type=string
  param name=stmtKind type="string[]"
  param name=stmtFn type="string[]"
  param name=stmtName type="string[]"
  param name=stmtTarget type="string[]"
  handler lang="kern"
    for name=i from=0 to="stmtKind.length"
      if cond="stmtFn[i] == fnName"
        if cond="stmtKind[i] == \"assign\""
          if cond="stmtTarget[i] == binding"
            return value="true"
        if cond="stmtKind[i] == \"let\""
          if cond="stmtName[i] == binding"
            return value="true"
    return value="false"

fn name=paramOrdinalOf returns=number
  param name=fnName type=string
  param name=binding type=string
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramOrdinal type=number[]
  handler lang="kern"
    for name=i from=0 to="paramFn.length"
      if cond="paramFn[i] == fnName"
        if cond="paramName[i] == binding"
          return value="paramOrdinal[i]"
    return value="-1"

fn name=termProvenanced returns=boolean
  param name=fnName type=string
  param name=kind type=string
  param name=name type=string
  param name=num type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramOrdinal type=number[]
  handler lang="kern"
    if cond="kind == \"numLit\""
      return value="isSafeIntText(num)"
    if cond="kind != \"ident\""
      return value="false"
    if cond="isForCounter(fnName, name, stmtKind, stmtFn, stmtName)"
      if cond="!isIndexRebound(fnName, name, stmtKind, stmtFn, stmtName, stmtTarget)"
        return value="true"
    if cond="paramOrdinalOf(fnName, name, paramFn, paramName, paramOrdinal) >= 0"
      if cond="!isIndexRebound(fnName, name, stmtKind, stmtFn, stmtName, stmtTarget)"
        return value="true"
    return value="false"

fn name=argIndexOf returns=number
  param name=callId type=number
  param name=ordinal type=number
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  handler lang="kern"
    for name=i from=0 to="argCall.length"
      if cond="argCall[i] == callId"
        if cond="argOrdinal[i] == ordinal"
          return value="i"
    return value="-1"

fn name=argProvenanced returns=boolean
  param name=fnName type=string
  param name=argId type=number
  param name=argKind type="string[]"
  param name=argName type="string[]"
  param name=argNum type="string[]"
  param name=argOp type="string[]"
  param name=argLeftKind type="string[]"
  param name=argLeftName type="string[]"
  param name=argLeftNum type="string[]"
  param name=argRightKind type="string[]"
  param name=argRightName type="string[]"
  param name=argRightNum type="string[]"
  param name=stmtKind type="string[]"
  param name=stmtFn type="string[]"
  param name=stmtName type="string[]"
  param name=stmtTarget type="string[]"
  param name=paramFn type="string[]"
  param name=paramName type="string[]"
  param name=paramOrdinal type="number[]"
  handler lang="kern"
    if cond="argKind[argId] == \"numLit\""
      return value="isSafeIntText(argNum[argId])"
    if cond="argKind[argId] == \"ident\""
      return value="termProvenanced(fnName, \"ident\", argName[argId], \"\", stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
    if cond="argKind[argId] == \"binary\""
      if cond="argOp[argId] == \"+\""
        if cond="termProvenanced(fnName, argLeftKind[argId], argLeftName[argId], argLeftNum[argId], stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
          if cond="termProvenanced(fnName, argRightKind[argId], argRightName[argId], argRightNum[argId], stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
            return value="true"
      if cond="argOp[argId] == \"-\""
        if cond="termProvenanced(fnName, argLeftKind[argId], argLeftName[argId], argLeftNum[argId], stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
          if cond="termProvenanced(fnName, argRightKind[argId], argRightName[argId], argRightNum[argId], stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
            return value="true"
    return value="false"

fn name=paramCallsitesOk returns=boolean
  param name=callee type=string
  param name=ordinal type=number
  param name=callName type=string[]
  param name=callFn type=string[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=argNum type=string[]
  param name=argOp type=string[]
  param name=argLeftKind type=string[]
  param name=argLeftName type=string[]
  param name=argLeftNum type=string[]
  param name=argRightKind type=string[]
  param name=argRightName type=string[]
  param name=argRightNum type=string[]
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramOrdinal type=number[]
  handler lang="kern"
    let name=found value="false"
    for name=i from=0 to="callName.length"
      if cond="callName[i] == callee"
        assign target=found value="true"
        let name=matched value="false"
        for name=a from=0 to="argCall.length"
          if cond="argCall[a] == i"
            if cond="argOrdinal[a] == ordinal"
              assign target=matched value="true"
              if cond="!argProvenanced(callFn[i], a, argKind, argName, argNum, argOp, argLeftKind, argLeftName, argLeftNum, argRightKind, argRightName, argRightNum, stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
                return value="false"
        if cond="!matched"
          return value="false"
    return value="found"

fn name=indexRejectDetail returns=string
  param name=fnName type=string
  param name=indexKind type=string
  param name=indexName type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=callName type=string[]
  param name=callFn type=string[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=argNum type=string[]
  param name=argOp type=string[]
  param name=argLeftKind type=string[]
  param name=argLeftName type=string[]
  param name=argLeftNum type=string[]
  param name=argRightKind type=string[]
  param name=argRightName type=string[]
  param name=argRightNum type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramOrdinal type=number[]
  handler lang="kern"
    if cond="indexKind == \"numLit\""
      if cond="isSafeIntText(indexName)"
        return value="\"\""
      return value="\"unsafe_literal\""
    if cond="indexKind != \"ident\""
      return value="\"unsupported_index_expr\""
    if cond="isForCounter(fnName, indexName, stmtKind, stmtFn, stmtName)"
      if cond="!isIndexRebound(fnName, indexName, stmtKind, stmtFn, stmtName, stmtTarget)"
        return value="\"\""
    let name=ord value="paramOrdinalOf(fnName, indexName, paramFn, paramName, paramOrdinal)"
    if cond="ord >= 0"
      if cond="!isIndexRebound(fnName, indexName, stmtKind, stmtFn, stmtName, stmtTarget)"
        if cond="paramCallsitesOk(fnName, ord, callName, callFn, argCall, argOrdinal, argKind, argName, argNum, argOp, argLeftKind, argLeftName, argLeftNum, argRightKind, argRightName, argRightNum, stmtKind, stmtFn, stmtName, stmtTarget, paramFn, paramName, paramOrdinal)"
          return value="\"\""
    return value="\"missing_provenance\""

fn name=mapArgToken returns=string
  param name=callId type=number
  param name=ordinal type=number
  param name=argCall type="number[]"
  param name=argOrdinal type="number[]"
  param name=argKind type="string[]"
  param name=argName type="string[]"
  handler lang="kern"
    for name=i from=0 to="argCall.length"
      if cond="argCall[i] == callId"
        if cond="argOrdinal[i] == ordinal"
          if cond="argKind[i] == \"ident\""
            return value="argName[i]"
          return value="\"\""
    return value="\"\""

fn name=mapKeyToken returns=string
  param name=callId type=number
  param name=callFn type=string[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtTarget type=string[]
  handler lang="kern"
    for name=i from=0 to="argCall.length"
      if cond="argCall[i] == callId"
        if cond="argOrdinal[i] == 1"
          if cond="argKind[i] == \"strLit\""
            return value="\"lit:\" + argName[i]"
          if cond="argKind[i] == \"ident\""
            if cond="!isAssigned(callFn[callId], argName[i], stmtKind, stmtFn, stmtTarget)"
              return value="\"var:\" + argName[i]"
          return value="\"\""
    return value="\"\""

fn name=mapKnownBefore returns=boolean
  param name=callId type=number
  param name=callStmt type=number[]
  param name=callFn type=string[]
  param name=callMemberObject type=string[]
  param name=callMemberProp type=string[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtTarget type=string[]
  handler lang="kern"
    let name=mapName value="mapArgToken(callId, 0, argCall, argOrdinal, argKind, argName)"
    let name=keyToken value="mapKeyToken(callId, callFn, argCall, argOrdinal, argKind, argName, stmtKind, stmtFn, stmtTarget)"
    if cond="mapName == \"\""
      return value="false"
    if cond="keyToken == \"\""
      return value="false"
    for name=i from=0 to="callMemberProp.length"
      if cond="i == callId"
        return value="false"
      if cond="callFn[i] == callFn[callId]"
        if cond="callStmt[i] < callStmt[callId]"
          if cond="callMemberObject[i] == \"Map\""
            if cond="callMemberProp[i] == \"set\""
              if cond="mapArgToken(i, 0, argCall, argOrdinal, argKind, argName) == mapName"
                if cond="mapKeyToken(i, callFn, argCall, argOrdinal, argKind, argName, stmtKind, stmtFn, stmtTarget) == keyToken"
                  return value="true"
    return value="false"

fn name=mapCallRejectDetail returns=string
  param name=callId type=number
  param name=callStmtKind type=string[]
  param name=callMemberProp type=string[]
  param name=callStmt type=number[]
  param name=callFn type=string[]
  param name=callMemberObject type=string[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtTarget type=string[]
  handler lang="kern"
    if cond="callMemberProp[callId] == \"set\""
      if cond="callStmtKind[callId] != \"do\""
        return value="\"set_outside_do\""
    if cond="callMemberProp[callId] != \"set\""
      if cond="callMemberProp[callId] != \"get\""
        if cond="callMemberProp[callId] != \"has\""
          return value="\"unsupported_method\""
    if cond="mapKeyToken(callId, callFn, argCall, argOrdinal, argKind, argName, stmtKind, stmtFn, stmtTarget) == \"\""
      return value="\"computed_key\""
    if cond="callMemberProp[callId] == \"get\""
      if cond="!mapKnownBefore(callId, callStmt, callFn, callMemberObject, callMemberProp, argCall, argOrdinal, argKind, argName, stmtKind, stmtFn, stmtTarget)"
        return value="\"missing_key_proof\""
    return value="\"\""

fn name=callRejectCode returns=string
  param name=callId type=number
  param name=callName type=string[]
  param name=callStmtKind type=string[]
  param name=callMemberObject type=string[]
  param name=callMemberProp type=string[]
  param name=stmtKind type=string[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=callStmt type=number[]
  param name=callFn type=string[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=stmtFn type=string[]
  handler lang="kern"
    if cond="callName[callId] == \"<parse-error>\""
      return value="\"T10_SURFACE|parse_error\""
    if cond="callMemberProp[callId] == \"delete\""
      return value="\"T10_MAP|unsupported_method\""
    if cond="callMemberProp[callId] == \"clear\""
      return value="\"T10_MAP|unsupported_method\""
    if cond="callMemberProp[callId] == \"push\""
      if cond="callStmtKind[callId] != \"do\""
        return value="\"T10_EFFECT|push_outside_do\""
      return value="\"\""
    if cond="callMemberObject[callId] == \"Text\""
      if cond="callMemberProp[callId] == \"length\""
        return value="\"\""
      if cond="callMemberProp[callId] == \"charAt\""
        return value="\"\""
      if cond="callMemberProp[callId] == \"startsWith\""
        return value="\"\""
      return value="\"T10_SURFACE|unsupported_text_call\""
    if cond="callMemberObject[callId] == \"Map\""
      let name=detail value="mapCallRejectDetail(callId, callStmtKind, callMemberProp, callStmt, callFn, callMemberObject, argCall, argOrdinal, argKind, argName, stmtKind, stmtFn, stmtTarget)"
      if cond="detail == \"\""
        return value="\"\""
      return value="\"T10_MAP|\" + detail"
    if cond="callName[callId] == \"String\""
      return value="\"\""
    if cond="callName[callId] == \"Map\""
      return value="\"\""
    if cond="isUserCallable(callName[callId], stmtKind, stmtName, stmtTarget)"
      return value="\"\""
    return value="\"T10_SURFACE|unsupported_call\""

fn name=checkModule returns=string[] export=true
  param name=path type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtLine type=number[]
  param name=stmtCol type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtValue type=string[]
  param name=stmtTemplate type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprCall type=string[]
  param name=stmtExprMemberObject type=string[]
  param name=stmtExprMemberProp type=string[]
  param name=stmtExprArgCount type=number[]
  param name=idxStmt type=number[]
  param name=idxFn type=string[]
  param name=idxLine type=number[]
  param name=idxCol type=number[]
  param name=idxIndexKind type=string[]
  param name=idxIndexName type=string[]
  param name=callStmt type=number[]
  param name=callFn type=string[]
  param name=callStmtKind type=string[]
  param name=callLine type=number[]
  param name=callCol type=number[]
  param name=callName type=string[]
  param name=callMemberObject type=string[]
  param name=callMemberProp type=string[]
  param name=callArgCount type=number[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=argNum type=string[]
  param name=argOp type=string[]
  param name=argLeftKind type=string[]
  param name=argLeftName type=string[]
  param name=argLeftNum type=string[]
  param name=argRightKind type=string[]
  param name=argRightName type=string[]
  param name=argRightNum type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  param name=paramOrdinal type=number[]
  handler lang="kern"
    let name=out value="[]"
    for name=i from=0 to="stmtKind.length"
      if cond="!isSurfaceKind(stmtKind[i])"
        do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_SURFACE\", \"unsupported_\" + stmtKind[i]))"
      if cond="stmtLine[i] <= 0"
        do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_ROW\", \"missing_loc\"))"
      if cond="stmtLine[i] > 0"
        if cond="stmtCol[i] <= 0"
          do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_ROW\", \"missing_loc\"))"
      if cond="stmtKind[i] == \"print\""
        if cond="stmtFn[i] != \"\""
          if cond="stmtFn[i] != \"main\""
            do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_HELPER\", \"helper_stdout\"))"
        if cond="stmtExprKind[i] == \"arrayLit\""
          do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_PRINT\", \"array_literal\"))"
        if cond="stmtExprKind[i] == \"ident\""
          if cond="isArrayBinding(stmtFn[i], stmtExprName[i], stmtKind, stmtFn, stmtName, stmtExprKind)"
            do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_PRINT\", \"array_binding\"))"
        if cond="stmtExprKind[i] == \"numLit\""
          if cond="!isPrintNumberText(stmtExprNum[i])"
            do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_PRINT\", \"production_reject\"))"
      if cond="stmtKind[i] == \"fmt\""
        if cond="stmtName[i] == \"\""
          do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_FMT\", \"production_reject\"))"
      if cond="stmtKind[i] == \"do\""
        if cond="stmtExprMemberProp[i] != \"push\""
          if cond="stmtExprCall[i] != \"Map.set\""
            do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_EFFECT\", \"unsupported_do\"))"
      if cond="stmtKind[i] == \"else\""
        let name=elseDetail value="elseRejectDetail(i, stmtKind, stmtParent)"
        if cond="elseDetail != \"\""
          do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_ELSE\", elseDetail))"
      if cond="stmtKind[i] == \"while\""
        let name=whileDetail value="whileRejectDetail(i, stmtKind, stmtFn, stmtParent, stmtName, stmtTarget, stmtExprKind, stmtExprName, stmtExprNum, stmtExprLeftKind, stmtExprLeftName, stmtExprLeftNum, stmtExprLeftMemberObject, stmtExprLeftMemberProp, stmtExprRightKind, stmtExprRightName, stmtExprRightNum, stmtExprRightMemberObject, stmtExprRightMemberProp, paramFn, paramName, paramType)"
        if cond="whileDetail != \"\""
          do value="out.push(rejectLine(path, stmtLine[i], stmtCol[i], \"T10_WHILE\", whileDetail))"
    for name=c from=0 to="callName.length"
      let name=callVerdict value="callRejectCode(c, callName, callStmtKind, callMemberObject, callMemberProp, stmtKind, stmtName, stmtTarget, callStmt, callFn, argCall, argOrdinal, argKind, argName, stmtFn)"
      if cond="callVerdict != \"\""
        if cond="callVerdict == \"T10_MAP|unsupported_method\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_MAP\", \"unsupported_method\"))"
        if cond="callVerdict == \"T10_SURFACE|parse_error\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_SURFACE\", \"parse_error\"))"
        if cond="callVerdict == \"T10_SURFACE|unsupported_text_call\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_SURFACE\", \"unsupported_text_call\"))"
        if cond="callVerdict == \"T10_SURFACE|unsupported_call\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_SURFACE\", \"unsupported_call\"))"
        if cond="callVerdict == \"T10_EFFECT|push_outside_do\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_EFFECT\", \"push_outside_do\"))"
        if cond="callVerdict == \"T10_MAP|computed_key\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_MAP\", \"computed_key\"))"
        if cond="callVerdict == \"T10_MAP|missing_key_proof\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_MAP\", \"missing_key_proof\"))"
        if cond="callVerdict == \"T10_MAP|set_outside_do\""
          do value="out.push(rejectLine(path, callLine[c], callCol[c], \"T10_MAP\", \"set_outside_do\"))"
    for name=x from=0 to="idxFn.length"
      let name=indexDetail value="indexRejectDetail(idxFn[x], idxIndexKind[x], idxIndexName[x], stmtKind, stmtFn, stmtName, stmtTarget, callName, callFn, argCall, argOrdinal, argKind, argName, argNum, argOp, argLeftKind, argLeftName, argLeftNum, argRightKind, argRightName, argRightNum, paramFn, paramName, paramOrdinal)"
      if cond="indexDetail != \"\""
        do value="out.push(rejectLine(path, idxLine[x], idxCol[x], \"T10_INDEX\", indexDetail))"
    if cond="out.length == 0"
      do value="out.push(acceptLine(path))"
    return value="out"

fn name=checkerFactsFailure returns=string[]
  param name=code type=string
  handler lang="kern"
    let name=out value="[]"
    do value="out.push(\"kern.checker.native-result.1\")"
    do value="out.push(\"failure\")"
    do value="out.push(code)"
    return value="out"

fn name=checkerFactsArgumentsCanonical returns=boolean
  param name=callArgCount type=number[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  handler lang="kern"
    for name=callRow from=0 to="callArgCount.length"
      if cond="callArgCount[callRow] < 0"
        return value="false"
    for name=row from=0 to="argCall.length"
      if cond="argCall[row] < 0 || argCall[row] >= callArgCount.length"
        return value="false"
      if cond="row == 0"
        if cond="argOrdinal[row] != 0"
          return value="false"
      if cond="row > 0"
        if cond="argCall[row] == argCall[row - 1]"
          if cond="argOrdinal[row] != argOrdinal[row - 1] + 1"
            return value="false"
        if cond="argCall[row] != argCall[row - 1]"
          if cond="argCall[row] < argCall[row - 1]"
            return value="false"
          if cond="argOrdinal[row] != 0"
            return value="false"
    return value="true"

fn name=checkerFactsParametersCanonical returns=boolean
  param name=stmtKind type=string[]
  param name=stmtName type=string[]
  param name=paramFn type=string[]
  param name=paramOrdinal type=number[]
  param name=paramOwnerStmt type=number[]
  handler lang="kern"
    for name=row from=1 to="paramOwnerStmt.length"
      if cond="paramOwnerStmt[row] < paramOwnerStmt[row - 1]"
        return value="false"
    let name=seen value=0
    for name=statementRow from=0 to="stmtKind.length"
      let name=ordinal value=0
      for name=parameterRow from=0 to="paramFn.length"
        if cond="paramOwnerStmt[parameterRow] == statementRow"
          if cond="stmtKind[statementRow] != \"fn\""
            return value="false"
          if cond="paramFn[parameterRow] != stmtName[statementRow]"
            return value="false"
          if cond="paramOrdinal[parameterRow] != ordinal"
            return value="false"
          assign target=ordinal value="ordinal + 1"
          assign target=seen value="seen + 1"
    return value="seen == paramFn.length"

fn name=checkFacts returns=string[] export=true
  param name=format type=string
  param name=path type=string
  param name=stmtKind type=string[]
  param name=stmtFn type=string[]
  param name=stmtParent type=number[]
  param name=stmtLine type=number[]
  param name=stmtCol type=number[]
  param name=stmtName type=string[]
  param name=stmtTarget type=string[]
  param name=stmtValue type=string[]
  param name=stmtTemplate type=string[]
  param name=stmtExprKind type=string[]
  param name=stmtExprName type=string[]
  param name=stmtExprLeftKind type=string[]
  param name=stmtExprLeftName type=string[]
  param name=stmtExprLeftNum type=string[]
  param name=stmtExprLeftMemberObject type=string[]
  param name=stmtExprLeftMemberProp type=string[]
  param name=stmtExprRightKind type=string[]
  param name=stmtExprRightName type=string[]
  param name=stmtExprRightNum type=string[]
  param name=stmtExprRightMemberObject type=string[]
  param name=stmtExprRightMemberProp type=string[]
  param name=stmtExprNum type=string[]
  param name=stmtExprCall type=string[]
  param name=stmtExprMemberObject type=string[]
  param name=stmtExprMemberProp type=string[]
  param name=stmtExprArgCount type=number[]
  param name=idxStmt type=number[]
  param name=idxFn type=string[]
  param name=idxLine type=number[]
  param name=idxCol type=number[]
  param name=idxIndexKind type=string[]
  param name=idxIndexName type=string[]
  param name=callStmt type=number[]
  param name=callFn type=string[]
  param name=callStmtKind type=string[]
  param name=callLine type=number[]
  param name=callCol type=number[]
  param name=callName type=string[]
  param name=callMemberObject type=string[]
  param name=callMemberProp type=string[]
  param name=callArgCount type=number[]
  param name=argCall type=number[]
  param name=argOrdinal type=number[]
  param name=argKind type=string[]
  param name=argName type=string[]
  param name=argNum type=string[]
  param name=argOp type=string[]
  param name=argLeftKind type=string[]
  param name=argLeftName type=string[]
  param name=argLeftNum type=string[]
  param name=argRightKind type=string[]
  param name=argRightName type=string[]
  param name=argRightNum type=string[]
  param name=paramFn type=string[]
  param name=paramName type=string[]
  param name=paramType type=string[]
  param name=paramOrdinal type=number[]
  param name=paramOwnerStmt type=number[]
  param name=maxRows type=number
  param name=maxCells type=number
  param name=maxDiagnostics type=number
  handler lang="kern"
    if cond="format != \"kern.checker.facts.2\""
      return value="checkerFactsFailure(\"CHECKER_FACTS_FORMAT\")"
    if cond="path == \"\" || maxRows <= 0 || maxCells <= 0 || maxDiagnostics <= 0"
      return value="checkerFactsFailure(\"CHECKER_FACTS_LIMITS\")"
    let name=statementRows value="stmtKind.length"
    let name=indexRows value="idxStmt.length"
    let name=callRows value="callStmt.length"
    let name=argumentRows value="argCall.length"
    let name=parameterRows value="paramFn.length"
    if cond="stmtFn.length != statementRows || stmtParent.length != statementRows || stmtLine.length != statementRows || stmtCol.length != statementRows || stmtName.length != statementRows || stmtTarget.length != statementRows || stmtValue.length != statementRows || stmtTemplate.length != statementRows || stmtExprKind.length != statementRows || stmtExprName.length != statementRows || stmtExprLeftKind.length != statementRows || stmtExprLeftName.length != statementRows || stmtExprLeftNum.length != statementRows || stmtExprLeftMemberObject.length != statementRows || stmtExprLeftMemberProp.length != statementRows || stmtExprRightKind.length != statementRows || stmtExprRightName.length != statementRows || stmtExprRightNum.length != statementRows || stmtExprRightMemberObject.length != statementRows || stmtExprRightMemberProp.length != statementRows || stmtExprNum.length != statementRows || stmtExprCall.length != statementRows || stmtExprMemberObject.length != statementRows || stmtExprMemberProp.length != statementRows || stmtExprArgCount.length != statementRows"
