fn name=main returns=void
  handler lang="kern"
    let kind=let name=total value="0"
    for name=i from="1" to="4"
      assign target=total value="total + i"
    if cond="total > 5"
      print value="\"sum-ok\""
    else
      print value="\"sum-bad\""
    let kind=let name=n value="0"
    while cond="n < 2"
      print value="n"
      assign target=n value="n + 1"
    let name=xs value="[10,20,30]"
    print value="xs[1]"
    let name=labels value="[\"rag\",\"runtime\"]"
    each name=label in=labels
      print value="label"
    fmt name=message template="fmt-${total}"
    print value="message"
    branch on="message"
      path value="fmt-6"
        print value="\"branch\""
      path default=true
        print value="\"branch-miss\""
    try
      throw value="new Error(\"caught\")"
      catch name=e
        print value="e.message"
      finally
        print value="\"finally\""
    capability namespace=storage operation=set name=setOk input="{ key: \"mode\", value: \"preview\" }"
    print value="setOk"
    capability namespace=storage operation=get name=mode input="{ key: \"mode\" }"
    print value="mode"
    capability namespace=storage operation=delete name=deleted input="{ key: \"mode\" }"
    print value="deleted"
    capability namespace=crypto operation=randomBytes name=bytes input="{ length: 3 }"
    print value="bytes.length"
