fn name=charokfirst params="c:string" returns=boolean export=true
  handler lang="kern"
    if cond="c >= \"A\" && c <= \"Z\""
      return value="true"
    if cond="c >= \"a\" && c <= \"z\""
      return value="true"
    if cond="c == \"_\""
      return value="true"
    return value="false"

fn name=charoknext params="c:string" returns=boolean export=true
  handler lang="kern"
    if cond="charokfirst(c)"
      return value="true"
    if cond="c >= \"0\" && c <= \"9\""
      return value="true"
    return value="false"

fn name=isreserved params="name:string" returns=boolean export=true
  handler lang="kern"
    if cond="name == \"Array\""
      return value="true"
    if cond="name == \"Boolean\""
      return value="true"
    if cond="name == \"JSON\""
      return value="true"
    if cond="name == \"List\""
      return value="true"
    if cond="name == \"Map\""
      return value="true"
    if cond="name == \"Math\""
      return value="true"
    if cond="name == \"None\""
      return value="true"
    if cond="name == \"Number\""
      return value="true"
    if cond="name == \"Object\""
      return value="true"
    if cond="name == \"Set\""
      return value="true"
    if cond="name == \"String\""
      return value="true"
    if cond="name == \"True\""
      return value="true"
    if cond="name == \"False\""
      return value="true"
    if cond="name == \"bool\""
      return value="true"
    if cond="name == \"class\""
      return value="true"
    if cond="name == \"const\""
      return value="true"
    if cond="name == \"def\""
      return value="true"
    if cond="name == \"dict\""
      return value="true"
    if cond="name == \"else\""
      return value="true"
    if cond="name == \"false\""
      return value="true"
    if cond="name == \"for\""
      return value="true"
    if cond="name == \"function\""
      return value="true"
    if cond="name == \"if\""
      return value="true"
    if cond="name == \"int\""
      return value="true"
    if cond="name == \"len\""
      return value="true"
    if cond="name == \"let\""
      return value="true"
    if cond="name == \"list\""
      return value="true"
    if cond="name == \"null\""
      return value="true"
    if cond="name == \"print\""
      return value="true"
    if cond="name == \"return\""
      return value="true"
    if cond="name == \"str\""
      return value="true"
    if cond="name == \"true\""
      return value="true"
    if cond="name == \"undefined\""
      return value="true"
    if cond="name == \"var\""
      return value="true"
    if cond="name == \"while\""
      return value="true"
    return value="false"

fn name=isportable params="name:string" returns=boolean export=true
  handler lang="kern"
    if cond="Text.length(name) == 0"
      return value="false"
    if cond="!charokfirst(Text.charAt(name, 0))"
      return value="false"
    let name=n value="Text.length(name)"
    for name=i from=1 to="n"
      if cond="!charoknext(Text.charAt(name, i))"
        return value="false"
    if cond="isreserved(name)"
      return value="false"
    if cond="Text.startsWith(name, \"__k\")"
      return value="false"
    if cond="Text.startsWith(name, \"_kern\")"
      return value="false"
    return value="true"

fn name=localname params="alias:string,imported:string" returns=string export=true
  handler lang="kern"
    if cond="alias == \"\""
      return value="imported"
    return value="alias"

fn name=failline params="code:string,subject:string,rowId:number" returns=string export=true
  handler lang="kern"
    return value="\"FAIL|\" + code + \"|\" + subject + \"#\" + String(rowId)"

fn name=rootpath params="module:number,moduleId:number[],moduleRoot:string[]" returns=string export=true
  handler lang="kern"
    for name=i from=0 to="moduleId.length"
      if cond="moduleId[i] == module"
        return value="moduleRoot[i]"
    return value="\"\""

fn name=statusof params="module:number,moduleId:number[],moduleStatus:string[]" returns=string export=true
  handler lang="kern"
    for name=i from=0 to="moduleId.length"
      if cond="moduleId[i] == module"
        return value="moduleStatus[i]"
    return value="\"missing\""

fn name=contained params="root:string,candidate:string" returns=boolean export=true
  handler lang="kern"
    if cond="root == \"\""
      return value="false"
    if cond="candidate == root"
      return value="true"
    return value="Text.startsWith(candidate, root + \"/\")"

fn name=paramcount params="fnRow:number,paramFn:number[]" returns=number export=true
  handler lang="kern"
    let name=count value="0"
    for name=i from=0 to="paramFn.length"
      if cond="paramFn[i] == fnRow"
        assign target=count value="count + 1"
    return value="count"

fn name=fnokat params="idx:number,fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],paramFn:number[]" returns=boolean export=true
  handler lang="kern"
    if cond="fnName[idx] == \"main\""
      return value="false"
    if cond="!isportable(fnName[idx])"
      return value="false"
    if cond="fnAsync[idx] == 1"
      return value="false"
    if cond="fnStream[idx] == 1"
      return value="false"
    if cond="fnReturns[idx] == \"\""
      return value="false"
    if cond="fnReturns[idx] == \"void\""
      return value="false"
    if cond="fnHandlers[idx] != 1"
      return value="false"
    if cond="fnParams[idx] != \"\""
      if cond="paramcount(idx + 1, paramFn) != 0"
        return value="false"
    return value="true"

fn name=owncallable params="module:number,name:string,fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],paramFn:number[],classModule:number[],className:string[]" returns=boolean export=true
  handler lang="kern"
    for name=i from=0 to="fnModule.length"
      if cond="fnModule[i] == module"
        if cond="fnokat(i, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn)"
          if cond="fnName[i] == name"
            return value="true"
    for name=j from=0 to="classModule.length"
      if cond="classModule[j] == module"
        if cond="className[j] == name"
          return value="true"
    return value="false"

fn name=ownexportkind params="module:number,name:string,fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],fnExport:number[],paramFn:number[],classModule:number[],className:string[],classExport:number[]" returns=string export=true
  handler lang="kern"
    for name=i from=0 to="fnModule.length"
      if cond="fnModule[i] == module"
        if cond="fnExport[i] == 1"
          if cond="fnokat(i, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn)"
            if cond="fnName[i] == name"
              return value="\"fn\""
    for name=j from=0 to="classModule.length"
      if cond="classModule[j] == module"
        if cond="classExport[j] == 1"
          if cond="className[j] == name"
            return value="\"class\""
    return value="\"\""

fn name=containsid params="xs:number[],id:number" returns=boolean export=true
  handler lang="kern"
    for name=i from=0 to="xs.length"
      if cond="xs[i] == id"
        return value="true"
    return value="false"

fn name=appendid params="xs:number[],id:number" returns=number[] export=true
  handler lang="kern"
    let name=out value="[]"
    for name=i from=0 to="xs.length"
      do value="out.push(xs[i])"
    do value="out.push(id)"
    return value="out"

fn name=exportkind params="module:number,name:string,fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],fnExport:number[],paramFn:number[],classModule:number[],className:string[],classExport:number[],useModule:number[],useTarget:number[],fromUse:number[],fromName:string[],fromAs:string[],fromExport:number[],path:number[]" returns=string export=true
  handler lang="kern"
    if cond="containsid(path, module)"
      return value="\"CYCLE\""
    let name=own value="ownexportkind(module, name, fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport)"
    if cond="own != \"\""
      return value="own"
    let name=nextPath value="appendid(path, module)"
    for name=i from=0 to="fromUse.length"
      if cond="fromExport[i] == 1"
        let name=local value="localname(fromAs[i], fromName[i])"
        if cond="local == name"
          for name=u from=0 to="useModule.length"
            if cond="u + 1 == fromUse[i]"
              if cond="useModule[u] == module"
                if cond="useTarget[u] != 0"
                  return value="exportkind(useTarget[u], fromName[i], fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport, useModule, useTarget, fromUse, fromName, fromAs, fromExport, nextPath)"
    return value="\"MISSING\""

fn name=classrow params="module:number,name:string,classModule:number[],className:string[]" returns=number export=true
  handler lang="kern"
    for name=i from=0 to="classModule.length"
      if cond="classModule[i] == module"
        if cond="className[i] == name"
          return value="i + 1"
    return value="0"

fn name=classcyclefrom params="module:number,name:string,classModule:number[],className:string[],classExtends:string[],path:number[]" returns=boolean export=true
  handler lang="kern"
    for name=i from=0 to="classModule.length"
      if cond="classModule[i] == module"
        if cond="className[i] == name"
          let name=row value="i + 1"
          if cond="containsid(path, row)"
            return value="true"
          if cond="classExtends[i] == \"\""
            return value="false"
          let name=nextPath value="appendid(path, row)"
          return value="classcyclefrom(module, classExtends[i], classModule, className, classExtends, nextPath)"
    return value="false"

fn name=hasimportcyclefrom params="module:number,useModule:number[],useTarget:number[],path:number[]" returns=boolean export=true
  handler lang="kern"
    if cond="containsid(path, module)"
      return value="true"
    let name=nextPath value="appendid(path, module)"
    for name=i from=0 to="useModule.length"
      if cond="useModule[i] == module"
        if cond="useTarget[i] != 0"
          if cond="hasimportcyclefrom(useTarget[i], useModule, useTarget, nextPath)"
            return value="true"
    return value="false"

fn name=sortstrings params="xs:string[]" returns=string[] export=true
  handler lang="kern"
    let name=out value="[]"
    let name=emitted value="0"
    let name=last value="\"\""
    let name=found value="false"
    let name=min value="\"\""
    while cond="emitted < xs.length"
      assign target=found value="false"
      assign target=min value="\"\""
      for name=i from=0 to="xs.length"
        if cond="emitted == 0 || last < xs[i]"
          if cond="!found"
            assign target=min value="xs[i]"
            assign target=found value="true"
          else
            if cond="xs[i] < min"
              assign target=min value="xs[i]"
      for name=j from=0 to="xs.length"
        if cond="xs[j] == min"
          do value="out.push(min)"
          assign target=emitted value="emitted + 1"
      assign target=last value="min"
    return value="out"

fn name=validate params="schemaVersion:number,moduleId:number[],moduleRoot:string[],moduleStatus:string[],fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],fnExport:number[],paramFn:number[],paramName:string[],paramHasChildren:number[],paramHasValue:number[],paramHasDefault:number[],paramOptional:number[],paramVariadic:number[],classModule:number[],className:string[],classExtends:string[],classExport:number[],fieldClass:number[],fieldName:string[],memberClass:number[],memberKind:string[],memberName:string[],memberAsync:number[],memberStream:number[],memberStatic:number[],memberHandlers:number[],useModule:number[],usePath:string[],useTarget:number[],useCandidate:string[],fromUse:number[],fromName:string[],fromAs:string[],fromKind:string[],fromExport:number[]" returns=string[] export=true
  handler lang="kern"
    let name=fails value="[]"
    if cond="schemaVersion != 1"
      do value="fails.push(failline(\"SCHEMA_VERSION\", \"schema\", schemaVersion))"

    for name=i from=0 to="moduleId.length"
      if cond="moduleStatus[i] == \"unreadable\""
        do value="fails.push(failline(\"MODULE_UNREADABLE\", \"module\", moduleId[i]))"
      if cond="moduleStatus[i] == \"parse-error\""
        do value="fails.push(failline(\"MODULE_PARSE\", \"module\", moduleId[i]))"

    let name=mainCount value="0"
    for name=i from=0 to="fnModule.length"
      let name=fnRow value="i + 1"
      if cond="fnModule[i] == 1"
        if cond="fnName[i] == \"main\""
          assign target=mainCount value="mainCount + 1"
          if cond="mainCount > 1"
            do value="fails.push(failline(\"MAIN_DUPLICATE\", \"main\", fnRow))"
          if cond="fnReturns[i] != \"void\""
            do value="fails.push(failline(\"MAIN_RETURNS\", \"main\", fnRow))"
          if cond="fnParams[i] != \"\" || paramcount(fnRow, paramFn) != 0"
            do value="fails.push(failline(\"MAIN_PARAMS\", \"main\", fnRow))"
          if cond="fnAsync[i] == 1"
            do value="fails.push(failline(\"MAIN_ASYNC\", \"main\", fnRow))"
          if cond="fnStream[i] == 1"
            do value="fails.push(failline(\"MAIN_STREAM\", \"main\", fnRow))"
          if cond="fnHandlers[i] != 1"
            do value="fails.push(failline(\"MAIN_HANDLER\", \"main\", fnRow))"
      if cond="fnModule[i] != 1"
        if cond="fnName[i] == \"main\""
          do value="fails.push(failline(\"IMPORTED_MAIN\", \"main\", fnRow))"
    if cond="mainCount == 0"
      do value="fails.push(failline(\"MAIN_MISSING\", \"root\", 0))"

    for name=i from=0 to="fnModule.length"
      let name=row value="i + 1"
      for name=j from=0 to="fnModule.length"
        if cond="j > i"
          if cond="fnModule[i] == fnModule[j]"
            if cond="fnName[i] == fnName[j]"
              do value="fails.push(failline(\"DUP_FN\", fnName[i], row))"
      if cond="fnName[i] != \"main\""
        if cond="fnParams[i] != \"\""
          if cond="paramcount(row, paramFn) != 0"
            do value="fails.push(failline(\"PARAM_MIX\", fnName[i], row))"
        if cond="fnExport[i] == 1"
          if cond="!fnokat(i, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn)"
            do value="fails.push(failline(\"EXPORT_UNSUPPORTED\", fnName[i], row))"

    for name=i from=0 to="classModule.length"
      let name=row value="i + 1"
      if cond="className[i] == \"main\""
        do value="fails.push(failline(\"CLASS_MAIN\", className[i], row))"
      for name=j from=0 to="classModule.length"
        if cond="j > i"
          if cond="classModule[i] == classModule[j]"
            if cond="className[i] == className[j]"
              do value="fails.push(failline(\"DUP_CLASS\", className[i], row))"
      if cond="classExtends[i] != \"\""
        if cond="classrow(classModule[i], classExtends[i], classModule, className) == 0"
          do value="fails.push(failline(\"CLASS_EXTENDS_UNKNOWN\", className[i], row))"
        let name=emptyPath value="[]"
        if cond="classcyclefrom(classModule[i], className[i], classModule, className, classExtends, emptyPath)"
          do value="fails.push(failline(\"CLASS_CYCLE\", className[i], row))"

    for name=i from=0 to="fnModule.length"
      for name=j from=0 to="classModule.length"
        if cond="fnModule[i] == classModule[j]"
          if cond="fnName[i] == className[j]"
            do value="fails.push(failline(\"CALLABLE_CONFLICT\", fnName[i], i + 1))"

    for name=i from=0 to="fieldClass.length"
      for name=j from=0 to="fieldClass.length"
        if cond="j > i"
          if cond="fieldClass[i] == fieldClass[j]"
            if cond="fieldName[i] == fieldName[j]"
              do value="fails.push(failline(\"DUP_FIELD\", fieldName[i], i + 1))"

    for name=i from=0 to="memberClass.length"
      if cond="memberAsync[i] == 1 || memberStream[i] == 1 || memberStatic[i] == 1"
        do value="fails.push(failline(\"MEMBER_UNSUPPORTED\", memberName[i], i + 1))"
      if cond="memberHandlers[i] != 1"
        do value="fails.push(failline(\"MEMBER_HANDLER\", memberName[i], i + 1))"
      for name=j from=0 to="memberClass.length"
        if cond="j > i"
          if cond="memberClass[i] == memberClass[j]"
            if cond="memberKind[i] == memberKind[j]"
              if cond="memberName[i] == memberName[j]"
                do value="fails.push(failline(\"DUP_MEMBER\", memberName[i], i + 1))"

    for name=i from=0 to="paramFn.length"
      if cond="!isportable(paramName[i])"
        do value="fails.push(failline(\"PARAM_NAME\", paramName[i], i + 1))"
      if cond="paramHasChildren[i] == 1 || paramHasValue[i] == 1 || paramHasDefault[i] == 1 || paramOptional[i] == 1 || paramVariadic[i] == 1"
        do value="fails.push(failline(\"PARAM_UNSUPPORTED\", paramName[i], i + 1))"
      for name=j from=0 to="paramFn.length"
        if cond="j > i"
          if cond="paramFn[i] == paramFn[j]"
            if cond="paramName[i] == paramName[j]"
              do value="fails.push(failline(\"DUP_PARAM\", paramName[i], i + 1))"

    for name=i from=0 to="useModule.length"
      let name=useRow value="i + 1"
      if cond="usePath[i] == \"\""
        do value="fails.push(failline(\"USE_MISSING_PATH\", String(useModule[i]), useRow))"
      let name=root value="rootpath(useModule[i], moduleId, moduleRoot)"
      if cond="useCandidate[i] != \"\""
        if cond="!contained(root, useCandidate[i])"
          do value="fails.push(failline(\"IMPORT_ESCAPES_ROOT\", usePath[i], useRow))"
      if cond="usePath[i] != \"\""
        if cond="useTarget[i] == 0"
          if cond="useCandidate[i] == \"\" || contained(root, useCandidate[i])"
            do value="fails.push(failline(\"CANNOT_RESOLVE\", usePath[i], useRow))"

    for name=i from=0 to="moduleId.length"
      if cond="moduleStatus[i] == \"ok\""
        let name=emptyPath value="[]"
        if cond="hasimportcyclefrom(moduleId[i], useModule, useTarget, emptyPath)"
          do value="fails.push(failline(\"IMPORT_CYCLE\", String(moduleId[i]), moduleId[i]))"

    for name=i from=0 to="fromUse.length"
      let name=fromRow value="i + 1"
      let name=local value="localname(fromAs[i], fromName[i])"
      if cond="!isportable(fromName[i])"
        do value="fails.push(failline(\"FROM_NAME\", fromName[i], fromRow))"
      if cond="!isportable(local)"
        do value="fails.push(failline(\"ALIAS_NAME\", local, fromRow))"
      let name=matchedUse value="0"
      for name=u from=0 to="useModule.length"
        if cond="u + 1 == fromUse[i]"
          assign target=matchedUse value="1"
          let name=module value="useModule[u]"
          let name=target value="useTarget[u]"
          for name=j from=0 to="fromUse.length"
            if cond="j > i"
              let name=otherLocal value="localname(fromAs[j], fromName[j])"
              for name=ou from=0 to="useModule.length"
                if cond="ou + 1 == fromUse[j]"
                  if cond="useModule[ou] == module"
                    if cond="otherLocal == local"
                      do value="fails.push(failline(\"DUP_ALIAS\", local, fromRow))"
          if cond="owncallable(module, local, fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn, classModule, className)"
            do value="fails.push(failline(\"ALIAS_CONFLICT\", local, fromRow))"
          if cond="target != 0"
            if cond="statusof(target, moduleId, moduleStatus) == \"ok\""
              let name=emptyPath value="[]"
              let name=kind value="exportkind(target, fromName[i], fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport, useModule, useTarget, fromUse, fromName, fromAs, fromExport, emptyPath)"
              if cond="kind == \"MISSING\""
                do value="fails.push(failline(\"DOES_NOT_EXPORT\", fromName[i], fromRow))"
              if cond="kind != \"MISSING\""
                if cond="kind != \"CYCLE\""
                  if cond="fromKind[i] != \"\""
                    if cond="fromKind[i] != kind"
                      do value="fails.push(failline(\"KIND_MISMATCH\", fromName[i], fromRow))"
          if cond="fromExport[i] == 1"
            if cond="ownexportkind(module, local, fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport) != \"\""
              do value="fails.push(failline(\"DUP_EXPORT\", local, fromRow))"
            for name=k from=0 to="fromUse.length"
              if cond="k < i"
                if cond="fromExport[k] == 1"
                  if cond="localname(fromAs[k], fromName[k]) == local"
                    for name=pu from=0 to="useModule.length"
                      if cond="pu + 1 == fromUse[k]"
                        if cond="useModule[pu] == module"
                          do value="fails.push(failline(\"DUP_EXPORT\", local, fromRow))"
      if cond="matchedUse == 0"
        do value="fails.push(failline(\"FROM_USE_MISSING\", String(fromUse[i]), fromRow))"

    if cond="fails.length == 0"
      do value="fails.push(\"PASS\")"
    return value="sortstrings(fails)"
