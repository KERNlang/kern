fn name=charokfirst returns=boolean export=true
  param name=c type=string
  handler lang="kern"
    if cond="c >= \"A\" && c <= \"Z\""
      return value="true"
    if cond="c >= \"a\" && c <= \"z\""
      return value="true"
    if cond="c == \"_\""
      return value="true"
    return value="false"

fn name=charoknext returns=boolean export=true
  param name=c type=string
  handler lang="kern"
    if cond="charokfirst(c)"
      return value="true"
    if cond="c >= \"0\" && c <= \"9\""
      return value="true"
    return value="false"

fn name=isreserved params="name:string" returns=boolean export=true
  handler lang="kern"
    if cond="name == \"Array\""
      return value="true"
    if cond="name == \"Boolean\""
      return value="true"
    if cond="name == \"JSON\""
      return value="true"
    if cond="name == \"List\""
      return value="true"
    if cond="name == \"Map\""
      return value="true"
    if cond="name == \"Math\""
      return value="true"
    if cond="name == \"None\""
      return value="true"
    if cond="name == \"Number\""
      return value="true"
    if cond="name == \"Object\""
      return value="true"
    if cond="name == \"Set\""
      return value="true"
    if cond="name == \"String\""
      return value="true"
    if cond="name == \"True\""
      return value="true"
    if cond="name == \"False\""
      return value="true"
    if cond="name == \"bool\""
      return value="true"
    if cond="name == \"class\""
      return value="true"
    if cond="name == \"const\""
      return value="true"
    if cond="name == \"def\""
      return value="true"
    if cond="name == \"dict\""
      return value="true"
    if cond="name == \"else\""
      return value="true"
    if cond="name == \"false\""
      return value="true"
    if cond="name == \"for\""
      return value="true"
    if cond="name == \"function\""
      return value="true"
    if cond="name == \"if\""
      return value="true"
    if cond="name == \"int\""
      return value="true"
    if cond="name == \"len\""
      return value="true"
    if cond="name == \"let\""
      return value="true"
    if cond="name == \"list\""
      return value="true"
    if cond="name == \"null\""
      return value="true"
    if cond="name == \"print\""
      return value="true"
    if cond="name == \"return\""
      return value="true"
    if cond="name == \"str\""
      return value="true"
    if cond="name == \"true\""
      return value="true"
    if cond="name == \"undefined\""
      return value="true"
    if cond="name == \"var\""
      return value="true"
    if cond="name == \"while\""
      return value="true"
    return value="false"

fn name=isportable params="name:string" returns=boolean export=true
  handler lang="kern"
    if cond="Text.length(name) == 0"
      return value="false"
    if cond="!charokfirst(Text.charAt(name, 0))"
      return value="false"
    let name=n value="Text.length(name)"
    for name=i from=1 to="n"
      if cond="!charoknext(Text.charAt(name, i))"
        return value="false"
    if cond="isreserved(name)"
      return value="false"
    if cond="Text.startsWith(name, \"__k\")"
      return value="false"
    if cond="Text.startsWith(name, \"_kern\")"
      return value="false"
    return value="true"

fn name=localname returns=string export=true
  param name=alias type=string
  param name=imported type=string
  handler lang="kern"
    if cond="alias == \"\""
      return value="imported"
    return value="alias"

fn name=failline returns=string export=true
  param name=code type=string
  param name=subject type=string
  param name=rowId type=number
  handler lang="kern"
    return value="\"FAIL|\" + code + \"|\" + subject + \"#\" + String(rowId)"

fn name=rootpath returns=string export=true
  param name=module type=number
  param name=moduleId type=number[]
  param name=moduleRoot type=string[]
  handler lang="kern"
    for name=i2 from=0 to="moduleId.length"
      if cond="moduleId[i2] == module"
        return value="moduleRoot[i2]"
    return value="\"\""

fn name=statusof returns=string export=true
  param name=module type=number
  param name=moduleId type=number[]
  param name=moduleStatus type=string[]
  handler lang="kern"
    for name=i3 from=0 to="moduleId.length"
      if cond="moduleId[i3] == module"
        return value="moduleStatus[i3]"
    return value="\"missing\""

fn name=contained returns=boolean export=true
  param name=root type=string
  param name=candidate type=string
  handler lang="kern"
    if cond="root == \"\""
      return value="false"
    if cond="candidate == root"
      return value="true"
    return value="Text.startsWith(candidate, root + \"/\")"

fn name=paramcount returns=number export=true
  param name=fnRow type=number
  param name=paramFn type=number[]
  handler lang="kern"
    let name=count value="0"
    for name=i4 from=0 to="paramFn.length"
      if cond="paramFn[i4] == fnRow"
        assign target=count value="count + 1"
    return value="count"

fn name=fnokat params="idx:number,fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],paramFn:number[]" returns=boolean export=true
  handler lang="kern"
    if cond="fnName[idx] == \"main\""
      return value="false"
    if cond="!isportable(fnName[idx])"
      return value="false"
    if cond="fnAsync[idx] == 1"
      return value="false"
    if cond="fnStream[idx] == 1"
      return value="false"
    if cond="fnReturns[idx] == \"\""
      return value="false"
    if cond="fnReturns[idx] == \"void\""
      return value="false"
    if cond="fnHandlers[idx] != 1"
      return value="false"
    if cond="fnParams[idx] != \"\""
      if cond="paramcount(idx + 1, paramFn) != 0"
        return value="false"
    return value="true"

fn name=owncallable params="module:number,name:string,fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],paramFn:number[],classModule:number[],className:string[]" returns=boolean export=true
  handler lang="kern"
    for name=i5 from=0 to="fnModule.length"
      if cond="fnModule[i5] == module"
        if cond="fnokat(i5, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn)"
          if cond="fnName[i5] == name"
            return value="true"
    for name=j from=0 to="classModule.length"
      if cond="classModule[j] == module"
        if cond="className[j] == name"
          return value="true"
    return value="false"

fn name=ownexportkind params="module:number,name:string,fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],fnExport:number[],paramFn:number[],classModule:number[],className:string[],classExport:number[]" returns=string export=true
  handler lang="kern"
    for name=i6 from=0 to="fnModule.length"
      if cond="fnModule[i6] == module"
        if cond="fnExport[i6] == 1"
          if cond="fnokat(i6, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn)"
            if cond="fnName[i6] == name"
              return value="\"fn\""
    for name=j from=0 to="classModule.length"
      if cond="classModule[j] == module"
        if cond="classExport[j] == 1"
          if cond="className[j] == name"
            return value="\"class\""
    return value="\"\""

fn name=containsid returns=boolean export=true
  param name=xs type=number[]
  param name=id type=number
  handler lang="kern"
    for name=i7 from=0 to="xs.length"
      if cond="xs[i7] == id"
        return value="true"
    return value="false"

fn name=appendid returns=number[] export=true
  param name=xs type=number[]
  param name=id type=number
  handler lang="kern"
    let name=out value="[]"
    for name=i8 from=0 to="xs.length"
      do value="out.push(xs[i8])"
    do value="out.push(id)"
    return value="out"

fn name=exportkind params="module:number,name:string,fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],fnExport:number[],paramFn:number[],classModule:number[],className:string[],classExport:number[],useModule:number[],useTarget:number[],fromUse:number[],fromName:string[],fromAs:string[],fromExport:number[],path:number[]" returns=string export=true
  handler lang="kern"
    if cond="containsid(path, module)"
      return value="\"CYCLE\""
    let name=own value="ownexportkind(module, name, fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport)"
    if cond="own != \"\""
      return value="own"
    let name=nextPath value="appendid(path, module)"
    for name=i9 from=0 to="fromUse.length"
      if cond="fromExport[i9] == 1"
        let name=local value="localname(fromAs[i9], fromName[i9])"
        if cond="local == name"
          for name=u from=0 to="useModule.length"
            if cond="u + 1 == fromUse[i9]"
              if cond="useModule[u] == module"
                if cond="useTarget[u] != 0"
                  return value="exportkind(useTarget[u], fromName[i9], fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport, useModule, useTarget, fromUse, fromName, fromAs, fromExport, nextPath)"
    return value="\"MISSING\""

fn name=classrow returns=number export=true
  param name=module type=number
  param name=name type=string
  param name=classModule type=number[]
  param name=className type=string[]
  handler lang="kern"
    for name=i10 from=0 to="classModule.length"
      if cond="classModule[i10] == module"
        if cond="className[i10] == name"
          return value="i10 + 1"
    return value="0"

fn name=classcyclefrom params="module:number,name:string,classModule:number[],className:string[],classExtends:string[],path:number[]" returns=boolean export=true
  handler lang="kern"
    for name=i11 from=0 to="classModule.length"
      if cond="classModule[i11] == module"
        if cond="className[i11] == name"
          let name=row value="i11 + 1"
          if cond="containsid(path, row)"
            return value="true"
          if cond="classExtends[i11] == \"\""
            return value="false"
          let name=nextPath value="appendid(path, row)"
          return value="classcyclefrom(module, classExtends[i11], classModule, className, classExtends, nextPath)"
    return value="false"

fn name=hasimportcyclefrom params="module:number,useModule:number[],useTarget:number[],path:number[]" returns=boolean export=true
  handler lang="kern"
    if cond="containsid(path, module)"
      return value="true"
    let name=nextPath value="appendid(path, module)"
    for name=i12 from=0 to="useModule.length"
      if cond="useModule[i12] == module"
        if cond="useTarget[i12] != 0"
          if cond="hasimportcyclefrom(useTarget[i12], useModule, useTarget, nextPath)"
            return value="true"
    return value="false"

fn name=sortstrings params="xs:string[]" returns=string[] export=true
  handler lang="kern"
    let name=out value="[]"
    let name=emitted value="0"
    let name=last value="\"\""
    let name=found value="false"
    let name=min value="\"\""
    while cond="emitted < xs.length"
      assign target=found value="false"
      assign target=min value="\"\""
      for name=i13 from=0 to="xs.length"
        if cond="emitted == 0 || last < xs[i13]"
          if cond="!found"
            assign target=min value="xs[i13]"
            assign target=found value="true"
          else
            if cond="xs[i13] < min"
              assign target=min value="xs[i13]"
      for name=j from=0 to="xs.length"
        if cond="xs[j] == min"
          do value="out.push(min)"
          assign target=emitted value="emitted + 1"
      assign target=last value="min"
    return value="out"

fn name=validate params="schemaVersion:number,moduleId:number[],moduleRoot:string[],moduleStatus:string[],fnModule:number[],fnName:string[],fnReturns:string[],fnAsync:number[],fnStream:number[],fnHandlers:number[],fnParams:string[],fnExport:number[],paramFn:number[],paramName:string[],paramHasChildren:number[],paramHasValue:number[],paramHasDefault:number[],paramOptional:number[],paramVariadic:number[],classModule:number[],className:string[],classExtends:string[],classExport:number[],fieldClass:number[],fieldName:string[],memberClass:number[],memberKind:string[],memberName:string[],memberAsync:number[],memberStream:number[],memberStatic:number[],memberHandlers:number[],useModule:number[],usePath:string[],useTarget:number[],useCandidate:string[],fromUse:number[],fromName:string[],fromAs:string[],fromKind:string[],fromExport:number[]" returns=string[] export=true
  handler lang="kern"
    let name=fails value="[]"
    if cond="schemaVersion != 1"
      do value="fails.push(failline(\"SCHEMA_VERSION\", \"schema\", schemaVersion))"

    for name=i14 from=0 to="moduleId.length"
      if cond="moduleStatus[i14] == \"unreadable\""
        do value="fails.push(failline(\"MODULE_UNREADABLE\", \"module\", moduleId[i14]))"
      if cond="moduleStatus[i14] == \"parse-error\""
        do value="fails.push(failline(\"MODULE_PARSE\", \"module\", moduleId[i14]))"

    let name=mainCount value="0"
    for name=i15 from=0 to="fnModule.length"
      let name=fnRow value="i15 + 1"
      if cond="fnModule[i15] == 1"
        if cond="fnName[i15] == \"main\""
          assign target=mainCount value="mainCount + 1"
          if cond="mainCount > 1"
            do value="fails.push(failline(\"MAIN_DUPLICATE\", \"main\", fnRow))"
          if cond="fnReturns[i15] != \"void\""
            do value="fails.push(failline(\"MAIN_RETURNS\", \"main\", fnRow))"
          if cond="fnParams[i15] != \"\" || paramcount(fnRow, paramFn) != 0"
            do value="fails.push(failline(\"MAIN_PARAMS\", \"main\", fnRow))"
          if cond="fnAsync[i15] == 1"
            do value="fails.push(failline(\"MAIN_ASYNC\", \"main\", fnRow))"
          if cond="fnStream[i15] == 1"
            do value="fails.push(failline(\"MAIN_STREAM\", \"main\", fnRow))"
          if cond="fnHandlers[i15] != 1"
            do value="fails.push(failline(\"MAIN_HANDLER\", \"main\", fnRow))"
      if cond="fnModule[i15] != 1"
        if cond="fnName[i15] == \"main\""
          do value="fails.push(failline(\"IMPORTED_MAIN\", \"main\", fnRow))"
    if cond="mainCount == 0"
      do value="fails.push(failline(\"MAIN_MISSING\", \"root\", 0))"

    for name=i16 from=0 to="fnModule.length"
      let name=row value="i16 + 1"
      for name=j from=0 to="fnModule.length"
        if cond="j > i16"
          if cond="fnModule[i16] == fnModule[j]"
            if cond="fnName[i16] == fnName[j]"
              do value="fails.push(failline(\"DUP_FN\", fnName[i16], row))"
      if cond="fnName[i16] != \"main\""
        if cond="fnParams[i16] != \"\""
          if cond="paramcount(row, paramFn) != 0"
            do value="fails.push(failline(\"PARAM_MIX\", fnName[i16], row))"
        if cond="fnExport[i16] == 1"
          if cond="!fnokat(i16, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn)"
            do value="fails.push(failline(\"EXPORT_UNSUPPORTED\", fnName[i16], row))"

    for name=i17 from=0 to="classModule.length"
      let name=row value="i17 + 1"
      if cond="className[i17] == \"main\""
        do value="fails.push(failline(\"CLASS_MAIN\", className[i17], row))"
      for name=j from=0 to="classModule.length"
        if cond="j > i17"
          if cond="classModule[i17] == classModule[j]"
            if cond="className[i17] == className[j]"
              do value="fails.push(failline(\"DUP_CLASS\", className[i17], row))"
      if cond="classExtends[i17] != \"\""
        if cond="classrow(classModule[i17], classExtends[i17], classModule, className) == 0"
          do value="fails.push(failline(\"CLASS_EXTENDS_UNKNOWN\", className[i17], row))"
        let name=emptyPath value="[]"
        if cond="classcyclefrom(classModule[i17], className[i17], classModule, className, classExtends, emptyPath)"
          do value="fails.push(failline(\"CLASS_CYCLE\", className[i17], row))"

    for name=i18 from=0 to="fnModule.length"
      for name=j from=0 to="classModule.length"
        if cond="fnModule[i18] == classModule[j]"
          if cond="fnName[i18] == className[j]"
            do value="fails.push(failline(\"CALLABLE_CONFLICT\", fnName[i18], i18 + 1))"

    for name=i19 from=0 to="fieldClass.length"
      for name=j from=0 to="fieldClass.length"
        if cond="j > i19"
          if cond="fieldClass[i19] == fieldClass[j]"
            if cond="fieldName[i19] == fieldName[j]"
              do value="fails.push(failline(\"DUP_FIELD\", fieldName[i19], i19 + 1))"

    for name=i20 from=0 to="memberClass.length"
      if cond="memberAsync[i20] == 1 || memberStream[i20] == 1 || memberStatic[i20] == 1"
        do value="fails.push(failline(\"MEMBER_UNSUPPORTED\", memberName[i20], i20 + 1))"
      if cond="memberHandlers[i20] != 1"
        do value="fails.push(failline(\"MEMBER_HANDLER\", memberName[i20], i20 + 1))"
      for name=j from=0 to="memberClass.length"
        if cond="j > i20"
          if cond="memberClass[i20] == memberClass[j]"
            if cond="memberKind[i20] == memberKind[j]"
              if cond="memberName[i20] == memberName[j]"
                do value="fails.push(failline(\"DUP_MEMBER\", memberName[i20], i20 + 1))"

    for name=i21 from=0 to="paramFn.length"
      if cond="!isportable(paramName[i21])"
        do value="fails.push(failline(\"PARAM_NAME\", paramName[i21], i21 + 1))"
      if cond="paramHasChildren[i21] == 1 || paramHasValue[i21] == 1 || paramHasDefault[i21] == 1 || paramOptional[i21] == 1 || paramVariadic[i21] == 1"
        do value="fails.push(failline(\"PARAM_UNSUPPORTED\", paramName[i21], i21 + 1))"
      for name=j from=0 to="paramFn.length"
        if cond="j > i21"
          if cond="paramFn[i21] == paramFn[j]"
            if cond="paramName[i21] == paramName[j]"
              do value="fails.push(failline(\"DUP_PARAM\", paramName[i21], i21 + 1))"

    for name=i22 from=0 to="useModule.length"
      let name=useRow value="i22 + 1"
      if cond="usePath[i22] == \"\""
        do value="fails.push(failline(\"USE_MISSING_PATH\", String(useModule[i22]), useRow))"
      let name=root value="rootpath(useModule[i22], moduleId, moduleRoot)"
      if cond="useCandidate[i22] != \"\""
        if cond="!contained(root, useCandidate[i22])"
          do value="fails.push(failline(\"IMPORT_ESCAPES_ROOT\", usePath[i22], useRow))"
      if cond="usePath[i22] != \"\""
        if cond="useTarget[i22] == 0"
          if cond="useCandidate[i22] == \"\" || contained(root, useCandidate[i22])"
            do value="fails.push(failline(\"CANNOT_RESOLVE\", usePath[i22], useRow))"

    for name=i23 from=0 to="moduleId.length"
      if cond="moduleStatus[i23] == \"ok\""
        let name=emptyPath value="[]"
        if cond="hasimportcyclefrom(moduleId[i23], useModule, useTarget, emptyPath)"
          do value="fails.push(failline(\"IMPORT_CYCLE\", String(moduleId[i23]), moduleId[i23]))"

    for name=i24 from=0 to="fromUse.length"
      let name=fromRow value="i24 + 1"
      let name=local value="localname(fromAs[i24], fromName[i24])"
      if cond="!isportable(fromName[i24])"
        do value="fails.push(failline(\"FROM_NAME\", fromName[i24], fromRow))"
      if cond="!isportable(local)"
        do value="fails.push(failline(\"ALIAS_NAME\", local, fromRow))"
      let name=matchedUse value="0"
      for name=u from=0 to="useModule.length"
        if cond="u + 1 == fromUse[i24]"
          assign target=matchedUse value="1"
          let name=module value="useModule[u]"
          let name=target value="useTarget[u]"
          for name=j from=0 to="fromUse.length"
            if cond="j > i24"
              let name=otherLocal value="localname(fromAs[j], fromName[j])"
              for name=ou from=0 to="useModule.length"
                if cond="ou + 1 == fromUse[j]"
                  if cond="useModule[ou] == module"
                    if cond="otherLocal == local"
                      do value="fails.push(failline(\"DUP_ALIAS\", local, fromRow))"
          if cond="owncallable(module, local, fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, paramFn, classModule, className)"
            do value="fails.push(failline(\"ALIAS_CONFLICT\", local, fromRow))"
          if cond="target != 0"
            if cond="statusof(target, moduleId, moduleStatus) == \"ok\""
              let name=emptyPath value="[]"
              let name=kind value="exportkind(target, fromName[i24], fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport, useModule, useTarget, fromUse, fromName, fromAs, fromExport, emptyPath)"
              if cond="kind == \"MISSING\""
                do value="fails.push(failline(\"DOES_NOT_EXPORT\", fromName[i24], fromRow))"
              if cond="kind != \"MISSING\""
                if cond="kind != \"CYCLE\""
                  if cond="fromKind[i24] != \"\""
                    if cond="fromKind[i24] != kind"
                      do value="fails.push(failline(\"KIND_MISMATCH\", fromName[i24], fromRow))"
          if cond="fromExport[i24] == 1"
            if cond="ownexportkind(module, local, fnModule, fnName, fnReturns, fnAsync, fnStream, fnHandlers, fnParams, fnExport, paramFn, classModule, className, classExport) != \"\""
              do value="fails.push(failline(\"DUP_EXPORT\", local, fromRow))"
            for name=k from=0 to="fromUse.length"
              if cond="k < i24"
                if cond="fromExport[k] == 1"
                  if cond="localname(fromAs[k], fromName[k]) == local"
                    for name=pu from=0 to="useModule.length"
                      if cond="pu + 1 == fromUse[k]"
                        if cond="useModule[pu] == module"
                          do value="fails.push(failline(\"DUP_EXPORT\", local, fromRow))"
      if cond="matchedUse == 0"
        do value="fails.push(failline(\"FROM_USE_MISSING\", String(fromUse[i24]), fromRow))"

    if cond="fails.length == 0"
      do value="fails.push(\"PASS\")"
    return value="sortstrings(fails)"
