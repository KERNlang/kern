server name=MusicAPI port=3001
  middleware name=cors
  middleware name=json
  middleware name=auth handler=verifyToken
  import from="./services/db.js" names=db
  import from="./services/analyzer.js" names=analyzeTrack

  route method=get path=/api/tracks
    auth required
    derive tracks expr={{await db.tracks.findAll({userId: user.id})}}
    respond 200 json=tracks

  route method=post path=/api/tracks/analyze
    schema body="{trackId: string, options?: {stems: boolean}}"
    derive result expr={{await analyzeTrack(body.trackId, body.options)}}
    respond 200 json=result

  route method=get path=/api/tracks/:id
    derive track expr={{await db.tracks.findById(params.id)}}
    guard name=exists expr={{track}} else=404
    respond 200 json=track
    error 404 "Not found"

  route method=delete path=/api/tracks/:id
    middleware name=requireOwner
    derive deleted expr={{await db.tracks.delete(params.id)}}
    respond 204
