fn name=main returns=void
  handler lang="kern"
    print value="\"<!doctype html>\""
    print value="\"<html lang=\\\"en\\\">\""
    print value="\"<head>\""
    print value="\"<meta charset=\\\"utf-8\\\">\""
    print value="\"<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\""
    print value="\"<title>KERN 5 Preview App</title>\""
    print value="\"<style>body{font-family:system-ui,-apple-system,Segoe UI,sans-serif;margin:0;background:#f7f8fb;color:#141820}.shell{max-width:860px;margin:0 auto;padding:32px 20px}.panel{background:#fff;border:1px solid #d9dee8;border-radius:8px;padding:20px;box-shadow:0 1px 3px #0001}label{display:block;font-weight:650;margin-bottom:8px}textarea{box-sizing:border-box;width:100%;min-height:88px;border:1px solid #b9c1d0;border-radius:6px;padding:10px;font:inherit}button{margin-top:12px;border:0;border-radius:6px;background:#135cc8;color:white;padding:10px 14px;font-weight:650;cursor:pointer}pre{white-space:pre-wrap;background:#101723;color:#eff5ff;border-radius:6px;padding:14px;min-height:120px}small{color:#596274}</style>\""
    print value="\"</head>\""
    print value="\"<body data-kern-ui=\\\"native-runner-preview\\\">\""
    print value="\"<main class=\\\"shell\\\">\""
    print value="\"<h1>KERN 5 Preview App</h1>\""
    print value="\"<p>This refund-support browser UI, backend route, RAG query, and grounding guard are authored in .kern and run through the native runner preview.</p>\""
    print value="\"<section class=\\\"panel\\\">\""
    print value="\"<label for=\\\"question\\\">Refund question</label>\""
    print value="\"<textarea id=\\\"question\\\">refund policy receipt</textarea>\""
    print value="\"<button id=\\\"ask\\\" type=\\\"button\\\">Ask KERN</button>\""
    print value="\"<small id=\\\"status\\\">Ready</small>\""
    print value="\"<pre id=\\\"answer\\\"></pre>\""
    print value="\"</section>\""
    print value="\"</main>\""
    print value="\"<script type=\\\"module\\\">const q=document.getElementById('question');const a=document.getElementById('answer');const s=document.getElementById('status');const nl=String.fromCharCode(10);document.getElementById('ask').addEventListener('click',async()=>{s.textContent='Running native runner preview';a.textContent='';try{const r=await fetch('/api/answer?question='+encodeURIComponent(q.value));const data=await r.json();if(!r.ok){s.textContent='Failed';a.textContent=data.error||'Request failed';return;}s.textContent='Grounding: '+data.status;a.textContent=data.answer+nl+nl+'source: '+data.source+nl+'chunks: '+data.chunkCount;}catch{s.textContent='Failed';a.textContent='Request failed';}});</script>\""
    print value="\"</body>\""
    print value="\"</html>\""
